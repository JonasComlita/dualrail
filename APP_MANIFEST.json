{
  "version": 1,
  "schema": "trit.app_manifest.v1",
  "source_of_truth": "build_tos_image.cpp",
  "root_layout": [
    "/bin",
    "/apps",
    "/etc",
    "/home",
    "/tmp",
    "/var",
    "/var/log",
    "/dev",
    "/system",
    "/system/services",
    "/lib",
    "/var/crash",
    "/var/packages",
    "/home/root/docs"
  ],
  "default_user": {
    "name": "root",
    "home": "/home/root",
    "shell": "/bin/desktop"
  },
  "registry_format": {
    "path": "/apps/registry",
    "records": "GUI apps only",
