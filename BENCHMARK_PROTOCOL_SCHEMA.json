{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.dev/schemas/benchmark_protocol.v1.schema.json",
  "version": 1,
  "title": "P10 reproducible benchmark protocol and result",
  "type": "object",
  "required": [
    "schema",
    "protocol_id",
    "manifest_id",
    "workload_id",
    "profile_id",
    "correctness",
    "metrics"
  ],
  "properties": {
    "schema": { "const": "trit.benchmark_protocol_result.v1" },
    "protocol_id": { "type": "string", "minLength": 1 },
    "manifest_id": { "type": "string", "minLength": 1 },
    "workload_id": { "type": "string", "minLength": 1 },
    "representation_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runner_image": { "type": "string", "minLength": 1 },
    "limits": { "$ref": "#/$defs/limits" },
    "correctness": { "$ref": "#/$defs/correctness" },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/metric" }
    },
    "context": { "type": "object", "additionalProperties": true },
    "environment": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true,
  "$defs": {
    "limits": {
      "type": "object",
      "required": ["wall_time_ms", "memory_bytes", "output_bytes", "processes"],
      "properties": {
        "wall_time_ms": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "output_bytes": { "type": "integer", "minimum": 1 },
        "processes": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "object",
      "required": ["equivalent", "fixture_id", "reference_output_hash", "observed_output_hash"],
      "properties": {
        "equivalent": { "type": "boolean" },
        "fixture_id": { "type": "string", "minLength": 1 },
        "reference_output_hash": { "type": "string", "minLength": 1 },
        "observed_output_hash": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "metric": {
      "type": "object",
      "required": ["unit", "samples"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        },
        "distribution": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    }
  }
}
