{
  "version": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trit.benchmark_result.v1",
  "title": "Trit reproducible benchmark result",
  "type": "object",
  "required": [
    "schema",
    "captured_at_utc",
    "source",
    "host",
    "build",
    "workload",
    "correctness",
    "timing",
    "instruction_mix",
    "memory",
    "tlb",
    "scheduler",
    "wal",
    "disk"
  ],
  "properties": {
    "schema": {
      "const": "trit.benchmark_result.v1"
    },
    "captured_at_utc": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "dirty"],
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": "string"},
        "dirty": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "required": ["system", "release", "machine", "processor", "python"],
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "required": ["directory", "profile"],
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "required": ["name", "suite"],
      "additionalProperties": true
    },
    "correctness": {
      "type": "object",
      "required": ["passed", "warmup_returncodes", "measured_returncodes"],
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "required": [
        "unit",
        "warmups",
        "iterations",
        "samples",
        "median",
        "mean",
        "standard_deviation",
        "coefficient_of_variation",
        "maximum_accepted_cv"
      ],
      "properties": {
        "unit": {"const": "seconds"},
        "warmups": {"type": "integer", "minimum": 0},
        "iterations": {"type": "integer", "minimum": 1},
        "samples": {
          "type": "array",
          "items": {"type": "number", "minimum": 0}
        },
        "median": {"type": "number", "minimum": 0},
        "mean": {"type": "number", "minimum": 0},
        "standard_deviation": {"type": "number", "minimum": 0},
        "coefficient_of_variation": {"type": "number", "minimum": 0},
        "maximum_accepted_cv": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "instruction_mix": {"type": "object"},
    "memory": {"type": "object"},
    "tlb": {"type": "object"},
    "scheduler": {"type": "object"},
    "wal": {"type": "object"},
    "disk": {"type": "object"},
    "graphics": {"type": "object"},
    "compute": {"type": "object"}
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": ["workload"],
        "properties": {
          "workload": {
            "required": ["suite"],
            "properties": {"suite": {"const": "system_benchmarks"}}
          }
        }
      },
      "then": {
        "required": ["graphics", "compute"],
        "properties": {
          "workload": {"required": ["version", "suite"]},
          "correctness": {
            "required": ["passed", "warmup_returncodes", "measured_returncodes", "expected_hash", "observed_hash"],
            "properties": {
              "warmup_returncodes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
              "measured_returncodes": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "integer"}},
              "expected_hash": {"type": "string", "minLength": 1},
              "observed_hash": {"type": "string", "minLength": 1}
            }
          },
          "timing": {
            "required": ["scope", "stable"],
            "properties": {
              "warmups": {"const": 2},
              "iterations": {"const": 7},
              "samples": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "number", "minimum": 0}},
              "maximum_accepted_cv": {"const": 0.03},
              "stable": {"type": "boolean"}
            }
          },
          "instruction_mix": {"required": ["dynamic_total"]},
          "memory": {"required": ["high_water_words"]},
          "tlb": {"required": ["misses"]},
          "scheduler": {"required": ["timer_ticks"]},
          "wal": {"required": ["durable_lsn"]},
          "disk": {"required": ["read_words"]},
          "graphics": {"required": ["frames_presented"]},
          "compute": {"required": ["kernel"]}
        }
      }
    }
  ]
}
