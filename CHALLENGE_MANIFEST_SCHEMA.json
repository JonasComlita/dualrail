{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "treatcode.challenge_manifest.v1.schema.json",
  "version": 1,
  "title": "TreatCode challenge manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "source_of_truth", "facet_dimensions", "challenges"],
  "properties": {
    "schema": { "const": "treatcode.challenge_manifest.v1" },
    "version": { "const": 1 },
    "source_of_truth": { "const": "CHALLENGE_MANIFEST.json" },
    "facet_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "technique", "data_model", "stack_layer", "target", "optimization_objective"],
      "properties": {
        "domain": { "$ref": "#/$defs/facet-values" },
        "technique": { "$ref": "#/$defs/facet-values" },
        "data_model": { "$ref": "#/$defs/facet-values" },
        "stack_layer": { "$ref": "#/$defs/facet-values" },
        "target": { "$ref": "#/$defs/facet-values" },
        "optimization_objective": { "$ref": "#/$defs/facet-values" }
      }
    },
    "challenges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/challenge" }
    }
  },
  "$defs": {
    "facet-values": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "facet-set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "technique", "data_model", "stack_layer", "target", "optimization_objective"],
      "properties": {
        "domain": { "$ref": "#/$defs/facet-values" },
        "technique": { "$ref": "#/$defs/facet-values" },
        "data_model": { "$ref": "#/$defs/facet-values" },
        "stack_layer": { "$ref": "#/$defs/facet-values" },
        "target": { "$ref": "#/$defs/facet-values" },
        "optimization_objective": { "$ref": "#/$defs/facet-values" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solved", "submissions", "acceptance", "points"],
      "properties": {
        "solved": { "type": "boolean" },
        "submissions": { "type": "integer", "minimum": 0 },
        "acceptance": { "type": "number", "minimum": 0, "maximum": 100 },
        "points": { "type": "integer", "minimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_ms", "memory_kib", "max_cycles", "max_output_bytes"],
      "properties": {
        "time_ms": { "type": "integer", "minimum": 1 },
        "memory_kib": { "type": "integer", "minimum": 1 },
        "max_cycles": { "type": "integer", "minimum": 1 },
        "max_output_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "test-case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arg"],
      "properties": {
        "arg": {},
        "expected_output": { "type": "string" },
        "expected_r13": { "type": "integer" }
      },
      "oneOf": [
        { "required": ["expected_output"] },
        { "required": ["expected_r13"] }
      ]
    },
    "wrapper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "template"],
      "properties": {
        "kind": { "enum": ["call", "string-buffer"] },
        "template": { "type": "string", "minLength": 1 }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "test_cases", "wrapper"],
      "properties": {
        "kind": { "const": "deterministic-vm-contract" },
        "test_cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test-case" } },
        "wrapper": { "$ref": "#/$defs/wrapper" }
      }
    },
    "cost-probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["representation", "reference_representation", "metric", "max_cycles"],
      "properties": {
        "representation": { "type": "string", "minLength": 1 },
        "reference_representation": { "type": "string", "minLength": 1 },
        "metric": { "const": "cycles" },
        "max_cycles": { "type": "integer", "minimum": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "runner", "limits"],
      "properties": {
        "mode": { "enum": ["verified", "compile-only"] },
        "runner": { "const": "tcl-vm" },
        "limits": { "$ref": "#/$defs/limits" },
        "correctness": { "$ref": "#/$defs/correctness" },
        "cost_probe": { "$ref": "#/$defs/cost-probe" }
      }
    },
    "source-ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "symbol"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "symbol": { "type": "string", "minLength": 1 }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "lifecycle", "difficulty", "category", "tags", "facets", "description", "signature", "template", "stats", "execution", "source_refs"],
      "properties": {
        "id": { "type": "string", "pattern": "^T[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "lifecycle": { "enum": ["published", "draft", "retired"] },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "category": { "type": "string", "minLength": 1 },
        "tags": { "$ref": "#/$defs/facet-values" },
        "facets": { "$ref": "#/$defs/facet-set" },
        "description": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "minLength": 1 },
        "stats": { "$ref": "#/$defs/stats" },
        "execution": { "$ref": "#/$defs/execution" },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source-ref" } }
      }
    }
  }
}
