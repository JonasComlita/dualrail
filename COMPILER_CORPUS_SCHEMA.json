{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trit.compiler_corpus_gate.v1",
  "title": "Trit deterministic SSA compiler corpus gate",
  "type": "object",
  "required": ["schema", "source", "policy", "workloads", "aggregate", "gate"],
  "properties": {
    "schema": {"const": "trit.compiler_corpus_gate.v1"},
    "source": {
      "type": "object",
      "required": ["repository", "commit", "dirty", "corpus_id", "corpus_hash", "pipeline"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"},
        "corpus_id": {"const": "compiler-corpus.v1"},
        "corpus_hash": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"},
        "pipeline": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["o0", "optimized", "count_repetitions", "minimum_median_reduction", "maximum_workload_regression"],
      "properties": {
        "o0": {"const": "none"},
        "optimized": {"const": "default"},
        "count_repetitions": {"const": 2},
        "minimum_median_reduction": {"const": 0.15},
        "maximum_workload_regression": {"const": 0.05}
      },
      "additionalProperties": false
    },
    "workloads": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/workload"}
    },
    "aggregate": {
      "type": "object",
      "required": ["o0_median", "optimized_median", "median_reduction", "maximum_workload_regression"],
      "properties": {
        "o0_median": {"type": "number", "minimum": 0},
        "optimized_median": {"type": "number", "minimum": 0},
        "median_reduction": {"type": "number"},
        "maximum_workload_regression": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": ["passed", "verdict", "failures"],
      "properties": {
        "passed": {"type": "boolean"},
        "verdict": {"enum": ["pass", "fail"]},
        "failures": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mode": {
      "type": "object",
      "required": ["compiled", "linked", "correct", "deterministic", "repetitions", "median", "returns", "syscalls", "diagnostics"],
      "properties": {
        "compiled": {"type": "boolean"},
        "linked": {"type": "boolean"},
        "correct": {"type": "boolean"},
        "deterministic": {"type": "boolean"},
        "repetitions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "median": {"type": "integer", "minimum": 0},
        "returns": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
        "syscalls": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "diagnostics": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": ["id", "source_hash", "categories", "expected_return", "expected_syscall", "correctness", "counts", "reduction", "passed"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_hash": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"},
        "categories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "expected_return": {"type": "integer"},
        "expected_syscall": {"type": "string"},
        "correctness": {
          "type": "object",
          "required": ["equivalent", "o0", "optimized"],
          "properties": {
            "equivalent": {"type": "boolean"},
            "o0": {"$ref": "#/$defs/compile_status"},
            "optimized": {"$ref": "#/$defs/compile_status"}
          },
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "required": ["o0", "optimized"],
          "properties": {"o0": {"$ref": "#/$defs/mode"}, "optimized": {"$ref": "#/$defs/mode"}},
          "additionalProperties": false
        },
        "reduction": {"type": "number"},
        "passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "compile_status": {
      "type": "object",
      "required": ["compiled", "linked", "correct"],
      "properties": {
        "compiled": {"type": "boolean"},
        "linked": {"type": "boolean"},
        "correct": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
