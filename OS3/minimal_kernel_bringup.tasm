; Phase 4 closure kernel proof.
; Boots in kernel mode, handles lifecycle/device syscalls, runs a ready queue,
; wakes timer/console/child waits, loads static executable descriptors, and
; runs a tiny shell from host-fed console input.

.text
boot:
    mov r1, trap_handler
    csrw tvec, r1
    mov r1, ctx_shell
    csrw scratch, r1
    mov r1, imem_pt_shell
    csrw user_imem_ptbr, r1
    mov r1, 6
    csrw user_imem_pages, r1
    mov r1, dmem_pt_shell
    csrw user_dmem_ptbr, r1
    mov r1, 1
    csrw user_dmem_pages, r1
    mov r1, 1
    csrw mmu_enable, r1
    mov sp, 24
    mov r1, 40
    csrw timer_counter, r1
    mov r1, 1
    csrw timer_enable, r1
    mov r1, 0
    csrw epc, r1
    mov r1, 35
    csrw status, r1
    eret

trap_handler:
    csrrw sp, scratch, sp
    store r1, sp, 6
    store r2, sp, 7
    store r3, sp, 8
    store r4, sp, 9
    store r5, sp, 10
    store r6, sp, 11
    store r7, sp, 12
    store r8, sp, 13
    store r9, sp, 14
    store r10, sp, 15
    store r11, sp, 16
    store r12, sp, 17
    store r13, sp, 18
    store r14, sp, 19
    store r15, sp, 20
    store r16, sp, 21
    store r17, sp, 22
    store r18, sp, 23
    store r19, sp, 24
    store r20, sp, 25
    store r21, sp, 26
    store r22, sp, 27
    store r23, sp, 28
    store r24, sp, 29
    store r25, sp, 30
    csrr r1, scratch
    store r1, sp, 31
    csrr r1, epc
    store r1, sp, 0
    csrr r1, status
    store r1, sp, 1
    csrr r1, user_imem_ptbr
    store r1, sp, 2
    csrr r1, user_imem_pages
    store r1, sp, 3
    csrr r1, user_dmem_ptbr
    store r1, sp, 4
    csrr r1, user_dmem_pages
    store r1, sp, 5
    mov r1, 0
    csrw timer_pending, r1
    csrw timer_enable, r1
    csrr r1, cause
    mov r2, 7
    tcmp r2, r1, r2
    brz r2, handle_syscall
    jmp account_timer

enqueue_ready:
    mov r2, proc_ready_next
    add r2, r2, r1
    mov r3, -1
    store r3, r2, 0
    load r3, zero, ready_tail
    mov r4, -1
    tcmp r5, r3, r4
    brz r5, enqueue_ready_empty
    mov r2, proc_ready_next
    add r2, r2, r3
    store r1, r2, 0
    store r1, zero, ready_tail
    ret
enqueue_ready_empty:
    store r1, zero, ready_head
    store r1, zero, ready_tail
    ret

dequeue_ready:
    load r1, zero, ready_head
    mov r2, -1
    tcmp r3, r1, r2
    brz r3, dequeue_ready_done
    mov r4, proc_ready_next
    add r4, r4, r1
    load r5, r4, 0
    store r5, zero, ready_head
    tcmp r3, r5, r2
    brz r3, dequeue_ready_tail_empty
    store r2, r4, 0
    ret
dequeue_ready_tail_empty:
    store r2, zero, ready_tail
    store r2, r4, 0
dequeue_ready_done:
    ret

account_timer:
    load r1, zero, current_proc
    mov r2, proc_ticks
    add r2, r2, r1
    load r3, r2, 0
    mov r4, 1
    add r3, r3, r4
    store r3, r2, 0
    mov r2, proc_preemptions
    add r2, r2, r1
    load r3, r2, 0
    add r3, r3, r4
    store r3, r2, 0
    mov r2, proc_quantum_remaining
    add r2, r2, r1
    load r3, r2, 0
    sub r3, r3, r4
    store r3, r2, 0
    load r2, zero, idle_proc
    tcmp r3, r1, r2
    brz r3, schedule_next
    mov r2, proc_state
    add r2, r2, r1
    load r3, r2, 0
    mov r4, 2
    tcmp r5, r3, r4
    brn r5, schedule_next
    brp r5, schedule_next
    mov r3, 1
    store r3, r2, 0
    call enqueue_ready
    jmp schedule_next

schedule_next:
    call wake_events
    call dequeue_ready
    mov r2, -1
    tcmp r3, r1, r2
    brz r3, select_idle
    jmp select_proc
select_idle:
    load r1, zero, idle_proc
select_proc:
    store r1, zero, current_proc
    mov r2, proc_state
    add r2, r2, r1
    mov r3, 2
    store r3, r2, 0
    mov r2, proc_quantum_remaining
    add r2, r2, r1
    mov r3, 180
    store r3, r2, 0
    mov r2, proc_table
    add r2, r2, r1
    load r3, r2, 0
    jmp restore_next

wake_events:
    mov r1, 0
wake_events_loop:
    load r2, zero, user_proc_count
    tcmp r3, r1, r2
    brz r3, wake_events_done
    brp r3, wake_events_done
    mov r2, proc_state
    add r2, r2, r1
    load r3, r2, 0
    mov r4, 4
    tcmp r5, r3, r4
    brz r5, wake_check_timer
    mov r4, 3
    tcmp r5, r3, r4
    brz r5, wake_check_blocked
    jmp wake_events_next
wake_check_timer:
    mov r4, proc_wait_channel
    add r4, r4, r1
    load r5, r4, 0
    mov r6, 1
    tcmp r5, r5, r6
    brn r5, wake_events_next
    brp r5, wake_events_next
    mov r4, proc_wakeup_tick
    add r4, r4, r1
    load r5, r4, 0
    mov r6, 0
    tcmp r6, r5, r6
    brz r6, wake_events_next
    csrr r6, cycle
    tcmp r6, r6, r5
    brn r6, wake_events_next
    jmp wake_make_runnable
wake_check_blocked:
    mov r4, proc_wait_channel
    add r4, r4, r1
    load r5, r4, 0
    mov r6, 2
    tcmp r7, r5, r6
    brz r7, wake_check_console
    mov r6, 3
    tcmp r7, r5, r6
    brz r7, wake_check_child
    jmp wake_events_next
wake_check_console:
    csrr r6, console_in_ctrl
    mov r7, 0
    tcmp r7, r6, r7
    brp r7, wake_make_runnable
    jmp wake_events_next
wake_check_child:
    mov r4, proc_wait_target
    add r4, r4, r1
    load r6, r4, 0
    mov r7, 1
    sub r6, r6, r7
    mov r7, 0
    tcmp r7, r6, r7
    brn r7, wake_events_next
    load r7, zero, user_proc_count
    tcmp r7, r6, r7
    brz r7, wake_events_next
    brp r7, wake_events_next
    mov r4, proc_state
    add r4, r4, r6
    load r7, r4, 0
    mov r8, 5
    tcmp r7, r7, r8
    brz r7, wake_make_runnable
    jmp wake_events_next
wake_make_runnable:
    mov r2, proc_state
    add r2, r2, r1
    mov r3, 1
    store r3, r2, 0
    mov r2, proc_wait_channel
    add r2, r2, r1
    mov r3, 0
    store r3, r2, 0
    mov r2, proc_wakeup_tick
    add r2, r2, r1
    store r3, r2, 0
    mov r2, proc_wait_next
    add r2, r2, r1
    mov r3, -1
    store r3, r2, 0
    copy r9, lr
    call enqueue_ready
    copy lr, r9
wake_events_next:
    mov r4, 1
    add r1, r1, r4
    jmp wake_events_loop
wake_events_done:
    ret

restore_next:
    copy sp, r3
    load r1, sp, 0
    csrw epc, r1
    load r1, sp, 1
    csrw status, r1
    load r1, sp, 2
    csrw user_imem_ptbr, r1
    load r1, sp, 3
    csrw user_imem_pages, r1
    load r1, sp, 4
    csrw user_dmem_ptbr, r1
    load r1, sp, 5
    csrw user_dmem_pages, r1
    load r1, sp, 31
    csrw scratch, r1
    mov r1, 180
    csrw timer_counter, r1
    mov r1, 1
    csrw timer_enable, r1
    load r1, sp, 6
    load r2, sp, 7
    load r3, sp, 8
    load r4, sp, 9
    load r5, sp, 10
    load r6, sp, 11
    load r7, sp, 12
    load r8, sp, 13
    load r9, sp, 14
    load r10, sp, 15
    load r11, sp, 16
    load r12, sp, 17
    load r13, sp, 18
    load r14, sp, 19
    load r15, sp, 20
    load r16, sp, 21
    load r17, sp, 22
    load r18, sp, 23
    load r19, sp, 24
    load r20, sp, 25
    load r21, sp, 26
    load r22, sp, 27
    load r23, sp, 28
    load r24, sp, 29
    load r25, sp, 30
    csrrw sp, scratch, sp
    eret

handle_syscall:
    csrr r1, syscall_id
    mov r2, 1
    tcmp r2, r1, r2
    brz r2, syscall_write
    mov r2, 2
    tcmp r2, r1, r2
    brz r2, syscall_newline
    mov r2, 3
    tcmp r2, r1, r2
    brz r2, syscall_clear
    mov r2, 4
    tcmp r2, r1, r2
    brz r2, syscall_yield
    mov r2, 5
    tcmp r2, r1, r2
    brz r2, syscall_sleep_until
    mov r2, 6
    tcmp r2, r1, r2
    brz r2, syscall_exit
    mov r2, 7
    tcmp r2, r1, r2
    brz r2, syscall_getpid
    mov r2, 8
    tcmp r2, r1, r2
    brz r2, syscall_uptime
    mov r2, 9
    tcmp r2, r1, r2
    brz r2, syscall_read_input
    mov r2, 10
    tcmp r2, r1, r2
    brz r2, syscall_spawn
    mov r2, 11
    tcmp r2, r1, r2
    brz r2, syscall_waitpid
    mov r2, 12
    tcmp r2, r1, r2
    brz r2, syscall_open
    mov r2, 13
    tcmp r2, r1, r2
    brz r2, syscall_close
    mov r2, 14
    tcmp r2, r1, r2
    brz r2, syscall_read
    mov r2, 15
    tcmp r2, r1, r2
    brz r2, syscall_file_write
    mov r2, 16
    tcmp r2, r1, r2
    brz r2, syscall_stat
    mov r2, 17
    tcmp r2, r1, r2
    brz r2, syscall_readdir
    mov r2, 18
    tcmp r2, r1, r2
    brz r2, syscall_brk
    mov r2, 19
    tcmp r2, r1, r2
    brz r2, syscall_sbrk
    mov r2, 20
    tcmp r2, r1, r2
    brz r2, syscall_fork
    mov r2, 21
    tcmp r2, r1, r2
    brz r2, syscall_exec
    mov r1, -1
    store r1, sp, 18
    jmp syscall_advance_restore

syscall_write:
    csrw console_out, r13
    mov r1, 0
    store r1, sp, 18
    jmp syscall_advance_restore
syscall_newline:
    mov r1, 1
    csrw console_ctrl, r1
    mov r1, 0
    store r1, sp, 18
    jmp syscall_advance_restore
syscall_clear:
    mov r1, -1
    csrw console_ctrl, r1
    mov r1, 0
    store r1, sp, 18
    jmp syscall_advance_restore
syscall_getpid:
    load r1, zero, current_proc
    mov r2, 1
    add r1, r1, r2
    store r1, sp, 18
    jmp syscall_advance_restore
syscall_uptime:
    csrr r1, cycle
    store r1, sp, 18
    jmp syscall_advance_restore
syscall_yield:
    load r1, zero, current_proc
    mov r2, proc_yields
    add r2, r2, r1
    load r3, r2, 0
    mov r4, 1
    add r3, r3, r4
    store r3, r2, 0
    mov r2, proc_state
    add r2, r2, r1
    mov r3, 1
    store r3, r2, 0
    call enqueue_ready
    mov r3, 0
    store r3, sp, 18
    jmp syscall_advance_schedule
syscall_sleep_until:
    load r1, zero, current_proc
    mov r2, proc_sleeps
    add r2, r2, r1
    load r3, r2, 0
    mov r4, 1
    add r3, r3, r4
    store r3, r2, 0
    mov r2, proc_state
    add r2, r2, r1
    mov r3, 4
    store r3, r2, 0
    mov r2, proc_wait_channel
    add r2, r2, r1
    mov r3, 1
    store r3, r2, 0
    mov r2, proc_wakeup_tick
    add r2, r2, r1
    load r3, sp, 18
    store r3, r2, 0
    mov r3, 0
    store r3, sp, 18
    jmp syscall_advance_schedule
syscall_read_input:
    csrr r1, console_in_ctrl
    mov r2, 0
    tcmp r2, r1, r2
    brp r2, syscall_read_input_ready
    load r1, zero, current_proc
    mov r2, proc_read_blocks
    add r2, r2, r1
    load r3, r2, 0
    mov r4, 1
    add r3, r3, r4
    store r3, r2, 0
    mov r2, proc_state
    add r2, r2, r1
    mov r3, 3
    store r3, r2, 0
    mov r2, proc_wait_channel
    add r2, r2, r1
    mov r3, 2
    store r3, r2, 0
    jmp syscall_block_schedule
syscall_read_input_ready:
    csrr r1, console_in
    store r1, sp, 18
    mov r2, 1
    csrw console_in_ctrl, r2
    load r2, zero, current_proc
    mov r3, proc_input_reads
    add r3, r3, r2
    load r4, r3, 0
    mov r5, 1
    add r4, r4, r5
    store r4, r3, 0
    jmp syscall_advance_restore
syscall_spawn:
    load r1, sp, 18
    mov r2, 1
    tcmp r3, r1, r2
    brz r3, syscall_spawn_a
    mov r2, 2
    tcmp r3, r1, r2
    brz r3, syscall_spawn_b
    mov r1, -1
    store r1, sp, 18
    jmp syscall_advance_restore
syscall_spawn_a:
    mov r1, 1
    mov r8, imem_pt_a
    mov r9, dmem_pt_a
    mov r10, ctx_a
    jmp syscall_spawn_slot
syscall_spawn_b:
    mov r1, 2
    mov r8, imem_pt_b
    mov r9, dmem_pt_b
    mov r10, ctx_b
    jmp syscall_spawn_slot
syscall_spawn_slot:
    mov r2, proc_state
    add r2, r2, r1
    load r3, r2, 0
    mov r4, 0
    tcmp r5, r3, r4
    brz r5, syscall_spawn_slot_free
    mov r3, -1
    store r3, sp, 18
    jmp syscall_advance_restore
syscall_spawn_slot_free:
    mov r3, 0
    store r3, r10, 0
    mov r3, 35
    store r3, r10, 1
    store r8, r10, 2
    mov r3, 1
    store r3, r10, 3
    store r9, r10, 4
    store r3, r10, 5
    mov r4, 6
    mov r5, 32
spawn_clear_context:
    tcmp r6, r4, r5
    brz r6, spawn_context_cleared
    brp r6, spawn_context_cleared
    add r7, r10, r4
    mov r6, 0
    store r6, r7, 0
    mov r6, 1
    add r4, r4, r6
    jmp spawn_clear_context
spawn_context_cleared:
    mov r3, 24
    store r3, r10, 31
    load r3, zero, current_proc
    mov r4, 1
    add r3, r3, r4
    mov r5, proc_parent_pid
    add r5, r5, r1
    store r3, r5, 0
    mov r5, proc_exit_status
    add r5, r5, r1
    mov r3, 0
    store r3, r5, 0
    mov r5, proc_wait_channel
    add r5, r5, r1
    store r3, r5, 0
    mov r5, proc_wait_target
    add r5, r5, r1
    store r3, r5, 0
    mov r5, proc_state
    add r5, r5, r1
    mov r3, 1
    store r3, r5, 0
    call enqueue_ready
    load r2, zero, current_proc
    mov r3, proc_spawns
    add r3, r3, r2
    load r4, r3, 0
    mov r5, 1
    add r4, r4, r5
    store r4, r3, 0
    add r1, r1, r5
    store r1, sp, 18
    jmp syscall_advance_restore
syscall_waitpid:
    load r1, sp, 18
    mov r2, 1
    sub r1, r1, r2
    mov r3, 0
    tcmp r4, r1, r3
    brn r4, syscall_waitpid_fail
    load r3, zero, user_proc_count
    tcmp r4, r1, r3
    brz r4, syscall_waitpid_fail
    brp r4, syscall_waitpid_fail
    mov r3, proc_parent_pid
    add r3, r3, r1
    load r4, r3, 0
    load r5, zero, current_proc
    mov r6, 1
    add r5, r5, r6
    tcmp r4, r4, r5
    brn r4, syscall_waitpid_fail
    brp r4, syscall_waitpid_fail
    mov r3, proc_state
    add r3, r3, r1
    load r4, r3, 0
    mov r5, 5
    tcmp r6, r4, r5
    brz r6, syscall_waitpid_done
    mov r5, 0
    tcmp r6, r4, r5
    brz r6, syscall_waitpid_fail
    load r7, zero, current_proc
    mov r3, proc_waits
    add r3, r3, r7
    load r4, r3, 0
    mov r5, 1
    add r4, r4, r5
    store r4, r3, 0
    mov r3, proc_state
    add r3, r3, r7
    mov r4, 3
    store r4, r3, 0
    mov r3, proc_wait_channel
    add r3, r3, r7
    mov r4, 3
    store r4, r3, 0
    mov r3, proc_wait_target
    add r3, r3, r7
    load r4, sp, 18
