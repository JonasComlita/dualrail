syscall_read:
    load r1, sp, 18
    mov r2, 3
    tcmp r3, r1, r2
    brn r3, syscall_fd_fail
    brp r3, syscall_fd_fail
    load r1, zero, phase8_fd_open
    mov r2, 1
    tcmp r3, r1, r2
    brn r3, syscall_fd_fail
    brp r3, syscall_fd_fail
    load r10, sp, 19
    load r11, sp, 20
    copy r1, r10
    copy r2, r11
    call validate_user_span
    mov r4, 1
    tcmp r5, r3, r4
    brn r5, syscall_bad_ptr_fail
    brp r5, syscall_bad_ptr_fail
    load r4, zero, phase8_fd_offset
    load r5, zero, phase8_file_size
    mov r6, 0
syscall_read_loop:
    tcmp r7, r6, r11
    brz r7, syscall_read_done
