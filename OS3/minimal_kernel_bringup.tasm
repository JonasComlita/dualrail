translate_user_ptr:
    load r2, zero, current_proc
    mov r3, proc_data_base
    add r3, r3, r2
    load r3, r3, 0
    add r1, r3, r1
    ret

validate_user_span:
    mov r3, 0
    tcmp r4, r1, r3
