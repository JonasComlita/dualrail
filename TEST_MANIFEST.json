{
  "version": 1,
  "schema": "trit.test_manifest.v1",
  "default_build_dir": "build",
  "tool": "tools/trit_tool.py test",
  "authoritative_gate": "production",
  "suites": [
    {
      "name": "smoke",
      "description": "Fast host/runtime sanity checks for agent loops.",
      "targets": [
        "test_host_runtime",
        "test_production_hardening"
      ]
    },
    {
      "name": "core",
      "description": "Core ternary math, ISA, VM, IR, lanes, and numeric workload regression tests.",
      "targets": [
        "test_multiwidth_vm",
        "test_architecture_v2",
        "test_ternary_ir",
        "test_ternary_lanes",
        "test_native_ops",
        "test_numeric_workloads",
        "test_encrypted_volume",
        "test_encrypted_volume_parser"
      ]
    },
    {
      "name": "compiler",
      "description": "Compiler frontend, IR, linking, allocator, and TCL assembler coverage.",
      "targets": [
        "test_phase7_compiler",
        "test_compiler_abi_contract",
        "test_executable_abi_v3",
        "test_compiler_corpus_gate",
        "test_tcl_asm",
        "test_malloc_micro",
        "test_layer1_hal"
      ],
      "docs": [
        "COMPILER_CORPUS_SCHEMA.json",
        "docs/05_Compiler_Infra/compiler_corpus_gate.md"
      ]
    },
    {
      "name": "os",
      "description": "Kernel, platform, VFS, process handoff, native apps, and host runtime coverage.",
      "targets": [
        "test_multiwidth_vm",
        "test_os_platform",
        "test_vfs_reclamation",
        "test_vfs_rename",
        "test_first_silicon_bringup",
        "test_migration_v2",
        "test_redo_wal_v2",
        "test_phase_d_kernel",
        "test_process_handoff",
        "next_scheduler_acceptance",
        "test_native_apps",
        "test_consumer_shell_productization",
        "test_production_layers",
        "test_production_hardening",
        "test_syscall_pointer_fuzz",
        "test_host_runtime"
      ]
    },
    {
      "name": "production",
      "description": "Authoritative production profile; the CMake ci_production target also runs the architecture contract, synthetic portfolio workloads, and staged release gate when SDL is available.",
      "targets": [
        "test_production_layers",
        "test_production_hardening",
        "test_syscall_pointer_fuzz",
        "test_os_platform",
        "test_vfs_reclamation",
        "test_vfs_rename",
        "test_first_silicon_bringup",
        "test_architecture_v2",
        "test_migration_v2",
        "test_redo_wal_v2",
        "test_scaling_profile_compact",
        "next_scheduler_acceptance",
        "test_consumer_shell_productization",
        "test_host_runtime",
        "test_compiler_abi_contract",
        "test_compiler_corpus_gate"
      ]
    },
    {
      "name": "apps",
      "description": "Native app compilation and desktop productization tests.",
      "targets": [
        "test_native_apps",
        "test_all_apps",
        "test_consumer_shell_productization",
        "next_apps_golden_snapshots"
      ]
    },
    {
      "name": "agent_tooling",
      "description": "Python/CTest checks for repo automation, manifests, Obsidian vault validation, and Graphify/Trit graph augmentation helpers.",
      "targets": [],
      "ctest_tests": [
        "test_agent_tooling",
        "test_posix_wrappers",
        "test_source_manifest_generation"
      ],
      "runner": "ctest",
      "commands": [
        "ctest --test-dir build -R test_agent_tooling --output-on-failure",
        "python tools/trit_tool.py knowledge status --json",
        "python tools/trit_tool.py knowledge setup --check --json",
        "python tools/generate_source_manifests.py --check"
      ]
    },
    {
      "name": "benchmark",
      "description": "Performance-oriented benchmark regression harness.",
      "targets": [
        "test_benchmark",
        "test_execution_backends_benchmark"
      ],
      "manual": true,
      "docs": [
        "BENCHMARK_MANIFEST.json",
        "BENCHMARK_PROTOCOL_SCHEMA.json",
        "benchmarks/reference/p10-reference.v1.json"
      ]
    },
    {
      "name": "treatcode_intelligence_v3",
      "description": "Intelligence v3.1 multi-track portfolio protocol, recoverable authorship, signed execution identity, independent score dimensions, statistics, and participant/grader isolation foundation; legacy scalar tasks remain diagnostic-only.",
      "targets": [],
      "status": "development",
      "manual": true,
      "commands": [
        "npm.cmd --prefix treatcode run generate:intelligence:v3",
        "npm.cmd --prefix treatcode run validate:intelligence:v3",
        "npm.cmd --prefix treatcode run test:intelligence:v3",
        "npm.cmd --prefix treatcode run validate:intelligence:v31",
        "npm.cmd --prefix treatcode run test:intelligence:v31:author-shards",
        "npm.cmd --prefix treatcode run test:intelligence:v31:repository",
        "npm.cmd --prefix treatcode run test:intelligence:v31:calibration-assignments",
        "npm.cmd --prefix treatcode run test:intelligence:v31:calibration",
        "npm.cmd --prefix treatcode run test:intelligence:v31:infrastructure",
        "npm.cmd --prefix treatcode run test:intelligence:v31:comparison",
        "npm.cmd --prefix treatcode run test:intelligence:v31:catalog",
        "npm.cmd --prefix treatcode run test:intelligence:v31:tracks",
        "npm.cmd --prefix treatcode run test:intelligence:v31:pilot-e2e",
        "npm.cmd --prefix treatcode run test:intelligence-ui",
        "npm.cmd --prefix treatcode run test:e2e:intelligence"
      ],
      "docs": [
        "benchmarks/intelligence-v3/README.md",
        "benchmarks/intelligence-v3/protocol.v3.json",
        "benchmarks/intelligence-v3/task.schema.v3.json",
        "benchmarks/intelligence-v3/calibration-observations.schema.v3.json",
        "benchmarks/intelligence-v3/calibration-plan.v3.json",
        "benchmarks/intelligence-v3/discussion-rubric.v3.json",
        "benchmarks/intelligence-v3/provenance-bundle.schema.v3.json",
        "benchmarks/intelligence-v3/trusted-contributors.schema.v3.json",
        "benchmarks/intelligence-v3/corpus.candidates.v3.json",
        "benchmarks/intelligence-v3/executable-drafts.v3.json",
        "benchmarks/intelligence-v3.1/README.md",
        "benchmarks/intelligence-v3.1/protocol.v3.1.json",
        "benchmarks/intelligence-v3.1/tracks.v3.1.json",
        "benchmarks/intelligence-v3.1/score-observation.schema.v3.1.json",
        "benchmarks/intelligence-v3.1/final-corpus-contract.v3.1.json",
        "benchmarks/intelligence-v3.1/author-shard-plan.v3.1.json",
        "benchmarks/intelligence-v3.1/author-shard-plan.schema.v3.1.json",
        "benchmarks/intelligence-v3.1/author-shard-receipt.schema.v3.1.json",
        "benchmarks/intelligence-v3.1/model-execution-attestation.schema.v3.1.json",
        "benchmarks/intelligence-v3.1/calibration-plan.v3.1.json",
        "docs/11_TreatCode_Platform/plans/P14_intelligence_benchmark.md"
      ],
      "acceptance_evidence": [
        "build/treatcode-plan-evidence/P14/intelligence-v3-foundation.json",
        "build/treatcode-plan-evidence/P14/intelligence-e2e.json",
        "build/treatcode-plan-evidence/P14/intelligence-v31-corpus-validation.json",
        "build/treatcode-plan-evidence/P14/intelligence-v31-authoring-validation.json"
      ]
    },
    {
      "name": "native_jit_acceptance",
      "description": "Controlled-host NativeX64Jit timing, fingerprint, and direct-control acceptance evidence.",
      "targets": [
        "test_execution_backends_benchmark"
      ],
      "manual": true,
      "status": "accepted",
      "commands": [
        "python tools/trit_tool.py bench native-jit --controlled --archive-if-passed"
      ],
      "docs": [
        "docs/03_Execution_Engine/decoded_trace_and_native_jit.md",
        "tools/collect_native_x64_jit_acceptance.py"
      ],
      "acceptance_evidence": "build/native-x64-jit-acceptance/native_x64_jit_acceptance.v1.json"
    },
    {
      "name": "system_benchmarks",
      "description": "Deterministic manual OS portfolio workloads for Doom-class interactivity and BitNet-style inference.",
      "targets": [
        "benchmark_doom_os",
        "benchmark_bitnet_os"
      ],
      "ctest_tests": [
        "test_system_benchmark_contract",
        "test_performance_baseline",
        "test_external_benchmark_assets"
      ],
      "manual": true,
      "status": "active",
      "docs": [
        "docs/10_Benchmarks/system_benchmark_plan.md",
        "docs/10_Benchmarks/doom.md",
        "docs/10_Benchmarks/bitnet.md",
        "docs/10_Benchmarks/performance_baselines.md",
        "benchmarks/performance_baseline_schema.json",
        "benchmarks/reference/performance-baseline.v1.json",
        "benchmarks/assets/external_assets.v1.json",
        "docs/10_Benchmarks/external_assets.md"
      ]
    },
    {
      "name": "external_system_benchmarks",
      "description": "Manual, cache-backed real Freedoom and official BitNet acceptance profiles.",
      "targets": [],
      "ctest_tests": [
        "test_external_benchmark_assets",
        "test_bitnet_external_execution"
      ],
      "manual": true,
      "status": "accepted_local_cache",
      "commands": [
      "python tools/import_external_benchmark_assets.py validate",
      "python tools/import_external_benchmark_assets.py cache --asset-id doom-freedoom-0.13.0",
      "python tools/import_external_benchmark_assets.py cache --asset-id bitnet-b1.58-2B-4T-safetensors",
      "python tools/import_external_benchmark_assets.py cache --asset-id bitnet-b1.58-2B-4T-gguf",
      "$env:TRIT_BENCH_PROBE='1'; $env:TRIT_DOOM_PROFILE='freedoom-slice'; build/benchmark_doom_os.exe build/external-freedoom-slice.json",
      "$env:TRIT_BENCH_PROBE='1'; $env:TRIT_DOOM_PROFILE='freedoom-full'; build/benchmark_doom_os.exe build/external-freedoom-full.json",
      "$env:TRIT_BITNET_CONVERTED_DIR='build/external-assets/bitnet-b1.58-2B-4T-safetensors/converted-official-slice'; $env:TRIT_BITNET_INPUT_TOKEN_IDS='128000,791,7438,315,2324,374'; $env:TRIT_BITNET_GUEST_EXECUTOR='build/bitnet_guest_executor.exe'; $env:TRIT_BITNET_PROFILE='official-slice'; $env:TRIT_BITNET_FORMAT='safetensors'; build/benchmark_bitnet_os.exe build/external-bitnet-slice.json",
      "$env:TRIT_BITNET_CONVERTED_DIR='build/external-assets/bitnet-b1.58-2B-4T-safetensors/converted-official-full'; $env:TRIT_BITNET_REFERENCE_EVIDENCE='build/external-assets/bitnet-b1.58-2B-4T-safetensors/derived-reference/reference.v1.json'; $env:TRIT_BITNET_GUEST_EXECUTOR='build/bitnet_guest_executor.exe'; $env:TRIT_BITNET_PROFILE='official-full'; $env:TRIT_BITNET_FORMAT='safetensors'; build/benchmark_bitnet_os.exe build/external-bitnet-full.json"
      ],
      "docs": [
        "docs/10_Benchmarks/external_assets.md",
        "docs/10_Benchmarks/doom.md",
        "docs/10_Benchmarks/bitnet.md",
        "benchmarks/assets/external_assets.v1.json"
      ],
      "acceptance_evidence": [
        "build/external-freedoom-slice.json",
        "build/external-freedoom-full.json",
        "build/external-bitnet-slice.json",
        "build/external-bitnet-full.json",
        "build/external-assets/bitnet-b1.58-2B-4T-safetensors/derived-reference/reference.v1.json"
      ]
    },
    {
      "name": "symbolic_encodings",
      "description": "ASCII/UTF-8 compatibility, fixed TASCII-81, exact trits, and compact base-27/base-81 notation.",
      "targets": [
        "test_symbolic_encodings",
        "test_tcl_asm"
      ],
      "ctest_tests": [
        "test_symbolic_guest",
        "test_symbolic_diagnostics"
      ],
      "status": "verified",
      "docs": [
        "docs/04_Binary_Contract/symbolic_encodings.md"
      ],
      "acceptance_evidence": [
        "tests/test_symbolic_guest.py",
        "tests/test_symbolic_diagnostics.py"
      ]
    },
    {
      "name": "accelerators",
      "description": "Optional CUDA and SYCL validation targets when configured.",
      "targets": [
        "test_cuda_kernels",
        "test_sycl_kernels"
      ],
      "manual": true,
      "requires_cmake_options": [
        "ENABLE_CUDA=ON",
        "ENABLE_SYCL=ON"
      ]
    }
  ]
}
