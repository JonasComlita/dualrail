{
  "version": 1,
  "schema": "trit.test_manifest.v1",
  "default_build_dir": "build",
  "tool": "tools/trit_tool.py test",
  "authoritative_gate": "production",
  "suites": [
    {
      "name": "smoke",
      "description": "Fast host/runtime sanity checks for agent loops.",
      "targets": [
        "test_host_runtime",
        "test_production_hardening"
      ]
    },
    {
      "name": "core",
      "description": "Core ternary math, ISA, VM, IR, lanes, and numeric workload regression tests.",
      "targets": [
        "test_multiwidth_vm",
        "test_architecture_v2",
        "test_ternary_ir",
        "test_ternary_lanes",
        "test_native_ops",
        "test_numeric_workloads"
      ]
    },
    {
      "name": "compiler",
      "description": "Compiler frontend, IR, linking, allocator, and TCL assembler coverage.",
      "targets": [
        "test_phase7_compiler",
        "test_tcl_asm",
        "test_malloc_micro",
        "test_layer1_hal"
      ]
    },
    {
      "name": "os",
      "description": "Kernel, platform, VFS, process handoff, native apps, and host runtime coverage.",
      "targets": [
        "test_multiwidth_vm",
        "test_os_platform",
        "test_first_silicon_bringup",
        "test_migration_v2",
        "test_redo_wal_v2",
        "test_phase_d_kernel",
        "test_process_handoff",
        "test_native_apps",
        "test_consumer_shell_productization",
        "test_production_layers",
        "test_production_hardening",
        "test_host_runtime"
      ]
    },
    {
      "name": "production",
      "description": "Current production profile gate mirrored by the CMake ci_production target.",
      "targets": [
        "test_production_layers",
        "test_production_hardening",
        "test_os_platform",
        "test_first_silicon_bringup",
        "test_architecture_v2",
        "test_migration_v2",
        "test_redo_wal_v2",
        "test_scaling_profile_compact",
        "test_consumer_shell_productization",
        "test_host_runtime"
      ]
    },
    {
      "name": "apps",
      "description": "Native app compilation and desktop productization tests.",
      "targets": [
        "test_native_apps",
        "test_all_apps",
        "test_consumer_shell_productization"
      ]
    },
    {
      "name": "agent_tooling",
      "description": "Python/CTest checks for repo automation, manifests, Obsidian vault validation, and Graphify/Trit graph augmentation helpers.",
      "targets": [],
      "ctest_tests": [
        "test_agent_tooling"
      ],
      "runner": "ctest",
      "commands": [
        "ctest --test-dir build -R test_agent_tooling --output-on-failure",
        "python tools/trit_tool.py knowledge status --json",
        "python tools/trit_tool.py knowledge setup --check --json"
      ]
    },
    {
      "name": "benchmark",
      "description": "Performance-oriented benchmark regression harness.",
      "targets": [
        "test_benchmark",
        "test_execution_backends_benchmark"
      ],
      "manual": true,
      "docs": [
        "BENCHMARK_MANIFEST.json",
        "BENCHMARK_PROTOCOL_SCHEMA.json",
        "benchmarks/reference/p10-reference.v1.json"
      ]
    },
    {
      "name": "system_benchmarks",
      "description": "Deterministic manual OS portfolio workloads for Doom-class interactivity and BitNet-style inference.",
      "targets": [
        "benchmark_doom_os",
        "benchmark_bitnet_os"
      ],
      "manual": true,
      "status": "active",
      "docs": [
        "docs/10_Benchmarks/system_benchmark_plan.md",
        "docs/10_Benchmarks/doom.md",
        "docs/10_Benchmarks/bitnet.md"
      ]
    },
    {
      "name": "symbolic_encodings",
      "description": "Planned tests for ASCII/UTF-8 compatibility, hexadecimal boundaries, and ternary-native symbolic encodings.",
      "targets": [],
      "planned_targets": [
        "test_symbolic_encodings",
        "test_tascii81",
        "test_ternary_dump_notation"
      ],
      "manual": true,
      "status": "planned",
      "docs": [
        "docs/04_Binary_Contract/symbolic_encodings.md"
      ]
    },
    {
      "name": "accelerators",
      "description": "Optional CUDA and SYCL validation targets when configured.",
      "targets": [
        "test_cuda_kernels",
        "test_sycl_kernels"
      ],
      "manual": true,
      "requires_cmake_options": [
        "ENABLE_CUDA=ON",
        "ENABLE_SYCL=ON"
      ]
    }
  ]
}
