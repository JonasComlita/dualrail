const DESKTOP_CALC_SLOT: t40 = 1;
const DESKTOP_TASK_SLOT: t40 = 2;
const DESKTOP_PAINT_SLOT: t40 = 3;
const DESKTOP_FILES_SLOT: t40 = 4;
const DESKTOP_SETTINGS_SLOT: t40 = 5;
const DESKTOP_TERMINAL_SLOT: t40 = 6;

const DESKTOP_CALC_PID: t40 = 101;
const DESKTOP_TASK_PID: t40 = 102;
const DESKTOP_PAINT_PID: t40 = 103;
const DESKTOP_FILES_PID: t40 = 104;
const DESKTOP_SETTINGS_PID: t40 = 105;
const DESKTOP_TERMINAL_PID: t40 = 106;
const DESKTOP_PROCINFO_ADDR: t40 = 12100;
const DESKTOP_PROCINFO_STATE: t40 = 1;
const DESKTOP_PROC_RUNNABLE: t40 = 1;
const DESKTOP_PROC_RUNNING: t40 = 2;
const DESKTOP_PROC_BLOCKED: t40 = 3;
const DESKTOP_PROC_SLEEPING: t40 = 4;

fn desktop_title() -> t40 {
    os_text_cell(0, 0, 84, 11); // 'T'
    os_text_cell(1, 0, 82, 11); // 'R'
    os_text_cell(2, 0, 73, 11); // 'I'
    os_text_cell(3, 0, 84, 11); // 'T'
    os_text_cell(4, 0, 32, 11); // ' '
    os_text_cell(5, 0, 79, 11); // 'O'
    os_text_cell(6, 0, 83, 11); // 'S'
    return 1;
}

