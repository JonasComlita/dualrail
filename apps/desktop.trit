fn draw_box(x1: t40, y1: t40, x2: t40, y2: t40, color: t40) -> t40 {
    var x: t40 = x1;
    while x2 - x >= 0 {
        os_text_cell(x, y1, 45, color); // '-'
        os_text_cell(x, y2, 45, color); // '-'
        x = x + 1;
    }
    var y: t40 = y1 + 1;
    while y2 - y > 0 {
        os_text_cell(x1, y, 124, color); // '|'
        os_text_cell(x2, y, 124, color); // '|'
        y = y + 1;
    }
    return 1;
}

fn draw_string(x: t40, y: t40, text_addr: t40, len: t40, color: t40) -> t40 {
    var i: t40 = 0;
    while len - i > 0 {
        var c: t40 = 0;
        unsafe { c = load(text_addr + i); }
        os_text_cell(x + i, y, c, color);
        i = i + 1;
    }
    return len;
}

fn seed_login_header(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 42); store(addr + 1, 42); store(addr + 2, 42); store(addr + 3, 32); // "*** "
        store(addr + 4, 83); store(addr + 5, 69); store(addr + 6, 67); store(addr + 7, 85); // "SECU"
        store(addr + 8, 82); store(addr + 9, 69); store(addr + 10, 68); store(addr + 11, 32); // "RED "
        store(addr + 12, 76); store(addr + 13, 79); store(addr + 14, 71); store(addr + 15, 73); // "LOGI"
        store(addr + 16, 78); store(addr + 17, 32); store(addr + 18, 42); store(addr + 19, 42); // "N **"
        store(addr + 20, 42); store(addr + 21, 0);
    }
    return addr;
}

