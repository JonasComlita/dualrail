    os_text_cell(2, 3, 49, 10);
    os_text_cell(4, 3, 67, 10);
    os_text_cell(5, 3, 65, 10);
    os_text_cell(6, 3, 76, 10);
    os_text_cell(7, 3, 67, 10);

    os_text_cell(2, 5, 50, 10);
    os_text_cell(4, 5, 84, 10);
    os_text_cell(5, 5, 65, 10);
    os_text_cell(6, 5, 83, 10);
    os_text_cell(7, 5, 75, 10);
    os_text_cell(8, 5, 83, 10);

    os_text_cell(2, 7, 51, 10);
    os_text_cell(4, 7, 80, 10);
    os_text_cell(5, 7, 65, 10);
    os_text_cell(6, 7, 73, 10);
    os_text_cell(7, 7, 78, 10);
    os_text_cell(8, 7, 84, 10);
    return 1;
}

fn desktop_seed_calculator_path(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 47);
        store(addr + 1, 98);
        store(addr + 2, 105);
        store(addr + 3, 110);
        store(addr + 4, 47);
        store(addr + 5, 99);
        store(addr + 6, 97);
        store(addr + 7, 108);
        store(addr + 8, 99);
        store(addr + 9, 117);
        store(addr + 10, 108);
        store(addr + 11, 97);
        store(addr + 12, 116);
        store(addr + 13, 111);
        store(addr + 14, 114);
        store(addr + 15, 0);
    }
    return addr;
}

