fn seed_access_denied(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 65); store(addr + 1, 67); store(addr + 2, 67); store(addr + 3, 69); // "ACCE"
        store(addr + 4, 83); store(addr + 5, 83); store(addr + 6, 32); store(addr + 7, 68); // "SS D"
        store(addr + 8, 69); store(addr + 9, 78); store(addr + 10, 73); store(addr + 11, 69); // "ENIE"
        store(addr + 12, 68); store(addr + 13, 33); store(addr + 14, 0);
    }
    return addr;
}

fn draw_background() -> t40 {
    var y: t40 = 1;
    while 24 - y > 0 {
        var x: t40 = 0;
        while 80 - x > 0 {
            var check_x: t40 = x;
            while check_x >= 2 { check_x = check_x - 2; }
            var check_y: t40 = y;
            while check_y >= 2 { check_y = check_y - 2; }
            
            if check_x - check_y == 0 {
                os_text_cell(x, y, 46, 8); // '.' in dim gray-green
            } else {
                os_text_cell(x, y, 32, 0); // blank
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return 1;
}

fn desktop_draw_hud() -> t40 {
    draw_background();
    
    // Main window panel
    draw_box(10, 3, 70, 21, 10); // Green panel border
    draw_box(11, 4, 69, 20, 2);  // CRT Shadow inner border
    
    desktop_title();
    
    // Status Bar specs at row 24
    os_text_cell(2, 24, 77, 3); // 'M'
    os_text_cell(3, 24, 69, 3); // 'E'
    os_text_cell(4, 24, 77, 3); // 'M'
    os_text_cell(5, 24, 58, 3); // ':'
    os_text_cell(7, 24, 50, 3); // '2'
    os_text_cell(8, 24, 54, 3); // '6'
    os_text_cell(9, 24, 50, 3); // '2'
    os_text_cell(10, 24, 75, 3); // 'K'
    
    os_text_cell(12, 24, 32, 3);
    os_text_cell(13, 24, 124, 3); // '|'
    
    os_text_cell(15, 24, 83, 3); // 'S'
    os_text_cell(16, 24, 84, 3); // 'T'
    os_text_cell(17, 24, 65, 3); // 'A'
    os_text_cell(18, 24, 84, 3); // 'T'
    os_text_cell(19, 24, 85, 3); // 'U'
    os_text_cell(20, 24, 83, 3); // 'S'
    os_text_cell(21, 24, 58, 3); // ':'
    os_text_cell(23, 24, 79, 10); // 'O'
    os_text_cell(24, 24, 75, 10); // 'K'
    
    // Info panel on right
    os_text_cell(48, 8, 67, 2); os_text_cell(49, 8, 76, 2); os_text_cell(50, 8, 73, 2); os_text_cell(51, 8, 67, 2); os_text_cell(52, 8, 75, 2); // "CLICK"
    os_text_cell(54, 8, 65, 2); os_text_cell(55, 8, 78, 2); os_text_cell(56, 8, 32, 2); os_text_cell(57, 8, 65, 2); os_text_cell(58, 8, 80, 2); os_text_cell(59, 8, 80, 2); // "AN APP"
    
    os_text_cell(48, 12, 84, 2); os_text_cell(49, 12, 79, 2); // "TO"
    os_text_cell(51, 12, 76, 2); os_text_cell(52, 12, 65, 2); os_text_cell(53, 12, 85, 2); os_text_cell(54, 12, 78, 2); os_text_cell(55, 12, 67, 2); os_text_cell(56, 12, 72, 2); // "LAUNCH"
    
    os_text_cell(48, 16, 79, 2); os_text_cell(49, 16, 82, 2); // "OR"
    os_text_cell(51, 16, 75, 2); os_text_cell(52, 16, 69, 2); os_text_cell(53, 16, 89, 2); os_text_cell(54, 16, 83, 2); // "KEYS"
    os_text_cell(56, 16, 49, 2); os_text_cell(57, 16, 45, 2); os_text_cell(58, 16, 51, 2); // "1-3"
    
    return 1;
}

fn draw_button_text(y: t40, text_addr: t40, len: t40, is_hovered: t40) -> t40 {
    var color: t40 = 10; // green
    if is_hovered > 0 {
        color = 5; // highlight cyan
    }
    os_text_cell(18, y, 91, color); // '['
    draw_string(20, y, text_addr, len, color);
    os_text_cell(20 + len + 1, y, 93, color); // ']'
    return 1;
}

