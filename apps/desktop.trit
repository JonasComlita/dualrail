fn desktop_launch_child(path_addr: t40, child_slot: t40, child_pid: t40) -> t40 {
    return os_spawn_app(path_addr, child_slot, child_pid);
}

fn desktop_child_accepts_input(child_pid: t40, info_addr: t40) -> t40 {
    if child_pid <= 0 {
        return 0;
    }
    var proc_words: t40 = os_getproc(child_pid, info_addr);
    if proc_words <= 0 {
        return 0;
    }
    var state: t40 = 0;
    unsafe { state = load(info_addr + DESKTOP_PROCINFO_STATE); }
    if state - DESKTOP_PROC_RUNNABLE == 0 { return 1; }
    if state - DESKTOP_PROC_RUNNING == 0 { return 1; }
    if state - DESKTOP_PROC_BLOCKED == 0 { return 1; }
    if state - DESKTOP_PROC_SLEEPING == 0 { return 1; }
    return 0;
}

fn desktop_launch_hotkey(key: t40) -> t40 {
    if key - 49 == 0 {
        var path_addr: t40 = desktop_seed_calculator_path(10000);
        return desktop_launch_child(path_addr, DESKTOP_CALC_SLOT, DESKTOP_CALC_PID);
    }
    if key - 50 == 0 {
        var path_addr: t40 = desktop_seed_task_manager_path(10000);
        return desktop_launch_child(path_addr, DESKTOP_TASK_SLOT, DESKTOP_TASK_PID);
    }
    if key - 51 == 0 {
        var path_addr: t40 = desktop_seed_paint_path(10000);
        return desktop_launch_child(path_addr, DESKTOP_PAINT_SLOT, DESKTOP_PAINT_PID);
    }
    if key - 52 == 0 {
        var path_addr: t40 = desktop_seed_file_manager_path(10000);
        return desktop_launch_child(path_addr, DESKTOP_FILES_SLOT, DESKTOP_FILES_PID);
    }
    if key - 53 == 0 {
        var path_addr: t40 = desktop_seed_settings_path(10000);
        return desktop_launch_child(path_addr, DESKTOP_SETTINGS_SLOT, DESKTOP_SETTINGS_PID);
    }
    if key - 54 == 0 {
        var path_addr: t40 = desktop_seed_terminal_path(10000);
        return desktop_launch_child(path_addr, DESKTOP_TERMINAL_SLOT, DESKTOP_TERMINAL_PID);
    }
    return 0;
}

fn draw_box(x1: t40, y1: t40, x2: t40, y2: t40, color: t40) -> t40 {
    var x: t40 = x1;
    while x2 - x >= 0 {
        os_text_cell(x, y1, 45, color); // '-'
        os_text_cell(x, y2, 45, color); // '-'
        x = x + 1;
    }
    var y: t40 = y1 + 1;
    while y2 - y > 0 {
        os_text_cell(x1, y, 124, color); // '|'
        os_text_cell(x2, y, 124, color); // '|'
        y = y + 1;
    }
    return 1;
}

fn draw_string(x: t40, y: t40, text_addr: t40, len: t40, color: t40) -> t40 {
    var i: t40 = 0;
    while len - i > 0 {
        var c: t40 = 0;
        unsafe { c = load(text_addr + i); }
        os_text_cell(x + i, y, c, color);
        i = i + 1;
    }
    return len;
}

fn seed_login_header(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 42); store(addr + 1, 42); store(addr + 2, 42); store(addr + 3, 32); // "*** "
        store(addr + 4, 79); store(addr + 5, 83); store(addr + 6, 32);                       // "OS "
        store(addr + 7, 51); store(addr + 8, 32);                                             // "3 "
        store(addr + 9, 83); store(addr + 10, 69); store(addr + 11, 67);                      // "SEC"
        store(addr + 12, 85); store(addr + 13, 82); store(addr + 14, 69);                     // "URE"
        store(addr + 15, 32); store(addr + 16, 42); store(addr + 17, 42); store(addr + 18, 42); // " ***"
        store(addr + 19, 0);
    }
    return addr;
}

fn seed_passcode_prompt(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 69); store(addr + 1, 78); store(addr + 2, 84); store(addr + 3, 69); // "ENTE"
        store(addr + 4, 82); store(addr + 5, 32); store(addr + 6, 75); store(addr + 7, 69); // "R KE"
        store(addr + 8, 89); store(addr + 9, 67); store(addr + 10, 79); store(addr + 11, 68); // "YCOD"
        store(addr + 12, 69); store(addr + 13, 58); store(addr + 14, 32); store(addr + 15, 0); // "E: "
    }
    return addr;
}

fn seed_access_granted(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 65); store(addr + 1, 67); store(addr + 2, 67); store(addr + 3, 69); // "ACCE"
        store(addr + 4, 83); store(addr + 5, 83); store(addr + 6, 32); store(addr + 7, 71); // "SS G"
        store(addr + 8, 82); store(addr + 9, 65); store(addr + 10, 78); store(addr + 11, 84); // "RANT"
        store(addr + 12, 69); store(addr + 13, 68); store(addr + 14, 33); store(addr + 15, 0); // "ED!"
    }
    return addr;
}

fn seed_access_denied(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 65); store(addr + 1, 67); store(addr + 2, 67); store(addr + 3, 69); // "ACCE"
        store(addr + 4, 83); store(addr + 5, 83); store(addr + 6, 32); store(addr + 7, 68); // "SS D"
        store(addr + 8, 69); store(addr + 9, 78); store(addr + 10, 73); store(addr + 11, 69); // "ENIE"
        store(addr + 12, 68); store(addr + 13, 33); store(addr + 14, 0);
    }
    return addr;
}

fn draw_background() -> t40 {
    os_text_cell(6, 5, 46, 8);
    os_text_cell(17, 9, 46, 8);
    os_text_cell(31, 6, 46, 8);
    os_text_cell(44, 11, 46, 8);
    os_text_cell(9, 17, 46, 8);
    os_text_cell(25, 20, 46, 8);
    os_text_cell(39, 18, 46, 8);
    os_text_cell(47, 22, 46, 8);
    return 1;
}

fn desktop_clear_region(x1: t40, y1: t40, x2: t40, y2: t40, color: t40) -> t40 {
    var y: t40 = y1;
    while y2 - y >= 0 {
        var x: t40 = x1;
        while x2 - x >= 0 {
            os_text_cell(x, y, 32, color);
            x = x + 1;
        }
        y = y + 1;
    }
    return 1;
}

fn desktop_clear_login_area() -> t40 {
    desktop_clear_region(16, 4, 51, 18, 0);
    return 1;
}

fn draw_taskbar() -> t40 {
    // Fill row 24 with dim background
    var tx: t40 = 0;
    while 80 - tx > 0 {
        os_text_cell(tx, 24, 32, 0);
        tx = tx + 1;
    }
    // [OS3] start button
    os_text_cell(1, 24, 91, 5);  // '['
    os_text_cell(2, 24, 79, 7);  // 'O'
    os_text_cell(3, 24, 83, 7);  // 'S'
    os_text_cell(4, 24, 51, 7);  // '3'
    os_text_cell(5, 24, 93, 5);  // ']'

    // Separator
    os_text_cell(7, 24, 124, 8); // '|'

    // Right side: CTRL+Q=QUIT label
    os_text_cell(55, 24, 67, 8);  // 'C'
    os_text_cell(56, 24, 84, 8);  // 'T'
    os_text_cell(57, 24, 82, 8);  // 'R'
    os_text_cell(58, 24, 76, 8);  // 'L'
    os_text_cell(59, 24, 43, 8);  // '+'
    os_text_cell(60, 24, 81, 8);  // 'Q'
    os_text_cell(61, 24, 61, 8);  // '='
    os_text_cell(62, 24, 81, 3);  // 'Q'
    os_text_cell(63, 24, 85, 3);  // 'U'
    os_text_cell(64, 24, 73, 3);  // 'I'
    os_text_cell(65, 24, 84, 3);  // 'T'

    // Far right: F1=DEBUG
    os_text_cell(68, 24, 70, 8);  // 'F'
    os_text_cell(69, 24, 49, 8);  // '1'
    os_text_cell(70, 24, 61, 8);  // '='
    os_text_cell(71, 24, 68, 3);  // 'D'
    os_text_cell(72, 24, 66, 3);  // 'B'
    os_text_cell(73, 24, 71, 3);  // 'G'
    return 1;
}

fn desktop_draw_launcher_line(y: t40, n: t40, a: t40, b: t40, c: t40, d: t40, e: t40) -> t40 {
    os_text_cell(8, y, n, 5);
    os_text_cell(9, y, 46, 8);
    os_text_cell(11, y, a, 10);
    os_text_cell(12, y, b, 10);
    os_text_cell(13, y, c, 10);
    os_text_cell(14, y, d, 10);
    if e > 0 { os_text_cell(15, y, e, 10); }
    return 1;
}

fn desktop_draw_launcher() -> t40 {
    desktop_clear_region(6, 2, 44, 13, 0);
    os_text_cell(8, 2, 76, 8); os_text_cell(9, 2, 65, 8); os_text_cell(10, 2, 85, 8);
    os_text_cell(11, 2, 78, 8); os_text_cell(12, 2, 67, 8); os_text_cell(13, 2, 72, 8);
    os_text_cell(15, 2, 80, 3); os_text_cell(16, 2, 65, 3); os_text_cell(17, 2, 68, 3);
    desktop_draw_launcher_line(4, 49, 67, 65, 76, 67, 0);
    desktop_draw_launcher_line(5, 50, 84, 65, 83, 75, 0);
    desktop_draw_launcher_line(6, 51, 80, 65, 73, 78, 84);
    desktop_draw_launcher_line(7, 52, 70, 73, 76, 69, 83);
    desktop_draw_launcher_line(8, 53, 83, 69, 84, 84, 0);
    desktop_draw_launcher_line(9, 54, 84, 69, 82, 77, 0);
    return 1;
}

fn desktop_draw_launch_status(slot: t40, result: t40) -> t40 {
    desktop_clear_region(8, 12, 42, 12, 0);
    os_text_cell(8, 12, 76, 8); os_text_cell(9, 12, 65, 8); os_text_cell(10, 12, 85, 8);
    os_text_cell(11, 12, 78, 8); os_text_cell(12, 12, 67, 8); os_text_cell(13, 12, 72, 8);
    os_text_cell(15, 12, 48 + slot, 5);
    if result - 999 == 0 {
        os_text_cell(17, 12, 46, 3); os_text_cell(18, 12, 46, 3); os_text_cell(19, 12, 46, 3);
    } else if result > 0 {
        os_text_cell(17, 12, 79, 1); os_text_cell(18, 12, 75, 1);
    } else {
        os_text_cell(17, 12, 69, 9); os_text_cell(18, 12, 82, 9); os_text_cell(19, 12, 82, 9);
    }
    return 1;
}

// Draw a single icon cell at grid col/row position
// col: 0-2, row: 0-1; glyph: ASCII char for icon center
fn draw_icon_cell(col: t40, row_idx: t40, glyph: t40, label_addr: t40, label_len: t40, is_hovered: t40) -> t40 {
    // Each icon cell: 12 wide, 4 tall, starting at x=8, y=3
    var cell_x: t40 = 8 + col * 14;
    var cell_y: t40 = 3 + row_idx * 5;

    var border_color: t40 = WIDGET_THEME_ICON_BORDER;
    var glyph_color: t40 = WIDGET_THEME_TEXT;
    if is_hovered > 0 {
        border_color = WIDGET_THEME_ICON_HOVER;
        glyph_color = WIDGET_THEME_ICON_HOVER;
    }

    // Top border
    os_text_cell(cell_x,      cell_y, 43, border_color); // '+'
    os_text_cell(cell_x + 1,  cell_y, 45, border_color); // '-'
    os_text_cell(cell_x + 2,  cell_y, 45, border_color);
    os_text_cell(cell_x + 3,  cell_y, 45, border_color);
    os_text_cell(cell_x + 4,  cell_y, 45, border_color);
    os_text_cell(cell_x + 5,  cell_y, 45, border_color);
    os_text_cell(cell_x + 6,  cell_y, 45, border_color);
    os_text_cell(cell_x + 7,  cell_y, 45, border_color);
    os_text_cell(cell_x + 8,  cell_y, 45, border_color);
    os_text_cell(cell_x + 9,  cell_y, 45, border_color);
    os_text_cell(cell_x + 10, cell_y, 45, border_color);
    os_text_cell(cell_x + 11, cell_y, 43, border_color); // '+'

    // Row 1: sides + empty
    os_text_cell(cell_x, cell_y + 1, 124, border_color);  // '|'
    var fill1: t40 = 1;
    while 11 - fill1 > 0 {
        os_text_cell(cell_x + fill1, cell_y + 1, 32, 0);
        fill1 = fill1 + 1;
    }
    os_text_cell(cell_x + 11, cell_y + 1, 124, border_color);

    // Row 2: sides + glyph centred
    os_text_cell(cell_x, cell_y + 2, 124, border_color);
    var fill2: t40 = 1;
    while 11 - fill2 > 0 {
        os_text_cell(cell_x + fill2, cell_y + 2, 32, 0);
        fill2 = fill2 + 1;
    }
    os_text_cell(cell_x + 5, cell_y + 2, glyph, glyph_color); // centred glyph
    os_text_cell(cell_x + 11, cell_y + 2, 124, border_color);

    // Row 3: sides + label centred
    os_text_cell(cell_x, cell_y + 3, 124, border_color);
    var fill3: t40 = 1;
    while 11 - fill3 > 0 {
        os_text_cell(cell_x + fill3, cell_y + 3, 32, 0);
        fill3 = fill3 + 1;
    }
    // Centre label (max 8 chars visible)
    var label_x: t40 = cell_x + 1;
    if 10 - label_len > 0 {
        label_x = cell_x + 1 + (10 - label_len) / 2;
    }
    var li: t40 = 0;
    while label_len - li > 0 {
        var lc: t40 = 0;
        unsafe { lc = load(label_addr + li); }
        os_text_cell(label_x + li, cell_y + 3, lc, glyph_color);
        li = li + 1;
    }
    os_text_cell(cell_x + 11, cell_y + 3, 124, border_color);

    // Bottom border
    os_text_cell(cell_x,      cell_y + 4, 43, border_color); // '+'
    var bi: t40 = 1;
    while 11 - bi > 0 {
        os_text_cell(cell_x + bi, cell_y + 4, 45, border_color);
        bi = bi + 1;
    }
    os_text_cell(cell_x + 11, cell_y + 4, 43, border_color); // '+'

    return 1;
}

fn desktop_draw_hud() -> t40 {
    // OS 3 title in top-left
    os_text_cell(1, 0, 79, 5);  // 'O'
    os_text_cell(2, 0, 83, 5);  // 'S'
    os_text_cell(3, 0, 32, 5);
    os_text_cell(4, 0, 51, 7);  // '3'
    os_text_cell(6, 0, 45, 8);  // '-'
    os_text_cell(8, 0, 68, 8);  // 'D'
    os_text_cell(9, 0, 69, 8);  // 'E'
    os_text_cell(10, 0, 83, 8); // 'S'
    os_text_cell(11, 0, 75, 8); // 'K'
    os_text_cell(12, 0, 84, 8); // 'T'
    os_text_cell(13, 0, 79, 8); // 'O'
    os_text_cell(14, 0, 80, 8); // 'P'

    draw_background();
    draw_taskbar();

    // System info panel on the right (cols 52-78, rows 2-13)
    draw_box(52, 2, 78, 13, 8); // dim blue-grey border

    // Panel title: SYSTEM
    os_text_cell(61, 2, 83, 5); os_text_cell(62, 2, 89, 5); os_text_cell(63, 2, 83, 5);
    os_text_cell(64, 2, 84, 5); os_text_cell(65, 2, 69, 5); os_text_cell(66, 2, 77, 5);

    // ARCH : TERNARY T40
    os_text_cell(54, 4, 65, 8); os_text_cell(55, 4, 82, 8); os_text_cell(56, 4, 67, 8);
    os_text_cell(57, 4, 72, 8); os_text_cell(59, 4, 58, 8);
    os_text_cell(61, 4, 84, 3); os_text_cell(62, 4, 69, 3); os_text_cell(63, 4, 82, 3);
    os_text_cell(64, 4, 78, 3); os_text_cell(65, 4, 65, 3); os_text_cell(66, 4, 82, 3);
    os_text_cell(67, 4, 89, 3); os_text_cell(69, 4, 84, 3); os_text_cell(70, 4, 52, 3);
    os_text_cell(71, 4, 48, 3);

    // CPU  : 1GHz EMU
    os_text_cell(54, 6, 67, 8); os_text_cell(55, 6, 80, 8); os_text_cell(56, 6, 85, 8);
    os_text_cell(59, 6, 58, 8);
    os_text_cell(61, 6, 49, 3); os_text_cell(62, 6, 71, 3); os_text_cell(63, 6, 72, 3);
    os_text_cell(64, 6, 122, 3); os_text_cell(65, 6, 32, 3); os_text_cell(66, 6, 69, 3);
    os_text_cell(67, 6, 77, 3); os_text_cell(68, 6, 85, 3);

    // MEM  : 1MB DMEM
    os_text_cell(54, 8, 77, 8); os_text_cell(55, 8, 69, 8); os_text_cell(56, 8, 77, 8);
    os_text_cell(59, 8, 58, 8);
    os_text_cell(61, 8, 49, 3); os_text_cell(62, 8, 77, 3); os_text_cell(63, 8, 66, 3);
    os_text_cell(65, 8, 68, 3); os_text_cell(66, 8, 77, 3); os_text_cell(67, 8, 69, 3);
    os_text_cell(68, 8, 77, 3);

    // DISK : VFS
    os_text_cell(54, 10, 68, 8); os_text_cell(55, 10, 73, 8); os_text_cell(56, 10, 83, 8);
    os_text_cell(57, 10, 75, 8);
    os_text_cell(59, 10, 58, 8);
    os_text_cell(61, 10, 86, 3); os_text_cell(62, 10, 70, 3); os_text_cell(63, 10, 83, 3);

    // STATUS: OK
    os_text_cell(54, 12, 83, 8); os_text_cell(55, 12, 84, 8); os_text_cell(56, 12, 65, 8);
    os_text_cell(57, 12, 84, 8); os_text_cell(58, 12, 85, 8); os_text_cell(59, 12, 83, 8);
    os_text_cell(59, 12, 58, 8);
    os_text_cell(61, 12, 79, 1); os_text_cell(62, 12, 75, 1); // OK in green

    // Hotkey hints bottom-right
    os_text_cell(53, 15, 75, 8); os_text_cell(54, 15, 69, 8); os_text_cell(55, 15, 89, 8);
    os_text_cell(56, 15, 83, 8); os_text_cell(58, 15, 49, 8); os_text_cell(59, 15, 45, 8);
    os_text_cell(60, 15, 54, 8); // KEYS 1-6
    os_text_cell(62, 15, 76, 8); os_text_cell(63, 15, 65, 8); os_text_cell(64, 15, 85, 8);
    os_text_cell(65, 15, 78, 8); os_text_cell(66, 15, 67, 8); os_text_cell(67, 15, 72, 8); // LAUNCH

    return 1;
}

fn draw_button_text(y: t40, text_addr: t40, len: t40, is_hovered: t40) -> t40 {
    return widget_draw_text_button_text(18, y, len + 4, text_addr, len, is_hovered, 0, 0, 1);
}

fn seed_btn_calc(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 49); store(addr + 1, 46); store(addr + 2, 32); store(addr + 3, 67); // "1. C"
        store(addr + 4, 65); store(addr + 5, 76); store(addr + 6, 67); store(addr + 7, 85); // "ALCU"
        store(addr + 8, 76); store(addr + 9, 65); store(addr + 10, 84); store(addr + 11, 79); // "LATO"
        store(addr + 12, 82); store(addr + 13, 0);
    }
    return addr;
}

