    unsafe {
        store(addr + 0, 47);   // /
        store(addr + 1, 98);   // b
        store(addr + 2, 105);  // i
        store(addr + 3, 110);  // n
        store(addr + 4, 47);   // /
        store(addr + 5, 116);  // t
        store(addr + 6, 97);   // a
        store(addr + 7, 115);  // s
        store(addr + 8, 107);  // k
        store(addr + 9, 95);   // _
        store(addr + 10, 109); // m
        store(addr + 11, 97);  // a
        store(addr + 12, 110); // n
        store(addr + 13, 97);  // a
        store(addr + 14, 103); // g
        store(addr + 15, 101); // e
        store(addr + 16, 114); // r
        store(addr + 17, 0);   // \0
    }
    return addr;
}

