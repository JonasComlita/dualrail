// apps/kill.trit - Process-control placeholder.

fn main() -> t40 {
    os_putc(75); os_putc(73); os_putc(76); os_putc(76); os_putc(58); os_putc(32);
    os_putc(85); os_putc(83); os_putc(69); os_putc(32);
    os_putc(84); os_putc(65); os_putc(83); os_putc(75); os_putc(83); os_newline();
    return 1;
}
