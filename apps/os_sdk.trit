const OS_SIGNAL_KILL: t40 = 2;
const OS_SIGNAL_STOP: t40 = 4;
const OS_SIGNAL_CONT: t40 = 8;
const OS_SIGNAL_CLOSE_REQUEST: t40 = 16;

const OS_PROCINFO_WORDS: t40 = 8;

