fn os_event_kind(event_addr: t40) -> t40 {
    var val: t40 = 0;
    unsafe { val = load(event_addr); }
    return val;
}

fn os_event_x_or_key(event_addr: t40) -> t40 {
    var val: t40 = 0;
    unsafe { val = load(event_addr + 1); }
    return val;
}

fn os_event_y(event_addr: t40) -> t40 {
    var val: t40 = 0;
    unsafe { val = load(event_addr + 2); }
    return val;
}

fn os_event_modifiers(event_addr: t40) -> t40 {
    var val: t40 = 0;
