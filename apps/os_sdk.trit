    return val;
}

fn os_window_pixel_offset(width: t40, x: t40, y: t40) -> t40 {
    return (y * width + x) * 3;
}

fn os_window_plot_rgb(buf: t40, width: t40, height: t40, x: t40, y: t40, r: t40, g: t40, b: t40) -> t40 {
    if buf <= 0 {
        return 0;
    }
    if x < 0 {
        return 0;
    }
    if y < 0 {
        return 0;
    }
    if x - width >= 0 {
        return 0;
    }
    if y - height >= 0 {
        return 0;
    }
    var off: t40 = os_window_pixel_offset(width, x, y);
    unsafe {
        store(buf + off, r);
        store(buf + off + 1, g);
        store(buf + off + 2, b);
    }
    return 1;
}

fn os_window_fill_rgb(buf: t40, width: t40, height: t40, r: t40, g: t40, b: t40) -> t40 {
    if buf <= 0 {
        return 0;
    }
    if width <= 0 {
        return 0;
    }
    if height <= 0 {
        return 0;
    }
    var words: t40 = width * height * 3;
    var i: t40 = 0;
    while words - i > 0 {
        unsafe {
            store(buf + i, r);
            store(buf + i + 1, g);
            store(buf + i + 2, b);
        }
        i = i + 3;
    }
    return words;
}

fn os_window_fill_rect_rgb(buf: t40, width: t40, height: t40, x: t40, y: t40, w: t40, h: t40, r: t40, g: t40, b: t40) -> t40 {
    if buf <= 0 {
        return 0;
    }
    if width <= 0 {
        return 0;
    }
    if height <= 0 {
        return 0;
    }
    if w <= 0 {
        return 0;
    }
    if h <= 0 {
        return 0;
    }
    var x0: t40 = x;
    var y0: t40 = y;
    var x1: t40 = x + w;
    var y1: t40 = y + h;
    if x0 < 0 {
        x0 = 0;
    }
    if y0 < 0 {
        y0 = 0;
    }
    if x1 - width > 0 {
        x1 = width;
    }
    if y1 - height > 0 {
        y1 = height;
    }
    if x1 - x0 <= 0 {
        return 0;
    }
    if y1 - y0 <= 0 {
        return 0;
    }
    var drawn: t40 = 0;
    var yy: t40 = y0;
    while y1 - yy > 0 {
        var off: t40 = os_window_pixel_offset(width, x0, yy);
        var xx: t40 = x0;
        while x1 - xx > 0 {
            unsafe {
                store(buf + off, r);
                store(buf + off + 1, g);
                store(buf + off + 2, b);
            }
            off = off + 3;
            drawn = drawn + 1;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    return drawn;
}

fn os_window_draw_rect_rgb(buf: t40, width: t40, height: t40, x: t40, y: t40, w: t40, h: t40, r: t40, g: t40, b: t40) -> t40 {
    if w <= 0 {
        return 0;
    }
    if h <= 0 {
        return 0;
    }
    var drawn: t40 = 0;
    drawn = drawn + os_window_fill_rect_rgb(buf, width, height, x, y, w, 1, r, g, b);
    if h - 1 > 0 {
        drawn = drawn + os_window_fill_rect_rgb(buf, width, height, x, y + h - 1, w, 1, r, g, b);
    }
    if h - 2 > 0 {
        drawn = drawn + os_window_fill_rect_rgb(buf, width, height, x, y + 1, 1, h - 2, r, g, b);
        if w - 1 > 0 {
            drawn = drawn + os_window_fill_rect_rgb(buf, width, height, x + w - 1, y + 1, 1, h - 2, r, g, b);
        }
    }
    return drawn;
}

fn os_mouse_x() -> t40 {
