fn paint_seed_desktop_path(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 47);   // /
        store(addr + 1, 98);   // b
        store(addr + 2, 105);  // i
        store(addr + 3, 110);  // n
        store(addr + 4, 47);   // /
        store(addr + 5, 100);  // d
        store(addr + 6, 101);  // e
        store(addr + 7, 115);  // s
        store(addr + 8, 107);  // k
        store(addr + 9, 116);  // t
        store(addr + 10, 111); // o
        store(addr + 11, 112); // p
        store(addr + 12, 0);   // \0
    }
    return addr;
}

const PAINT_WIDGET_BASE: t40 = 11200;
const PAINT_CHILDREN_ADDR: t40 = 11800;
const PAINT_CHILD_COUNT: t40 = 7;
const PAINT_LABEL_BUF: t40 = 11900;
const PAINT_TOOL_CLEAR: t40 = 10;
const PAINT_TOOL_EXIT: t40 = 99;

fn paint_widget_at_index(index: t40) -> t40 {
    return PAINT_WIDGET_BASE + index * WIDGET_WORDS;
}

fn paint_seed_clear_label(addr: t40) -> t40 {
    unsafe { store(addr + 0, 67); store(addr + 1, 76); store(addr + 2, 82); store(addr + 3, 0); }
    return addr;
}

fn paint_seed_exit_label(addr: t40) -> t40 {
    unsafe { store(addr + 0, 69); store(addr + 1, 88); store(addr + 2, 73); store(addr + 3, 84); store(addr + 4, 0); }
    return addr;
}

fn paint_init_tool(index: t40, id: t40, x: t40, y: t40, w: t40) -> t40 {
    var addr: t40 = paint_widget_at_index(index);
    widget_init(addr, WIDGET_KIND_BUTTON, x, y, w, 1, 0, -1);
    widget_store(addr + WIDGET_AUX, id);
    widget_store(PAINT_CHILDREN_ADDR + index, addr);
    return addr;
}

fn paint_init_widgets() -> t40 {
    paint_init_tool(0, 1, 9, 0, 3);
    paint_init_tool(1, 2, 13, 0, 3);
    paint_init_tool(2, 3, 17, 0, 3);
    paint_init_tool(3, 4, 21, 0, 3);
    paint_init_tool(4, 5, 25, 0, 3);
    paint_init_tool(5, PAINT_TOOL_CLEAR, 45, 0, 5);
    paint_init_tool(6, PAINT_TOOL_EXIT, 65, 0, 6);
    return PAINT_CHILD_COUNT;
}

fn paint_toolbar_at(mx: t40, my: t40) -> t40 {
    var hit: t40 = widget_panel_route_xy(PAINT_CHILDREN_ADDR, PAINT_CHILD_COUNT, mx, my);
    if hit > 0 {
        return widget_load(hit + WIDGET_AUX);
    }
    return 0;
}

fn paint_draw_header(active_color: t40) -> t40 {
    paint_init_widgets();

    // Clear top row of text cells (row 0)
    var x: t40 = 0;
    while 80 - x > 0 {
        os_text_cell(x, 0, 32, 0);
        x = x + 1;
    }

    // Title: "PAINT" in amber (3)
    os_text_cell(1, 0, 80, 3);
    os_text_cell(2, 0, 65, 3);
    os_text_cell(3, 0, 73, 3);
    os_text_cell(4, 0, 78, 3);
    os_text_cell(5, 0, 84, 3);
    os_text_cell(6, 0, 58, 3); // ':'

    // Color swatches
    var red_focus: t40 = 0;
    var green_focus: t40 = 0;
    var cyan_focus: t40 = 0;
    var yellow_focus: t40 = 0;
    var magenta_focus: t40 = 0;
    if active_color - 4 == 0 { red_focus = 1; }
    if active_color - 10 == 0 { green_focus = 1; }
    if active_color - 5 == 0 { cyan_focus = 1; }
    if active_color - 14 == 0 { yellow_focus = 1; }
    if active_color - 6 == 0 { magenta_focus = 1; }
    widget_draw_text_button_char(9, 0, 3, 49, 0, 0, red_focus, 1);
    os_text_cell(10, 0, 49, 4);
    widget_draw_text_button_char(13, 0, 3, 50, 0, 0, green_focus, 1);
    os_text_cell(14, 0, 50, 10);
    widget_draw_text_button_char(17, 0, 3, 51, 0, 0, cyan_focus, 1);
    os_text_cell(18, 0, 51, 5);
    widget_draw_text_button_char(21, 0, 3, 52, 0, 0, yellow_focus, 1);
    os_text_cell(22, 0, 52, 14);
    widget_draw_text_button_char(25, 0, 3, 53, 0, 0, magenta_focus, 1);
    os_text_cell(26, 0, 53, 6);

    // Active color indicator
    os_text_cell(30, 0, 65, 2); // 'A'
    os_text_cell(31, 0, 67, 2); // 'C'
    os_text_cell(32, 0, 58, 2); // ':'
    os_text_cell(34, 0, 42, active_color); // '*' in active color

    // Toolbar buttons
    widget_draw_text_button_text(45, 0, 5, paint_seed_clear_label(PAINT_LABEL_BUF), 3, 0, 0, 0, 1);
    widget_draw_text_button_text(65, 0, 6, paint_seed_exit_label(PAINT_LABEL_BUF + 10), 4, 0, 0, 0, 1);

    // Separator line under header
    x = 0;
    while 80 - x > 0 {
        os_text_cell(x, 1, 45, 8); // '-' in dim gray-green
        x = x + 1;
    }

    return 1;
}

fn main() -> t40 {
    var in_kernel: t40 = 0;
    var active_color: t40 = 14; // Start with yellow
    var done: t40 = 0;
    var draw_cnt: t40 = 0;
    var cur_page: t40 = 0;
    var k: t40 = 0;
    var event_addr: t40 = 10100;
    var event_status: t40 = 0;
    var event_kind: t40 = 0;
    var mx: t40 = 0;
    var my: t40 = 0;
    var btn: t40 = 0;
    var toolbar_hit: t40 = 0;

    unsafe { in_kernel = csr_read(scratch); }
    if in_kernel == 0 {
        os_putc(80); os_putc(65); os_putc(73); os_putc(78); os_putc(84); os_newline();
        os_gpu_mode(1);
        os_sprite(10, 10, 43, 14);
        os_gpu_rect(6, 6, 7, 7, 4);
        os_text_cell(0, 0, 80, 14);
        return 1;
    }

    os_gpu_mode(1);
    os_gpu_clear(0, 0);
    os_gpu_clear(1, 0);

    paint_draw_header(active_color);

    while 1 - done > 0 {
        k = 0;
        event_status = os_wait_event(-1, event_addr, 0);
        if event_status > 0 {
            event_kind = os_event_kind(event_addr);
            if event_kind - OS_EVENT_KIND_MOUSE == 0 {
                mx = os_event_x_or_key(event_addr);
                my = os_event_y(event_addr);
                btn = os_event_modifiers(event_addr);
            }
            if event_kind - OS_EVENT_KIND_KEY == 0 {
                k = os_event_x_or_key(event_addr);
            }
            if event_kind - OS_EVENT_KIND_CLOSE == 0 {
                done = 1;
            }
        }

        // Convert graphics my (0-59) to text cell coordinate (0-24) for cursor sprite
        // text_y = my * 25 / 60
        var sprite_y: t40 = my * 5;
        sprite_y = sprite_y / 12;

        // Draw cursor pointer sprite
        os_sprite(mx, sprite_y, 43, active_color); // '+' in active color

        if btn - 1 == 0 {
            // Check if clicking the header (my < 5 corresponding to text rows 0 and 1)
            if sprite_y - 2 < 0 {
                toolbar_hit = paint_toolbar_at(mx, sprite_y);
                if toolbar_hit - 1 == 0 { active_color = 4; paint_draw_header(active_color); }
                if toolbar_hit - 2 == 0 { active_color = 10; paint_draw_header(active_color); }
                if toolbar_hit - 3 == 0 { active_color = 5; paint_draw_header(active_color); }
                if toolbar_hit - 4 == 0 { active_color = 14; paint_draw_header(active_color); }
                if toolbar_hit - 5 == 0 { active_color = 6; paint_draw_header(active_color); }
                if toolbar_hit - PAINT_TOOL_CLEAR == 0 {
                    os_gpu_clear(0, 0);
                    os_gpu_clear(1, 0);
                    paint_draw_header(active_color);
                }
                if toolbar_hit - PAINT_TOOL_EXIT == 0 {
                    done = 1;
                }
            } else {
                // Drawing region: Draw a 2x2 rect on canvas
                // Avoid drawing over the header at the top
                if my - 5 >= 0 {
                    unsafe { cur_page = csr_read(gpu_page); }
                    os_gpu_rect(mx, my, mx + 1, my + 1, active_color);
                    os_gpu_page(1 - cur_page);
                    os_gpu_rect(mx, my, mx + 1, my + 1, active_color);
                }
            }
        }

        // Support keyboard hotkeys concurrently
        if k > 0 {
            if k - 49 == 0 { active_color = 4; paint_draw_header(active_color); }  // '1'
            if k - 50 == 0 { active_color = 10; paint_draw_header(active_color); } // '2'
            if k - 51 == 0 { active_color = 5; paint_draw_header(active_color); }  // '3'
            if k - 52 == 0 { active_color = 14; paint_draw_header(active_color); } // '4'
            if k - 53 == 0 { active_color = 6; paint_draw_header(active_color); }  // '5'
            if k - 99 == 0 { os_gpu_clear(0, 0); os_gpu_clear(1, 0); paint_draw_header(active_color); } // 'c'
            if k - 67 == 0 { os_gpu_clear(0, 0); os_gpu_clear(1, 0); paint_draw_header(active_color); } // 'C'
            if k - 120 == 0 { done = 1; } // 'x'
            if k - 88 == 0 { done = 1; }  // 'X'
        }
    }

    // Exit back to the desktop
    var path_addr: t40 = paint_seed_desktop_path(10000);
    sys_exec(path_addr);
    return 1;
}
