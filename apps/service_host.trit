        if df_bool_or(state == 1,state == 2) { svc_job_finish(job,4,0); }
        i=i+1;
    }
    i=4; var bit: t40 = 16;
    while i >= 0 {
        var mask: t40 = svc_get(51); var check: t40 = mask;
        while check >= bit*2 { check=check-bit*2; }
        var cleaned: t40 = svc_get(52);
        while cleaned >= bit*2 { cleaned=cleaned-bit*2; }
        if check >= bit { if cleaned < bit {
            if i == 1 {
                svc_close(svc_get(68)); svc_set(68,-1); svc_close(svc_get(69)); svc_set(69,-1);
                svc_close(svc_get(81)); svc_set(81,-1);
            }
            svc_add(52,bit);
        } }
        bit=bit/2; i=i-1;
    }
    // Logger can fail before its initialization bit is committed.
    svc_close(svc_get(68)); svc_set(68,-1); svc_close(svc_get(69)); svc_set(69,-1); svc_close(svc_get(81)); svc_set(81,-1);
    svc_set(49,0); svc_set(35,0); svc_set(36,0);
