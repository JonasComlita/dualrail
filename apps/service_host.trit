fn df_service_node_execute(node: t40) -> t40 {
    var kind: t40 = svc_word(node,1);
    if (kind == SVC_KIND_SOURCE) { return svc_source(node); }
    if (kind == SVC_KIND_PRESSURE) { return svc_pressure(node); }
    if (kind == SVC_KIND_AGGREGATE) { return svc_aggregate(node); }
    if (kind == SVC_KIND_LOGGER) { return svc_logger(node); }
    if (kind == SVC_KIND_WORKER) { return svc_worker(node); }
    if (kind == SVC_KIND_INIT_ARENA) {
        var pid: t40 = sys_getpid(); if df_bool_or(pid < 1,pid > 255) { return svc_fatal(-1); }
        if os_getproc(pid,SVC_PROC) != 8 { return svc_fatal(-1); }
        svc_set(3,pid); svc_set(4,svc_word(SVC_PROC,7)); return svc_initialized(0);
    }
    if (kind == SVC_KIND_INIT_LOGGER) { return svc_init_logger(); }
