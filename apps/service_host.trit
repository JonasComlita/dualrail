fn svc_report_row(job: t40, kind: t40, row: t40) -> t40 {
    memset(SVC_REPORT,0,32); svc_put(SVC_REPORT,0,SVC_MAGIC); svc_put(SVC_REPORT,1,1);
    svc_put(SVC_REPORT,2,svc_get(5)); svc_put(SVC_REPORT,3,svc_word(job,0)); svc_put(SVC_REPORT,4,svc_get(8)); svc_put(SVC_REPORT,5,kind);
