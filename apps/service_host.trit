// One cooperative user-space service. All storage is construction-owned in
// the existing private scratch mapping; callbacks never allocate or sleep.
// Statistics 17..27 are per generation. Prior-generation truncation is visible
// in VFS history, but is not charged against this generation's acceptance.
const SVC_STATE: t40 = 10000;
const SVC_POOL: t40 = 10745;
const SVC_JOBS: t40 = 11513;
const SVC_LEDGER: t40 = 11641;
const SVC_PATHS: t40 = 11769;
const SVC_PS: t40 = 11897;
const SVC_TRACE: t40 = 12397;
const SVC_METRICS: t40 = 15400;
const SVC_PROC: t40 = 15408;
const SVC_LOG: t40 = 15416;
const SVC_REPORT: t40 = 15436;
const SVC_GEN: t40 = 15468;
const SVC_MAGIC: t40 = 516;
const SVC_WIRE_MAX: t40 = radix3(88573,22) + radix3(88573,11) + radix3(88573,0);
const SVC_KIND_SOURCE: t40 = 5;
const SVC_KIND_PRESSURE: t40 = 6;
const SVC_KIND_AGGREGATE: t40 = 7;
const SVC_KIND_LOGGER: t40 = 8;
const SVC_KIND_WORKER: t40 = 9;
const SVC_KIND_INIT_ARENA: t40 = 10;
const SVC_KIND_INIT_LOGGER: t40 = 11;
const SVC_KIND_INIT_METRICS: t40 = 12;
const SVC_KIND_INIT_MONITOR: t40 = 13;
const SVC_KIND_INIT_WORKER: t40 = 14;

fn svc_get(index: t40) -> t40 { var v: t40 = 0; unsafe { v = load(SVC_STATE + index); } return v; }
fn svc_set(index: t40, value: t40) -> t40 { unsafe { store(SVC_STATE + index, value); } return value; }
fn svc_add(index: t40, value: t40) -> t40 { return svc_set(index, svc_get(index) + value); }
fn svc_word(ptr: t40, index: t40) -> t40 { var v: t40 = 0; unsafe { v = load(ptr + index); } return v; }
fn svc_put(ptr: t40, index: t40, value: t40) -> t40 { unsafe { store(ptr + index, value); } return value; }
fn svc_vfs_open(path: t40, mode: t40) -> t40 { return os_open(path, mode); }
fn svc_vfs_write(fd: t40, ptr: t40, words: t40) -> t40 { return os_write(fd, ptr, words); }
fn svc_metrics_read(out: t40, words: t40) -> t40 { return os_service_metrics(out, words); }

// Same existing remainder primitive used by the kernel's metrics span gate.
// The bound is exactly 33 balanced ones, formed from three exact 11-trit
// chunks; decimal MOV seeds must not define numeric admission boundaries.
fn svc_integer(value: t40) -> t40 {
    var v: t40 = value;
    if v < 0 { v = 0 - v; }
    if (v <= SVC_WIRE_MAX) {
        var remainder: t40 = 0;
        unsafe { remainder = tmod(value,1); }
        if remainder == 0 { return 1; }
    }
    return 0;
}
fn svc_span(ptr: t40, words: t40, need: t40) -> t40 {
    if svc_integer(ptr) == 0 { return 0; }
    if svc_integer(words) == 0 { return 0; }
    if ptr < 10000 { return 0; }
    if words < need { return 0; }
    if ptr + words > 16000 { return 0; }
    return 1;
}
fn svc_trace(kind: t40, a: t40, b: t40) -> t40 {
    var cursor: t40 = svc_get(96);
    var row: t40 = SVC_TRACE + cursor * 8;
    svc_put(row, 0, kind); svc_put(row, 1, svc_get(8));
    svc_put(row, 2, svc_get(5)); svc_put(row, 3, a); svc_put(row, 4, b);
    svc_put(row, 5, svc_get(17)); svc_put(row, 6, svc_get(20)); svc_put(row, 7, svc_get(1));
    cursor = cursor + 1; if cursor >= 128 { cursor = 0; }
    svc_set(96, cursor);
    if svc_get(61) < 128 { svc_add(61, 1); } else { svc_add(62, 1); }
    return 1;
}
fn svc_close(fd: t40) -> t40 {
    if fd < 0 { return 0; }
    var result: t40 = os_close(fd); svc_add(41, -1); return result;
}
fn svc_open(path: t40, mode: t40) -> t40 {
    if svc_get(54) == 0 { svc_add(50, 1); }
    var fd: t40 = svc_vfs_open(path, mode);
    if fd >= 0 { svc_add(41, 1); }
    return fd;
}
fn svc_fatal(error: t40) -> t40 {
    if error >= 0 { error = -1; }
    svc_set(2, error); svc_set(1, -1); svc_set(60, svc_get(20));
    svc_set(12, df_arena_highwater()); svc_trace(-1, error, svc_get(60));
    svc_cleanup();
    return DF_CALLBACK_ERROR;
}
fn svc_pool_reserve() -> t40 {
    var i: t40 = 2;
    while i < svc_get(28) {
        var slot: t40 = SVC_POOL + i * 24;
        if svc_word(slot, 0) == 0 {
            svc_put(slot, 0, 1); svc_put(slot, 1, 0); svc_put(slot, 2, 0); svc_put(slot, 3, 0);
            svc_add(29, 1); if svc_get(29) > svc_get(30) { svc_set(30, svc_get(29)); }
            return slot;
        }
        i = i + 1;
    }
    svc_add(31, 1); return 0;
}
fn svc_pool_release(slot: t40) -> t40 {
    if svc_word(slot, 2) == 1 { svc_add(20, -1); }
    svc_put(slot, 2, 0); svc_put(slot, 3, 0);
    if slot >= SVC_POOL + 48 { svc_put(slot, 0, 0); svc_add(29, -1); }
    return 1;
}
fn svc_lookup(token: t40) -> t40 {
    if svc_get(9) <= 0 { return 0; }
    if svc_get(10) <= 0 { return 0; }
    if svc_integer(token) == 0 { return 0; }
    if token <= 0 { return 0; }
    var i: t40 = 0;
    while i < svc_get(28) {
        var slot: t40 = SVC_POOL + i * 24;
        if svc_word(slot, 0) == 1 {
            if svc_word(slot, 2) == 1 {
                if svc_word(slot, 1) == token {
                    if svc_word(slot, 6) == svc_get(3) {
                        if svc_word(slot, 7) == svc_get(5) { return slot; }
                    }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}
fn svc_credit(parent: t40, role: t40) -> t40 {
    var i: t40 = 2;
    while i < svc_get(28) {
        var slot: t40 = SVC_POOL + i * 24;
        if svc_word(slot, 3) == parent * 3 + role { return slot; }
        i = i + 1;
    }
    return 0;
}
fn svc_record_prepare(slot: t40, kind: t40, tag: t40, tick: t40) -> t40 {
    var seq: t40 = svc_get(6);
    if seq > 1048575 { return svc_fatal(-1); }
    var record: t40 = slot + 4; memset(record, 0, 20);
    var token: t40 = (svc_get(3) * 1024 + svc_get(5)) * 1048576 + seq;
    svc_put(slot, 1, token); svc_put(slot, 3, 0);
    svc_put(record, 0, SVC_MAGIC); svc_put(record, 1, 1); svc_put(record, 2, svc_get(3));
    svc_put(record, 3, svc_get(5)); svc_put(record, 4, seq); svc_put(record, 5, kind);
    svc_put(record, 6, tick); svc_put(record, 7, tag); svc_put(record, 18, svc_get(4));
    svc_add(6, 1); return token;
}
fn svc_record_accept(slot: t40) -> t40 {
    var kind: t40 = svc_word(slot + 4, 5);
    svc_add(17, 1); svc_add(20, 1);
    if kind == 2 { svc_add(21, 1); }
    else if kind == 3 { svc_add(22, 1); }
    else if kind == 4 { svc_add(23, 1); }
    else if kind == 5 { svc_add(24, 1); }
    else if kind == 7 { svc_add(26, 1); }
    else { svc_add(25, 1); }
    // Publish last: observers and all consumers see a complete immutable record.
    svc_put(slot, 2, 1); return svc_word(slot, 1);
}
fn svc_record_snapshot(token: t40, out: t40, words: t40) -> t40 {
    if svc_span(out, words, 20) == 0 { return -1; }
    var slot: t40 = svc_lookup(token); if slot <= 0 { return -1; }
    memcpy(out, slot + 4, 20); return 20;
}
fn svc_graph(which: t40) -> t40 {
    if which == 0 { return svc_get(9); }
    if which == 1 { return svc_get(10); }
    return 0;
}
fn svc_stats(out: t40, words: t40) -> t40 {
    if svc_span(out, words, 64) == 0 { return -1; }
    svc_set(11, df_arena_used()); memcpy(out, SVC_STATE, 64); return 64;
}
fn svc_paths() -> t40 {
    var i: t40 = 0;
    while i < 4 {
        var p: t40 = SVC_PATHS + i * 32;
        svc_put(p,0,47); svc_put(p,1,118); svc_put(p,2,97); svc_put(p,3,114);
        svc_put(p,4,47); svc_put(p,5,108); svc_put(p,6,111); svc_put(p,7,103);
        svc_put(p,8,47); svc_put(p,9,115); svc_put(p,10,118); svc_put(p,11,99); svc_put(p,12,46);
        if i < 2 { svc_put(p,13,48+i); }
        if i == 2 { svc_put(p,13,103); svc_put(p,14,101); svc_put(p,15,110); }
        if i == 3 { svc_put(p,13,114); svc_put(p,14,101); svc_put(p,15,112); svc_put(p,16,111); svc_put(p,17,114); svc_put(p,18,116); }
        i = i + 1;
    }
    return 1;
}
fn df_service_kind_valid(kind: t40) -> t40 {
    var i: t40 = 5; while i <= 14 { if kind == i { return 1; } i = i + 1; } return 0;
}
fn svc_construction_fail() -> t40 {
    var highwater: t40 = df_arena_highwater();
    if highwater > svc_get(12) { svc_set(12,highwater); }
    svc_set(2,-1); svc_set(9,0); svc_set(10,0); df_arena_reset(); svc_set(11,0); return -1;
}
fn svc_allocate(words: t40, expected: t40) -> t40 {
    var ptr: t40 = malloc_raw(words);
    if ptr != expected { return 0; }
    memset(ptr,0,words); return ptr;
}
fn svc_construct(capacity: t40, pool: t40) -> t40 {
    if svc_get(1) == 1 { return -1; }
    memset(SVC_STATE, 0, 128); svc_set(0, 1); svc_set(6, 1);
    if df_bool_or(capacity != 1, pool < 5) {
        if capacity != 2 { svc_set(2,-1); return -1; }
    }
    if svc_integer(pool) == 0 { svc_set(2,-1); return -1; }
    if df_bool_or(pool < 5, pool > 32) { svc_set(2,-1); return -1; }
    if df_arena_init(10000, 5400) == 0 { return -1; }
    if malloc_raw(128) != 10000 { return svc_construction_fail(); }
    svc_set(12,df_arena_highwater());
    var startup: t40 = df_sched_new(5);
    if startup <= 0 { return svc_construction_fail(); }
    svc_set(12,df_arena_highwater());
    var persistent: t40 = df_sched_new(5);
    if persistent <= 0 { return svc_construction_fail(); }
    svc_set(9,startup); svc_set(10,persistent);
    var c0: t40 = df_channel_new(capacity); var c1: t40 = df_channel_new(capacity); var c2: t40 = df_channel_new(capacity);
    if c0 <= 0 { return svc_construction_fail(); } if c1 <= 0 { return svc_construction_fail(); } if c2 <= 0 { return svc_construction_fail(); }
    if capacity == 1 { if malloc_raw(6) <= 0 { return svc_construction_fail(); } }
    var contexts: t40 = svc_allocate(106,10639); if contexts <= 0 { return svc_construction_fail(); }
    if svc_allocate(768,SVC_POOL) <= 0 { return svc_construction_fail(); }
    if svc_allocate(128,SVC_JOBS) <= 0 { return svc_construction_fail(); }
    if svc_allocate(128,SVC_LEDGER) <= 0 { return svc_construction_fail(); }
    if svc_allocate(128,SVC_PATHS) <= 0 { return svc_construction_fail(); }
    if svc_allocate(500,SVC_PS) <= 0 { return svc_construction_fail(); }
    if svc_allocate(1024,SVC_TRACE) <= 0 { return svc_construction_fail(); }
    if df_arena_used() != 3421 { return svc_construction_fail(); }
    svc_set(12,df_arena_highwater()); svc_set(11,df_arena_used()); svc_set(28,pool);
    svc_set(29,2); svc_set(30,2); svc_put(SVC_POOL,0,1); svc_put(SVC_POOL+24,0,1);
    svc_set(64,c0); svc_set(65,c1); svc_set(66,c2); svc_set(67,contexts);
    svc_set(68,-1); svc_set(69,-1); svc_set(70,-1); svc_set(81,-1);
    svc_paths();
    var i: t40 = 0;
    while i < 5 {
        if df_node_new(startup,0,10+i,contexts+i*8) <= 0 { return svc_construction_fail(); }
        var node: t40 = df_node_new(persistent,0,5+i,contexts+40+i*8);
        if node <= 0 { return svc_construction_fail(); }
        if df_sched_register_stream(persistent,node) <= 0 { return svc_construction_fail(); } i = i + 1;
    }
    var nodes: t40 = svc_word(startup,4);
    if df_node_add_dependent(nodes,nodes+38) <= 0 { return svc_construction_fail(); }
    if df_node_add_dependent(nodes+38,nodes+76) <= 0 { return svc_construction_fail(); }
    if df_node_add_dependent(nodes+76,nodes+114) <= 0 { return svc_construction_fail(); }
    if df_node_add_dependent(nodes+76,nodes+152) <= 0 { return svc_construction_fail(); }
    nodes = svc_word(persistent,4);
    if df_node_add_dependent(nodes,nodes+38) <= 0 { return svc_construction_fail(); }
    if df_node_add_dependent(nodes+38,nodes+76) <= 0 { return svc_construction_fail(); }
    if df_node_add_dependent(nodes+76,nodes+114) <= 0 { return svc_construction_fail(); }
    if df_sched_register_channel(persistent,c0) <= 0 { return svc_construction_fail(); }
    if df_sched_register_channel(persistent,c1) <= 0 { return svc_construction_fail(); }
    if df_sched_register_channel(persistent,c2) <= 0 { return svc_construction_fail(); }
    if df_node_add_output(nodes,c0) <= 0 { return svc_construction_fail(); }
    if df_node_add_input(nodes+38,c0) <= 0 { return svc_construction_fail(); }
    if df_node_add_output(nodes+38,c1) <= 0 { return svc_construction_fail(); }
    if df_node_add_input(nodes+76,c1) <= 0 { return svc_construction_fail(); }
    if df_node_add_output(nodes+76,c2) <= 0 { return svc_construction_fail(); }
    if df_node_add_input(nodes+114,c2) <= 0 { return svc_construction_fail(); }
    if df_sched_validate(startup) < 0 { return svc_construction_fail(); }
    if df_sched_validate(persistent) < 0 { return svc_construction_fail(); }
    return 0;
}

fn svc_initialized(index: t40) -> t40 {
    var bit: t40 = 1; var i: t40 = 0;
    while i < index { bit = bit * 2; i = i + 1; }
    svc_add(51,bit); svc_add(53,1); svc_trace(10,index,svc_get(51)); return DF_CALLBACK_DONE;
}
fn svc_init_logger() -> t40 {
    var phase: t40 = svc_get(80);
    if phase == 0 {
        var fd: t40 = svc_open(SVC_PATHS+64,0);
        var generation: t40 = 1;
        if fd >= 0 {
            var count: t40 = os_read(fd,SVC_GEN,8);
            if count != 8 { svc_close(fd); return svc_fatal(-1); }
            var extra: t40 = os_read(fd,SVC_METRICS,1); svc_close(fd);
            if extra != 0 { return svc_fatal(-1); }
            if (svc_word(SVC_GEN,0) != SVC_MAGIC) { return svc_fatal(-1); }
            if svc_word(SVC_GEN,1) != 1 { return svc_fatal(-1); }
            var writer: t40 = svc_word(SVC_GEN,2); generation = svc_word(SVC_GEN,3);
            if svc_integer(writer) == 0 { return svc_fatal(-1); }
            if df_bool_or(writer < 1,writer > 255) { return svc_fatal(-1); }
            if svc_integer(generation) == 0 { return svc_fatal(-1); }
            if df_bool_or(generation < 1,generation >= 1023) { return svc_fatal(-1); }
            var i: t40 = 4; while i < 8 { if svc_word(SVC_GEN,i) != 0 { return svc_fatal(-1); } i = i+1; }
            generation = generation + 1;
        } else if fd != -1 { return svc_fatal(fd); }
        svc_set(5,generation); memset(SVC_GEN,0,8);
        svc_put(SVC_GEN,0,SVC_MAGIC); svc_put(SVC_GEN,1,1); svc_put(SVC_GEN,2,svc_get(3)); svc_put(SVC_GEN,3,generation);
        fd = svc_open(SVC_PATHS+64,3); if fd < 0 { return svc_fatal(fd); }
        svc_set(81,fd); svc_set(82,0); svc_set(80,1); return DF_CALLBACK_PROGRESS;
    }
    if phase == 1 {
        var offset: t40 = svc_get(82); var fd: t40 = svc_get(81);
        if offset < 8 {
            var written: t40 = svc_vfs_write(fd,SVC_GEN+offset,8-offset);
            if written < 0 { return svc_fatal(written); }
            if written == 0 { svc_add(33,1); return DF_CALLBACK_BLOCKED_OUTPUT; }
            if written > 8-offset { return svc_fatal(-1); }
            svc_add(82,written); return DF_CALLBACK_PROGRESS;
        }
        var synced: t40 = os_fsync(fd); if synced <= 0 { return svc_fatal(synced); }
        svc_close(fd); svc_set(81,-1); svc_set(80,2); return DF_CALLBACK_PROGRESS;
    }
    if phase == 2 {
        var fd: t40 = svc_open(SVC_PATHS,3); if fd < 0 { return svc_fatal(fd); }
        svc_set(68,fd); svc_set(80,3); return DF_CALLBACK_PROGRESS;
    }
    if phase == 3 {
        var fd: t40 = svc_open(SVC_PATHS+32,3); if fd < 0 { return svc_fatal(fd); }
        svc_set(69,fd); svc_set(80,4); return svc_initialized(1);
    }
    return DF_CALLBACK_DONE;
}
fn svc_start() -> t40 {
    if svc_get(9) <= 0 { return -1; }
    if svc_get(1) != 0 { return -1; }
    // Validate both graphs before identity, source or VFS startup effects.
    if df_sched_validate(svc_get(9)) < 0 { svc_fatal(-1); return -1; }
    if df_sched_validate(svc_get(10)) < 0 { svc_fatal(-1); return -1; }
    svc_set(1,1);
    var node: t40 = svc_word(svc_get(9),4);
    if df_sched_submit(svc_get(9),node) <= 0 { svc_fatal(-1); return -1; }
    return 0;
}
fn svc_request_cancel() -> t40 {
    if svc_get(1) != 1 { return -1; }
    svc_set(55,1); return 0;
}
fn svc_next_deadline() -> t40 { return svc_get(7); }
fn svc_has_immediate_work() -> t40 {
    if svc_get(1) != 1 { return 0; }
    if svc_get(54) == 0 { return 1; }
    if svc_get(20) > 0 { return 1; }
    if svc_get(44) > 0 { return 1; }
    if svc_get(55) > 0 { return 1; }
    return 0;
}
fn svc_control_submit(tag: t40, value: t40) -> t40 {
    if svc_get(1) != 1 { return -1; }
    if svc_get(54) != 1 { return -1; }
    if svc_get(55) != 0 { return -1; }
    if tag != -1 { if tag != -2 { if tag != -4 { if tag != -5 { return -1; } } } }
    if svc_integer(value) == 0 { return -1; }
    if svc_get(6) + svc_get(29) + 5 > 1048575 { svc_request_cancel(); return -1; }
    if svc_word(SVC_POOL,2) != 0 { return 0; }
    if svc_get(83) == 0 { return 0; }
    svc_record_prepare(SVC_POOL,6,tag,svc_get(8)); svc_put(SVC_POOL+4,11,value);
    svc_record_accept(SVC_POOL); svc_set(84,1); return 1;
}
fn svc_source(node: t40) -> t40 {
    if svc_get(84) == 1 {
        svc_set(84,0); df_node_pending_push(node,svc_word(SVC_POOL+4,7),svc_word(SVC_POOL,1));
        return df_node_pending_flush(node);
    }
    if svc_get(83) == 0 {
        var token: t40 = svc_record_prepare(SVC_POOL,1,DF_EVENT_DATA,svc_get(8));
        svc_record_accept(SVC_POOL); svc_set(83,1); df_node_pending_push(node,DF_EVENT_DATA,token);
        return df_node_pending_flush(node);
    }
    // Reserve domain for all unmaterialized expansion credits and shutdown.
    if svc_get(6) + svc_get(29) + 5 > 1048575 { svc_set(55,1); }
    if svc_get(55) == 1 {
        if svc_word(SVC_POOL,2) == 1 { return DF_CALLBACK_BLOCKED_OUTPUT; }
        if svc_get(85) == 0 {
            var token: t40 = svc_record_prepare(SVC_POOL,8,DF_EVENT_DATA,svc_get(8));
            // STOP is admissions stopped, not completed drain. Its commit must
            // return this source credit before EOS can reuse it.
            svc_put(SVC_POOL+4,19,1); svc_record_accept(SVC_POOL); svc_set(85,1);
            df_node_pending_push(node,DF_EVENT_DATA,token); return df_node_pending_flush(node);
        }
        if svc_get(85) == 1 {
            var token: t40 = svc_record_prepare(SVC_POOL,7,DF_EVENT_EOS,svc_get(8));
            svc_record_accept(SVC_POOL); svc_set(85,2);
            df_node_pending_push(node,DF_EVENT_EOS,token); return df_node_pending_flush(node);
        }
        return DF_CALLBACK_DONE;
    }
    // State 7 is an absolute CYCLE deadline; state 8 remains the metrics IRQ tick.
    if os_monotonic_cycles() < svc_get(7) { svc_add(32,1); return DF_CALLBACK_BLOCKED_INPUT; }
    var c0: t40 = svc_get(64);
    if svc_word(c0,4) >= svc_word(c0,1) { return DF_CALLBACK_BLOCKED_OUTPUT; }
    var raw: t40 = svc_pool_reserve(); if raw <= 0 { return DF_CALLBACK_BLOCKED_OUTPUT; }
    var pressure: t40 = svc_pool_reserve();
    if pressure <= 0 { svc_pool_release(raw); return DF_CALLBACK_BLOCKED_OUTPUT; }
    var window: t40 = svc_pool_reserve();
    if window <= 0 { svc_pool_release(raw); svc_pool_release(pressure); return DF_CALLBACK_BLOCKED_OUTPUT; }
    svc_set(97,os_monotonic_cycles());
    var result: t40 = svc_metrics_read(SVC_METRICS,7);
    if result != 7 { svc_pool_release(raw); svc_pool_release(pressure); svc_pool_release(window); return svc_fatal(result); }
    var tick: t40 = svc_word(SVC_METRICS,2);
    svc_set(8,tick); svc_set(7,svc_get(97)+svc_get(98)*1000000);
    var token: t40 = svc_record_prepare(raw,2,DF_EVENT_DATA,tick);
