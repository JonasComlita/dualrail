    if (kind == SVC_KIND_INIT_WORKER) { return svc_initialized(4); }
    return svc_fatal(-1);
}
fn svc_dispatch(budget: t40) -> t40 {
    if svc_get(1) != 1 { return 0; }
    if svc_integer(budget) == 0 { return 0; }
    if budget <= 0 { return 0; } if budget > 32 { budget=32; }
    var attempts: t40 = 0;
    if svc_get(54) == 0 {
        attempts = df_sched_run_budget(svc_get(9),budget);
        if df_sched_lifecycle(svc_get(9)) < 0 { if svc_get(1) == 1 { svc_fatal(-1); } }
        else if svc_get(51) == 31 { svc_set(54,1); }
    } else {
        attempts = df_sched_run_budget(svc_get(10),budget);
        if df_sched_lifecycle(svc_get(10)) < 0 { if svc_get(1) == 1 { svc_fatal(-1); } }
        else if df_sched_lifecycle(svc_get(10)) == 2 { svc_set(1,2); }
    }
    svc_set(14,attempts); if attempts > svc_get(15) { svc_set(15,attempts); }
    svc_add(16,1); svc_set(11,df_arena_used()); return attempts;
