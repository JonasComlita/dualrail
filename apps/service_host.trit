// Called only outside callbacks. Round the remaining absolute deadline up to ms.
fn svc_idle_wait() -> t40 {
    var remaining: t40 = svc_get(7) - os_monotonic_cycles();
    if remaining <= 0 { return 0; }
    var remainder: t40 = 0;
    unsafe { remainder = tmod(remaining,1000000); }
    var milliseconds: t40 = (remaining-remainder)/1000000;
    if remainder > 0 { milliseconds = milliseconds+1; }
    return os_sleep_ms(milliseconds);
}
fn main() -> t40 {
    if svc_construct(2,32) < 0 { os_print_int(-1); return -1; }
    svc_start(); var reported: t40 = 0;
    while svc_get(1) == 1 {
        svc_dispatch(32);
        if svc_get(54) == 1 {
            if reported == 0 { os_print_int(1); svc_job_submit(1); reported=1; }
            if svc_get(95) == 1 { if svc_job_submit(1) > 0 { svc_set(95,0); } }
        }
        if svc_has_immediate_work() == 0 { svc_idle_wait(); }
        else { sys_yield(); }
    }
    if svc_get(2) < 0 { os_print_int(svc_get(2)); os_print_int(svc_get(60)); }
    svc_destroy(); return svc_get(2);
}
