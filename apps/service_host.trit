fn svc_job_find(id: t40) -> t40 {
    if id <= 0 { return 0; }
    var i: t40 = 0; while i < 8 { var job: t40 = SVC_JOBS+i*16; if svc_word(job,0) == id { return job; } i=i+1; } return 0;
}
fn svc_job_submit(kind: t40) -> t40 {
    return svc_job_admit(kind,0);
}
fn svc_job_admit(kind: t40, maintenance: t40) -> t40 {
    if svc_get(1) != 1 { return -1; }
