// Bounded memory and small collection adapters for service-host guests.
// The caller chooses the arena extent explicitly. This module intentionally
// has no service-kind dispatcher; the embedding guest owns that hook.

// Reserved in the mapped service scratch page immediately before its arena.
const DF_ARENA_STATE_BASE: t40 = 9996;
const DF_ARENA_STATE_WORDS: t40 = 4;

fn df_bool_or(left: trit, right: trit) -> trit {
    match left {
        pos => { return left; }
        _ => { return right; }
    }
}

fn df_bool_and(left: trit, right: trit) -> trit {
    match left {
        pos => { return right; }
        _ => { return left; }
    }
}

fn df_arena_init(base: t40, words: t40) -> t40 {
    if df_bool_or(base <= 0, words <= 0) { return 0; }
    var end: t40 = base + words;
    if end <= base { return 0; }
    if df_bool_and(base < DF_ARENA_STATE_BASE + DF_ARENA_STATE_WORDS,
                   end > DF_ARENA_STATE_BASE) { return 0; }
    unsafe {
        store(DF_ARENA_STATE_BASE, base);
        store(DF_ARENA_STATE_BASE + 1, words);
        store(DF_ARENA_STATE_BASE + 2, 0);
        store(DF_ARENA_STATE_BASE + 3, 0);
    }
    return 1;
}

fn df_arena_used() -> t40 {
    var used: t40 = 0;
    unsafe { used = load(DF_ARENA_STATE_BASE + 2); }
    return used;
}

fn df_arena_highwater() -> t40 {
    var highwater: t40 = 0;
    unsafe { highwater = load(DF_ARENA_STATE_BASE + 3); }
    return highwater;
}

fn df_arena_reset() -> t40 {
    unsafe {
        store(DF_ARENA_STATE_BASE + 2, 0);
        store(DF_ARENA_STATE_BASE + 3, 0);
    }
    return 1;
}

fn malloc_raw(words: t40) -> t40 {
    if words <= 0 { return 0; }
    var base: t40 = 0;
    var capacity: t40 = 0;
    var used: t40 = 0;
    unsafe {
        base = load(DF_ARENA_STATE_BASE);
        capacity = load(DF_ARENA_STATE_BASE + 1);
        used = load(DF_ARENA_STATE_BASE + 2);
    }
    if df_bool_or(df_bool_or(base <= 0, capacity <= 0), used < 0) { return 0; }
    if capacity - used - words < 0 { return 0; }
    var result: t40 = base + used;
    var next_used: t40 = used + words;
    unsafe {
        store(DF_ARENA_STATE_BASE + 2, next_used);
        if next_used - load(DF_ARENA_STATE_BASE + 3) > 0 {
            store(DF_ARENA_STATE_BASE + 3, next_used);
        }
    }
    return result;
}

// Reclamation is intentionally deferred until the owning graph resets its arena.
fn free_raw(ptr: t40) -> t40 {
    if ptr <= 0 { return 0; }
    return 1;
}

fn memcpy(dest: t40, src: t40, words: t40) -> t40 {
    if df_bool_or(df_bool_or(dest <= 0, src <= 0), words < 0) { return 0; }
    var i: t40 = 0;
    while words - i > 0 {
        var value: t40 = 0;
        unsafe { value = load(src + i); store(dest + i, value); }
        i = i + 1;
    }
    return dest;
}

fn memset(ptr: t40, value: t40, words: t40) -> t40 {
    if df_bool_or(ptr <= 0, words < 0) { return 0; }
    var i: t40 = 0;
    while words - i > 0 {
        unsafe { store(ptr + i, value); }
        i = i + 1;
    }
    return ptr;
}

fn vec_len(vec: t40) -> t40 {
    if vec <= 0 { return 0; }
    var len: t40 = 0;
    unsafe { len = load(vec + 1); }
    return len;
}

fn vec_get(vec: t40, index: t40) -> t40 {
    if df_bool_or(vec <= 0, index < 0) { return 0; }
    var data: t40 = 0;
    var len: t40 = 0;
    unsafe { data = load(vec); len = load(vec + 1); }
    if df_bool_or(data <= 0, index >= len) { return 0; }
    var value: t40 = 0;
    unsafe { value = load(data + index); }
    return value;
}

fn vec_new() -> t40 {
    var vec: t40 = malloc_raw(3);
    if vec <= 0 { return 0; }
    var data: t40 = malloc_raw(8);
    if data <= 0 { return 0; }
    unsafe { store(vec, data); store(vec + 1, 0); store(vec + 2, 8); }
    return vec;
}

fn vec_push(vec: t40, value: t40) -> t40 {
    if vec <= 0 { return 0; }
    var data: t40 = 0;
    var len: t40 = 0;
    var cap: t40 = 0;
    unsafe { data = load(vec); len = load(vec + 1); cap = load(vec + 2); }
    if df_bool_or(df_bool_or(data <= 0, len < 0), cap <= 0) { return 0; }
    if len >= cap {
        var new_cap: t40 = cap * 2;
        var new_data: t40 = malloc_raw(new_cap);
        if new_data <= 0 { return 0; }
        memcpy(new_data, data, len);
        data = new_data;
        cap = new_cap;
        unsafe { store(vec, data); store(vec + 2, cap); }
    }
    unsafe { store(data + len, value); store(vec + 1, len + 1); }
    return 1;
}

fn vec_set(vec: t40, index: t40, value: t40) -> t40 {
    if df_bool_or(vec <= 0, index < 0) { return 0; }
    var data: t40 = 0;
    var len: t40 = 0;
    unsafe { data = load(vec); len = load(vec + 1); }
    if df_bool_or(data <= 0, index >= len) { return 0; }
    unsafe { store(data + index, value); }
    return 1;
}

fn vec_free(vec: t40) -> t40 {
    if vec <= 0 { return 1; }
    var data: t40 = 0;
    unsafe { data = load(vec); }
    free_raw(data);
    free_raw(vec);
    return 1;
}

// Ring layout matches the small scheduler queue used by the legacy API.
fn ring_new(capacity: t40) -> t40 {
    if capacity < 2 { return 0; }
    var ring: t40 = malloc_raw(4);
    if ring <= 0 { return 0; }
    var data: t40 = malloc_raw(capacity);
    if data <= 0 { return 0; }
    unsafe {
        store(ring, data); store(ring + 1, capacity);
        store(ring + 2, 0); store(ring + 3, 0);
    }
    return ring;
}

fn ring_free(ring: t40) -> t40 {
    if ring <= 0 { return 1; }
    var data: t40 = 0;
    unsafe { data = load(ring); }
    free_raw(data);
    free_raw(ring);
    return 1;
}

fn ring_empty(ring: t40) -> t40 {
    if ring <= 0 { return 1; }
    var read_pos: t40 = 0;
    var write_pos: t40 = 0;
    unsafe { read_pos = load(ring + 2); write_pos = load(ring + 3); }
    if read_pos == write_pos { return 1; }
    return 0;
}

fn ring_full(ring: t40) -> t40 {
    if ring <= 0 { return 1; }
    var cap: t40 = 0;
    var read_pos: t40 = 0;
    var write_pos: t40 = 0;
    unsafe { cap = load(ring + 1); read_pos = load(ring + 2); write_pos = load(ring + 3); }
    var next_write: t40 = write_pos + 1;
    if next_write >= cap { next_write = 0; }
    if next_write == read_pos { return 1; }
    return 0;
}

fn ring_write(ring: t40, value: t40) -> t40 {
    if df_bool_or(ring <= 0, ring_full(ring) > 0) { return 0; }
    var cap: t40 = 0;
    var write_pos: t40 = 0;
    var data: t40 = 0;
    unsafe { cap = load(ring + 1); write_pos = load(ring + 3); data = load(ring); }
    unsafe { store(data + write_pos, value); }
    write_pos = write_pos + 1;
    if write_pos >= cap { write_pos = 0; }
    unsafe { store(ring + 3, write_pos); }
    return 1;
}

fn ring_read(ring: t40) -> t40 {
    if df_bool_or(ring <= 0, ring_empty(ring) > 0) { return 0; }
    var cap: t40 = 0;
    var read_pos: t40 = 0;
    var data: t40 = 0;
    unsafe { cap = load(ring + 1); read_pos = load(ring + 2); data = load(ring); }
    var value: t40 = 0;
    unsafe { value = load(data + read_pos); }
    read_pos = read_pos + 1;
    if read_pos >= cap { read_pos = 0; }
    unsafe { store(ring + 2, read_pos); }
    return value;
}

fn print_int(value: t40) -> t40 { return sys_write_int(value); }

fn print_string(text: t40) -> t40 {
    if text <= 0 { return 0; }
    var index: t40 = 0;
    var done: t40 = 0;
    while done == 0 {
        var ch: t40 = 0;
        unsafe { ch = load(text + index); }
        if ch == 0 { done = 1; }
        else { sys_write_char(ch); index = index + 1; }
    }
    return 0;
}

fn df_service_unknown_kind(node: t40) -> t40 {
    return 0 - 1;
}
