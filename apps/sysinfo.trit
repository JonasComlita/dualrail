// apps/sysinfo.trit - Compact guest identity and runtime report.

const INFO_ROOT: t40 = 10000;
const INFO_RELEASE: t40 = 10016;
const INFO_STAT: t40 = 10100;
const INFO_BUF: t40 = 10300;
const INFO_MAX_WORDS: t40 = 64;

fn info_store(addr: t40, value: t40) -> t40 {
    unsafe { store(addr, value); }
    return value;
}

fn info_load(addr: t40) -> t40 {
    var value: t40 = 0;
    unsafe { value = load(addr); }
    return value;
}

fn info_seed_root() -> t40 {
    info_store(INFO_ROOT, 47); info_store(INFO_ROOT + 1, 0);
    return INFO_ROOT;
}

fn info_seed_release() -> t40 {
    // /etc/os-release
    info_store(INFO_RELEASE + 0, 47);  info_store(INFO_RELEASE + 1, 101);
    info_store(INFO_RELEASE + 2, 116); info_store(INFO_RELEASE + 3, 99);
    info_store(INFO_RELEASE + 4, 47);  info_store(INFO_RELEASE + 5, 111);
    info_store(INFO_RELEASE + 6, 115); info_store(INFO_RELEASE + 7, 45);
    info_store(INFO_RELEASE + 8, 114); info_store(INFO_RELEASE + 9, 101);
    info_store(INFO_RELEASE + 10, 108); info_store(INFO_RELEASE + 11, 101);
    info_store(INFO_RELEASE + 12, 97); info_store(INFO_RELEASE + 13, 115);
    info_store(INFO_RELEASE + 14, 101); info_store(INFO_RELEASE + 15, 0);
    return INFO_RELEASE;
}

fn info_label_pid(pid: t40) -> t40 {
    os_putc(80); os_putc(73); os_putc(68); os_putc(32); os_print_int(pid); os_newline();
    return 1;
}

fn info_label_uptime(ticks: t40) -> t40 {
    os_putc(85); os_putc(80); os_putc(84); os_putc(73); os_putc(77); os_putc(69); os_putc(32);
    os_print_int(ticks); os_newline();
    return 1;
}

fn info_label_root(kind: t40, size: t40) -> t40 {
    os_putc(82); os_putc(79); os_putc(79); os_putc(84); os_putc(32);
    os_putc(75); os_putc(73); os_putc(78); os_putc(68); os_putc(32); os_print_int(kind);
    os_putc(32); os_putc(83); os_putc(73); os_putc(90); os_putc(69); os_putc(32); os_print_int(size); os_newline();
    return 1;
}

fn info_label_processes(count: t40) -> t40 {
    os_putc(80); os_putc(82); os_putc(79); os_putc(67); os_putc(69); os_putc(83); os_putc(83); os_putc(69); os_putc(83); os_putc(32);
    os_print_int(count); os_newline();
    return 1;
}

fn main() -> t40 {
    var in_kernel: t40 = 0;
    unsafe { in_kernel = csr_read(scratch); }
    os_putc(83); os_putc(89); os_putc(83); os_putc(73); os_putc(78); os_putc(70); os_putc(79); os_newline();
    if in_kernel == 0 {
        os_putc(83); os_putc(89); os_putc(83); os_putc(73); os_putc(78); os_putc(70); os_putc(79); os_putc(32);
        os_putc(80); os_putc(65); os_putc(83); os_putc(83); os_newline();
        return 1;
    }

    var failures: t40 = 0;
    var pid: t40 = sys_getpid();
    info_label_pid(pid);
    if pid <= 0 { failures = failures + 1; }
    info_label_uptime(sys_uptime());

    var root_size: t40 = os_stat(info_seed_root(), INFO_STAT);
    var root_kind: t40 = info_load(INFO_STAT + 1);
    info_label_root(root_kind, root_size);
    if root_kind - 2 != 0 { failures = failures + 1; }
    if root_size < 0 { failures = failures + 1; }

    var release_size: t40 = os_stat(info_seed_release(), INFO_STAT);
    var release_kind: t40 = info_load(INFO_STAT + 1);
    if release_kind - 1 != 0 { failures = failures + 1; }
    if release_size <= 0 { failures = failures + 1; }

    // Read at most one bounded release-file page.  This keeps sysinfo safe
    // even if an image carries a very large or malformed metadata file.
    var fd: t40 = os_open(INFO_RELEASE, 0);
    var read_words: t40 = 0;
    var closed: t40 = 0;
    if fd >= 0 {
        read_words = os_read(fd, INFO_BUF, INFO_MAX_WORDS);
        closed = os_close(fd);
    }
    os_putc(82); os_putc(69); os_putc(76); os_putc(69); os_putc(65); os_putc(83); os_putc(69); os_newline();
    if INFO_MAX_WORDS - read_words < 0 {
        read_words = INFO_MAX_WORDS;
    }
    if read_words > 0 {
        var i: t40 = 0;
        while read_words - i > 0 {
            var c: t40 = info_load(INFO_BUF + i);
            os_putc(c);
            i = i + 1;
        }
    } else {
        os_putc(63); os_newline();
    }
    if read_words <= 0 { failures = failures + 1; }
    if closed <= 0 { failures = failures + 1; }

    var process_count: t40 = os_ps(INFO_STAT, 8);
    if process_count > 0 {
        info_label_processes(process_count);
    } else {
        os_putc(80); os_putc(82); os_putc(79); os_putc(67); os_putc(69); os_putc(83); os_putc(83); os_putc(69); os_putc(83); os_putc(32); os_putc(63); os_newline();
    }

    if failures == 0 {
        os_putc(83); os_putc(89); os_putc(83); os_putc(73); os_putc(78); os_putc(70); os_putc(79); os_putc(32);
        os_putc(80); os_putc(65); os_putc(83); os_putc(83); os_newline();
        return 1;
    }
    os_putc(83); os_putc(89); os_putc(83); os_putc(73); os_putc(78); os_putc(70); os_putc(79); os_putc(32);
    os_putc(70); os_putc(65); os_putc(73); os_putc(76); os_putc(32); os_print_int(failures); os_newline();
    return 0;
}
