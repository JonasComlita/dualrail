// apps/task_manager.trit - System task manager with live process data.

fn task_seed_desktop_path(addr: t40) -> t40 {
    unsafe {
        store(addr + 0, 47);   // /
        store(addr + 1, 98);   // b
        store(addr + 2, 105);  // i
        store(addr + 3, 110);  // n
        store(addr + 4, 47);   // /
        store(addr + 5, 100);  // d
        store(addr + 6, 101);  // e
        store(addr + 7, 115);  // s
        store(addr + 8, 107);  // k
        store(addr + 9, 116);  // t
        store(addr + 10, 111); // o
        store(addr + 11, 112); // p
        store(addr + 12, 0);   // \0
    }
    return addr;
}

fn task_draw_box(x1: t40, y1: t40, x2: t40, y2: t40, color: t40) -> t40 {
    var x: t40 = x1;
    while x2 - x >= 0 {
        os_text_cell(x, y1, 45, color); // '-'
        os_text_cell(x, y2, 45, color); // '-'
        x = x + 1;
    }
    var y: t40 = y1 + 1;
    while y2 - y > 0 {
        os_text_cell(x1, y, 124, color); // '|'
        os_text_cell(x2, y, 124, color); // '|'
        y = y + 1;
    }
    return 1;
}

fn task_draw_string(x: t40, y: t40, text_addr: t40, len: t40, color: t40) -> t40 {
    var i: t40 = 0;
    while len - i > 0 {
        var c: t40 = 0;
        unsafe { c = load(text_addr + i); }
        os_text_cell(x + i, y, c, color);
        i = i + 1;
    }
    return len;
}

// Draw a decimal integer at (x,y) — positive values only.
fn task_draw_int(x: t40, y: t40, val: t40, color: t40) -> t40 {
    if val == 0 {
        os_text_cell(x, y, 48, color);
        return 1;
    }
    var divisor: t40 = 1;
    var temp: t40 = val;
    while val / divisor >= 10 {
        divisor = divisor * 10;
    }
    var cx: t40 = x;
    while divisor > 0 {
        var digit: t40 = temp / divisor;
        os_text_cell(cx, y, 48 + digit, color);
        temp = temp - digit * divisor;
        divisor = divisor / 10;
        cx = cx + 1;
    }
    return cx - x;
}

// Decode PROC_STATE into a short label and write it at (x, y).
fn task_draw_state(x: t40, y: t40, state: t40) -> t40 {
    var color: t40 = 2;  // dim default
    if state - 2 == 0 { color = 5; } // RUNNING -> cyan
    if state - 3 == 0 { color = 9; } // BLOCKED -> red
    if state - 5 == 0 { color = 8; } // EXITED  -> dark
    if state - 6 == 0 { color = 11; } // STOPPED -> yellow
    if state - 7 == 0 { color = 8; }  // ZOMBIE -> dark
    if state - 8 == 0 { color = 9; }  // KILLING -> red
    if state - 9 == 0 { color = 12; } // CRASHED -> magenta
    // RUNNABLE
    if state - 1 == 0 {
        os_text_cell(x,     y, 82, color); // R
        os_text_cell(x + 1, y, 68, color); // D
        os_text_cell(x + 2, y, 89, color); // Y
        return 3;
    }
    // RUNNING
    if state - 2 == 0 {
        os_text_cell(x,     y, 82, color); // R
        os_text_cell(x + 1, y, 85, color); // U
        os_text_cell(x + 2, y, 78, color); // N
        return 3;
    }
    // BLOCKED
    if state - 3 == 0 {
        os_text_cell(x,     y, 66, color); // B
        os_text_cell(x + 1, y, 76, color); // L
        os_text_cell(x + 2, y, 75, color); // K
        return 3;
    }
    // SLEEPING
    if state - 4 == 0 {
        os_text_cell(x,     y, 90, color); // Z
        os_text_cell(x + 1, y, 90, color); // Z
        os_text_cell(x + 2, y, 90, color); // Z
        return 3;
    }
    // EXITED
    if state - 5 == 0 {
        os_text_cell(x,     y, 88, color); // X
        os_text_cell(x + 1, y, 73, color); // I
        os_text_cell(x + 2, y, 84, color); // T
        return 3;
    }
    // STOPPED
    if state - 6 == 0 {
        os_text_cell(x,     y, 83, color); // S
        os_text_cell(x + 1, y, 84, color); // T
        os_text_cell(x + 2, y, 80, color); // P
        return 3;
    }
    // ZOMBIE
    if state - 7 == 0 {
        os_text_cell(x,     y, 90, color); // Z
        os_text_cell(x + 1, y, 79, color); // O
        os_text_cell(x + 2, y, 77, color); // M
        return 3;
    }
    // KILLING
    if state - 8 == 0 {
        os_text_cell(x,     y, 75, color); // K
        os_text_cell(x + 1, y, 73, color); // I
        os_text_cell(x + 2, y, 76, color); // L
        return 3;
    }
    // CRASHED
    if state - 9 == 0 {
        os_text_cell(x,     y, 67, color); // C
        os_text_cell(x + 1, y, 82, color); // R
        os_text_cell(x + 2, y, 72, color); // H
        return 3;
    }
    // Unknown
    os_text_cell(x,     y, 63, 8); // ?
    return 1;
}

const TM_BTN_KILL: t40 = 10;
const TM_BTN_SUSPEND: t40 = 20;
const TM_BTN_RESUME: t40 = 30;
const TM_BTN_EXIT: t40 = 99;

fn task_draw_kill_button(is_hovered: t40) -> t40 {
    return widget_draw_text_button_text(16, 21, 6, task_seed_label(TM_LABEL_BUF, TM_BTN_KILL), 4, is_hovered, 0, 0, 1);
}

fn task_draw_suspend_button(is_hovered: t40) -> t40 {
    return widget_draw_text_button_text(24, 21, 6, task_seed_label(TM_LABEL_BUF + 10, TM_BTN_SUSPEND), 4, is_hovered, 0, 0, 1);
}

fn task_draw_resume_button(is_hovered: t40) -> t40 {
    return widget_draw_text_button_text(32, 21, 5, task_seed_label(TM_LABEL_BUF + 20, TM_BTN_RESUME), 3, is_hovered, 0, 0, 1);
}

fn task_draw_exit_button(is_hovered: t40) -> t40 {
    return widget_draw_text_button_text(39, 21, 6, task_seed_label(TM_LABEL_BUF + 30, TM_BTN_EXIT), 4, is_hovered, 0, 0, 1);
}

fn task_draw_controls(hovered_btn: t40) -> t40 {
    var bKill: t40 = 0;
    var bSuspend: t40 = 0;
    var bResume: t40 = 0;
    var bExit: t40 = 0;
    if hovered_btn - TM_BTN_KILL == 0 { bKill = 1; }
    if hovered_btn - TM_BTN_SUSPEND == 0 { bSuspend = 1; }
    if hovered_btn - TM_BTN_RESUME == 0 { bResume = 1; }
    if hovered_btn - TM_BTN_EXIT == 0 { bExit = 1; }
    task_draw_kill_button(bKill);
    task_draw_suspend_button(bSuspend);
    task_draw_resume_button(bResume);
    task_draw_exit_button(bExit);
    return 1;
}

// Scratch memory layout:
//   11000 .. 11000 + PROCESS_MAX * 5 - 1  : ps snapshot buffer (5 words per entry)
const TM_PS_BUF: t40 = 11000;
const TM_PS_MAX: t40 = 8;
const TM_PS_WORDS: t40 = 5;
const TM_INFO_BUF: t40 = 11100;
const TM_LABEL_BUF: t40 = 11200;
const TM_LISTBOX_ADDR: t40 = 12000;
const TM_BUTTON_BASE: t40 = 12040;
const TM_BUTTON_CHILDREN_ADDR: t40 = 12300;
const TM_BUTTON_COUNT: t40 = 4;

fn task_widget_button_at_index(index: t40) -> t40 {
    return TM_BUTTON_BASE + index * WIDGET_WORDS;
}

fn task_seed_label(addr: t40, kind: t40) -> t40 {
    if kind - TM_BTN_KILL == 0 {
        unsafe { store(addr + 0, 75); store(addr + 1, 73); store(addr + 2, 76); store(addr + 3, 76); store(addr + 4, 0); }
        return addr;
    }
    if kind - TM_BTN_SUSPEND == 0 {
        unsafe { store(addr + 0, 83); store(addr + 1, 85); store(addr + 2, 83); store(addr + 3, 80); store(addr + 4, 0); }
        return addr;
    }
    if kind - TM_BTN_RESUME == 0 {
        unsafe { store(addr + 0, 82); store(addr + 1, 85); store(addr + 2, 78); store(addr + 3, 0); }
        return addr;
    }
    unsafe { store(addr + 0, 69); store(addr + 1, 88); store(addr + 2, 73); store(addr + 3, 84); store(addr + 4, 0); }
    return addr;
}

fn task_init_button(index: t40, id: t40, x: t40, y: t40, w: t40) -> t40 {
    var addr: t40 = task_widget_button_at_index(index);
    widget_init(addr, WIDGET_KIND_BUTTON, x, y, w, 1, 0, -1);
    widget_store(addr + WIDGET_AUX, id);
    widget_store(TM_BUTTON_CHILDREN_ADDR + index, addr);
    return addr;
}

fn task_init_widgets(count: t40) -> t40 {
    widget_listbox_init(TM_LISTBOX_ADDR, 16, 7, 48, 12, 0, -1, count);
    task_init_button(0, TM_BTN_KILL, 16, 21, 6);
    task_init_button(1, TM_BTN_SUSPEND, 24, 21, 6);
    task_init_button(2, TM_BTN_RESUME, 32, 21, 5);
    task_init_button(3, TM_BTN_EXIT, 39, 21, 6);
    return count;
}

fn task_button_at(mx: t40, my: t40) -> t40 {
    var hit: t40 = widget_panel_route_xy(TM_BUTTON_CHILDREN_ADDR, TM_BUTTON_COUNT, mx, my);
    if hit > 0 {
        return widget_load(hit + WIDGET_AUX);
    }
    return 0;
}

fn task_row_index_at_xy(x: t40, y: t40) -> t40 {
    return widget_listbox_row_at(TM_LISTBOX_ADDR, x, y);
}

fn task_pid_at_index(index: t40) -> t40 {
    if index < 0 {
        return 0;
    }
    var count: t40 = os_ps(TM_PS_BUF, TM_PS_MAX);
    if count <= 0 {
        return 0;
    }
    if index - count >= 0 {
        return 0;
    }
    var pid: t40 = 0;
    unsafe { pid = load(TM_PS_BUF + index * TM_PS_WORDS); }
    return pid;
}

fn task_apply_action(action: t40, selected_pid: t40) -> t40 {
    if selected_pid <= 0 {
        return 0;
    }
    var self_pid: t40 = sys_getpid();
    if selected_pid - self_pid == 0 {
        return 0;
    }
    if action - TM_BTN_KILL == 0 {
        return os_kill(selected_pid, OS_SIGNAL_KILL);
    }
    if action - TM_BTN_SUSPEND == 0 {
        return os_suspend(selected_pid);
    }
    if action - TM_BTN_RESUME == 0 {
        return os_resume(selected_pid);
    }
    return 0;
}

fn task_draw_selected_info(selected_pid: t40) -> t40 {
    os_text_cell(18, 19, 80, 8); // P
    os_text_cell(19, 19, 73, 8); // I
    os_text_cell(20, 19, 68, 8); // D
    if selected_pid <= 0 {
        os_text_cell(22, 19, 45, 8); // -
        return 1;
    }
    task_draw_int(22, 19, selected_pid, 14);
    if os_getproc(selected_pid, TM_INFO_BUF) > 0 {
        var parent_pid: t40 = 0;
        var pending: t40 = 0;
        unsafe {
            parent_pid = load(TM_INFO_BUF + 2);
            pending = load(TM_INFO_BUF + 4);
        }
        os_text_cell(30, 19, 80, 8); // P
        os_text_cell(31, 19, 80, 8); // P
        if parent_pid < 0 {
            os_text_cell(33, 19, 45, 8); // -
        } else {
            task_draw_int(33, 19, parent_pid, 8);
        }
        os_text_cell(42, 19, 83, 8); // S
        os_text_cell(43, 19, 71, 8); // G
        task_draw_int(45, 19, pending, 8);
    }
    return 1;
}

fn task_draw_ui(hovered_btn: t40, selected_pid: t40) -> t40 {

    os_clear_text(0);

    // Title: "SYSTEM TASKS"
    os_text_cell(30, 2, 83, 3); // S
    os_text_cell(31, 2, 89, 3); // Y
    os_text_cell(32, 2, 83, 3); // S
    os_text_cell(33, 2, 84, 3); // T
    os_text_cell(34, 2, 69, 3); // E
    os_text_cell(35, 2, 77, 3); // M
    os_text_cell(36, 2, 32, 3);
    os_text_cell(37, 2, 84, 3); // T
    os_text_cell(38, 2, 65, 3); // A
    os_text_cell(39, 2, 83, 3); // S
    os_text_cell(40, 2, 75, 3); // K
    os_text_cell(41, 2, 83, 3); // S

    // Dashboard frame
    task_draw_box(15, 4, 65, 20, 10);

    // Column headers
    os_text_cell(20, 6, 80, 14); os_text_cell(21, 6, 73, 14); os_text_cell(22, 6, 68, 14); // PID
    os_text_cell(28, 6, 83, 14); os_text_cell(29, 6, 84, 14); os_text_cell(30, 6, 65, 14);
    os_text_cell(31, 6, 84, 14); os_text_cell(32, 6, 69, 14); // STATE
    os_text_cell(40, 6, 80, 14); os_text_cell(41, 6, 82, 14); os_text_cell(42, 6, 73, 14); // PRI
    os_text_cell(50, 6, 81, 14); os_text_cell(51, 6, 85, 14); os_text_cell(52, 6, 79, 14); // QUO

    // Query live process table
    var count: t40 = os_ps(TM_PS_BUF, TM_PS_MAX);
    if count < 0 { count = 0; }
    task_init_widgets(count);
    widget_draw_text_listbox_frame(TM_LISTBOX_ADDR);
    widget_text_fill(17, 8, 45, 10, 32, 0);

    var row_y: t40 = 8;
    var i: t40 = 0;
    while count - i > 0 {
        if row_y - 18 < 0 {
            var base: t40 = TM_PS_BUF + i * TM_PS_WORDS;
            var entry_pid: t40 = 0;
            var entry_state: t40 = 0;
            var entry_pri: t40 = 0;
            var entry_quo: t40 = 0;
            unsafe {
                entry_pid   = load(base);
                entry_state = load(base + 1);
                entry_pri   = load(base + 2);
                entry_quo   = load(base + 3);
            }
            var row_color: t40 = 10;
            if entry_pid - selected_pid == 0 {
                row_color = 14;
                os_text_cell(18, row_y, 62, row_color);
            }
            task_draw_int(21, row_y, entry_pid, row_color);
            task_draw_state(28, row_y, entry_state);
            task_draw_int(40, row_y, entry_pri, row_color);
            task_draw_int(50, row_y, entry_quo, row_color);
            row_y = row_y + 1;
        }
        i = i + 1;
    }

    task_draw_selected_info(selected_pid);

    task_draw_controls(hovered_btn);
    return 1;
}

fn main() -> t40 {
    var in_kernel: t40 = 0;
    unsafe { in_kernel = csr_read(scratch); }
    if in_kernel == 0 {
        // Standalone test mode
        os_clear_text(0);
        os_text_cell(0, 0, 84, 10); os_text_cell(1, 0, 65, 10); os_text_cell(2, 0, 83, 10);
        os_text_cell(3, 0, 75, 10); os_text_cell(4, 0, 83, 10);
        os_putc(84); os_putc(65); os_putc(83); os_putc(75); os_putc(83); os_newline();
        return 1;
    }

    os_gpu_mode(0);

    var hovered_btn: t40 = 0;
    var selected_pid: t40 = 0;
    task_draw_ui(hovered_btn, selected_pid);

    var done: t40 = 0;
    var last_hovered: t40 = 0;
    var event_addr: t40 = 10100;
    var event_status: t40 = 0;
    var event_kind: t40 = 0;
    var mx: t40 = 0;
    var my: t40 = 0;
    var btn: t40 = 0;
    var k: t40 = 0;

    while 1 - done > 0 {
        k = 0;
        event_status = os_wait_event(-1, event_addr, 2000);
        if event_status > 0 {
            event_kind = os_event_kind(event_addr);
            if event_kind - OS_EVENT_KIND_MOUSE == 0 {
                mx = os_event_x_or_key(event_addr);
                my = os_event_y(event_addr);
                btn = os_event_modifiers(event_addr);
            }
            if event_kind - OS_EVENT_KIND_KEY == 0 {
                k = os_event_x_or_key(event_addr);
            }
            if event_kind - OS_EVENT_KIND_CLOSE == 0 {
                done = 1;
            }
        } else {
            task_draw_ui(last_hovered, selected_pid);
        }

        os_sprite(mx, my, 43, 14); // '+' cursor

        var current_hover: t40 = task_button_at(mx, my);

        if current_hover - last_hovered != 0 {
            task_draw_ui(current_hover, selected_pid);
            last_hovered = current_hover;
        }

        var click: t40 = 0;
        var row_index: t40 = -1;
        var row_pid: t40 = 0;
        if btn - 1 == 0 {
            if current_hover > 0 {
                click = current_hover;
            } else {
                row_index = task_row_index_at_xy(mx, my);
                row_pid = task_pid_at_index(row_index);
                if row_pid > 0 {
                    selected_pid = row_pid;
                    task_draw_ui(last_hovered, selected_pid);
                }
            }
        }

        if k > 0 {
            if k - 120 == 0 { click = TM_BTN_EXIT; } // 'x'
            if k - 88 == 0 { click = TM_BTN_EXIT; }  // 'X'
            if k - 107 == 0 { click = TM_BTN_KILL; } // 'k'
            if k - 75 == 0 { click = TM_BTN_KILL; }  // 'K'
            if k - 115 == 0 { click = TM_BTN_SUSPEND; } // 's'
            if k - 83 == 0 { click = TM_BTN_SUSPEND; }  // 'S'
            if k - 99 == 0 { click = TM_BTN_RESUME; } // 'c'
            if k - 67 == 0 { click = TM_BTN_RESUME; } // 'C'
            if k - 114 == 0 {               // 'r' -> manual refresh
                task_draw_ui(last_hovered, selected_pid);
            }
        }

        if click - TM_BTN_EXIT == 0 {
            done = 1;
        } else {
            if click > 0 {
                task_apply_action(click, selected_pid);
                task_draw_ui(last_hovered, selected_pid);
            }
        }
    }

    var path_addr: t40 = task_seed_desktop_path(10000);
    sys_exec(path_addr);
    return 2;
}
