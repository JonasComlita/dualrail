// TC-SWE-001 starter defect: the ordering arms are accidentally reversed.
// Keep the three-way result contract used by median3:
// -1 when a < b, 0 when equal, and +1 when a > b.

fn compare(a: t40, b: t40) -> t40 {
    match a - b {
        neg => { return 1; }
        zero => { return 0; }
        pos => { return -1; }
    }
}
