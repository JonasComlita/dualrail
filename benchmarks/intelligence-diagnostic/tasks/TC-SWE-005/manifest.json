{
  "schema": "treatcode.intelligence.benchmark-manifest.diagnostic.v3.1",
  "version": 3.1,
  "task": {
    "id": "TC-SWE-005",
    "title": "Repair the Syscall Result-Policy Adapter",
    "kind": "mini-repository-repair",
    "description": "Repair a two-file ABI adapter that normalizes kernel status, validates partial results, and applies caller-selected result policies with strict error precedence.",
    "source_root": "src",
    "allowlisted_files": ["src/result_policy.trit", "src/syscall_adapter.trit"],
    "max_file_bytes": 65536,
    "trial_count": 4,
    "difficulty": "hard",
    "capabilities": ["multi-file reasoning", "ABI status normalization", "error precedence", "policy dispatch", "bounded values"],
    "score": { "formula": "passed / 4 * 100", "unit": "percent", "minimum_trial_count": 4 },
    "runner": { "kind": "trit-scalar-return", "entrypoint": "adapt_syscall", "arity": 3 },
    "contract": {
      "status": "Negative status is a kernel error and passes through unchanged. Status 0 is complete, status 1 is partial, and status greater than 1 is invalid.",
      "partial": "A partial result requires a nonnegative value; a negative partial value returns -3.",
      "policies": "Policy 0 returns raw value; 1 requires nonnegative; 2 clamps to [-729,729]; 3 booleanizes zero to 0 and nonzero to 1.",
      "precedence": "Kernel error (-N) precedes all validation; invalid status returns -2; invalid partial/nonnegative value returns -3; invalid policy returns -4."
    }
  },
  "public_tests": {
    "schema": "treatcode.intelligence.public-tests.diagnostic.v3.1",
    "metadata_path": "tests/public.metadata.json",
    "cases": [
      { "id": "public-kernel-precedence", "name": "kernel error ignores invalid policy", "a": -1, "b": 7, "c": 99, "expected": -1 },
      { "id": "public-raw-negative", "name": "complete raw negative", "a": 0, "b": -8, "c": 0, "expected": -8 },
      { "id": "public-nonnegative-reject", "name": "nonnegative policy rejects negative", "a": 0, "b": -8, "c": 1, "expected": -3 },
      { "id": "public-clamp-high", "name": "clamp high result", "a": 0, "b": 1000, "c": 2, "expected": 729 },
      { "id": "public-partial", "name": "valid partial result", "a": 1, "b": 5, "c": 0, "expected": 5 },
      { "id": "public-invalid-status", "name": "invalid positive status", "a": 2, "b": 5, "c": 0, "expected": -2 },
      { "id": "public-bool-zero", "name": "booleanize zero", "a": 0, "b": 0, "c": 3, "expected": 0 },
      { "id": "public-bool-negative", "name": "booleanize negative", "a": 0, "b": -1, "c": 3, "expected": 1 }
    ]
  },
