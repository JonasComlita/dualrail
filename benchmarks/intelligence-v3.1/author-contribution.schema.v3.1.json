{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence/author-contribution.v3.1.json",
  "title": "TreatCode Intelligence v3.1 independently authored candidate contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "shard_id", "authorship", "tasks"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.author-contribution.v3.1" },
    "version": { "const": "3.1" },
    "shard_id": { "type": "string", "pattern": "^V31-SHARD-[0-9]{3}$" },
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributor_id", "contributor_kind", "model", "reasoning_effort", "completed_at", "attestation"],
      "properties": {
        "contributor_id": { "type": "string", "minLength": 3 },
        "contributor_kind": { "const": "model_agent" },
        "model": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "not": { "pattern": "^gpt-5\\.6-(?:luna|sol)(?:$|[-.])" } },
        "reasoning_effort": { "type": "string", "minLength": 2 },
        "completed_at": { "type": "string", "format": "date-time" },
        "attestation": { "type": "string", "minLength": 40 }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "track", "category", "title", "initial_signal", "participant_files", "editable_files", "mutations", "distractor_files", "public_signal", "focused_suites", "focused_targets", "required_interaction", "invariant", "hidden_test_rationale", "design_features"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^TC-V31-FINAL-[0-9]{3}$" },
        "track": { "enum": ["fresh_coding", "repository_repair", "terminal_agent", "expert_reasoning", "frontier_math", "abstract_generalization", "multimodal_reasoning", "web_research"] },
        "category": { "enum": ["algorithm_and_data_structure", "balanced_ternary_and_numeric", "compiler_and_codegen", "memory_and_pointer_safety", "concurrency_and_state", "syscall_and_abi", "multi_module_repository_repair", "build_test_and_tooling", "performance_and_resource_constraints"] },
        "title": { "type": "string", "minLength": 12 },
        "initial_signal": { "type": "string", "minLength": 12 },
        "participant_files": { "type": "array", "minItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "editable_files": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "mutations": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/mutation" } },
        "distractor_files": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "public_signal": { "type": "string", "minLength": 8 },
        "focused_suites": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
        "focused_targets": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" } },
        "required_interaction": { "type": "string", "minLength": 12 },
        "invariant": { "type": "string", "minLength": 12 },
        "hidden_test_rationale": { "type": "string", "minLength": 12 },
        "design_features": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_exploration_required", "multi_module_change", "misleading_or_incomplete_tests", "conflicting_invariants", "initial_build_failure", "abi_or_integration_bug", "performance_constraint"],
          "properties": {
            "repository_exploration_required": { "const": true },
            "multi_module_change": { "type": "boolean" },
            "misleading_or_incomplete_tests": { "type": "boolean" },
            "conflicting_invariants": { "type": "boolean" },
            "initial_build_failure": { "type": "boolean" },
            "abi_or_integration_bug": { "type": "boolean" },
            "performance_constraint": { "type": "boolean" }
          }
        }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "before", "after", "invariant", "hidden_test_rationale"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "before": { "type": "string", "minLength": 1 },
        "after": { "type": "string", "minLength": 1 },
        "invariant": { "type": "string", "minLength": 12 },
        "hidden_test_rationale": { "type": "string", "minLength": 12 }
      }
    },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$" }
  }
}
