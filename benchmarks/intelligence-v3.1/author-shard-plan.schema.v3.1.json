{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence/author-shard-plan.v3.1.json",
  "title": "TreatCode Intelligence v3.1 recoverable author shard plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "status", "task_count", "shard_count", "tasks_per_shard", "contribution_file_pattern", "subject_model_families_excluded", "category_mix", "track_mix", "default_feature_minimums_per_shard", "feature_bonus_shards", "shards"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.author-shard-plan.v3.1" },
    "version": { "const": "3.1" },
    "status": { "const": "development_assignment_plan" },
    "task_count": { "const": 100 },
    "shard_count": { "const": 20 },
    "tasks_per_shard": { "const": 5 },
    "contribution_file_pattern": { "const": "<shard_id>.json" },
    "subject_model_families_excluded": { "type": "array", "const": ["gpt-5.6-luna", "gpt-5.6-sol"] },
    "category_mix": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "track_mix": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "default_feature_minimums_per_shard": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 5 } },
    "feature_bonus_shards": { "type": "object", "additionalProperties": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/shardId" } } },
    "shards": { "type": "array", "minItems": 20, "maxItems": 20, "items": { "$ref": "#/$defs/shard" } }
  },
  "$defs": {
    "shardId": { "type": "string", "pattern": "^V31-SHARD-[0-9]{3}$" },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shard_id", "first_task_number", "categories", "tracks"],
      "properties": {
        "shard_id": { "$ref": "#/$defs/shardId" },
        "first_task_number": { "type": "integer", "minimum": 1, "maximum": 96 },
        "categories": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "minLength": 3 } },
        "tracks": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "enum": ["fresh_coding", "repository_repair", "terminal_agent", "expert_reasoning", "frontier_math", "abstract_generalization", "multimodal_reasoning", "web_research"] } }
      }
    }
  }
}
