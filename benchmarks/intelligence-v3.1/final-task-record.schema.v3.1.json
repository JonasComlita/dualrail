{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence/final-task-record.v3.1.json",
  "title": "TreatCode Intelligence v3.1 final task provenance and calibration record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "task_id", "track", "category", "design_features", "participant_bundle_hash", "grader_bundle_hash", "authorship", "reviews", "qualification", "calibration", "status", "official"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.final-task-record.v3.1" },
    "version": { "const": "3.1" },
    "task_id": { "type": "string", "pattern": "^TC-V31-FINAL-[0-9]{3}$" },
    "track": { "enum": ["fresh_coding", "repository_repair", "terminal_agent", "expert_reasoning", "frontier_math", "abstract_generalization", "multimodal_reasoning", "web_research"] },
    "category": { "type": "string", "minLength": 1 },
    "design_features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_exploration_required", "multi_module_change", "misleading_or_incomplete_tests", "conflicting_invariants", "initial_build_failure", "abi_or_integration_bug", "performance_constraint"],
      "properties": {
        "repository_exploration_required": { "const": true },
        "multi_module_change": { "type": "boolean" },
        "misleading_or_incomplete_tests": { "type": "boolean" },
        "conflicting_invariants": { "type": "boolean" },
        "initial_build_failure": { "type": "boolean" },
        "abi_or_integration_bug": { "type": "boolean" },
        "performance_constraint": { "type": "boolean" }
      }
    },
    "participant_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "grader_bundle_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authorship": { "$ref": "#/$defs/contribution" },
    "reviews": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/review" }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_passed", "starter_failed", "mutants_caught", "mutants_total", "evidence_hash"],
      "properties": {
        "reference_passed": { "type": "boolean" },
        "starter_failed": { "type": "boolean" },
        "mutants_caught": { "type": "integer", "minimum": 0 },
        "mutants_total": { "type": "integer", "minimum": 1 },
        "evidence_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "observation_count", "item_discrimination", "cohort_pass_rates_ordered", "evidence_hash"],
      "properties": {
        "complete": { "type": "boolean" },
        "observation_count": { "type": "integer", "minimum": 0 },
        "item_discrimination": { "type": ["number", "null"] },
        "cohort_pass_rates_ordered": { "type": "boolean" },
        "evidence_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "status": { "enum": ["candidate", "rejected", "accepted", "frozen"] },
    "official": { "type": "boolean" }
  },
  "$defs": {
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributor_id", "contributor_kind", "completed_at", "attestation_hash"],
      "properties": {
        "contributor_id": { "type": "string", "minLength": 3 },
        "contributor_kind": { "enum": ["human", "model_agent"] },
        "completed_at": { "type": "string", "format": "date-time" },
        "attestation_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewer_kind", "decision", "completed_at", "review_hash"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "reviewer_kind": { "enum": ["human", "model_agent"] },
        "decision": { "enum": ["approve", "reject"] },
        "completed_at": { "type": "string", "format": "date-time" },
        "review_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
