{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence/infrastructure-attestation.v3.1.json",
  "title": "TreatCode Intelligence v3.1 signed infrastructure attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "payload", "signature_base64"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.infrastructure-attestation.v3.1" },
    "version": { "const": "3.1" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "provider_id", "key_id", "verified_at", "expires_at", "network_isolation", "resource_isolation", "evidence_store"],
      "properties": {
        "schema": { "const": "treatcode.intelligence.infrastructure-attestation-payload.v3.1" },
        "version": { "const": "3.1" },
        "provider_id": { "$ref": "#/$defs/id" },
        "key_id": { "$ref": "#/$defs/id" },
        "verified_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "network_isolation": { "$ref": "#/$defs/network" },
        "resource_isolation": { "$ref": "#/$defs/resource" },
        "evidence_store": { "$ref": "#/$defs/store" }
      }
    },
    "signature_base64": { "type": "string", "minLength": 80, "maxLength": 100 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "network": { "type": "object", "additionalProperties": false, "required": ["enforcement", "provider", "evidence_sha256"], "properties": { "enforcement": { "const": "verified_os_or_container" }, "provider": { "$ref": "#/$defs/id" }, "evidence_sha256": { "$ref": "#/$defs/hash" } } },
    "resource": { "type": "object", "additionalProperties": false, "required": ["enforcement", "provider", "evidence_sha256"], "properties": { "enforcement": { "const": "verified_os_or_container" }, "provider": { "$ref": "#/$defs/id" }, "evidence_sha256": { "$ref": "#/$defs/hash" } } },
    "store": { "type": "object", "additionalProperties": false, "required": ["enforcement", "provider", "evidence_sha256"], "properties": { "enforcement": { "const": "verified_append_only" }, "provider": { "$ref": "#/$defs/id" }, "evidence_sha256": { "$ref": "#/$defs/hash" } } }
  }
}
