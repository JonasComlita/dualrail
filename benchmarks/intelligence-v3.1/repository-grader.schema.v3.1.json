{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence/repository-grader.v3.1.json",
  "title": "TreatCode Intelligence v3.1 privileged repository grader",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "task_id", "participant_manifest_sha256", "baseline_bundle_sha256", "suites"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.repository-grader.v3.1" },
    "version": { "const": "3.1" },
    "task_id": { "type": "string", "pattern": "^TC-V31-[A-Z0-9-]+$" },
    "participant_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "baseline_bundle_sha256": { "$ref": "#/$defs/sha256" },
    "suites": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "command_id", "required"],
        "properties": {
          "id": { "$ref": "#/$defs/commandId" },
          "kind": { "enum": ["behavioral", "adversarial", "performance"] },
          "command_id": { "$ref": "#/$defs/commandId" },
          "required": { "const": true }
        }
      }
    }
  },
  "$defs": {
    "commandId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
