{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence/repository-task.v3.1.json",
  "title": "TreatCode Intelligence v3.1 repository task",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "task_id", "title", "phase", "initial_signal", "known_failing_command_id", "public_command_ids", "required_trit_change", "files", "limits"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.repository-task.v3.1" },
    "version": { "const": "3.1" },
    "task_id": { "type": "string", "pattern": "^TC-V31-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "phase": { "enum": ["diagnostic", "pilot", "calibration", "frozen", "official"] },
    "initial_signal": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "known_failing_command_id": { "$ref": "#/$defs/commandId" },
    "public_command_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/commandId" } },
    "required_trit_change": { "const": true },
    "files": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "editable", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/safeRelativePath" },
          "editable": { "type": "boolean" },
          "sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_ms", "cpu_ms", "memory_mb", "process_count", "output_bytes", "maximum_changed_files"],
      "properties": {
        "wall_clock_ms": { "type": "integer", "minimum": 1, "maximum": 1200000 },
        "cpu_ms": { "type": "integer", "minimum": 1, "maximum": 1200000 },
        "memory_mb": { "type": "integer", "minimum": 1, "maximum": 2048 },
        "process_count": { "type": "integer", "minimum": 1, "maximum": 32 },
        "output_bytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "maximum_changed_files": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "commandId": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "safeRelativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*(?:^|[/\\\\])\\.(?:[/\\\\]|$))[^\\u0000]+$" }
  }
}
