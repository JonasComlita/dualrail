{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence/review-contribution.v3.1.json",
  "title": "TreatCode Intelligence v3.1 independent task review contribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "reviewer", "reviewed_shard_id", "reviewed_contribution_sha256", "reviews"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.review-contribution.v3.1" },
    "version": { "const": "3.1" },
    "reviewed_shard_id": { "type": "string", "pattern": "^V31-SHARD-[0-9]{3}$" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewer_kind", "model", "reasoning_effort", "completed_at", "attestation"],
      "properties": {
        "reviewer_id": { "type": "string", "minLength": 3 },
        "reviewer_kind": { "const": "model_agent" },
        "model": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$", "not": { "pattern": "^gpt-5\\.6-(?:luna|sol)(?:$|[-.])" } },
        "reasoning_effort": { "type": "string", "minLength": 2 },
        "completed_at": { "type": "string", "format": "date-time" },
        "attestation": { "type": "string", "minLength": 40 }
      }
    },
    "reviewed_contribution_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reviews": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "decision", "source_anchor_valid", "semantic_alignment", "cross_module_interaction", "hidden_tests_nontrivial", "feature_claims_supported", "findings"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TC-V31-FINAL-[0-9]{3}$" },
          "decision": { "enum": ["approve", "reject"] },
          "source_anchor_valid": { "type": "boolean" },
          "semantic_alignment": { "type": "boolean" },
          "cross_module_interaction": { "type": "boolean" },
          "hidden_tests_nontrivial": { "type": "boolean" },
          "feature_claims_supported": { "type": "boolean" },
          "findings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } }
        }
      }
    }
  }
}
