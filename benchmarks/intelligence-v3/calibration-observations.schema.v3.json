{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence-calibration-observations.v3.json",
  "title": "TreatCode Intelligence V3 Pilot Calibration Observations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "candidate_manifest_hash", "task_ids", "observations"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.calibration-observations.v3" },
    "version": { "const": 3 },
    "candidate_manifest_hash": { "$ref": "#/$defs/hash" },
    "task_ids": { "type": "array", "minItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^TC-V3-[0-9]{3}$" } },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "cohort", "model_id", "configuration_id", "run_index", "run_id", "attempt_count", "fresh_context", "passed", "task_release_hash", "artifact_hash"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^TC-V3-[0-9]{3}$" },
          "cohort": { "enum": ["weak", "medium", "frontier"] },
          "model_id": { "type": "string", "minLength": 1 },
          "configuration_id": { "type": "string", "minLength": 1 },
          "run_index": { "type": "integer", "minimum": 1 },
          "run_id": { "type": "string", "minLength": 1 },
          "attempt_count": { "const": 1 },
          "fresh_context": { "const": true },
          "passed": { "type": "boolean" },
          "task_release_hash": { "$ref": "#/$defs/hash" },
          "artifact_hash": { "$ref": "#/$defs/hash" }
        }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^(sha256:)?[a-fA-F0-9]{64}$" } }
}
