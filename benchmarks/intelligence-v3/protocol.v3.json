{
  "schema": "treatcode.intelligence.protocol.v3",
  "version": 3,
  "title": "TreatCode Intelligence Repository Repair Benchmark v3",
  "status": "development",
  "score_scope": "independent_repository_task_pass_rate",
  "headline_metric": "correctness_task_pass_rate",
  "official_requirements": {
    "minimum_distinct_tasks": 100,
    "attempts_per_task": 1,
    "minimum_independent_authors": 10,
    "minimum_reviewers_per_task": 2,
    "require_subject_model_independence": true,
    "require_hidden_grader_isolation": true,
    "require_identical_task_set_for_pairwise_comparison": true,
    "require_complete_suite": true,
    "require_human_calibrated_discussion_rubric": true
  },
  "task_mix": {
    "algorithm_and_data_structure": 15,
    "balanced_ternary_and_numeric": 10,
    "compiler_and_codegen": 15,
    "memory_and_pointer_safety": 10,
    "concurrency_and_state": 10,
    "syscall_and_abi": 10,
    "multi_module_repository_repair": 15,
    "build_test_and_tooling": 10,
    "performance_and_resource_constraints": 5
  },
  "task_design_coverage": {
    "repository_exploration_required": 100,
    "multi_module_change": 60,
    "initial_build_failure": 20,
    "misleading_or_incomplete_tests": 25,
    "performance_constraint": 15,
    "abi_or_integration_bug": 20,
    "conflicting_invariants": 30
  },
  "attempt": {
    "fresh_context": true,
    "clock_starts_before_task_release": true,
    "public_tests_repeatable": true,
    "hidden_submission_limit": 1,
    "hidden_results_release": "after_suite_freeze",
    "cross_task_memory": "disabled",
    "solution_reuse": "prohibited"
  },
  "budgets": {
    "wall_clock_ms": 1200000,
    "tool_calls": 160,
    "input_tokens": 200000,
    "output_tokens": 60000,
    "repository_reads": 400,
    "test_runs": 40,
    "patch_attempts": 30
  },
  "isolation": {
    "participant_bundle_contains_hidden_graders": false,
    "participant_bundle_contains_reference_solutions": false,
    "grader_root_must_be_outside_participant_root": true,
    "grader_access_identity": "privileged-service-only",
    "network": "task-manifest-controlled",
    "record_file_reads": true,
    "record_processes": true,
    "record_tool_calls": true
  },
  "dimensions": {
    "correctness": {
      "weight": 0.7,
      "metric": "task_pass_rate",
      "all_required_hidden_suites_must_pass": true
    },
    "robustness": {
      "weight": 0.15,
      "metric": "adversarial_suite_pass_rate"
    },
    "efficiency": {
      "weight": 0.1,
      "metric": "budget_normalized_efficiency",
      "requires_correctness": true
    },
    "agent_execution": {
      "weight": 0.05,
      "metric": "valid_action_and_budget_compliance"
    },
    "discussion": {
      "weight": 0,
      "metric": "human_calibrated_secondary_rubric",
      "length_controlled": true,
      "maximum_words": 400
    }
  },
  "statistics": {
    "confidence_level": 0.95,
    "bootstrap_iterations": 10000,
    "bootstrap_unit": "task",
    "pairwise_method": "paired_task_bootstrap_and_exact_sign_test",
    "report_confidence_intervals": true,
    "report_task_level_matrix": true,
    "ceiling_threshold": 0.9,
    "floor_threshold": 0.1,
    "maximum_ceiling_fraction": 0.15,
    "maximum_floor_fraction": 0.15,
    "minimum_item_discrimination": 0.1
  },
  "calibration": {
    "required_cohorts": ["weak", "medium", "frontier"],
    "minimum_models_per_cohort": 2,
    "minimum_runs_per_configuration": 3,
    "remove_or_revise_non_discriminating_tasks": true,
    "freeze_holdout_before_subject_runs": true,
    "status": "not_started"
  }
}
