{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence-provenance-bundle.v3.json",
  "title": "TreatCode Intelligence V3 Signed Authorship and Review Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "task_id", "participant_bundle_hash", "grader_bundle_hash", "author", "reviews"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.provenance-bundle.v3" },
    "version": { "const": 3 },
    "task_id": { "$ref": "#/$defs/task_id" },
    "participant_bundle_hash": { "$ref": "#/$defs/hash" },
    "grader_bundle_hash": { "$ref": "#/$defs/hash" },
    "author": { "$ref": "#/$defs/author_attestation" },
    "reviews": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/review_attestation" } }
  },
  "$defs": {
    "task_id": { "type": "string", "pattern": "^TC-V3-[0-9]{3}$" },
    "hash": { "type": "string", "pattern": "^(sha256:)?[a-fA-F0-9]{64}$" },
    "signature": {
      "type": "object",
      "required": ["identity_id", "algorithm", "payload", "signature_base64"],
      "properties": {
        "identity_id": { "type": "string", "minLength": 1 },
        "algorithm": { "const": "ed25519" },
        "signature_base64": { "type": "string", "minLength": 16 }
      }
    },
    "author_attestation": {
      "allOf": [
        { "$ref": "#/$defs/signature" },
        { "properties": { "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "task_id", "identity_id", "participant_bundle_hash", "grader_bundle_hash", "independently_created", "no_subject_rollout_access", "subject_model_families_excluded", "conflict_disclosure", "completed_at"],
          "properties": {
            "role": { "const": "author" }, "task_id": { "$ref": "#/$defs/task_id" }, "identity_id": { "type": "string", "minLength": 1 },
            "participant_bundle_hash": { "$ref": "#/$defs/hash" }, "grader_bundle_hash": { "$ref": "#/$defs/hash" },
            "independently_created": { "const": true }, "no_subject_rollout_access": { "const": true },
            "subject_model_families_excluded": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "conflict_disclosure": { "type": "string", "minLength": 1 }, "completed_at": { "type": "string", "format": "date-time" }
          }
        } } }
      ]
    },
    "review_attestation": {
      "allOf": [
        { "$ref": "#/$defs/signature" },
        { "properties": { "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "task_id", "identity_id", "participant_bundle_hash", "grader_bundle_hash", "independent_of_author", "independent_of_subject_models", "conflict_disclosure", "checklist", "decision", "reviewed_at"],
          "properties": {
            "role": { "const": "reviewer" }, "task_id": { "$ref": "#/$defs/task_id" }, "identity_id": { "type": "string", "minLength": 1 },
            "participant_bundle_hash": { "$ref": "#/$defs/hash" }, "grader_bundle_hash": { "$ref": "#/$defs/hash" },
            "independent_of_author": { "const": true }, "independent_of_subject_models": { "const": true },
            "conflict_disclosure": { "type": "string", "minLength": 1 }, "decision": { "enum": ["approve", "reject"] }, "reviewed_at": { "type": "string", "format": "date-time" },
            "checklist": {
              "type": "object", "additionalProperties": false,
              "required": ["symptom_is_appropriately_underspecified", "reference_behavior_is_correct", "hidden_grader_is_behavioral_and_adversarial", "participant_bundle_has_no_grader_or_answer_leakage", "budgets_are_feasible", "task_requires_repository_level_reasoning"],
              "properties": {
                "symptom_is_appropriately_underspecified": { "const": true }, "reference_behavior_is_correct": { "const": true },
                "hidden_grader_is_behavioral_and_adversarial": { "const": true }, "participant_bundle_has_no_grader_or_answer_leakage": { "const": true },
                "budgets_are_feasible": { "const": true }, "task_requires_repository_level_reasoning": { "const": true }
              }
            }
          }
        } } }
      ]
    }
  }
}
