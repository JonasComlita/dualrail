// Starter defect: assumes the left interval starts first and performs an unchecked
// successor comparison, so reversed and boundary cases are mishandled.

fn merge_touching(left: t40, right: t40) -> t40 {
    let left_start: t40 = interval_start(left);
    let left_end: t40 = interval_end(left);
    let right_start: t40 = interval_start(right);
    let right_end: t40 = interval_end(right);
    if left_start > left_end { return -2; }
    if right_start > right_end { return -2; }
    if right_start > left_end + 1 { return -1; }
    var merged_end: t40 = left_end;
    if right_end > merged_end { merged_end = right_end; }
    return pack_interval(left_start, merged_end);
}
