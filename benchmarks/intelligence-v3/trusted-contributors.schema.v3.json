{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.local/schemas/intelligence-trusted-contributors.v3.json",
  "title": "TreatCode Intelligence V3 Trusted Contributor Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "keys", "approved_by", "approved_at"],
  "properties": {
    "schema": { "const": "treatcode.intelligence.trusted-contributors.v3" },
    "version": { "const": 3 },
    "keys": {
      "type": "object",
      "minProperties": 12,
      "propertyNames": { "pattern": "^[A-Za-z0-9._-]+$" },
      "additionalProperties": { "type": "string", "pattern": "^-----BEGIN PUBLIC KEY-----" }
    },
    "approved_by": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "approved_at": { "type": "string", "format": "date-time" }
  }
}
