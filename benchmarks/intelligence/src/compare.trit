// TC-SWE-001 starter defect: the ordering arms are accidentally reversed.
// Keep the compare(a, b) signature while repairing the three-way result:
// negative when a < b, zero when equal, positive when a > b.

fn compare(a: t40, b: t40) -> t40 {
    match a - b {
        neg => { return 1; }
        zero => { return 0; }
        pos => { return -1; }
    }
}
