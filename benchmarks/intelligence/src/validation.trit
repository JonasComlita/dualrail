// TC-SWE-001 reading contract:
//   - valid sensor values are in [-729, 729]
//   - -1000 is the missing-reading sentinel
//   - every other value is invalid
// Starter defects: the missing sentinel is inverted and the range is not
// checked. Preserve the 1=true / 0=false helper convention.

fn is_missing(reading: t40) -> t40 {
    if reading == 1000 { return 1; }
    return 0;
}

fn is_valid_reading(reading: t40) -> t40 {
    return 1;
}
