{
  "schema": "treatcode.intelligence.benchmark-manifest.v1",
  "version": 2,
  "task": {
    "id": "TC-SWE-002",
    "title": "Repair the Checked Balanced-Ternary Token Codec",
    "kind": "mini-repository-repair",
    "description": "Repair a two-file codec for tokens 0..26, interpreted as three base-3 encoded balanced trits (encoded digit 0/1/2 means -1/0/+1). Validate the token first (-102), then its claimed balanced-digit checksum (-100), then mode (-101). Mode 0 round-trips the token, mode 1 returns its balanced numeric value, and mode 2 rotates [low, middle, high] to [middle, high, low].",
    "difficulty": "hard",
    "capabilities": ["multi-file reasoning", "base-3 decomposition", "balanced ternary", "checksum validation", "error precedence", "serialization"],
    "source_root": "src",
    "allowlisted_files": ["src/trit_digits.trit", "src/parser.trit"],
    "max_file_bytes": 65536,
    "trial_count": 4,
    "score": { "formula": "passed / 4 * 100", "unit": "percent", "minimum_trial_count": 4 },
    "runner": { "kind": "trit-scalar-return", "entrypoint": "token_codec", "arity": 3 }
  },
  "public_tests": { "schema": "treatcode.intelligence.public-tests.v1", "metadata_path": "tests/public.metadata.v1.json", "cases": [
    { "id": "public-zero-roundtrip", "name": "zero-balanced token round trip", "a": 13, "b": 0, "c": 0, "expected": 13 },
    { "id": "public-zero-value", "name": "zero-balanced numeric value", "a": 13, "b": 0, "c": 1, "expected": 0 },
    { "id": "public-mixed-value", "name": "mixed balanced numeric value", "a": 5, "b": 0, "c": 1, "expected": -8 },
    { "id": "public-rotate", "name": "rotate encoded trits", "a": 5, "b": 0, "c": 2, "expected": 19 },
    { "id": "public-checksum", "name": "checksum mismatch", "a": 5, "b": 1, "c": 0, "expected": -100 },
    { "id": "public-mode", "name": "unsupported mode", "a": 13, "b": 0, "c": 3, "expected": -101 },
    { "id": "public-token", "name": "out-of-range token", "a": 27, "b": 0, "c": 0, "expected": -102 }
  ] },
  "hidden_tests": { "schema": "treatcode.intelligence.hidden-tests.v1", "server_only": true, "path": "tests/hidden.server.v1.json", "case_count": 28, "suites": [
    { "id": "round-trip", "case_count": 8 },
    { "id": "balanced-values", "case_count": 6 },
