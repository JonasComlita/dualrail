// Only alignments 1, 3, and 9 are supported. is_aligned must use arithmetic
// equality after range validation; starter defects accept every positive
// alignment and round the address in the wrong direction.

fn valid_alignment(alignment: t40) -> t40 {
    if alignment > 0 { return 1; }
    return 0;
}

fn is_aligned(address: t40, alignment: t40) -> t40 {
    if (address / alignment) * alignment != address { return 1; }
    return 0;
}
