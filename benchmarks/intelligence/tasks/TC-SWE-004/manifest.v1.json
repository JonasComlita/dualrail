    "capabilities": ["multi-file reasoning", "ordered composition", "state machine", "saturation", "sentinel errors", "short-circuiting"],
    "source_root": "src",
    "allowlisted_files": ["src/events.trit", "src/state_transition.trit"],
    "max_file_bytes": 65536,
    "trial_count": 4,
    "score": { "formula": "passed / 4 * 100", "unit": "percent", "minimum_trial_count": 4 },
    "runner": { "kind": "trit-scalar-return", "entrypoint": "apply_two_events", "arity": 3 }
  },
  "public_tests": { "schema": "treatcode.intelligence.public-tests.v1", "metadata_path": "tests/public.metadata.v1.json", "cases": [
