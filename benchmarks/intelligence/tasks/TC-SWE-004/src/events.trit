// Event codes: -2 reset, -1 decrement, 0 preserve, +1 increment, +2 toggle
// sign. State is always in [-9,9] once validated. Increment/decrement saturate.
// Starter defects swap reset/toggle and let increments escape the upper bound.

fn valid_event(event: t40) -> t40 {
    if event < -2 { return 0; }
    if event > 2 { return 0; }
    return 1;
}

fn apply_event(state: t40, event: t40) -> t40 {
    if valid_event(event) == 0 { return -27; }
    if event == -2 { return 0 - state; }
    if event == -1 { return state - 1; }
    if event == 0 { return state; }
    if event == 1 { return state + 1; }
    return 0;
}
