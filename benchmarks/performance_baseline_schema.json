{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.dev/schemas/performance_baseline.v1.schema.json",
  "version": 1,
  "title": "Trit reproducible performance baseline",
  "type": "object",
  "required": [
    "schema",
    "protocol_id",
    "captured_at_utc",
    "source",
    "host",
    "workload",
    "protocol",
    "metrics",
    "reproducibility",
    "policy"
  ],
  "properties": {
    "schema": { "const": "trit.performance_baseline.v1" },
    "protocol_id": { "const": "p10.performance-baseline.v1" },
    "captured_at_utc": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/source" },
    "host": { "$ref": "#/$defs/host" },
    "workload": { "$ref": "#/$defs/workload" },
    "protocol": { "$ref": "#/$defs/protocol" },
    "metrics": {
      "type": "object",
      "required": [
        "boot_events",
        "app_launch_events",
        "frames_presented",
        "disk_read_bytes",
        "disk_write_bytes",
        "disk_read_operations",
        "disk_write_operations",
        "context_switches",
        "boot_time_ms",
        "app_launch_time_ms",
        "frame_time_ms",
        "disk_io_time_ms"
      ],
      "properties": {
        "boot_events": { "$ref": "#/$defs/functional_metric" },
        "app_launch_events": { "$ref": "#/$defs/functional_metric" },
        "frames_presented": { "$ref": "#/$defs/functional_metric" },
        "disk_read_bytes": { "$ref": "#/$defs/functional_metric" },
        "disk_write_bytes": { "$ref": "#/$defs/functional_metric" },
        "disk_read_operations": { "$ref": "#/$defs/functional_metric" },
        "disk_write_operations": { "$ref": "#/$defs/functional_metric" },
        "context_switches": { "$ref": "#/$defs/functional_metric" },
        "boot_time_ms": { "$ref": "#/$defs/timing_metric" },
        "app_launch_time_ms": { "$ref": "#/$defs/timing_metric" },
        "frame_time_ms": { "$ref": "#/$defs/timing_metric" },
        "disk_io_time_ms": { "$ref": "#/$defs/timing_metric" },
        "host_context_switches": { "$ref": "#/$defs/host_counter_metric" }
      },
      "additionalProperties": true
    },
    "reproducibility": { "$ref": "#/$defs/reproducibility" },
    "external_evidence": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["repository", "commit", "dirty", "generator"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 },
        "dirty": { "type": "boolean" },
        "generator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "host": {
      "type": "object",
      "required": [
        "system",
        "release",
        "machine",
        "processor",
        "python",
        "fingerprint",
        "controlled",
        "timing_authority"
      ],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "machine": { "type": "string", "minLength": 1 },
        "processor": { "type": "string" },
        "python": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "controlled": { "type": "boolean" },
        "timing_authority": { "const": "advisory" }
      },
      "additionalProperties": true
    },
    "workload": {
      "type": "object",
      "required": ["name", "version", "seed", "frames", "disk_words", "app_words", "app_path"],
      "properties": {
        "name": { "const": "synthetic-os-performance-baseline" },
        "version": { "const": "v1" },
        "seed": { "type": "integer" },
        "frames": { "type": "integer", "minimum": 1 },
        "disk_words": { "type": "integer", "minimum": 1 },
        "app_words": { "type": "integer", "minimum": 1 },
        "app_path": { "const": "/bin/calculator" }
      },
      "additionalProperties": true
    },
    "protocol": {
      "type": "object",
      "required": [
        "warmups",
        "iterations",
        "functional_counts_authoritative",
        "wall_clock_authority",
        "timing_threshold_enforced"
      ],
      "properties": {
        "warmups": { "type": "integer", "minimum": 0 },
        "iterations": { "type": "integer", "minimum": 1 },
        "functional_counts_authoritative": { "const": true },
        "wall_clock_authority": { "const": "advisory" },
        "timing_threshold_enforced": { "const": false }
      },
      "additionalProperties": true
    },
    "functional_metric": {
      "type": "object",
      "required": ["kind", "unit", "value", "deterministic", "authority", "source"],
      "properties": {
        "kind": { "const": "counter" },
        "unit": { "type": "string", "minLength": 1 },
        "value": { "type": "integer", "minimum": 0 },
        "deterministic": { "const": true },
        "authority": { "const": "functional" },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": ["count", "median", "mean", "p95", "minimum", "maximum", "standard_deviation", "coefficient_of_variation"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "median": { "type": ["number", "null"], "minimum": 0 },
        "mean": { "type": ["number", "null"], "minimum": 0 },
        "p95": { "type": ["number", "null"], "minimum": 0 },
        "minimum": { "type": ["number", "null"], "minimum": 0 },
        "maximum": { "type": ["number", "null"], "minimum": 0 },
        "standard_deviation": { "type": ["number", "null"], "minimum": 0 },
        "coefficient_of_variation": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "timing_metric": {
      "type": "object",
      "required": ["kind", "unit", "samples", "summary", "deterministic", "authority", "source"],
      "properties": {
        "kind": { "const": "timing" },
        "unit": { "const": "milliseconds" },
        "samples": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } },
        "summary": { "$ref": "#/$defs/summary" },
        "deterministic": { "const": false },
        "authority": { "const": "advisory" },
        "source": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "host_counter_metric": {
      "type": "object",
      "required": ["kind", "unit", "samples", "summary", "available", "deterministic", "authority", "source"],
      "properties": {
        "kind": { "const": "host_counter" },
        "unit": { "const": "switches" },
        "samples": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "summary": { "$ref": "#/$defs/summary" },
        "available": { "type": "boolean" },
        "deterministic": { "const": false },
        "authority": { "const": "advisory" },
        "source": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
      },
      "additionalProperties": true
    },
    "reproducibility": {
      "type": "object",
      "required": ["input_hash", "expected_hash", "observed_hashes", "observed_hash", "functional_match", "trace_repeatable"],
      "properties": {
        "input_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "expected_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "observed_hashes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
        "observed_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "functional_match": { "const": true },
        "trace_repeatable": { "const": true }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "required": ["functional_metrics", "advisory_metrics", "no_wall_clock_threshold"],
      "properties": {
        "functional_metrics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "advisory_metrics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "no_wall_clock_threshold": { "const": true }
      },
      "additionalProperties": true
    }
  }
}
