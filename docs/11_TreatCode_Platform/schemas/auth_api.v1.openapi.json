{
  "openapi": "3.1.0",
  "info": {
    "title": "TreatCode Identity and Authorization API",
    "version": "1.0.0",
    "description": "Versioned identity, task-scoped authorization, capability discovery, and audit surface for TreatCode P07."
  },
  "paths": {
    "/api/auth/v1": { "get": { "operationId": "authDiscovery", "responses": { "200": { "$ref": "#/components/responses/Envelope" } } } },
    "/api/auth/v1/openapi.json": { "get": { "operationId": "authOpenApi", "responses": { "200": { "description": "This contract" } } } },
    "/api/auth/v1/login": {
      "post": {
        "operationId": "login",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Envelope" }, "401": { "$ref": "#/components/responses/AuthError" } }
      }
    },
    "/api/auth/v1/session": { "get": { "security": [{ "bearerAuth": [] }], "operationId": "session", "responses": { "200": { "$ref": "#/components/responses/Envelope" }, "401": { "$ref": "#/components/responses/AuthError" } } } },
    "/api/auth/v1/capabilities": { "get": { "operationId": "capabilities", "parameters": [{ "$ref": "#/components/parameters/Project" }, { "$ref": "#/components/parameters/Task" }], "responses": { "200": { "$ref": "#/components/responses/Envelope" }, "401": { "$ref": "#/components/responses/AuthError" } } } },
    "/api/auth/v1/check": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "operationId": "authorizeAction",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ActionCheckRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/Envelope" }, "401": { "$ref": "#/components/responses/AuthError" }, "403": { "$ref": "#/components/responses/AuthError" } }
      }
    },
    "/api/auth/v1/tasks": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "operationId": "issueTaskCredential",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskCredentialRequest" } } } },
        "responses": { "201": { "$ref": "#/components/responses/Envelope" }, "401": { "$ref": "#/components/responses/AuthError" }, "403": { "$ref": "#/components/responses/AuthError" } }
      }
    },
    "/api/auth/v1/credentials/{credentialId}/revoke": {
      "post": {
        "security": [{ "bearerAuth": [] }],
        "operationId": "revokeCredential",
        "parameters": [{ "$ref": "#/components/parameters/CredentialId" }],
        "responses": { "200": { "$ref": "#/components/responses/Envelope" }, "401": { "$ref": "#/components/responses/AuthError" }, "403": { "$ref": "#/components/responses/AuthError" } }
      }
    },
    "/api/auth/v1/audit": { "get": { "security": [{ "bearerAuth": [] }], "operationId": "audit", "parameters": [{ "$ref": "#/components/parameters/Project" }, { "$ref": "#/components/parameters/Task" }], "responses": { "200": { "$ref": "#/components/responses/Envelope" }, "401": { "$ref": "#/components/responses/AuthError" }, "403": { "$ref": "#/components/responses/AuthError" } } } },
    "/api/run": { "post": { "security": [{ "bearerAuth": [] }], "operationId": "runChallenge", "responses": { "200": { "description": "Execution result" }, "401": { "$ref": "#/components/responses/AuthError" }, "403": { "$ref": "#/components/responses/AuthError" } } } },
    "/api/submit": { "post": { "security": [{ "bearerAuth": [] }], "operationId": "submitChallenge", "responses": { "200": { "description": "Submission result" }, "401": { "$ref": "#/components/responses/AuthError" }, "403": { "$ref": "#/components/responses/AuthError" } } } }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque-task-credential" } },
    "parameters": {
      "Project": { "name": "project_id", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^tc:project:" } },
      "Task": { "name": "task_id", "in": "query", "required": false, "schema": { "type": "string", "pattern": "^tc:task:" } },
      "CredentialId": { "name": "credentialId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^tc:credential:" } }
    },
    "schemas": {
      "Envelope": { "type": "object", "required": ["schema_version", "data", "meta"], "properties": { "schema_version": { "const": "treatcode.auth.api.v1" }, "data": {}, "meta": { "type": "object" } } },
      "AuthError": { "type": "object", "required": ["schema_version", "error", "meta"], "properties": { "schema_version": { "const": "treatcode.auth.api.v1" }, "error": { "$ref": "#/components/schemas/AuthErrorBody" }, "meta": { "type": "object" } } },
      "AuthErrorBody": { "type": "object", "required": ["code", "reason", "action", "audit_event_id", "retryable"], "properties": { "code": { "type": "string" }, "reason": { "type": "string" }, "action": { "type": "string" }, "project_id": { "type": ["string", "null"] }, "task_id": { "type": ["string", "null"] }, "audit_event_id": { "type": ["string", "null"] }, "retryable": { "type": "boolean" } } },
      "LoginRequest": { "type": "object", "required": ["identity_id", "access_key"], "properties": { "identity_id": { "type": "string", "pattern": "^tc:identity:" }, "access_key": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
      "Action": { "type": "string", "enum": ["read", "workspace", "edit", "test", "benchmark", "artifact", "branch", "commit", "push", "draft_pr", "review", "merge"] },
      "ActionCheckRequest": { "type": "object", "required": ["action"], "properties": { "action": { "$ref": "#/components/schemas/Action" }, "project_id": { "type": "string" }, "task_id": { "type": ["string", "null"] } }, "additionalProperties": false },
      "TaskCredentialRequest": { "type": "object", "required": ["target_identity_id", "project_id", "task_id", "actions"], "properties": { "target_identity_id": { "type": "string", "pattern": "^tc:identity:" }, "project_id": { "type": "string", "pattern": "^tc:project:" }, "task_id": { "type": "string", "pattern": "^tc:task:" }, "actions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/components/schemas/Action" } }, "ttl_seconds": { "type": "integer", "minimum": 30, "maximum": 3600 } }, "additionalProperties": false }
    },
    "responses": {
      "Envelope": { "description": "Versioned auth response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } } } },
      "AuthError": { "description": "Structured authorization denial with audit evidence", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthError" } } } }
    }
  }
}
