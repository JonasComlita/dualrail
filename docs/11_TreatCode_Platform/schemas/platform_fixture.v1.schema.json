{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.dev/schemas/platform_fixture.v1.schema.json",
  "schema_version": "treatcode.platform.fixture.v1",
  "title": "TreatCode platform fixture graph",
  "type": "object",
  "required": ["schema_version", "fixture_id", "description", "entities"],
  "properties": {
    "schema_version": { "const": "treatcode.platform.fixture.v1" },
    "fixture_id": { "type": "string", "pattern": "^tc:fixture:[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "platform_domain.v1.schema.json" }
    }
  },
  "additionalProperties": false
}
