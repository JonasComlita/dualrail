{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treatcode.dev/schemas/treatcode_plan_manifest.v1.schema.json",
  "schema_version": "treatcode.plan-manifest.v1",
  "title": "TreatCode plan control manifest",
  "type": "object",
  "required": ["version", "schema", "plans"],
  "properties": {
    "version": { "const": 1 },
    "schema": { "const": "treatcode.plan-manifest.v1" },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/plan" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "plan_id": { "type": "string", "pattern": "^P[0-9]{2}$" },
    "plan": {
      "type": "object",
      "required": [
        "id",
        "version",
        "path",
        "depends_on",
        "status",
        "verification_commands",
        "required_evidence",
        "required_approvals",
        "gates"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/plan_id" },
        "version": { "type": "integer", "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/plan_id" }, "uniqueItems": true },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "blocked", "complete", "superseded"] },
        "verification_commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "required_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "required_approvals": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "gates": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["structural", "correctness", "security", "performance", "human"] }, "uniqueItems": true },
        "completion_evidence": { "type": "string", "minLength": 1 },
        "verified_commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role", "reviewer", "decision", "date", "commit"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "reviewer": { "type": "string", "minLength": 1 },
              "decision": { "type": "string", "enum": ["approved", "rejected", "pending"] },
              "date": { "type": "string", "format": "date-time" },
              "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{7,64}$" },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
