const TC_SPAN_WRITE: t40 = 9;
const TC_SPAN_VPN: t40 = 10;
const TC_SPAN_PTE_WORD: t40 = 11;
const TC_SPAN_PTBR: t40 = 12;

const EXEC_IMAGE_WORDS: t40 = 128;
const EXEC_IMAGE_BASE: t40 = 651000;
const EXEC_MAGIC: t40 = 40404;
const EXEC_V2_HEADER_WORDS: t40 = 15;
const EXEC_DESC_TEXT_PPN: t40 = 15;
const EXEC_DESC_TEXT_DISK_BLOCK: t40 = 16;
const EXEC_DESC_TEXT_WORDS: t40 = 17;
const EXEC_DESC_WORDS: t40 = 18;
const EXEC_V2_VERSION: t40 = 2;
const EXEC_V2_FUNCTION_ABI: t40 = 2;
const EXEC_V2_ISA: t40 = 2;
const EXEC_V2_SYSCALL_ABI: t40 = 2;
const EXEC_V2_SCALAR_TRITS: t40 = 40;
const EXEC_V2_BASE_PAGE_WORDS: t40 = 729;
const EXEC_V2_MAGIC_INDEX: t40 = 0;
const EXEC_V2_VERSION_INDEX: t40 = 1;
const EXEC_V2_FUNCTION_ABI_INDEX: t40 = 2;
const EXEC_V2_HEADER_SIZE_INDEX: t40 = 3;
const EXEC_V2_ISA_INDEX: t40 = 4;
const EXEC_V2_FEATURES_INDEX: t40 = 5;
const EXEC_V2_ENTRY_PC_INDEX: t40 = 6;
const EXEC_V2_TEXT_WORDS_INDEX: t40 = 7;
const EXEC_V2_DATA_WORDS_INDEX: t40 = 8;
const EXEC_V2_STACK_WORDS_INDEX: t40 = 9;
const EXEC_V2_SYSCALL_ABI_INDEX: t40 = 10;
const EXEC_V2_SCALAR_WIDTH_INDEX: t40 = 11;
const EXEC_V2_BASE_PAGE_INDEX: t40 = 12;
const EXEC_V2_FLAGS_INDEX: t40 = 13;
const EXEC_V2_CHECKSUM_INDEX: t40 = 14;
// v3 is an executable/context profile over the v2 instruction codec. The
// scalar trap record remains v2; the vector context is a separate 279-word
// process-owned allocation referenced by PROC_VECTOR_CONTEXT.
const EXEC_V3_HEADER_WORDS: t40 = 20;
const EXEC_V3_VERSION: t40 = 3;
const EXEC_V3_FUNCTION_ABI: t40 = 3;
const EXEC_V3_ISA: t40 = 2;
const EXEC_V3_SYSCALL_ABI: t40 = 2;
const EXEC_V3_VECTOR_REGISTER_COUNT: t40 = 8;
const EXEC_V3_VECTOR_LANE_COUNT: t40 = 27;
const EXEC_V3_VECTOR_LANE_WORD_TRITS: t40 = 40;
const EXEC_V3_VECTOR_CONTEXT_WORDS: t40 = 279;
const EXEC_V3_VECTOR_SPILL_WORDS: t40 = 27;
const EXEC_V3_VECTOR_REGISTER_COUNT_INDEX: t40 = 15;
const EXEC_V3_VECTOR_LANE_COUNT_INDEX: t40 = 16;
const EXEC_V3_VECTOR_LANE_WORD_TRITS_INDEX: t40 = 17;
const EXEC_V3_VECTOR_CONTEXT_WORDS_INDEX: t40 = 18;
const EXEC_V3_VECTOR_SPILL_WORDS_INDEX: t40 = 19;
const EXEC_V3_REQUIRED_FEATURES_WORD: t40 = 177175;
const EXEC_V3_CONTEXT_VERSION: t40 = 1;
const EXEC_V3_FEATURE_CONTEXT_TRIT: t40 = 11;
const PROCESS_ARCH_WORDS: t40 = 6;
const PROCESS_ARCH_BASE: t40 = 674000;
const PROC_ARCH_EXEC_VERSION: t40 = 0;
const PROC_ARCH_FUNCTION_ABI: t40 = 1;
const PROC_ARCH_SYSCALL_ABI: t40 = 2;
const PROC_ARCH_ISA: t40 = 3;
const PROC_ARCH_FEATURES: t40 = 4;
const PROC_ARCH_FLAGS: t40 = 5;
const TASK_CONTEXT_WORDS: t40 = 32;
const TASK_CONTEXT_EPC: t40 = 0;
const TASK_CONTEXT_STATUS: t40 = 1;
const TASK_CONTEXT_IMEM_PTBR: t40 = 2;
const TASK_CONTEXT_IMEM_PAGES: t40 = 3;
const TASK_CONTEXT_DMEM_PTBR: t40 = 4;
const TASK_CONTEXT_DMEM_PAGES: t40 = 5;
const TASK_CONTEXT_REG_BASE: t40 = 6;
const TASK_CONTEXT_SP: t40 = 31;
const TASK_CONTEXT_V3_WORDS: t40 = 279;
const TASK_CONTEXT_V3_HEADER_VERSION: t40 = 0;
const TASK_CONTEXT_V3_HEADER_LENGTH: t40 = 1;
const TASK_CONTEXT_V3_HEADER_VECTOR_ABI: t40 = 2;
const TASK_CONTEXT_V3_HEADER_REGISTER_COUNT: t40 = 3;
const TASK_CONTEXT_V3_VLEN: t40 = 4;
const TASK_CONTEXT_V3_ACCUMULATOR: t40 = 5;
const TASK_CONTEXT_V3_FIRST_FAILING_LANE: t40 = 6;
const TASK_CONTEXT_V3_FAULT_BASE: t40 = 7;
const TASK_CONTEXT_V3_VECTOR_BASE: t40 = 34;
const TASK_CONTEXT_V3_VECTOR_WORDS: t40 = 216;
const TASK_CONTEXT_V3_RESERVED_BASE: t40 = 250;
const TASK_CONTEXT_V3_RESERVED_WORDS: t40 = 29;
const TASK_CONTEXT_V3_VECTOR_LENGTH: t40 = TASK_CONTEXT_V3_VLEN;
const TASK_CONTEXT_V3_FAULT_WORDS: t40 = 27;
const TASK_STATUS_USER_RESUME: t40 = 35;
const HW_PT_MAX_PAGES: t40 = 512;
const HW_PT_WORDS: t40 = 1024;
const HW_PT_BASE: t40 = 19300;
const PROCESS_HEAP_WORDS: t40 = 4;
const PROCESS_HEAP_BASE: t40 = 668000;
const PROC_HEAP_START: t40 = 0;
const PROC_HEAP_BREAK: t40 = 1;
const PROC_HEAP_LIMIT: t40 = 2;
const PROC_HEAP_MAPPED_PAGES: t40 = 3;
const PROCESS_DMEM_PAGES_MAX: t40 = 192;
const PROCESS_SCRATCH_PPN_OFFSET: t40 = 74;
const PROCESS_DATA_PAGES_MAX: t40 = 74;
const PROCESS_DMEM_PPN_BASE: t40 = 1000;
const PROCESS_CONTEXT_BASE: t40 = 669000;
// Separate arena: PROCESS_CONTEXT_BASE is intentionally left at 32 words per
// task for the v2 trap ABI.  100 * 279 words fit below the WAL area.
const PROCESS_CONTEXT_V3_BASE: t40 = 700002;

const APP_MAX: t40 = 256;
const APP_ROW_WORDS: t40 = 10;
const APP_REGISTRY_BASE: t40 = 665000;
const APP_NAMESPACE: t40 = 0;
const APP_PATH_HASH: t40 = 1;
const APP_INODE: t40 = 2;
const APP_CAPS: t40 = 3;
const APP_QUOTA: t40 = 4;
const APP_TRUSTED: t40 = 5;
const APP_VERSION: t40 = 6;
const APP_LAUNCH_COUNT: t40 = 7;
const APP_MAX_IMAGE: t40 = 8;
const APP_FLAGS: t40 = 9;

const APP_CAP_CONSOLE: t40 = 1;
const APP_CAP_FS_READ: t40 = 2;
const APP_CAP_FS_WRITE: t40 = 4;
const APP_CAP_GRAPHICS: t40 = 8;
const APP_CAP_PROCESS: t40 = 16;
const APP_CAP_IPC: t40 = 32;
const APP_CAP_SYSTEM: t40 = 63;

struct PageHeader {
    ppn: t40;
    pin_count: t40;
    dirty: t1;
    version: t40;
    lru_clock: t40;
    namespace: t40;
}

fn kload(addr: t40) -> t40 {
    var value: t40 = 0;
    unsafe { value = load(addr); }
    return value;
}

fn kstore(addr: t40, value: t40) -> t40 {
    unsafe { store(addr, value); }
    return value;
}

fn metric_inc(addr: t40) -> t40 {
    kstore(addr, kload(addr) + 1);
    return kload(addr);
}

fn kacq(addr: t40) -> t40 {
    var value: t40 = 0;
    unsafe { value = tldr(addr, 1); }
    return value;
}

fn kcas(addr: t40, expected: t40, desired: t40) -> t40 {
    var status: t40 = 0;
    var current: t40 = 0;
    unsafe { current = tldr(addr, 1); }
    if current - expected != 0 {
        return 0;
    }
    unsafe { status = tstr(addr, desired, expected, 1); }
    return status;
}

fn kwrap_inc(value: t40, limit: t40) -> t40 {
    var next: t40 = value + 1;
    if next - limit >= 0 {
        return 0;
    }
    return next;
}

fn kclear(base: t40, words: t40) -> t40 {
    var i: t40 = 0;
    while words - i > 0 {
        kstore(base + i, 0);
        i = i + 1;
    }
    return i;
}

fn bootstrap_required_pages() -> t40 {
    return BOOTSTRAP_KERNEL_IMAGE_PAGES + BOOTSTRAP_BUFFER_POOL_HEADER_PAGES + BOOTSTRAP_WAL_RING_PAGES;
}

fn bootstrap_bitmap_capacity_pages() -> t40 {
    return BOOTSTRAP_MAX_PAGES;
}

fn bootstrap_bitmap_is_sized() -> t40 {
    var required: t40 = bootstrap_required_pages();
    if BOOTSTRAP_MAX_PAGES - required > 0 {
        return 1;
    }
    if BOOTSTRAP_MAX_PAGES - required == 0 {
        return 1;
    }
    return 0;
}

fn bootstrap_bitmap_addr(ppn: t40) -> t40 {
    return BOOTSTRAP_BITMAP_BASE + ppn;
}

fn bootstrap_is_allocated(ppn: t40) -> t40 {
    if ppn < 0 {
        return 0;
    }
    if ppn - BOOTSTRAP_MAX_PAGES >= 0 {
        return 0;
    }
    return kload(bootstrap_bitmap_addr(ppn));
}

fn bootstrap_allocated_count() -> t40 {
    return kload(BOOT_ALLOC_COUNT_ADDR);
}

fn bootstrap_allocator_init() -> t40 {
    var i: t40 = 0;
    while BOOTSTRAP_MAX_PAGES - i > 0 {
        kstore(bootstrap_bitmap_addr(i), 0);
        i = i + 1;
    }
    i = 0;
    while BOOTSTRAP_RESERVED_PAGES - i > 0 {
        kstore(bootstrap_bitmap_addr(i), 1);
        i = i + 1;
    }
    kstore(BOOT_ALLOC_COUNT_ADDR, BOOTSTRAP_RESERVED_PAGES);
    return bootstrap_bitmap_is_sized();
}

fn alloc_bootstrap_page() -> t40 {
    if kload(REL_MIGRATION_DONE_ADDR) > 0 {
        return ERR_INVALID;
    }
    var ppn: t40 = BOOTSTRAP_RESERVED_PAGES;
    while BOOTSTRAP_MAX_PAGES - ppn > 0 {
        if kload(bootstrap_bitmap_addr(ppn)) == 0 {
            kstore(bootstrap_bitmap_addr(ppn), 1);
            var count: t40 = kload(BOOT_ALLOC_COUNT_ADDR);
            kstore(BOOT_ALLOC_COUNT_ADDR, count + 1);
            return ppn;
        }
        ppn = ppn + 1;
    }
    return ERR_NO_SPACE;
}

fn page_header_addr(ppn: t40) -> t40 {
    return PAGE_HEADERS_BASE + ppn * PAGE_HEADER_WORDS;
}

fn page_header_field(ppn: t40, field: t40) -> t40 {
    return page_header_addr(ppn) + field;
}

fn page_version_state(version: t40) -> t40 {
    if version < 0 {
        return PTR_STATE_NULL;
    }
    if version > 0 {
        return PTR_STATE_VALID;
    }
    return PTR_STATE_UNKNOWN;
}

fn page_version_from_ptr_state(state: t40, generation: t40) -> t40 {
    if state < 0 {
        return 0 - generation;
    }
    if state > 0 {
        return generation;
    }
    return 0;
}

fn buffer_frame_addr(slot: t40) -> t40 {
    return BUFFER_POOL_BASE + slot * BUFFER_FRAME_WORDS;
}

fn buffer_logical_page(logical_word: t40) -> t40 {
    var remaining: t40 = logical_word;
    var page: t40 = 0;
    while remaining - STORAGE_BLOCK_WORDS >= 0 {
        remaining = remaining - STORAGE_BLOCK_WORDS;
        page = page + 1;
    }
    return page;
}

fn buffer_pool_init() -> t40 {
    var ppn: t40 = 0;
    while BOOTSTRAP_MAX_PAGES - ppn > 0 {
        var addr: t40 = page_header_addr(ppn);
        kstore(addr + PH_PPN, ppn);
        kstore(addr + PH_PIN_COUNT, 0);
        kstore(addr + PH_DIRTY, -1);
        kstore(addr + PH_VERSION, 0);
        kstore(addr + PH_LRU_CLOCK, ppn);
        kstore(addr + PH_NAMESPACE, 0);
        ppn = ppn + 1;
    }
    kclear(BUFFER_POOL_BASE, BUFFER_MAX_FRAMES * BUFFER_FRAME_WORDS);
    kstore(BUFFER_CLOCK_ADDR, 0);
    kstore(BUFFER_DIRTY_COUNT_ADDR, 0);
    kstore(BUFFER_FLUSH_COUNT_ADDR, 0);
    kstore(BUFFER_EVICTION_COUNT_ADDR, 0);
    return BOOTSTRAP_MAX_PAGES;
}

fn buffer_find(namespace_id: t40, inode: t40, logical_page: t40) -> t40 {
    var slot: t40 = 0;
    while BUFFER_MAX_FRAMES - slot > 0 {
        var row: t40 = buffer_frame_addr(slot);
        if kload(row + BF_VALID) > 0 {
            if kload(row + BF_NAMESPACE) - namespace_id == 0 {
                if kload(row + BF_INODE) - inode == 0 {
                    if kload(row + BF_LOGICAL_PAGE) - logical_page == 0 {
                        return slot;
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

fn buffer_dirty_count() -> t40 {
    return kload(BUFFER_DIRTY_COUNT_ADDR);
}

fn buffer_flush_count() -> t40 {
    return kload(BUFFER_FLUSH_COUNT_ADDR);
}

fn buffer_evict_count() -> t40 {
    return kload(BUFFER_EVICTION_COUNT_ADDR);
}

fn buffer_pinned_count() -> t40 {
    var slot: t40 = 0;
    var count: t40 = 0;
    while BUFFER_MAX_FRAMES - slot > 0 {
        var row: t40 = buffer_frame_addr(slot);
        if kload(row + BF_VALID) > 0 {
            if kload(row + BF_PIN_COUNT) > 0 {
                count = count + 1;
            }
        }
        slot = slot + 1;
    }
    return count;
}

fn buffer_frame_writeback_allowed(slot: t40) -> t40 {
    if slot < 0 { return 0; }
    if slot - BUFFER_MAX_FRAMES >= 0 { return 0; }
    var row: t40 = buffer_frame_addr(slot);
    if kload(row + BF_VALID) <= 0 { return 0; }
    if kload(row + BF_DIRTY) <= 0 { return 1; }
    // A VM without a persistent block device has no home-page write to
    // order.  Real storage must obey page-LSN <= durable-LSN.
    if vfs_disk_available() <= 0 { return 1; }
    if kload(row + BF_PAGE_LSN) - kload(WAL_DURABLE_LSN_ADDR) > 0 {
        return 0;
    }
    return 1;
}

fn buffer_flush_frame(slot: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - BUFFER_MAX_FRAMES >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = buffer_frame_addr(slot);
    if kload(row + BF_VALID) <= 0 {
        return ERR_INVALID;
    }
    if buffer_frame_writeback_allowed(slot) <= 0 {
        return ERR_AGAIN;
    }
    if kload(row + BF_DIRTY) > 0 {
        kstore(row + BF_DIRTY, 0);
        var dirty: t40 = kload(BUFFER_DIRTY_COUNT_ADDR);
        if dirty > 0 {
            kstore(BUFFER_DIRTY_COUNT_ADDR, dirty - 1);
        }
        kstore(BUFFER_FLUSH_COUNT_ADDR, kload(BUFFER_FLUSH_COUNT_ADDR) + 1);
    }
    return 1;
}

fn buffer_flush_all() -> t40 {
    var slot: t40 = 0;
    var flushed: t40 = 0;
    while BUFFER_MAX_FRAMES - slot > 0 {
        var row: t40 = buffer_frame_addr(slot);
        if kload(row + BF_VALID) > 0 {
            if kload(row + BF_DIRTY) > 0 {
                var status: t40 = buffer_flush_frame(slot);
                if status <= 0 { return status; }
                flushed = flushed + 1;
            }
        }
        slot = slot + 1;
    }
    return flushed;
}

fn buffer_flush_inode(namespace_id: t40, inode: t40) -> t40 {
    var slot: t40 = 0;
    var flushed: t40 = 0;
    while BUFFER_MAX_FRAMES - slot > 0 {
        var row: t40 = buffer_frame_addr(slot);
        if kload(row + BF_VALID) > 0 {
            if buffer_frame_matches_inode(row, namespace_id, inode) > 0 {
                if kload(row + BF_DIRTY) > 0 {
                    var status: t40 = buffer_flush_frame(slot);
                    if status <= 0 { return status; }
                    flushed = flushed + 1;
                }
            }
        }
        slot = slot + 1;
    }
    return flushed;
}

fn buffer_frame_matches_inode(row: t40, namespace_id: t40, inode: t40) -> t40 {
    if kload(row + BF_OWNER_INODE) - inode != 0 {
        return 0;
    }
    if namespace_id < 0 {
        return 1;
    }
    if kload(row + BF_NAMESPACE) - namespace_id != 0 {
        return 0;
    }
    return 1;
}

// Retire every cached page owned by an inode before its inode number or data
// span can be reused.  Frames are keyed by (namespace, inode, logical page),
// so merely clearing the extent row would otherwise let a new inode observe
// the old file's cache.  Validate the whole set before changing any frame so a
// pinned or non-durable dirty page leaves the cache untouched and the caller
// can retry after the I/O/WAL boundary.
fn buffer_invalidate_inode(namespace_id: t40, inode: t40) -> t40 {
    var slot: t40 = 0;
    while BUFFER_MAX_FRAMES - slot > 0 {
        var row: t40 = buffer_frame_addr(slot);
        if kload(row + BF_VALID) > 0 {
            if buffer_frame_matches_inode(row, namespace_id, inode) > 0 {
                if kload(row + BF_PIN_COUNT) > 0 {
                    return ERR_AGAIN;
                }
                if kload(row + BF_DIRTY) > 0 {
                    if buffer_frame_writeback_allowed(slot) <= 0 {
                        return ERR_AGAIN;
                    }
                }
            }
        }
        slot = slot + 1;
    }

    slot = 0;
    var retired: t40 = 0;
    while BUFFER_MAX_FRAMES - slot > 0 {
        var row: t40 = buffer_frame_addr(slot);
        if kload(row + BF_VALID) > 0 {
            if buffer_frame_matches_inode(row, namespace_id, inode) > 0 {
                if kload(row + BF_DIRTY) > 0 {
                    var flushed: t40 = buffer_flush_frame(slot);
                    if flushed < 0 {
                        return flushed;
                    }
                }
                kstore(row + BF_VALID, 0);
                kstore(row + BF_PIN_COUNT, 0);
                retired = retired + 1;
            }
        }
        slot = slot + 1;
    }
    return retired;
}

fn buffer_required_lsn_all() -> t40 {
    var slot: t40 = 0;
    var required: t40 = 0;
    while BUFFER_MAX_FRAMES - slot > 0 {
        var row: t40 = buffer_frame_addr(slot);
        if kload(row + BF_VALID) > 0 {
            if kload(row + BF_DIRTY) > 0 {
                if kload(row + BF_PAGE_LSN) - required > 0 {
                    required = kload(row + BF_PAGE_LSN);
                }
            }
        }
        slot = slot + 1;
    }
    return required;
}

fn buffer_page_lsn(slot: t40) -> t40 {
    if slot < 0 { return ERR_INVALID; }
    if slot - BUFFER_MAX_FRAMES >= 0 { return ERR_INVALID; }
    return kload(buffer_frame_addr(slot) + BF_PAGE_LSN);
}

fn inode_required_lsn_addr(inode: t40) -> t40 {
    return INODE_REQUIRED_LSN_BASE + inode;
}

fn inode_required_lsn(inode: t40) -> t40 {
    if inode < 0 { return 0; }
    if inode - INODE_REQUIRED_LSN_WORDS >= 0 { return 0; }
    return kload(inode_required_lsn_addr(inode));
}

fn inode_track_required_lsn(inode: t40, lsn: t40) -> t40 {
    if inode < 0 { return ERR_INVALID; }
    if inode - INODE_REQUIRED_LSN_WORDS >= 0 { return ERR_INVALID; }
    var addr: t40 = inode_required_lsn_addr(inode);
    if lsn - kload(addr) > 0 {
        kstore(addr, lsn);
    }
    return kload(addr);
}

fn inode_required_lsn_all() -> t40 {
    var inode: t40 = 0;
    var required: t40 = 0;
    while VFS_MAX_INODES - inode > 0 {
        var lsn: t40 = inode_required_lsn(inode);
        if lsn - required > 0 {
            required = lsn;
        }
        inode = inode + 1;
    }
    return required;
}

// Clock-hand eviction: two-pass sweep.
// Pass 1: give referenced frames a second chance (clear ref bit, continue).
// Pass 2: evict first unpinned+unreferenced frame whose WAL dependency is
// durable.  This preserves the write-ahead invariant under memory pressure.
fn buffer_pick_victim() -> t40 {
    var slot: t40 = 0;
    while BUFFER_MAX_FRAMES - slot > 0 {
        if kload(buffer_frame_addr(slot) + BF_VALID) <= 0 {
            return slot;
        }
        slot = slot + 1;
    }
    var hand: t40 = kload(BUFFER_CLOCK_HAND_ADDR);
    var scanned: t40 = 0;
    while scanned - BUFFER_MAX_FRAMES * 2 < 0 {
        var row: t40 = buffer_frame_addr(hand);
        if kload(row + BF_PIN_COUNT) <= 0 {
            if kload(row + BF_REF_BIT) > 0 {
                kstore(row + BF_REF_BIT, 0);
            } else {
                if buffer_frame_writeback_allowed(hand) > 0 {
                    kstore(BUFFER_CLOCK_HAND_ADDR, kwrap_inc(hand, BUFFER_MAX_FRAMES));
                    return hand;
                }
            }
        }
        hand = kwrap_inc(hand, BUFFER_MAX_FRAMES);
        scanned = scanned + 1;
    }
    return ERR_NO_SPACE;
}

fn buffer_alloc_frame(namespace_id: t40, inode: t40, logical_page: t40, data_addr: t40) -> t40 {
    var slot: t40 = buffer_pick_victim();
    if slot < 0 {
        return slot;
    }
    var row: t40 = buffer_frame_addr(slot);
    if kload(row + BF_VALID) > 0 {
        var flushed: t40 = buffer_flush_frame(slot);
        if flushed <= 0 { return flushed; }
        kstore(BUFFER_EVICTION_COUNT_ADDR, kload(BUFFER_EVICTION_COUNT_ADDR) + 1);
    }
    kstore(row + BF_VALID, 1);
    kstore(row + BF_NAMESPACE, namespace_id);
    kstore(row + BF_OWNER_INODE, inode);
    kstore(row + BF_LOGICAL_PAGE, logical_page);
    kstore(row + BF_DATA_ADDR, data_addr);
    kstore(row + BF_PIN_COUNT, 0);
    kstore(row + BF_DIRTY, 0);
    kstore(row + BF_PAGE_LSN, 0);
    kstore(row + BF_VERSION, kload(row + BF_VERSION) + 1);
    kstore(row + BF_LAST_USED, kload(BUFFER_CLOCK_ADDR));
    kstore(row + BF_REF_BIT, 1);
    return slot;
}

fn buffer_pin(namespace_id: t40, inode: t40, logical_word: t40, data_addr: t40) -> t40 {
    var logical_page: t40 = buffer_logical_page(logical_word);
    var slot: t40 = buffer_find(namespace_id, inode, logical_page);
    if slot < 0 {
        slot = buffer_alloc_frame(namespace_id, inode, logical_page, data_addr);
        if slot < 0 {
            return slot;
        }
    }
    var row: t40 = buffer_frame_addr(slot);
    kstore(row + BF_PIN_COUNT, kload(row + BF_PIN_COUNT) + 1);
    var clock: t40 = kload(BUFFER_CLOCK_ADDR) + 1;
    kstore(BUFFER_CLOCK_ADDR, clock);
    kstore(row + BF_LAST_USED, clock);
    return slot;
}

fn buffer_unpin(slot: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - BUFFER_MAX_FRAMES >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = buffer_frame_addr(slot);
    var pins: t40 = kload(row + BF_PIN_COUNT);
    if pins <= 0 {
        return ERR_INVALID;
    }
    kstore(row + BF_PIN_COUNT, pins - 1);
    return pins - 1;
}

fn buffer_ns_dirty_version(ns: t40) -> t40 {
    if ns < 0 { return 0; }
    if ns - NS_DIRTY_VERSION_WORDS >= 0 { return 0; }
    return kload(NS_DIRTY_VERSION_BASE + ns);
}

fn buffer_ns_touch(ns: t40) -> t40 {
    if ns < 0 { return 0; }
    if ns - NS_DIRTY_VERSION_WORDS >= 0 { return 0; }
    var addr: t40 = NS_DIRTY_VERSION_BASE + ns;
    var v: t40 = kacq(addr);
    kcas(addr, v, v + 1);
    return v + 1;
}

fn buffer_mark_dirty(slot: t40, page_lsn: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - BUFFER_MAX_FRAMES >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = buffer_frame_addr(slot);
    if kload(row + BF_VALID) <= 0 {
        return ERR_INVALID;
    }
    if kload(row + BF_DIRTY) <= 0 {
        kstore(row + BF_DIRTY, 1);
        kstore(BUFFER_DIRTY_COUNT_ADDR, kload(BUFFER_DIRTY_COUNT_ADDR) + 1);
        // Notify namespace CDC: any subscriber watching this namespace's
        // version counter will see a change on next poll.
        buffer_ns_touch(kload(row + BF_NAMESPACE));
    }
    if page_lsn - kload(row + BF_PAGE_LSN) > 0 {
        kstore(row + BF_PAGE_LSN, page_lsn);
    }
    kstore(row + BF_VERSION, kload(row + BF_VERSION) + 1);
    kstore(row + BF_REF_BIT, 1);
    return 1;
}

fn framebuffer_words(width: t40, height: t40) -> t40 {
    return width * height * 3;
}

fn framebuffer_pages(words: t40) -> t40 {
    var pages: t40 = 0;
    var remaining: t40 = words;
    while remaining > 0 {
        pages = pages + 1;
        remaining = remaining - MMU_PAGE_WORDS;
    }
    return pages;
}

fn framebuffer_buffer_base(index: t40) -> t40 {
    if index == 0 {
        return FB_FRONT_BUFFER_BASE;
    }
    return FB_BACK_BUFFER_BASE;
}

fn framebuffer_visible_base() -> t40 {
    return framebuffer_buffer_base(kload(FB_STATE_BASE + FB_FRONT_INDEX));
}

fn framebuffer_draw_base() -> t40 {
    if kload(FB_STATE_BASE + FB_FRONT_INDEX) == 0 {
        return FB_BACK_BUFFER_BASE;
    }
    return FB_FRONT_BUFFER_BASE;
}

fn framebuffer_release_pins() -> t40 {
    var pinned: t40 = kload(FB_STATE_BASE + FB_PINNED_PAGES);
    var i: t40 = 0;
    while pinned - i > 0 {
        page_unpin(FB_PPN_BASE + i);
        i = i + 1;
    }
    kstore(FB_STATE_BASE + FB_PINNED_PAGES, 0);
    return i;
}

fn framebuffer_init(width: t40, height: t40) -> t40 {
    if width <= 0 {
        return ERR_INVALID;
    }
    if height <= 0 {
        return ERR_INVALID;
    }
    var words: t40 = framebuffer_words(width, height);
    if words - FB_MAX_WORDS > 0 {
        return ERR_NO_SPACE;
    }
    var pages: t40 = framebuffer_pages(words);
    if pages - FB_MAX_PINNED_PAGES > 0 {
        return ERR_NO_SPACE;
    }
    if kload(FB_STATE_BASE + FB_VALID) > 0 {
        framebuffer_release_pins();
    }
    kclear(FB_STATE_BASE, FB_STATE_WORDS);
    kclear(FB_FRONT_BUFFER_BASE, words);
    kclear(FB_BACK_BUFFER_BASE, words);
    var i: t40 = 0;
    while pages - i > 0 {
        page_pin(FB_PPN_BASE + i);
        i = i + 1;
    }
    kstore(FB_STATE_BASE + FB_VALID, 1);
    kstore(FB_STATE_BASE + FB_WIDTH, width);
    kstore(FB_STATE_BASE + FB_HEIGHT, height);
    kstore(FB_STATE_BASE + FB_STRIDE, width * 3);
    kstore(FB_STATE_BASE + FB_FORMAT, FB_FORMAT_T5_RGB);
    kstore(FB_STATE_BASE + FB_FRONT_INDEX, 0);
    kstore(FB_STATE_BASE + FB_WORDS, words);
    kstore(FB_STATE_BASE + FB_PAGES, pages);
    kstore(FB_STATE_BASE + FB_FLIP_COUNT, 0);
    kstore(FB_STATE_BASE + FB_PINNED_PAGES, pages);
    return FB_FRONT_BUFFER_BASE;
}

fn framebuffer_flip() -> t40 {
    if kload(FB_STATE_BASE + FB_VALID) <= 0 {
        return ERR_INVALID;
    }
    if kload(FB_STATE_BASE + FB_FRONT_INDEX) == 0 {
        kstore(FB_STATE_BASE + FB_FRONT_INDEX, 1);
    } else {
        kstore(FB_STATE_BASE + FB_FRONT_INDEX, 0);
    }
    var flips: t40 = kload(FB_STATE_BASE + FB_FLIP_COUNT) + 1;
    kstore(FB_STATE_BASE + FB_FLIP_COUNT, flips);
    return flips;
}

fn window_addr(slot: t40) -> t40 {
    return WINDOW_BASE + slot * WINDOW_ROW_WORDS;
}

fn window_buffer_addr(slot: t40) -> t40 {
    return WINDOW_BUFFER_BASE + slot * WINDOW_BUFFER_WORDS;
}

fn window_user_addr(slot: t40) -> t40 {
    return (WINDOW_USER_VPN_BASE + slot * WINDOW_USER_PAGES) * MMU_PAGE_WORDS;
}

fn window_event_addr(slot: t40, index: t40) -> t40 {
    return WINDOW_EVENT_BASE + (slot * WINDOW_EVENT_CAPACITY + index) * WINDOW_EVENT_WORDS;
}

fn window_table_init() -> t40 {
    kclear(WINDOW_BASE, WINDOW_MAX * WINDOW_ROW_WORDS);
    kclear(WINDOW_EVENT_BASE, WINDOW_MAX * WINDOW_EVENT_CAPACITY * WINDOW_EVENT_WORDS);
    kstore(WINDOW_NEXT_ID_ADDR, 0);
    kstore(COMPOSITOR_FRAME_COUNT_ADDR, 0);
    kstore(WINDOW_FOCUS_ID_ADDR, ERR_NOT_FOUND);
    kstore(INPUT_LAST_MOUSE_BTN_ADDR, 0);
    return 1;
}

fn window_find(window_id: t40) -> t40 {
    if window_id < 0 {
        return ERR_INVALID;
    }
    var slot: t40 = 0;
    while WINDOW_MAX - slot > 0 {
        var row: t40 = window_addr(slot);
        if kload(row + WIN_ACTIVE) > 0 {
            if kload(row + WIN_ID) - window_id == 0 {
                return slot;
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

fn window_create(pid: t40, x: t40, y: t40, width: t40, height: t40) -> t40 {
    if width <= 0 {
        return ERR_INVALID;
    }
    if height <= 0 {
        return ERR_INVALID;
    }
    var words: t40 = framebuffer_words(width, height);
    if words - WINDOW_BUFFER_WORDS > 0 {
        return ERR_NO_SPACE;
    }
    var slot: t40 = 0;
    while WINDOW_MAX - slot > 0 {
        var row: t40 = window_addr(slot);
        if kload(row + WIN_ACTIVE) <= 0 {
            var id: t40 = kload(WINDOW_NEXT_ID_ADDR);
            kstore(WINDOW_NEXT_ID_ADDR, id + 1);
            kstore(row + WIN_ACTIVE, 1);
            kstore(row + WIN_ID, id);
            kstore(row + WIN_OWNER_PID, pid);
            kstore(row + WIN_X, x);
            kstore(row + WIN_Y, y);
            kstore(row + WIN_WIDTH, width);
            kstore(row + WIN_HEIGHT, height);
            kstore(row + WIN_Z, slot);
            kstore(row + WIN_VISIBLE, 1);
            kstore(row + WIN_DIRTY, 1);
            kstore(row + WIN_BUFFER_ADDR, window_buffer_addr(slot));
            kstore(row + WIN_NAMESPACE, process_namespace_for_pid(pid));
            kstore(row + WIN_VERSION, 1);
            kstore(row + WIN_EVENT_READ, 0);
            kstore(row + WIN_EVENT_WRITE, 0);
            kstore(row + WIN_EVENT_COUNT, 0);
            kclear(window_event_addr(slot, 0), WINDOW_EVENT_CAPACITY * WINDOW_EVENT_WORDS);
            kclear(window_buffer_addr(slot), WINDOW_BUFFER_WORDS);
            return id;
        }
        slot = slot + 1;
    }
    return ERR_NO_SPACE;
}

fn window_authorized_slot(pid: t40, window_id: t40) -> t40 {
    var slot: t40 = window_find(window_id);
    if slot < 0 {
        return slot;
    }
    var row: t40 = window_addr(slot);
    if kload(row + WIN_OWNER_PID) - pid != 0 {
        return ERR_INVALID;
    }
    return slot;
}

fn window_control_slot(pid: t40, window_id: t40) -> t40 {
    var slot: t40 = window_find(window_id);
    if slot < 0 {
        return slot;
    }
    var row: t40 = window_addr(slot);
    if kload(row + WIN_OWNER_PID) - pid == 0 {
        return slot;
    }
    var process_slot: t40 = process_find_pid(pid);
    if process_slot < 0 {
        return process_slot;
    }
    var caller_ns: t40 = kload(process_addr(process_slot) + PROC_NAMESPACE);
    if caller_ns - kload(row + WIN_NAMESPACE) == 0 {
        return slot;
    }
    return ERR_INVALID;
}

fn window_get_buffer(pid: t40, window_id: t40) -> t40 {
    var slot: t40 = window_authorized_slot(pid, window_id);
    if slot < 0 {
        return slot;
    }
    var process_slot: t40 = process_find_pid(pid);
    if process_slot < 0 {
        return process_slot;
    }
    var base_vpn: t40 = WINDOW_USER_VPN_BASE + slot * WINDOW_USER_PAGES;
    var phys_ppn: t40 = kload(window_addr(slot) + WIN_BUFFER_ADDR) / MMU_PAGE_WORDS;
    var i: t40 = 0;
    while WINDOW_BUFFER_PAGES - i > 0 {
        kstore(exec_hw_dmem_ptbr(process_slot) + base_vpn + i, exec_encode_pte(phys_ppn + i, 1, 1, 1, 0));
        i = i + 1;
    }
    var required_pages: t40 = base_vpn + WINDOW_BUFFER_PAGES;
    var ctx: t40 = kload(process_addr(process_slot) + PROC_CONTEXT);
    if ctx > 0 {
        if required_pages - kload(ctx + TASK_CONTEXT_DMEM_PAGES) > 0 {
            kstore(ctx + TASK_CONTEXT_DMEM_PAGES, required_pages);
        }
    }
    translation_cache_invalidate(process_slot);
    return window_user_addr(slot);
}

fn window_queue_event(slot: t40, kind: t40, x_or_key: t40, y: t40, modifiers: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - WINDOW_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = window_addr(slot);
    if kload(row + WIN_ACTIVE) <= 0 {
        return ERR_NOT_FOUND;
    }
    var count: t40 = kload(row + WIN_EVENT_COUNT);
    if count - WINDOW_EVENT_CAPACITY >= 0 {
        return ERR_NO_SPACE;
    }
    var write_pos: t40 = kload(row + WIN_EVENT_WRITE);
    var ev: t40 = window_event_addr(slot, write_pos);
    kstore(ev + EVENT_KIND, kind);
    kstore(ev + EVENT_X_OR_KEY, x_or_key);
    kstore(ev + EVENT_Y, y);
    kstore(ev + EVENT_MODIFIERS, modifiers);
    kstore(row + WIN_EVENT_WRITE, kwrap_inc(write_pos, WINDOW_EVENT_CAPACITY));
    kstore(row + WIN_EVENT_COUNT, count + 1);
    kstore(row + WIN_VERSION, kload(row + WIN_VERSION) + 1);
    wait_wake_window(kload(row + WIN_ID));
    return count + 1;
}

fn window_read_event(pid: t40, window_id: t40, out_addr: t40) -> t40 {
    var slot: t40 = window_authorized_slot(pid, window_id);
    if slot < 0 {
        return slot;
    }
    if user_validate_span(pid, out_addr, WINDOW_EVENT_WORDS, 1) <= 0 {
        return ERR_BAD_PTR;
    }
    var row: t40 = window_addr(slot);
    var count: t40 = kload(row + WIN_EVENT_COUNT);
    if count <= 0 {
        window_poll_input_driver();
        count = kload(row + WIN_EVENT_COUNT);
    }
    if count <= 0 {
        return 0;
    }
    var read_pos: t40 = kload(row + WIN_EVENT_READ);
    var ev: t40 = window_event_addr(slot, read_pos);
    var copied: t40 = user_copy_from_kernel_validated(pid, out_addr, ev, WINDOW_EVENT_WORDS);
    if copied < 0 {
        return ERR_BAD_PTR;
    }
    kstore(row + WIN_EVENT_READ, kwrap_inc(read_pos, WINDOW_EVENT_CAPACITY));
    kstore(row + WIN_EVENT_COUNT, count - 1);
    return 1;
}

fn window_close_hit(slot: t40, x: t40, y: t40) -> t40 {
    if slot < 0 {
        return 0;
    }
    var row: t40 = window_addr(slot);
    var wx: t40 = kload(row + WIN_X);
    var wy: t40 = kload(row + WIN_Y);
    var ww: t40 = kload(row + WIN_WIDTH);
    if y - wy != 0 {
        return 0;
    }
    if x - (wx + ww - 1) != 0 {
        return 0;
    }
    return 1;
}

fn window_hit_test(x: t40, y: t40) -> t40 {
    var slot: t40 = 0;
    var best_slot: t40 = ERR_NOT_FOUND;
    var best_z: t40 = 0;
    while WINDOW_MAX - slot > 0 {
        var row: t40 = window_addr(slot);
        if kload(row + WIN_ACTIVE) > 0 {
            if kload(row + WIN_VISIBLE) > 0 {
                var wx: t40 = kload(row + WIN_X);
                var wy: t40 = kload(row + WIN_Y);
                var ww: t40 = kload(row + WIN_WIDTH);
                var wh: t40 = kload(row + WIN_HEIGHT);
                if x - wx >= 0 {
                    if y - wy >= 0 {
                        if wx + ww - x > 0 {
                            if wy + wh - y > 0 {
                                var z: t40 = kload(row + WIN_Z);
                                if best_slot < 0 {
                                    best_slot = slot;
                                    best_z = z;
                                } else {
                                    if z - best_z > 0 {
                                        best_slot = slot;
                                        best_z = z;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return best_slot;
}

fn window_top_visible_slot() -> t40 {
    var slot: t40 = 0;
    var best_slot: t40 = ERR_NOT_FOUND;
    var best_z: t40 = 0;
    while WINDOW_MAX - slot > 0 {
        var row: t40 = window_addr(slot);
        if kload(row + WIN_ACTIVE) > 0 {
            if kload(row + WIN_VISIBLE) > 0 {
                var z: t40 = kload(row + WIN_Z);
                if best_slot < 0 {
                    best_slot = slot;
                    best_z = z;
                } else {
                    if z - best_z > 0 {
                        best_slot = slot;
                        best_z = z;
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return best_slot;
}

fn window_focus_slot() -> t40 {
    var focus_id: t40 = kload(WINDOW_FOCUS_ID_ADDR);
    if focus_id < 0 {
        return ERR_NOT_FOUND;
    }
    return window_find(focus_id);
}

fn window_route_input(kind: t40, x_or_key: t40, y: t40, modifiers: t40) -> t40 {
    var slot: t40 = window_hit_test(x_or_key, y);
    if kind - EVENT_KIND_KEY == 0 {
        slot = window_focus_slot();
        if slot < 0 {
            slot = window_top_visible_slot();
        }
    }
    if slot < 0 {
        return 0;
    }
    if kind - EVENT_KIND_MOUSE == 0 {
        if modifiers > 0 {
            if window_close_hit(slot, x_or_key, y) > 0 {
                var close_id: t40 = kload(window_addr(slot) + WIN_ID);
                var owner_pid: t40 = kload(window_addr(slot) + WIN_OWNER_PID);
                var owner_slot: t40 = process_find_pid(owner_pid);
                if owner_slot >= 0 {
                    process_add_signal(owner_slot, SIGNAL_CLOSE_REQUEST);
                    process_wake_for_signal(owner_slot);
                }
                var close_queued: t40 = window_queue_event(slot, EVENT_KIND_CLOSE, close_id, 0, 0);
                if close_queued < 0 {
                    return close_queued;
                }
                kstore(WINDOW_FOCUS_ID_ADDR, close_id);
                return close_id;
            }
        }
    }
    var queued: t40 = window_queue_event(slot, kind, x_or_key, y, modifiers);
    if queued < 0 {
        return queued;
    }
    var id: t40 = kload(window_addr(slot) + WIN_ID);
    kstore(WINDOW_FOCUS_ID_ADDR, id);
    return id;
}

fn window_poll_input_driver() -> t40 {
    var routed: t40 = 0;
    var mx: t40 = 0;
    var my: t40 = 0;
    var btn: t40 = 0;
    unsafe { mx = csr_read(mouse_x); }
    unsafe { my = csr_read(mouse_y); }
    unsafe { btn = csr_read(mouse_btn); }
    var last_btn: t40 = kload(INPUT_LAST_MOUSE_BTN_ADDR);
    if btn > 0 {
        if last_btn <= 0 {
            var mouse_target: t40 = window_route_input(EVENT_KIND_MOUSE, mx, my, btn);
            if mouse_target > 0 {
                routed = routed + 1;
            }
        }
    }
    kstore(INPUT_LAST_MOUSE_BTN_ADDR, btn);
    var key_available: t40 = 0;
    unsafe { key_available = csr_read(console_in_ctrl); }
    if key_available > 0 {
        var key_slot: t40 = window_focus_slot();
        if key_slot < 0 {
            key_slot = window_top_visible_slot();
        }
        if key_slot >= 0 {
            var key: t40 = 0;
            unsafe { key = csr_read(console_in); }
            unsafe { csr_write(console_in_ctrl, 1); }
            var key_target: t40 = window_route_input(EVENT_KIND_KEY, key, 0, 0);
            if key_target > 0 {
                routed = routed + 1;
            }
        }
    }
    return routed;
}

fn compositor_blit_window(slot: t40, draw_base: t40) -> t40 {
    var row: t40 = window_addr(slot);
    var fb_width: t40 = kload(FB_STATE_BASE + FB_WIDTH);
    var fb_height: t40 = kload(FB_STATE_BASE + FB_HEIGHT);
    var wx0: t40 = kload(row + WIN_X);
    var wy0: t40 = kload(row + WIN_Y);
    var ww: t40 = kload(row + WIN_WIDTH);
    var wh: t40 = kload(row + WIN_HEIGHT);
    var src: t40 = kload(row + WIN_BUFFER_ADDR);
    var y: t40 = 0;
    while wh - y > 0 {
        var screen_y: t40 = wy0 + y;
        if screen_y >= 0 {
            if fb_height - screen_y > 0 {
                var x: t40 = 0;
                while ww - x > 0 {
                    var screen_x: t40 = wx0 + x;
                    if screen_x >= 0 {
                        if fb_width - screen_x > 0 {
                            var src_pos: t40 = (y * ww + x) * 3;
                            var dst_pos: t40 = (screen_y * fb_width + screen_x) * 3;
                            kstore(draw_base + dst_pos, kload(src + src_pos));
                            kstore(draw_base + dst_pos + 1, kload(src + src_pos + 1));
                            kstore(draw_base + dst_pos + 2, kload(src + src_pos + 2));
                        }
                    }
                    x = x + 1;
                }
            }
        }
        y = y + 1;
    }
    return 1;
}

fn compositor_tick() -> t40 {
    if kload(FB_STATE_BASE + FB_VALID) <= 0 {
        return ERR_INVALID;
    }
    var draw_base: t40 = framebuffer_draw_base();
    kclear(draw_base, kload(FB_STATE_BASE + FB_WORDS));
    var z: t40 = 0;
    var composed: t40 = 0;
    while WINDOW_MAX - z > 0 {
        var slot: t40 = 0;
        while WINDOW_MAX - slot > 0 {
            var row: t40 = window_addr(slot);
            if kload(row + WIN_ACTIVE) > 0 {
                if kload(row + WIN_VISIBLE) > 0 {
                    if kload(row + WIN_Z) - z == 0 {
                        compositor_blit_window(slot, draw_base);
                        if kload(row + WIN_DIRTY) > 0 {
                            kstore(row + WIN_DIRTY, 0);
                        }
                        composed = composed + 1;
                    }
                }
            }
            slot = slot + 1;
        }
        z = z + 1;
    }
    framebuffer_flip();
    kstore(COMPOSITOR_FRAME_COUNT_ADDR, kload(COMPOSITOR_FRAME_COUNT_ADDR) + 1);
    return composed;
}

fn window_present(pid: t40, window_id: t40) -> t40 {
    var slot: t40 = window_authorized_slot(pid, window_id);
    if slot < 0 {
        return slot;
    }
    var row: t40 = window_addr(slot);
    kstore(row + WIN_DIRTY, 1);
    kstore(row + WIN_VERSION, kload(row + WIN_VERSION) + 1);
    return compositor_tick();
}

fn window_move(pid: t40, window_id: t40, x: t40, y: t40) -> t40 {
    var slot: t40 = window_authorized_slot(pid, window_id);
    if slot < 0 {
        return slot;
    }
    var row: t40 = window_addr(slot);
    kstore(row + WIN_X, x);
    kstore(row + WIN_Y, y);
    kstore(row + WIN_DIRTY, 1);
    kstore(row + WIN_VERSION, kload(row + WIN_VERSION) + 1);
    return 1;
}

fn window_set_z(pid: t40, window_id: t40, z: t40) -> t40 {
    var slot: t40 = window_authorized_slot(pid, window_id);
    if slot < 0 {
        return slot;
    }
    if z < 0 {
        return ERR_INVALID;
    }
    if z - WINDOW_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = window_addr(slot);
    kstore(row + WIN_Z, z);
    kstore(row + WIN_DIRTY, 1);
    kstore(row + WIN_VERSION, kload(row + WIN_VERSION) + 1);
    return 1;
}

fn window_resize(pid: t40, window_id: t40, width: t40, height: t40) -> t40 {
    if width <= 0 {
        return ERR_INVALID;
    }
    if height <= 0 {
        return ERR_INVALID;
    }
    var words: t40 = framebuffer_words(width, height);
    if words - WINDOW_BUFFER_WORDS > 0 {
        return ERR_NO_SPACE;
    }
    var slot: t40 = window_authorized_slot(pid, window_id);
    if slot < 0 {
        return slot;
    }
    var row: t40 = window_addr(slot);
    kstore(row + WIN_WIDTH, width);
    kstore(row + WIN_HEIGHT, height);
    kstore(row + WIN_DIRTY, 1);
    kstore(row + WIN_VERSION, kload(row + WIN_VERSION) + 1);
    kclear(window_buffer_addr(slot), WINDOW_BUFFER_WORDS);
    return 1;
}

fn window_request_close(pid: t40, window_id: t40) -> t40 {
    var slot: t40 = window_control_slot(pid, window_id);
    if slot < 0 {
        return slot;
    }
    var owner_pid: t40 = kload(window_addr(slot) + WIN_OWNER_PID);
    var owner_slot: t40 = process_find_pid(owner_pid);
    if owner_slot >= 0 {
        process_add_signal(owner_slot, SIGNAL_CLOSE_REQUEST);
        process_wake_for_signal(owner_slot);
    }
    return window_queue_event(slot, EVENT_KIND_CLOSE, window_id, 0, 0);
}

fn window_destroy(pid: t40, window_id: t40) -> t40 {
    var slot: t40 = window_authorized_slot(pid, window_id);
    if slot < 0 {
        return slot;
    }
    wait_cancel_channel(wait_channel_window(window_id));
    kclear(window_addr(slot), WINDOW_ROW_WORDS);
    kclear(window_event_addr(slot, 0), WINDOW_EVENT_CAPACITY * WINDOW_EVENT_WORDS);
    kclear(window_buffer_addr(slot), WINDOW_BUFFER_WORDS);
    return 1;
}

fn page_pin(ppn: t40) -> t40 {
    if ppn < 0 {
        return ERR_INVALID;
    }
    if ppn - BOOTSTRAP_MAX_PAGES >= 0 {
        return ERR_INVALID;
    }
    var addr: t40 = page_header_field(ppn, PH_PIN_COUNT);
    var count: t40 = kload(addr);
    kstore(addr, count + 1);
    return count + 1;
}

fn page_unpin(ppn: t40) -> t40 {
    var addr: t40 = page_header_field(ppn, PH_PIN_COUNT);
    var count: t40 = kload(addr);
    if count <= 0 {
        return ERR_INVALID;
    }
    kstore(addr, count - 1);
    return count - 1;
}

fn page_is_evictable(ppn: t40) -> t40 {
    var pins: t40 = kload(page_header_field(ppn, PH_PIN_COUNT));
    if pins > 0 {
        return 0;
    }
    return 1;
}

fn page_set_version_state(ppn: t40, state: t40, generation: t40) -> t40 {
    var version: t40 = page_version_from_ptr_state(state, generation);
    kstore(page_header_field(ppn, PH_VERSION), version);
    return version;
}

fn mvcc_publish_page_version(ppn: t40, expected_state: t40, desired_state: t40, generation: t40) -> t40 {
    var addr: t40 = page_header_field(ppn, PH_VERSION);
    var current: t40 = kacq(addr);
    var current_state: t40 = page_version_state(current);
    if current_state - expected_state == 0 {
        var desired: t40 = page_version_from_ptr_state(desired_state, generation);
        return kcas(addr, current, desired);
    }
    return 0;
}

fn cow_can_remap(ppn: t40) -> t40 {
    return page_is_evictable(ppn);
}

fn fork_can_copy_page(ppn: t40) -> t40 {
    return page_is_evictable(ppn);
}

fn wal_record_addr(slot: t40) -> t40 {
    return WAL_BASE + slot * WAL_RECORD_WORDS;
}

fn wal_tx_tracker_slot(txid: t40) -> t40 {
    if txid < 0 {
        return ERR_INVALID;
    }
    var slot: t40 = txid;
    while slot - WAL_TX_TRACKER_CAPACITY >= 0 {
        slot = slot - WAL_TX_TRACKER_CAPACITY;
    }
    return slot;
}

fn wal_tx_tracker_key_addr(slot: t40) -> t40 {
    return WAL_TX_TRACKER_KEY_BASE + slot;
}

fn wal_tx_tracker_lsn_addr(slot: t40) -> t40 {
    return WAL_TX_TRACKER_LSN_BASE + slot;
}

fn wal_tx_tracker_begin(txid: t40) -> t40 {
    var slot: t40 = wal_tx_tracker_slot(txid);
    if slot < 0 {
        return 0;
    }
    var key_addr: t40 = wal_tx_tracker_key_addr(slot);
    var current: t40 = kload(key_addr);
    if current - txid == 0 {
        return 1;
    }
    if current != 0 {
        // A live modulo collision is intentionally left untracked. Callers
        // use the full ring scan for this transaction instead.
        return 0;
    }
    kstore(key_addr, txid);
    kstore(wal_tx_tracker_lsn_addr(slot), 0);
    return 1;
}

fn wal_tx_tracker_last_lsn(txid: t40) -> t40 {
    var slot: t40 = wal_tx_tracker_slot(txid);
    if slot < 0 {
        return ERR_NOT_FOUND;
    }
    if kload(wal_tx_tracker_key_addr(slot)) - txid != 0 {
        return ERR_NOT_FOUND;
    }
    return kload(wal_tx_tracker_lsn_addr(slot));
}

fn wal_tx_tracker_set_lsn(txid: t40, lsn: t40) -> t40 {
    var slot: t40 = wal_tx_tracker_slot(txid);
    if slot < 0 {
        return 0;
    }
    if kload(wal_tx_tracker_key_addr(slot)) - txid != 0 {
        return 0;
    }
    kstore(wal_tx_tracker_lsn_addr(slot), lsn);
    return 1;
}

fn wal_tx_tracker_clear(txid: t40) -> t40 {
    var slot: t40 = wal_tx_tracker_slot(txid);
    if slot < 0 {
        return 0;
    }
    if kload(wal_tx_tracker_key_addr(slot)) - txid != 0 {
        return 0;
    }
    kstore(wal_tx_tracker_key_addr(slot), 0);
    kstore(wal_tx_tracker_lsn_addr(slot), 0);
    return 1;
}

fn wal_record_checksum(slot: t40) -> t40 {
    var rec: t40 = wal_record_addr(slot);
    var sum: t40 = 17;
    var i: t40 = 0;
    while WAL_RECORD_WORDS - i > 0 {
        if i - WAL_CHECKSUM != 0 {
            sum = sum + kload(rec + i) * (i + 1);
        }
        i = i + 1;
    }
    return sum;
}

fn wal_record_finalize(slot: t40) -> t40 {
    var rec: t40 = wal_record_addr(slot);
    kstore(rec + WAL_CHECKSUM, 0);
    var checksum: t40 = wal_record_checksum(slot);
    kstore(rec + WAL_CHECKSUM, checksum);
    return checksum;
}

fn wal_record_valid(slot: t40) -> t40 {
    if slot < 0 { return 0; }
    if slot - WAL_CAPACITY >= 0 { return 0; }
    var rec: t40 = wal_record_addr(slot);
    if kload(rec + 0) - WAL_MAGIC != 0 { return 0; }
    if kload(rec + 1) - WAL_VERSION != 0 { return 0; }
    var count: t40 = kload(rec + WAL_COUNT);
    if count < 0 { return 0; }
    if count - WAL_PAYLOAD_WORDS > 0 { return 0; }
    if wal_record_checksum(slot) - kload(rec + WAL_CHECKSUM) != 0 {
        return 0;
    }
    return 1;
}

fn wal_used_blocks() -> t40 {
    var head: t40 = kload(WAL_HEAD_ADDR);
    var tail: t40 = kload(WAL_TAIL_ADDR);
    if head - tail >= 0 {
        return head - tail;
    }
    return WAL_CAPACITY - tail + head;
}

fn wal_free_blocks() -> t40 {
    return WAL_CAPACITY - wal_used_blocks() - 1;
}

fn wal_init() -> t40 {
    kclear(WAL_BASE, WAL_CAPACITY * WAL_RECORD_WORDS);
    kclear(WAL_TX_TRACKER_KEY_BASE, WAL_TX_TRACKER_CAPACITY);
    kclear(WAL_TX_TRACKER_LSN_BASE, WAL_TX_TRACKER_CAPACITY);
    kclear(INODE_REQUIRED_LSN_BASE, INODE_REQUIRED_LSN_WORDS);
    kstore(WAL_HEAD_ADDR, 0);
    kstore(WAL_TAIL_ADDR, 0);
    kstore(WAL_NEXT_TXID_ADDR, 1);
    kstore(WAL_CHECKPOINT_ADDR, 0);
    kstore(WAL_NEXT_LSN_ADDR, 1);
    kstore(WAL_DURABLE_LSN_ADDR, 0);
    kstore(WAL_GENERATION_ADDR, 1);
    kstore(WAL_DURABLE_HEAD_ADDR, 0);
    kstore(WAL_PENDING_TX_ADDR, 0);
    kstore(WAL_PENDING_BLOCK_ADDR, 0);
    kstore(WAL_FIRST_PENDING_TICK_ADDR, -1);
    kstore(WAL_ACTIVE_SUPER_ADDR, 0);
    kstore(WAL_LAST_ERROR_ADDR, 0);
    return 1;
}

fn log_begin() -> t40 {
    var txid: t40 = kload(WAL_NEXT_TXID_ADDR);
    kstore(WAL_NEXT_TXID_ADDR, txid + 1);
    wal_tx_tracker_begin(txid);
    return txid;
}

fn log_write(txid: t40, block_addr: t40, old_data: t40, new_data: t40) -> t40 {
    if wal_free_blocks() <= 0 {
        return ERR_NO_SPACE;
    }
    var head: t40 = kload(WAL_HEAD_ADDR);
    var rec: t40 = wal_record_addr(head);
    var previous_lsn: t40 = wal_tx_tracker_last_lsn(txid);
    if previous_lsn < 0 {
        // A live modulo collision (or a legacy transaction started before
        // tracker initialization) falls back to the fully validated ring
        // scan, preserving the original chain semantics.
        previous_lsn = 0;
        var prior_slot: t40 = kload(WAL_TAIL_ADDR);
        var prior_head: t40 = kload(WAL_HEAD_ADDR);
        while prior_slot - prior_head != 0 {
            var prior_rec: t40 = wal_record_addr(prior_slot);
            if wal_record_valid(prior_slot) > 0 {
                if kload(prior_rec + WAL_TXID) - txid == 0 {
                    if kload(prior_rec + WAL_TYPE) - WAL_DATA == 0 {
                        var prior_lsn: t40 = kload(prior_rec + WAL_LSN);
                        if prior_lsn - previous_lsn > 0 {
                            previous_lsn = prior_lsn;
                        }
                    }
                }
            }
            prior_slot = kwrap_inc(prior_slot, WAL_CAPACITY);
        }
    }
    kclear(rec, WAL_RECORD_WORDS);
    kstore(rec + 0, WAL_MAGIC);
    kstore(rec + 1, WAL_VERSION);
    kstore(rec + WAL_GENERATION, kload(WAL_GENERATION_ADDR));
    kstore(rec + WAL_LSN, kload(WAL_NEXT_LSN_ADDR));
    kstore(rec + WAL_TXID, txid);
    kstore(rec + WAL_PREV_LSN, previous_lsn);
    kstore(rec + WAL_TYPE, WAL_DATA);
    kstore(rec + WAL_TARGET_KIND, WAL_TARGET_WORD);
    kstore(rec + WAL_TARGET_ID, 0);
    kstore(rec + WAL_OFFSET, block_addr);
    kstore(rec + WAL_COUNT, 1);
    kstore(rec + WAL_HEADER_WORDS, new_data);
    wal_record_finalize(head);
    wal_tx_tracker_set_lsn(txid, kload(rec + WAL_LSN));
    kstore(WAL_HEAD_ADDR, kwrap_inc(head, WAL_CAPACITY));
    kstore(WAL_NEXT_LSN_ADDR, kload(WAL_NEXT_LSN_ADDR) + 1);
    kstore(WAL_PENDING_BLOCK_ADDR, kload(WAL_PENDING_BLOCK_ADDR) + 1);
    return head;
}

fn log_commit(txid: t40) -> t40 {
    if wal_free_blocks() <= 0 {
        return ERR_NO_SPACE;
    }
    var previous_lsn: t40 = wal_tx_tracker_last_lsn(txid);
    var changed: t40 = 0;
    if previous_lsn < 0 {
        // Preserve correctness for a modulo-colliding active transaction by
        // validating and scanning the complete live ring.
        previous_lsn = 0;
        var slot: t40 = kload(WAL_TAIL_ADDR);
        var scan_head: t40 = kload(WAL_HEAD_ADDR);
        while slot - scan_head != 0 {
            var rec: t40 = wal_record_addr(slot);
            if wal_record_valid(slot) > 0 {
                if kload(rec + WAL_TXID) - txid == 0 {
                    if kload(rec + WAL_TYPE) - WAL_DATA == 0 {
                        var record_lsn: t40 = kload(rec + WAL_LSN);
                        if record_lsn - previous_lsn > 0 {
                            previous_lsn = record_lsn;
                        }
                    }
                }
            }
            slot = kwrap_inc(slot, WAL_CAPACITY);
        }
    }

    var head: t40 = kload(WAL_HEAD_ADDR);
    var commit_rec: t40 = wal_record_addr(head);
    kclear(commit_rec, WAL_RECORD_WORDS);
    kstore(commit_rec + 0, WAL_MAGIC);
    kstore(commit_rec + 1, WAL_VERSION);
    kstore(commit_rec + WAL_GENERATION, kload(WAL_GENERATION_ADDR));
    kstore(commit_rec + WAL_LSN, kload(WAL_NEXT_LSN_ADDR));
    var commit_lsn: t40 = kload(commit_rec + WAL_LSN);
    kstore(commit_rec + WAL_TXID, txid);
    kstore(commit_rec + WAL_PREV_LSN, previous_lsn);
    kstore(commit_rec + WAL_TYPE, WAL_COMMIT);
    kstore(commit_rec + WAL_TARGET_KIND, WAL_TARGET_WORD);
    kstore(commit_rec + WAL_COUNT, 0);
    wal_record_finalize(head);
    wal_tx_tracker_clear(txid);
    kstore(WAL_HEAD_ADDR, kwrap_inc(head, WAL_CAPACITY));
    kstore(WAL_NEXT_LSN_ADDR, kload(WAL_NEXT_LSN_ADDR) + 1);
    kstore(WAL_PENDING_BLOCK_ADDR, kload(WAL_PENDING_BLOCK_ADDR) + 1);

    slot = kload(WAL_TAIL_ADDR);
    scan_head = kload(WAL_HEAD_ADDR);
    while slot - scan_head != 0 {
        var data_rec: t40 = wal_record_addr(slot);
        if wal_record_valid(slot) > 0 {
            if kload(data_rec + WAL_TXID) - txid == 0 {
                if kload(data_rec + WAL_TYPE) - WAL_DATA == 0 {
                    var target: t40 = kload(data_rec + WAL_OFFSET);
                    var count: t40 = kload(data_rec + WAL_COUNT);
                    var i: t40 = 0;
                    while count - i > 0 {
                        kstore(target + i, kload(data_rec + WAL_HEADER_WORDS + i));
                        i = i + 1;
                    }
                    changed = changed + count;
                }
            }
        }
        slot = kwrap_inc(slot, WAL_CAPACITY);
    }

    kstore(WAL_PENDING_TX_ADDR, kload(WAL_PENDING_TX_ADDR) + 1);
    if kload(WAL_FIRST_PENDING_TICK_ADDR) < 0 {
        kstore(WAL_FIRST_PENDING_TICK_ADDR, kload(KERNEL_TICK_ADDR));
    }
    // A bring-up kernel without a block device still needs to make forward
    // progress in its in-memory WAL.  Only attempt the periodic durable sync
    // when a persistent VFS device is actually available; otherwise
    // wal_sync_to_disk() would report ERR_NO_SPACE at the threshold and make
    // ordinary metadata transactions fail even though the ring has capacity.
    if vfs_disk_available() > 0 {
        if kload(WAL_PENDING_TX_ADDR) - 27 >= 0 {
            var sync_status: t40 = wal_sync_to_disk();
            if sync_status < 0 { return sync_status; }
        } else {
            if kload(WAL_PENDING_BLOCK_ADDR) - 27 >= 0 {
                var sync_status: t40 = wal_sync_to_disk();
                if sync_status < 0 { return sync_status; }
            }
        }
    }
    // The commit LSN is the dependency stamped onto affected frames and
    // the owning inode.  Return it rather than the changed-word count.
    return commit_lsn;
}

fn log_abort(txid: t40) -> t40 {
    var slot: t40 = kload(WAL_TAIL_ADDR);
    var scan_head: t40 = kload(WAL_HEAD_ADDR);
    var changed: t40 = 0;
    while slot - scan_head != 0 {
        var rec: t40 = wal_record_addr(slot);
        if wal_record_valid(slot) > 0 {
            if kload(rec + WAL_TXID) - txid == 0 {
                if kload(rec + WAL_TYPE) - WAL_DATA == 0 {
                    // No home-page update occurs before commit, so abort needs
                    // no durable undo record.
                    kstore(rec + WAL_TXID, 0);
                    wal_record_finalize(slot);
                    changed = changed + 1;
                }
            }
        }
        slot = kwrap_inc(slot, WAL_CAPACITY);
    }
    wal_tx_tracker_clear(txid);
    return changed;
}

fn log_recover() -> t40 {
    var changed: t40 = 0;
    var commit_slot: t40 = kload(WAL_TAIL_ADDR);
    var scan_head: t40 = kload(WAL_HEAD_ADDR);
    while commit_slot - scan_head != 0 {
        var commit_rec: t40 = wal_record_addr(commit_slot);
        if wal_record_valid(commit_slot) > 0 {
            if kload(commit_rec + WAL_TYPE) - WAL_COMMIT == 0 {
                var txid: t40 = kload(commit_rec + WAL_TXID);
                var commit_previous_lsn: t40 = kload(commit_rec + WAL_PREV_LSN);
                var data_slot: t40 = kload(WAL_TAIL_ADDR);
                var chain_valid: t40 = 1;
                var have_data: t40 = 0;
                var last_lsn: t40 = 0;
                while data_slot - scan_head != 0 {
                    var data_rec_check: t40 = wal_record_addr(data_slot);
                    if wal_record_valid(data_slot) > 0 {
                        if kload(data_rec_check + WAL_TXID) - txid == 0 {
                            if kload(data_rec_check + WAL_TYPE) - WAL_DATA == 0 {
                                var record_lsn: t40 = kload(data_rec_check + WAL_LSN);
                                var record_previous_lsn: t40 = kload(data_rec_check + WAL_PREV_LSN);
                                if have_data <= 0 {
                                    if record_previous_lsn != 0 {
                                        chain_valid = 0;
                                    }
                                } else {
                                    if record_previous_lsn - last_lsn != 0 {
                                        chain_valid = 0;
                                    }
                                }
                                have_data = 1;
                                last_lsn = record_lsn;
                            }
                        }
                    }
                    data_slot = kwrap_inc(data_slot, WAL_CAPACITY);
                }
                if have_data <= 0 {
                    if commit_previous_lsn != 0 { chain_valid = 0; }
                } else {
                    if commit_previous_lsn - last_lsn != 0 {
                        chain_valid = 0;
                    }
                }
                if chain_valid > 0 {
                    data_slot = kload(WAL_TAIL_ADDR);
                    while data_slot - scan_head != 0 {
                        var data_rec_apply: t40 = wal_record_addr(data_slot);
                        if wal_record_valid(data_slot) > 0 {
                            if kload(data_rec_apply + WAL_TXID) - txid == 0 {
                                if kload(data_rec_apply + WAL_TYPE) - WAL_DATA == 0 {
                                    var target: t40 = kload(data_rec_apply + WAL_OFFSET);
                                    var count: t40 = kload(data_rec_apply + WAL_COUNT);
                                    var i: t40 = 0;
                                    while count - i > 0 {
                                        kstore(target + i, kload(data_rec_apply + WAL_HEADER_WORDS + i));
                                        i = i + 1;
                                    }
                                    changed = changed + count;
                                }
                            }
                        }
                        data_slot = kwrap_inc(data_slot, WAL_CAPACITY);
                    }
                }
            }
        }
        commit_slot = kwrap_inc(commit_slot, WAL_CAPACITY);
    }
    return changed;
}

fn log_checkpoint() -> t40 {
    var cleaned: t40 = wal_used_blocks();
    if vfs_disk_available() <= 0 {
        // Bring-up/no-device checkpoints cannot be durable, but preserve the
        // in-memory boundary used by the bootstrap tests.
        kstore(WAL_CHECKPOINT_ADDR, kload(WAL_DURABLE_LSN_ADDR));
        kstore(WAL_TAIL_ADDR, kload(WAL_HEAD_ADDR));
        return cleaned;
    }

    // 1. Make all committed WAL durable before any home-page write.
    var wal_status: t40 = wal_sync_to_disk();
    if wal_status < 0 { return wal_status; }
    var chosen_lsn: t40 = kload(WAL_DURABLE_LSN_ADDR);

    // 2. Flush pages whose dependency is at or below chosen_lsn and issue the
    // data barrier before the checkpoint record is appended.
    var home_status: t40 = vfs_sync_to_disk();
    if home_status < 0 { return home_status; }

    // 3. Append a checkpoint record describing that ordered home-page image.
    if wal_free_blocks() <= 0 { return ERR_NO_SPACE; }
    var head: t40 = kload(WAL_HEAD_ADDR);
    var checkpoint_rec: t40 = wal_record_addr(head);
    kclear(checkpoint_rec, WAL_RECORD_WORDS);
    kstore(checkpoint_rec + 0, WAL_MAGIC);
    kstore(checkpoint_rec + 1, WAL_VERSION);
    kstore(checkpoint_rec + WAL_GENERATION, kload(WAL_GENERATION_ADDR));
    kstore(checkpoint_rec + WAL_LSN, kload(WAL_NEXT_LSN_ADDR));
    kstore(checkpoint_rec + WAL_TXID, 0);
    kstore(checkpoint_rec + WAL_PREV_LSN, chosen_lsn);
    kstore(checkpoint_rec + WAL_TYPE, WAL_CHECKPOINT);
    kstore(checkpoint_rec + WAL_TARGET_KIND, WAL_TARGET_WORD);
    kstore(checkpoint_rec + WAL_COUNT, 0);
    wal_record_finalize(head);
    kstore(WAL_HEAD_ADDR, kwrap_inc(head, WAL_CAPACITY));
    kstore(WAL_NEXT_LSN_ADDR, kload(WAL_NEXT_LSN_ADDR) + 1);
    kstore(WAL_PENDING_BLOCK_ADDR, kload(WAL_PENDING_BLOCK_ADDR) + 1);

    // 4. Make the checkpoint record durable, then advance the tail in a new
    // checksummed superblock.  The second WAL sync is the tail-order barrier.
    wal_status = wal_sync_to_disk();
    if wal_status < 0 { return wal_status; }
    kstore(WAL_CHECKPOINT_ADDR, chosen_lsn);
    kstore(WAL_TAIL_ADDR, kload(WAL_HEAD_ADDR));
    wal_status = wal_sync_to_disk();
    if wal_status < 0 { return wal_status; }
    return cleaned;
}

fn rel_alloc_addr(ppn: t40) -> t40 {
    return REL_ALLOC_BASE + ppn * REL_ALLOC_WORDS;
}

fn rel_store_init() -> t40 {
    kclear(REL_ALLOC_BASE, BOOTSTRAP_MAX_PAGES * REL_ALLOC_WORDS);
    kstore(REL_ONLINE_ADDR, 1);
    kstore(REL_MIGRATION_CURSOR_ADDR, 0);
    kstore(REL_MIGRATION_DONE_ADDR, 0);
    return 1;
}

fn alloc_row_upsert(ppn: t40, state: t40) -> t40 {
    var row: t40 = rel_alloc_addr(ppn);
    // Physical allocator ownership is transient fast-path state.  Durable
    // allocation truth is reconstructed from VFS metadata at reconciliation.
    kstore(row + REL_ALLOC_STATE, state);
    var version: t40 = kload(row + REL_ALLOC_VERSION);
    kstore(row + REL_ALLOC_VERSION, version + 1);
    return 1;
}

fn migrate_bootstrap_allocations_step(max_rows: t40) -> t40 {
    if kload(REL_ONLINE_ADDR) <= 0 {
        return ERR_INVALID;
    }
    if kload(REL_MIGRATION_DONE_ADDR) > 0 {
        return 0;
    }
    var cursor: t40 = kload(REL_MIGRATION_CURSOR_ADDR);
    var processed: t40 = 0;
    while max_rows - processed > 0 {
        if BOOTSTRAP_MAX_PAGES - cursor <= 0 {
            kstore(REL_MIGRATION_DONE_ADDR, 1);
            return processed;
        }
        if bootstrap_is_allocated(cursor) > 0 {
            alloc_row_upsert(cursor, 1);
        }
        cursor = cursor + 1;
        processed = processed + 1;
        kstore(REL_MIGRATION_CURSOR_ADDR, cursor);
    }
    if BOOTSTRAP_MAX_PAGES - cursor <= 0 {
        kstore(REL_MIGRATION_DONE_ADDR, 1);
    }
    return processed;
}

fn migrate_bootstrap_allocations() -> t40 {
    var total: t40 = 0;
    while kload(REL_MIGRATION_DONE_ADDR) == 0 {
        var step: t40 = migrate_bootstrap_allocations_step(8);
        if step < 0 {
            return step;
        }
        total = total + step;
    }
    return total;
}

fn rel_allocation_state(ppn: t40) -> t40 {
    return kload(rel_alloc_addr(ppn) + REL_ALLOC_STATE);
}

// ── WAL extended API ──────────────────────────────────────────────────────────

// Count PENDING records currently in the WAL ring.
fn log_pending_count() -> t40 {
    return kload(WAL_PENDING_BLOCK_ADDR);
}

// Return 1 if the WAL can absorb `needed` more PENDING records without overflow.
fn log_capacity_for(needed: t40) -> t40 {
    if needed - wal_free_blocks() > 0 { return 0; }
    return 1;
}

// Write `count_words` WAL records for sequential addresses base_addr..base_addr+count_words-1.
// All records share the same txid. Aborts (writes nothing) if insufficient capacity.
fn log_write_range(txid: t40, base_addr: t40, count_words: t40) -> t40 {
    if log_capacity_for(count_words) <= 0 { return ERR_NO_SPACE; }
    var i: t40 = 0;
    while count_words - i > 0 {
        var addr: t40 = base_addr + i;
        var logged: t40 = log_write(txid, addr, kload(addr), kload(addr));
        if logged < 0 {
            log_abort(txid);
            return logged;
        }
        i = i + 1;
    }
    return count_words;
}

// ── MVCC Snapshot table ───────────────────────────────────────────────────────
// A reader acquires a snapshot at the current committed TXID. Subsequent reads
// using `log_visible_to_snapshot` see only records committed before snapshot
// acquisition — giving snapshot-isolation semantics.

fn log_snapshot_row(slot: t40) -> t40 {
    return WAL_SNAPSHOT_BASE + slot * WAL_SNAPSHOT_WORDS;
}

// Acquire a snapshot for `reader_pid`. Returns snapshot slot or ERR_NO_SPACE.
fn log_snapshot_acquire(reader_pid: t40) -> t40 {
    var slot: t40 = 0;
    while WAL_SNAPSHOT_MAX - slot > 0 {
        var row: t40 = log_snapshot_row(slot);
        if kload(row + SNAP_ACTIVE) <= 0 {
            var committed_txid: t40 = kload(WAL_NEXT_TXID_ADDR) - 1;
            if committed_txid < 0 { committed_txid = 0; }
            kstore(row + SNAP_READER_PID, reader_pid);
            kstore(row + SNAP_READ_TXID, committed_txid);
            kstore(row + SNAP_ACTIVE, 1);
            return slot;
        }
        slot = slot + 1;
    }
    return ERR_NO_SPACE;
}

// Release a snapshot slot.
fn log_snapshot_release(slot: t40) -> t40 {
    if slot < 0 { return ERR_INVALID; }
    if slot - WAL_SNAPSHOT_MAX >= 0 { return ERR_INVALID; }
    kclear(log_snapshot_row(slot), WAL_SNAPSHOT_WORDS);
    return 1;
}

// Return 1 if a WAL record committed at `commit_txid` is visible to the
// reader holding `snap_slot`. Visibility: commit_txid <= snap_read_txid.
fn log_visible_to_snapshot(commit_txid: t40, snap_slot: t40) -> t40 {
    if snap_slot < 0 { return 1; } // no snapshot = read latest
    if snap_slot - WAL_SNAPSHOT_MAX >= 0 { return 1; }
    var row: t40 = log_snapshot_row(snap_slot);
    if kload(row + SNAP_ACTIVE) <= 0 { return 1; }
    var read_txid: t40 = kload(row + SNAP_READ_TXID);
    if commit_txid - read_txid > 0 { return 0; } // committed after snapshot
    return 1;
}

// Return the oldest read TXID across all active snapshots.
// Checkpoint must not reclaim WAL records with TXID > this value.
fn log_oldest_snapshot_txid() -> t40 {
    var oldest: t40 = kload(WAL_NEXT_TXID_ADDR);
    var slot: t40 = 0;
    while WAL_SNAPSHOT_MAX - slot > 0 {
        var row: t40 = log_snapshot_row(slot);
        if kload(row + SNAP_ACTIVE) > 0 {
            var rtxid: t40 = kload(row + SNAP_READ_TXID);
            if rtxid - oldest < 0 { oldest = rtxid; }
        }
        slot = slot + 1;
    }
    return oldest;
}

// ── Attribute store (second kernel relation) ──────────────────────────────────
// Schema: (object_id, object_type, attr_key, attr_value, txid, version)
// Provides a general-purpose tag/attribute layer over kernel objects,
// making the kernel state model genuinely relational:
//   Relation 1 — alloc_store(ppn → state, version)
//   Relation 2 — attr_store(object_id, type, key → value, txid, version)
// Joins between the process table and attr_store give subscription-ready
// desired-vs-actual reconciliation without a userspace daemon.

fn attr_row_addr(slot: t40) -> t40 {
    return ATTR_STORE_BASE + slot * ATTR_STORE_WORDS;
}

fn attr_store_init() -> t40 {
    kclear(ATTR_STORE_BASE, ATTR_STORE_MAX * ATTR_STORE_WORDS);
    return 1;
}

// Find a row matching (object_id, type, key). Returns slot or ERR_NOT_FOUND.
fn attr_find(object_id: t40, object_type: t40, key: t40) -> t40 {
    var slot: t40 = 0;
    while ATTR_STORE_MAX - slot > 0 {
        var row: t40 = attr_row_addr(slot);
        if kload(row + ATTR_VERSION) > 0 {
            if kload(row + ATTR_OBJECT_ID) - object_id == 0 {
                if kload(row + ATTR_OBJECT_TYPE) - object_type == 0 {
                    if kload(row + ATTR_KEY) - key == 0 {
                        return slot;
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

// Insert or overwrite an attribute. WAL-backed.
fn attr_insert(object_id: t40, object_type: t40, key: t40, value: t40) -> t40 {
    // Upsert: if the (object_id, type, key) tuple already exists, update it.
    var slot: t40 = attr_find(object_id, object_type, key);
    if slot < 0 {
        // Allocate first free row (version == 0 means unoccupied).
        var s: t40 = 0;
        var found: t40 = -1;
        while ATTR_STORE_MAX - s > 0 {
            if found < 0 {
                if kload(attr_row_addr(s) + ATTR_VERSION) <= 0 {
                    found = s;
                }
            }
            s = s + 1;
        }
        if found < 0 { return ERR_NO_SPACE; }
        slot = found;
    }
    var row: t40 = attr_row_addr(slot);
    var txid: t40 = log_begin();
    var logged: t40 = log_write(txid, row + ATTR_VALUE, kload(row + ATTR_VALUE), value);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    kstore(row + ATTR_OBJECT_ID, object_id);
    kstore(row + ATTR_OBJECT_TYPE, object_type);
    kstore(row + ATTR_KEY, key);
    kstore(row + ATTR_TXID, txid);
    var ver: t40 = kload(row + ATTR_VERSION) + 1;
    if ver <= 0 { ver = 1; }
    kstore(row + ATTR_VERSION, ver);
    var commit_status: t40 = log_commit(txid);
    if commit_status < 0 { return commit_status; }
    return slot;
}


// Delete an attribute row. WAL-backed.
fn attr_delete(object_id: t40, object_type: t40, key: t40) -> t40 {
    var slot: t40 = attr_find(object_id, object_type, key);
    if slot < 0 { return slot; }
    var row: t40 = attr_row_addr(slot);
    var txid: t40 = log_begin();
    var logged: t40 = log_write(txid, row + ATTR_VERSION, kload(row + ATTR_VERSION), 0);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var commit_status: t40 = log_commit(txid);
    if commit_status < 0 { return commit_status; }
    kclear(row, ATTR_STORE_WORDS);
    return 1;
}

// Look up an attribute value. Returns value or ERR_NOT_FOUND.
fn attr_lookup(object_id: t40, object_type: t40, key: t40) -> t40 {
    var slot: t40 = attr_find(object_id, object_type, key);
    if slot < 0 { return slot; }
    return kload(attr_row_addr(slot) + ATTR_VALUE);
}

// Snapshot-isolated attribute lookup.
fn attr_lookup_snap(object_id: t40, object_type: t40, key: t40, snap_slot: t40) -> t40 {
    var s: t40 = 0;
    while ATTR_STORE_MAX - s > 0 {
        var row: t40 = attr_row_addr(s);
        if kload(row + ATTR_VERSION) > 0 {
            if kload(row + ATTR_OBJECT_ID) - object_id == 0 {
                if kload(row + ATTR_OBJECT_TYPE) - object_type == 0 {
                    if kload(row + ATTR_KEY) - key == 0 {
                        if log_visible_to_snapshot(kload(row + ATTR_TXID), snap_slot) > 0 {
                            return kload(row + ATTR_VALUE);
                        }
                    }
                }
            }
        }
        s = s + 1;
    }
    return ERR_NOT_FOUND;
}

// Scan all attributes for a given object. Writes [key, value] pairs to out_addr.
// Returns count of pairs written.
fn attr_scan_by_object(object_id: t40, out_addr: t40, max_rows: t40) -> t40 {
    var written: t40 = 0;
    var slot: t40 = 0;
    while ATTR_STORE_MAX - slot > 0 {
        var row: t40 = attr_row_addr(slot);
        if kload(row + ATTR_VERSION) > 0 {
            if kload(row + ATTR_OBJECT_ID) - object_id == 0 {
                if written - max_rows < 0 {
                    kstore(out_addr + written * 2, kload(row + ATTR_KEY));
                    kstore(out_addr + written * 2 + 1, kload(row + ATTR_VALUE));
                    written = written + 1;
                }
            }
        }
        slot = slot + 1;
    }
    return written;
}

// Scan all objects sharing a (type, key). Writes [object_id, value] pairs.
fn attr_scan_by_type(object_type: t40, key: t40, out_addr: t40, max_rows: t40) -> t40 {
    var written: t40 = 0;
    var slot: t40 = 0;
    while ATTR_STORE_MAX - slot > 0 {
        var row: t40 = attr_row_addr(slot);
        if kload(row + ATTR_VERSION) > 0 {
            if kload(row + ATTR_OBJECT_TYPE) - object_type == 0 {
                if kload(row + ATTR_KEY) - key == 0 {
                    if written - max_rows < 0 {
                        kstore(out_addr + written * 2, kload(row + ATTR_OBJECT_ID));
                        kstore(out_addr + written * 2 + 1, kload(row + ATTR_VALUE));
                        written = written + 1;
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return written;
}

// Cross-table join: process table (pid→state) ⋈ attr_store (pid, PROCESS, key).
// Returns the attribute value for a live process, or ERR_NOT_FOUND.
fn rel_join_proc_attr(pid: t40, key: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 { return slot; }
    return attr_lookup(pid, ATTR_TYPE_PROCESS, key);
}

// Relational reconciliation query:
// Returns count of processes where DESIRED_STATE attribute != current PROC_STATE.
// This is the Kubernetes control-loop primitive expressed as a relational scan.
fn rel_reconcile_count() -> t40 {
    var count: t40 = 0;
    var slot: t40 = 0;
    while PROCESS_MAX - slot > 0 {
        var row: t40 = process_addr(slot);
        var state: t40 = kload(row + PROC_STATE);
        if state > 0 {
            var pid: t40 = kload(row + PROC_PID);
            var desired: t40 = attr_lookup(pid, ATTR_TYPE_PROCESS, ATTR_KEY_DESIRED_STATE);
            if desired >= 0 {
                if desired - state != 0 {
                    count = count + 1;
                }
            }
        }
        slot = slot + 1;
    }
    return count;
}

fn scheduler_init() -> t40 {
    var i: t40 = 0;
    while TIER1_CAPACITY - i > 0 {
        kstore(TIER1_QUEUE_BASE + i, -1);
        i = i + 1;
    }
    i = 0;
    while MACRO_CAPACITY - i > 0 {
        kstore(MACRO_QUEUE_BASE + i, -1);
        i = i + 1;
    }
    kstore(TIER1_HEAD_ADDR, 0);
    kstore(TIER1_TAIL_ADDR, 0);
    kstore(TIER1_COUNT_ADDR, 0);
    kstore(MACRO_COUNT_ADDR, 0);
    kstore(SCHED_EPOCH_ADDR, 0);
    kstore(KERNEL_TICK_ADDR, 0);
    kstore(INPUT_LAST_MOUSE_X_ADDR, 0);
    kstore(INPUT_LAST_MOUSE_Y_ADDR, 0);
    kstore(INPUT_LAST_MOUSE_BTN_ADDR, 0);
    kclear(SCHED_SLOT_GENERATION_BASE, PROCESS_MAX);
    kclear(SCHED_SLOT_MEMBER_BASE, PROCESS_MAX);
    kclear(TIER1_QUEUE_GENERATION_BASE, TIER1_CAPACITY);
    kclear(PID_INDEX_KEY_BASE, PID_INDEX_CAPACITY);
    var pid_index_slot: t40 = 0;
    while PID_INDEX_CAPACITY - pid_index_slot > 0 {
        kstore(PID_INDEX_SLOT_BASE + pid_index_slot, -1);
        pid_index_slot = pid_index_slot + 1;
    }
    var timer_bucket: t40 = 0;
    while TIMER_WHEEL_BUCKETS - timer_bucket > 0 {
        kstore(TIMER_WHEEL_HEAD_BASE + timer_bucket, -1);
        timer_bucket = timer_bucket + 1;
    }
    timer_bucket = 0;
    while PROCESS_MAX - timer_bucket > 0 {
        kstore(TIMER_WHEEL_NEXT_BASE + timer_bucket, -1);
        timer_bucket = timer_bucket + 1;
    }
    wait_queue_init();
    return 1;
}

fn scheduler_invalidate_slot(process_slot: t40) -> t40 {
    if process_slot < 0 { return ERR_INVALID; }
    if process_slot - PROCESS_MAX >= 0 { return ERR_INVALID; }
    kstore(SCHED_SLOT_MEMBER_BASE + process_slot, 0);
    var generation: t40 =
        kload(SCHED_SLOT_GENERATION_BASE + process_slot) + 1;
    kstore(SCHED_SLOT_GENERATION_BASE + process_slot, generation);
    return generation;
}

fn tier1_enqueue(process_slot: t40) -> t40 {
    if process_slot < 0 { return ERR_INVALID; }
    if process_slot - PROCESS_MAX >= 0 { return ERR_INVALID; }
    if kload(SCHED_SLOT_MEMBER_BASE + process_slot) > 0 {
        return 1;
    }
    var count: t40 = kacq(TIER1_COUNT_ADDR);
    if count - TIER1_CAPACITY >= 0 {
        return ERR_NO_SPACE;
    }
    var tail: t40 = kacq(TIER1_TAIL_ADDR);
    var slot_addr: t40 = TIER1_QUEUE_BASE + tail;
    var status: t40 = kcas(slot_addr, -1, process_slot);
    if status <= 0 {
        return ERR_INVALID;
    }
    var generation: t40 =
        kload(SCHED_SLOT_GENERATION_BASE + process_slot) + 1;
    kstore(SCHED_SLOT_GENERATION_BASE + process_slot, generation);
    kstore(TIER1_QUEUE_GENERATION_BASE + tail, generation);
    kstore(SCHED_SLOT_MEMBER_BASE + process_slot, 1);
    kstore(TIER1_TAIL_ADDR, kwrap_inc(tail, TIER1_CAPACITY));
    kstore(TIER1_COUNT_ADDR, count + 1);
    return 1;
}

fn tier1_dequeue() -> t40 {
    var skipped: t40 = 0;
    while TIER1_CAPACITY - skipped > 0 {
        var count: t40 = kacq(TIER1_COUNT_ADDR);
        if count <= 0 {
            return ERR_NOT_FOUND;
        }
        var head: t40 = kacq(TIER1_HEAD_ADDR);
        var slot_addr: t40 = TIER1_QUEUE_BASE + head;
        var process_slot: t40 = kacq(slot_addr);
        var queued_generation: t40 =
            kload(TIER1_QUEUE_GENERATION_BASE + head);
        kcas(slot_addr, process_slot, -1);
        kstore(TIER1_QUEUE_GENERATION_BASE + head, 0);
        kstore(TIER1_HEAD_ADDR, kwrap_inc(head, TIER1_CAPACITY));
        kstore(TIER1_COUNT_ADDR, count - 1);
        if process_slot >= 0 {
            if process_slot - PROCESS_MAX < 0 {
                if kload(SCHED_SLOT_MEMBER_BASE + process_slot) > 0 {
                    if kload(SCHED_SLOT_GENERATION_BASE + process_slot) -
                            queued_generation == 0 {
                        kstore(SCHED_SLOT_MEMBER_BASE + process_slot, 0);
                        return process_slot;
                    }
                }
            }
        }
        skipped = skipped + 1;
    }
    return ERR_NOT_FOUND;
}

fn macro_stage_thread(process_slot: t40) -> t40 {
    var count: t40 = kload(MACRO_COUNT_ADDR);
    if count - MACRO_CAPACITY >= 0 {
        return ERR_NO_SPACE;
    }
    kstore(MACRO_QUEUE_BASE + count, process_slot);
    kstore(MACRO_COUNT_ADDR, count + 1);
    return 1;
}

fn macro_publish() -> t40 {
    var count: t40 = kacq(MACRO_COUNT_ADDR);
    var i: t40 = 0;
    var published: t40 = 0;
    while count - i > 0 {
        var process_slot: t40 = kload(MACRO_QUEUE_BASE + i);
        if process_slot >= 0 {
            var ok: t40 = tier1_enqueue(process_slot);
            if ok > 0 {
                published = published + 1;
            }
            kstore(MACRO_QUEUE_BASE + i, -1);
        }
        i = i + 1;
    }
    kstore(MACRO_COUNT_ADDR, 0);
    var epoch: t40 = kacq(SCHED_EPOCH_ADDR);
    kcas(SCHED_EPOCH_ADDR, epoch, epoch + 1);
    return published;
}

fn scheduler_epoch() -> t40 {
    return kacq(SCHED_EPOCH_ADDR);
}

fn process_addr(slot: t40) -> t40 {
    return PROCESS_BASE + slot * PROCESS_ROW_WORDS;
}

fn pid_index_hash(pid: t40) -> t40 {
    if pid <= 0 { return 0; }
    var index: t40 = pid;
    while index - PID_INDEX_CAPACITY >= 0 {
        index = index - PID_INDEX_CAPACITY;
    }
    return index;
}

fn pid_index_find(pid: t40) -> t40 {
    if pid <= 0 { return ERR_NOT_FOUND; }
    var index: t40 = pid_index_hash(pid);
    var probes: t40 = 0;
    while PID_INDEX_CAPACITY - probes > 0 {
        var key: t40 = kload(PID_INDEX_KEY_BASE + index);
        if key - PID_INDEX_EMPTY == 0 {
            return ERR_NOT_FOUND;
        }
        if key - pid == 0 {
            return kload(PID_INDEX_SLOT_BASE + index);
        }
        index = kwrap_inc(index, PID_INDEX_CAPACITY);
        probes = probes + 1;
    }
    return ERR_NOT_FOUND;
}

fn pid_index_insert(pid: t40, process_slot: t40) -> t40 {
    if pid <= 0 { return ERR_INVALID; }
    if process_slot < 0 { return ERR_INVALID; }
    if process_slot - PROCESS_MAX >= 0 { return ERR_INVALID; }
    var index: t40 = pid_index_hash(pid);
    var first_tombstone: t40 = -1;
    var probes: t40 = 0;
    while PID_INDEX_CAPACITY - probes > 0 {
        var key: t40 = kload(PID_INDEX_KEY_BASE + index);
        if key - pid == 0 {
            kstore(PID_INDEX_SLOT_BASE + index, process_slot);
            return process_slot;
        }
        if key - PID_INDEX_TOMBSTONE == 0 {
            if first_tombstone < 0 { first_tombstone = index; }
        }
        if key - PID_INDEX_EMPTY == 0 {
            var target: t40 = index;
            if first_tombstone >= 0 { target = first_tombstone; }
            kstore(PID_INDEX_KEY_BASE + target, pid);
            kstore(PID_INDEX_SLOT_BASE + target, process_slot);
            return process_slot;
        }
        index = kwrap_inc(index, PID_INDEX_CAPACITY);
        probes = probes + 1;
    }
    if first_tombstone >= 0 {
        kstore(PID_INDEX_KEY_BASE + first_tombstone, pid);
        kstore(PID_INDEX_SLOT_BASE + first_tombstone, process_slot);
        return process_slot;
    }
    return ERR_NO_SPACE;
}

fn pid_index_remove(pid: t40) -> t40 {
    if pid <= 0 { return ERR_NOT_FOUND; }
    var index: t40 = pid_index_hash(pid);
    var probes: t40 = 0;
    while PID_INDEX_CAPACITY - probes > 0 {
        var key: t40 = kload(PID_INDEX_KEY_BASE + index);
        if key - PID_INDEX_EMPTY == 0 { return ERR_NOT_FOUND; }
        if key - pid == 0 {
            kstore(PID_INDEX_KEY_BASE + index, PID_INDEX_TOMBSTONE);
            kstore(PID_INDEX_SLOT_BASE + index, -1);
            return 1;
        }
        index = kwrap_inc(index, PID_INDEX_CAPACITY);
        probes = probes + 1;
    }
    return ERR_NOT_FOUND;
}

fn process_heap_addr(slot: t40) -> t40 {
    return PROCESS_HEAP_BASE + slot * PROCESS_HEAP_WORDS;
}

fn process_arch_addr(slot: t40) -> t40 {
    return PROCESS_ARCH_BASE + slot * PROCESS_ARCH_WORDS;
}

fn process_arch_set_v2(slot: t40) -> t40 {
    var arch: t40 = process_arch_addr(slot);
    kstore(arch + PROC_ARCH_EXEC_VERSION, EXEC_V2_VERSION);
    kstore(arch + PROC_ARCH_FUNCTION_ABI, EXEC_V2_FUNCTION_ABI);
    kstore(arch + PROC_ARCH_SYSCALL_ABI, EXEC_V2_SYSCALL_ABI);
    kstore(arch + PROC_ARCH_ISA, EXEC_V2_ISA);
    kstore(arch + PROC_ARCH_FEATURES, 1);
    kstore(arch + PROC_ARCH_FLAGS, 0);
    return 1;
}

fn process_arch_copy(dst_slot: t40, src_slot: t40) -> t40 {
    var dst: t40 = process_arch_addr(dst_slot);
    var src: t40 = process_arch_addr(src_slot);
    var word: t40 = 0;
    while PROCESS_ARCH_WORDS - word > 0 {
        kstore(dst + word, kload(src + word));
        word = word + 1;
    }
    return 1;
}

fn quota_addr(slot: t40) -> t40 {
    return QUOTA_BASE + slot * QUOTA_ROW_WORDS;
}

fn process_default_context_addr(slot: t40) -> t40 {
    return PROCESS_CONTEXT_BASE + slot * TASK_CONTEXT_WORDS;
}

fn process_default_context_v3_addr(slot: t40) -> t40 {
    return PROCESS_CONTEXT_V3_BASE + slot * TASK_CONTEXT_V3_WORDS;
}

fn process_v3_context_addr_valid(context_addr: t40) -> t40 {
    if context_addr - PROCESS_CONTEXT_V3_BASE < 0 {
        return 0;
    }
    if context_addr - (PROCESS_CONTEXT_V3_BASE +
                       PROCESS_MAX * TASK_CONTEXT_V3_WORDS -
                       TASK_CONTEXT_V3_WORDS) > 0 {
        return 0;
    }
    return 1;
}

// Prepare only the process-owned v3 storage. Scalar state remains in the v2
// task record. The native VCTX entry points save/restore this allocation at
// the kernel boundary; this routine is also used for fork/exec/reuse reset.
fn process_prepare_v3_context(slot: t40) -> t40 {
    if slot < 0 { return ERR_INVALID; }
    if slot - PROCESS_MAX >= 0 { return ERR_INVALID; }
    var context_addr: t40 = process_default_context_v3_addr(slot);
    if process_v3_context_addr_valid(context_addr) <= 0 {
        return ERR_INVALID;
    }
    kclear(context_addr, TASK_CONTEXT_V3_WORDS);
    kstore(context_addr + TASK_CONTEXT_V3_HEADER_VERSION,
           EXEC_V3_CONTEXT_VERSION);
    kstore(context_addr + TASK_CONTEXT_V3_HEADER_LENGTH,
           TASK_CONTEXT_V3_WORDS);
    kstore(context_addr + TASK_CONTEXT_V3_HEADER_VECTOR_ABI, 1);
    kstore(context_addr + TASK_CONTEXT_V3_HEADER_REGISTER_COUNT, 8);
    kstore(context_addr + TASK_CONTEXT_V3_VLEN, EXEC_V3_VECTOR_LANE_COUNT);
    kstore(context_addr + TASK_CONTEXT_V3_ACCUMULATOR, 0);
    kstore(context_addr + TASK_CONTEXT_V3_FIRST_FAILING_LANE, -1);
    var lane: t40 = 0;
    while EXEC_V3_VECTOR_LANE_COUNT - lane > 0 {
        // The host VM stores one exact tagged fault record per lane. Kernel
        // initialization clears those records; the common layout reserves
        // 27 words beginning at the same offset.
        kstore(context_addr + TASK_CONTEXT_V3_FAULT_BASE + lane, 0);
        lane = lane + 1;
    }
    return context_addr;
}

fn process_vector_context_addr(slot: t40) -> t40 {
    if slot < 0 { return ERR_INVALID; }
    if slot - PROCESS_MAX >= 0 { return ERR_INVALID; }
    var addr: t40 = kload(process_addr(slot) + PROC_VECTOR_CONTEXT);
    if process_v3_context_addr_valid(addr) <= 0 { return ERR_INVALID; }
    return addr;
}

fn process_vector_context_reset(slot: t40) -> t40 {
    var addr: t40 = process_prepare_v3_context(slot);
    if addr < 0 { return addr; }
    kstore(process_addr(slot) + PROC_VECTOR_CONTEXT, addr);
    return addr;
}

fn process_vector_context_copy(dst_slot: t40, src_slot: t40) -> t40 {
    var dst: t40 = process_vector_context_addr(dst_slot);
    var src: t40 = process_vector_context_addr(src_slot);
    if dst < 0 { return dst; }
    if src < 0 { return src; }
    var word: t40 = 0;
    while TASK_CONTEXT_V3_WORDS - word > 0 {
        kstore(dst + word, kload(src + word));
        word = word + 1;
    }
    return dst;
}

// These two hooks are the kernel-side lifecycle boundary for the privileged
// VCTXSTORE/VCTXLOAD instructions. The native dispatcher supplies the current
// vector file; the process table owns only the validated destination pointer.
fn process_vector_context_save(slot: t40) -> t40 {
    return process_vector_context_addr(slot);
}

fn process_vector_context_restore(slot: t40) -> t40 {
    return process_vector_context_addr(slot);
}

fn process_table_init() -> t40 {
    kclear(PROCESS_BASE, PROCESS_MAX * PROCESS_ROW_WORDS);
    kclear(QUOTA_BASE, QUOTA_MAX * QUOTA_ROW_WORDS);
    kclear(PROCESS_CONTEXT_BASE, PROCESS_MAX * TASK_CONTEXT_WORDS);
    // V3 vector contexts are initialized lazily by process_create and reset
    // on task-slot reuse.  Avoid clearing the full 100 x 279-word arena on
    // every scheduler/process-table reset; no unowned slot is observable.
    kclear(PROCESS_HEAP_BASE, PROCESS_MAX * PROCESS_HEAP_WORDS);
    kclear(PROCESS_ARCH_BASE, PROCESS_MAX * PROCESS_ARCH_WORDS);
    kclear(DESIRED_PROCESS_BASE, PROCESS_MAX);
    kclear(WAIT_CHANNEL_BASE, PROCESS_MAX);
    kclear(PROC_PARENT_PID_BASE, PROCESS_MAX);
    kclear(PROC_EXIT_STATUS_BASE, PROCESS_MAX);
    kclear(PROC_SIGNAL_PENDING_BASE, PROCESS_MAX);
    kclear(PROC_CLEANED_BASE, PROCESS_MAX);
    kclear(PROC_CAPS_BASE, PROCESS_MAX);
    var i: t40 = 0;
    while QUOTA_MAX - i > 0 {
        var q: t40 = quota_addr(i);
        kstore(q + QUOTA_ID, i);
        kstore(q + QUOTA_LIMIT, QUOTA_DEFAULT_LIMIT);
        kstore(q + QUOTA_USED, 0);
        kstore(q + QUOTA_VERSION, 1);
        i = i + 1;
    }
    return 1;
}

fn process_create(slot: t40, pid: t40, namespace_id: t40, priority: t40, quota_id: t40, context_addr: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = process_addr(slot);
    var ctx: t40 = context_addr;
    if ctx <= 0 {
        ctx = process_default_context_addr(slot);
    }
    if process_find_pid(pid) >= 0 { return ERR_INVALID; }
    kstore(row + PROC_PID, pid);
    kstore(row + PROC_STATE, PROC_RUNNABLE);
    kstore(row + PROC_NAMESPACE, namespace_id);
    kstore(row + PROC_PRIORITY, priority);
    kstore(row + PROC_QUOTA, quota_id);
    kstore(row + PROC_CONTEXT, ctx);
    var vector_ctx: t40 = process_prepare_v3_context(slot);
    if vector_ctx < 0 { return vector_ctx; }
    kstore(row + PROC_VECTOR_CONTEXT, vector_ctx);
    kstore(row + PROC_WAIT_CHANNEL, 0);
    kstore(PROC_PARENT_PID_BASE + slot, -1);
    kstore(PROC_EXIT_STATUS_BASE + slot, 0);
    kstore(PROC_SIGNAL_PENDING_BASE + slot, 0);
    kstore(PROC_CLEANED_BASE + slot, 0);
    kstore(PROC_CAPS_BASE + slot, 0);
    process_arch_set_v2(slot);
    var heap: t40 = process_heap_addr(slot);
    kstore(heap + PROC_HEAP_START, MMU_PAGE_WORDS);
    kstore(heap + PROC_HEAP_BREAK, MMU_PAGE_WORDS);
    kstore(heap + PROC_HEAP_LIMIT, PROCESS_DATA_PAGES_MAX * MMU_PAGE_WORDS);
    kstore(heap + PROC_HEAP_MAPPED_PAGES, 1);
    if pid_index_insert(pid, slot) < 0 { return ERR_NO_SPACE; }
    kstore(row + PROC_VERSION, kload(row + PROC_VERSION) + 1);
    kstore(DESIRED_PROCESS_BASE + slot, 1);
    translation_cache_invalidate(slot);
    tier1_enqueue(slot);
    return pid;
}

fn process_state(slot: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    return kload(process_addr(slot) + PROC_STATE);
}

fn process_find_pid(pid: t40) -> t40 {
    var slot: t40 = pid_index_find(pid);
    if slot < 0 { return slot; }
    var row: t40 = process_addr(slot);
    if kload(row + PROC_PID) - pid != 0 { return ERR_NOT_FOUND; }
    if kload(row + PROC_STATE) <= 0 { return ERR_NOT_FOUND; }
    return slot;
}

fn process_set_parent(slot: t40, parent_pid: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    kstore(PROC_PARENT_PID_BASE + slot, parent_pid);
    return parent_pid;
}

fn process_set_caps(slot: t40, caps: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    kstore(PROC_CAPS_BASE + slot, caps);
    translation_cache_invalidate(slot);
    return caps;
}

fn process_has_cap(slot: t40, cap: t40) -> t40 {
    if slot < 0 {
        return 0;
    }
    if slot - PROCESS_MAX >= 0 {
        return 0;
    }
    return app_cap_has(kload(PROC_CAPS_BASE + slot), cap);
}

fn process_control_authorized(caller_pid: t40, target_pid: t40) -> t40 {
    var caller_slot: t40 = process_find_pid(caller_pid);
    if caller_slot < 0 {
        return caller_slot;
    }
    var target_slot: t40 = process_find_pid(target_pid);
    if target_slot < 0 {
        return target_slot;
    }
    if caller_pid - target_pid == 0 {
        return 1;
    }
    if caller_pid - 1 == 0 {
        return 1;
    }
    if process_has_cap(caller_slot, APP_CAP_PROCESS) > 0 {
        return 1;
    }
    if kload(PROC_PARENT_PID_BASE + target_slot) - caller_pid == 0 {
        return 1;
    }
    return ERR_INVALID;
}

fn process_terminal_state(state: t40) -> t40 {
    if state - PROC_EXITED == 0 {
        return 1;
    }
    if state - PROC_ZOMBIE == 0 {
        return 1;
    }
    if state - PROC_CRASHED == 0 {
        return 1;
    }
    return 0;
}

fn signal_valid(signal: t40) -> t40 {
    if signal - SIGNAL_TERM == 0 { return 1; }
    if signal - SIGNAL_KILL == 0 { return 1; }
    if signal - SIGNAL_STOP == 0 { return 1; }
    if signal - SIGNAL_CONT == 0 { return 1; }
    if signal - SIGNAL_CLOSE_REQUEST == 0 { return 1; }
    return 0;
}

fn signal_has(mask: t40, signal: t40) -> t40 {
    var cursor: t40 = mask;
    if cursor - SIGNAL_CLOSE_REQUEST >= 0 {
        if signal - SIGNAL_CLOSE_REQUEST == 0 { return 1; }
        cursor = cursor - SIGNAL_CLOSE_REQUEST;
    }
    if cursor - SIGNAL_CONT >= 0 {
        if signal - SIGNAL_CONT == 0 { return 1; }
        cursor = cursor - SIGNAL_CONT;
    }
    if cursor - SIGNAL_STOP >= 0 {
        if signal - SIGNAL_STOP == 0 { return 1; }
        cursor = cursor - SIGNAL_STOP;
    }
    if cursor - SIGNAL_KILL >= 0 {
        if signal - SIGNAL_KILL == 0 { return 1; }
        cursor = cursor - SIGNAL_KILL;
    }
    if cursor - SIGNAL_TERM >= 0 {
        if signal - SIGNAL_TERM == 0 { return 1; }
    }
    return 0;
}

fn signal_add(mask: t40, signal: t40) -> t40 {
    if signal_has(mask, signal) > 0 {
        return mask;
    }
    return mask + signal;
}

fn signal_remove(mask: t40, signal: t40) -> t40 {
    if signal_has(mask, signal) <= 0 {
        return mask;
    }
    return mask - signal;
}

fn process_add_signal(slot: t40, signal: t40) -> t40 {
    if signal_valid(signal) <= 0 {
        return ERR_INVALID;
    }
    var pending: t40 = kload(PROC_SIGNAL_PENDING_BASE + slot);
    pending = signal_add(pending, signal);
    kstore(PROC_SIGNAL_PENDING_BASE + slot, pending);
    return pending;
}

fn process_clear_wait(slot: t40) -> t40 {
    return wait_clear_slot(slot);
}

fn process_wake_for_signal(slot: t40) -> t40 {
    var state: t40 = process_state(slot);
    if state - PROC_BLOCKED == 0 {
        process_clear_wait(slot);
        return process_set_state(slot, PROC_RUNNABLE);
    }
    if state - PROC_SLEEPING == 0 {
        process_clear_wait(slot);
        return process_set_state(slot, PROC_RUNNABLE);
    }
    return state;
}

fn process_namespace_for_pid(pid: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return 0;
    }
    return kload(process_addr(slot) + PROC_NAMESPACE);
}

fn process_set_state(slot: t40, state: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = process_addr(slot);
    var old_state: t40 = kload(row + PROC_STATE);
    if old_state - state == 0 { return state; }
    if old_state - PROC_RUNNABLE == 0 {
        scheduler_invalidate_slot(slot);
    } else {
        if old_state - PROC_RUNNING == 0 {
            scheduler_invalidate_slot(slot);
        }
    }
    kstore(row + PROC_STATE, state);
    kstore(row + PROC_VERSION, kload(row + PROC_VERSION) + 1);
    if state - PROC_RUNNABLE == 0 {
        tier1_enqueue(slot);
    }
    return state;
}

fn wait_queue_addr(slot: t40) -> t40 {
    return WAIT_QUEUE_BASE + slot * WAIT_QUEUE_WORDS;
}

fn wait_queue_init() -> t40 {
    kclear(WAIT_QUEUE_BASE, WAIT_QUEUE_MAX * WAIT_QUEUE_WORDS);
    kclear(WAIT_QUEUE_TAIL_BASE, WAIT_QUEUE_MAX);
    kclear(WAIT_KIND_BASE, PROCESS_MAX);
    kclear(WAIT_DEADLINE_BASE, PROCESS_MAX);
    kclear(WAIT_ARG0_BASE, PROCESS_MAX);
    kclear(WAIT_ARG1_BASE, PROCESS_MAX);
    kclear(WAIT_ARG2_BASE, PROCESS_MAX);
    var i: t40 = 0;
    while WAIT_QUEUE_MAX - i > 0 {
        kstore(wait_queue_addr(i) + WQ_HEAD, -1);
        kstore(WAIT_QUEUE_TAIL_BASE + i, -1);
        i = i + 1;
    }
    i = 0;
    while PROCESS_MAX - i > 0 {
        kstore(WAIT_PROC_NEXT_BASE + i, -1);
        kstore(WAIT_DEADLINE_BASE + i, WAIT_NO_DEADLINE);
        i = i + 1;
    }
    return 1;
}

fn wait_queue_find(channel: t40) -> t40 {
    var slot: t40 = 0;
    while WAIT_QUEUE_MAX - slot > 0 {
        var row: t40 = wait_queue_addr(slot);
        if kload(row + WQ_VERSION) > 0 {
            if kload(row + WQ_CHANNEL) - channel == 0 {
                return slot;
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

fn wait_queue_get(channel: t40) -> t40 {
    var found: t40 = wait_queue_find(channel);
    if found >= 0 {
        return found;
    }
    var slot: t40 = 0;
    while WAIT_QUEUE_MAX - slot > 0 {
        var row: t40 = wait_queue_addr(slot);
        if kload(row + WQ_VERSION) <= 0 {
            kstore(row + WQ_CHANNEL, channel);
            kstore(row + WQ_HEAD, -1);
            kstore(WAIT_QUEUE_TAIL_BASE + slot, -1);
            kstore(row + WQ_VERSION, 1);
            return slot;
        }
        slot = slot + 1;
    }
    return ERR_NO_SPACE;
}

fn wait_queue_remove_proc(channel: t40, proc_slot: t40) -> t40 {
    if proc_slot < 0 {
        return ERR_INVALID;
    }
    var queue_slot: t40 = wait_queue_find(channel);
    if queue_slot < 0 {
        return 0;
    }
    var row: t40 = wait_queue_addr(queue_slot);
    var prev: t40 = -1;
    var cur: t40 = kload(row + WQ_HEAD);
    while cur >= 0 {
        var next: t40 = kload(WAIT_PROC_NEXT_BASE + cur);
        if cur - proc_slot == 0 {
            if prev < 0 {
                kstore(row + WQ_HEAD, next);
            } else {
                kstore(WAIT_PROC_NEXT_BASE + prev, next);
            }
            if kload(WAIT_QUEUE_TAIL_BASE + queue_slot) - proc_slot == 0 {
                kstore(WAIT_QUEUE_TAIL_BASE + queue_slot, prev);
            }
            kstore(WAIT_PROC_NEXT_BASE + proc_slot, -1);
            kstore(row + WQ_VERSION, kload(row + WQ_VERSION) + 1);
            return 1;
        }
        prev = cur;
        cur = next;
    }
    return 0;
}

fn wait_queue_push(channel: t40, proc_slot: t40) -> t40 {
    if proc_slot < 0 {
        return ERR_INVALID;
    }
    if proc_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var queue_slot: t40 = wait_queue_get(channel);
    if queue_slot < 0 {
        return queue_slot;
    }
    wait_queue_remove_proc(channel, proc_slot);
    var row: t40 = wait_queue_addr(queue_slot);
    var tail: t40 = kload(WAIT_QUEUE_TAIL_BASE + queue_slot);
    kstore(WAIT_PROC_NEXT_BASE + proc_slot, -1);
    if tail < 0 {
        kstore(row + WQ_HEAD, proc_slot);
    } else {
        kstore(WAIT_PROC_NEXT_BASE + tail, proc_slot);
    }
    kstore(WAIT_QUEUE_TAIL_BASE + queue_slot, proc_slot);
    kstore(row + WQ_VERSION, kload(row + WQ_VERSION) + 1);
    return 1;
}

fn wait_queue_pop(channel: t40) -> t40 {
    var queue_slot: t40 = wait_queue_find(channel);
    if queue_slot < 0 {
        return ERR_NOT_FOUND;
    }
    var row: t40 = wait_queue_addr(queue_slot);
    var head: t40 = kload(row + WQ_HEAD);
    if head < 0 {
        return ERR_NOT_FOUND;
    }
    var next: t40 = kload(WAIT_PROC_NEXT_BASE + head);
    kstore(row + WQ_HEAD, next);
    if next < 0 {
        kstore(WAIT_QUEUE_TAIL_BASE + queue_slot, -1);
    }
    kstore(WAIT_PROC_NEXT_BASE + head, -1);
    kstore(row + WQ_VERSION, kload(row + WQ_VERSION) + 1);
    return head;
}

fn wait_deadline_from_timeout(timeout_ticks: t40) -> t40 {
    if timeout_ticks <= 0 {
        return WAIT_NO_DEADLINE;
    }
    return kload(KERNEL_TICK_ADDR) + timeout_ticks;
}

fn wait_channel_waitpid(pid: t40) -> t40 {
    return WAIT_CHAN_WAITPID_BASE + pid;
}

fn wait_channel_ipc(channel_id: t40) -> t40 {
    return WAIT_CHAN_IPC_BASE + channel_id;
}

fn wait_channel_window(window_id: t40) -> t40 {
    return WAIT_CHAN_WINDOW_BASE + window_id;
}

fn wait_channel_sleep(pid: t40) -> t40 {
    return WAIT_CHAN_SLEEP_BASE + pid;
}

fn wait_futex_key(pid: t40, addr: t40) -> t40 {
    if user_validate_span(pid, addr, 1, 0) <= 0 {
        return ERR_BAD_PTR;
    }
    var phys: t40 = user_translate_dmem_addr(pid, addr, 0);
    if phys < 0 {
        return phys;
    }
    return phys;
}

fn wait_channel_futex_key(key: t40) -> t40 {
    return WAIT_CHAN_FUTEX_BASE + key;
}

fn timer_wheel_bucket(deadline: t40) -> t40 {
    if deadline < 0 { return 0; }
    var bucket: t40 = deadline;
    while bucket - TIMER_WHEEL_BUCKETS >= 0 {
        bucket = bucket - TIMER_WHEEL_BUCKETS;
    }
    return bucket;
}

fn timer_wheel_remove(slot: t40) -> t40 {
    if slot < 0 { return ERR_INVALID; }
    if slot - PROCESS_MAX >= 0 { return ERR_INVALID; }
    var deadline: t40 = kload(WAIT_DEADLINE_BASE + slot);
    if deadline < 0 {
        kstore(TIMER_WHEEL_NEXT_BASE + slot, -1);
        return 0;
    }
    var bucket: t40 = timer_wheel_bucket(deadline);
    var current: t40 = kload(TIMER_WHEEL_HEAD_BASE + bucket);
    var previous: t40 = -1;
    while current >= 0 {
        var next: t40 = kload(TIMER_WHEEL_NEXT_BASE + current);
        if current - slot == 0 {
            if previous < 0 {
                kstore(TIMER_WHEEL_HEAD_BASE + bucket, next);
            } else {
                kstore(TIMER_WHEEL_NEXT_BASE + previous, next);
            }
            kstore(TIMER_WHEEL_NEXT_BASE + slot, -1);
            return 1;
        }
        previous = current;
        current = next;
    }
    kstore(TIMER_WHEEL_NEXT_BASE + slot, -1);
    return 0;
}

fn timer_wheel_add(slot: t40, deadline: t40) -> t40 {
    if deadline < 0 { return 0; }
    timer_wheel_remove(slot);
    var bucket: t40 = timer_wheel_bucket(deadline);
    kstore(TIMER_WHEEL_NEXT_BASE + slot,
           kload(TIMER_WHEEL_HEAD_BASE + bucket));
    kstore(TIMER_WHEEL_HEAD_BASE + bucket, slot);
    return 1;
}

fn wait_clear_slot(slot: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = process_addr(slot);
    var channel: t40 = kload(row + PROC_WAIT_CHANNEL);
    if channel != 0 {
        wait_queue_remove_proc(channel, slot);
    }
    timer_wheel_remove(slot);
    kstore(row + PROC_WAIT_CHANNEL, 0);
    kstore(WAIT_CHANNEL_BASE + slot, 0);
    kstore(WAIT_KIND_BASE + slot, WAIT_KIND_NONE);
    kstore(WAIT_DEADLINE_BASE + slot, WAIT_NO_DEADLINE);
    kstore(WAIT_ARG0_BASE + slot, 0);
    kstore(WAIT_ARG1_BASE + slot, 0);
    kstore(WAIT_ARG2_BASE + slot, 0);
    kstore(WAIT_PROC_NEXT_BASE + slot, -1);
    return 1;
}

fn wait_complete_slot(slot: t40, status: t40, payload: t40, detail: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = process_addr(slot);
    var ctx: t40 = kload(row + PROC_CONTEXT);
    if ctx > 0 {
        kstore(ctx + TASK_CONTEXT_EPC, kload(ctx + TASK_CONTEXT_EPC) + 1);
        kstore(ctx + 18, status);
        kstore(ctx + 19, payload);
        kstore(ctx + 20, detail);
    }
    wait_clear_slot(slot);
    process_set_state(slot, PROC_RUNNABLE);
    return 1;
}

fn process_block_on(slot: t40, channel: t40, kind: t40, timeout_ticks: t40, arg0: t40, arg1: t40, arg2: t40, state: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = process_addr(slot);
    wait_clear_slot(slot);
    kstore(row + PROC_WAIT_CHANNEL, channel);
    kstore(WAIT_CHANNEL_BASE + slot, channel);
    kstore(WAIT_KIND_BASE + slot, kind);
    var deadline: t40 = wait_deadline_from_timeout(timeout_ticks);
    kstore(WAIT_DEADLINE_BASE + slot, deadline);
    timer_wheel_add(slot, deadline);
    kstore(WAIT_ARG0_BASE + slot, arg0);
    kstore(WAIT_ARG1_BASE + slot, arg1);
    kstore(WAIT_ARG2_BASE + slot, arg2);
    var queued: t40 = wait_queue_push(channel, slot);
    if queued < 0 {
        wait_clear_slot(slot);
        return queued;
    }
    return process_set_state(slot, state);
}

fn process_wait(slot: t40, channel: t40) -> t40 {
    if slot < 0 {
        return ERR_INVALID;
    }
    if slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    return process_block_on(slot, channel, WAIT_KIND_LEGACY, 0, 0, 0, 0, PROC_BLOCKED);
}

fn process_wake_channel(channel: t40) -> t40 {
    var woke: t40 = 0;
    var slot: t40 = wait_queue_pop(channel);
    while slot >= 0 {
        wait_complete_slot(slot, 1, 0, 0);
        woke = woke + 1;
        slot = wait_queue_pop(channel);
    }
    return woke;
}

fn wait_cancel_channel(channel: t40) -> t40 {
    var canceled: t40 = 0;
    var slot: t40 = wait_queue_pop(channel);
    while slot >= 0 {
        wait_complete_slot(slot, -1, 0, ERR_CANCELED);
        canceled = canceled + 1;
        slot = wait_queue_pop(channel);
    }
    return canceled;
}

fn wait_wake_waitpid(pid: t40, exit_code: t40) -> t40 {
    var channel: t40 = wait_channel_waitpid(pid);
    var woke: t40 = 0;
    var slot: t40 = wait_queue_pop(channel);
    while slot >= 0 {
        wait_complete_slot(slot, 1, exit_code, 0);
        woke = woke + 1;
        slot = wait_queue_pop(channel);
    }
    return woke;
}

fn wait_wake_futex_key(key: t40, count: t40) -> t40 {
    if count <= 0 {
        return 0;
    }
    var channel: t40 = wait_channel_futex_key(key);
    var woke: t40 = 0;
    var slot: t40 = wait_queue_pop(channel);
    while slot >= 0 {
        wait_complete_slot(slot, 1, 1, 0);
        woke = woke + 1;
        if woke - count >= 0 {
            return woke;
        }
        slot = wait_queue_pop(channel);
    }
    return woke;
}

fn wait_wake_futex(pid: t40, addr: t40, count: t40) -> t40 {
    var key: t40 = wait_futex_key(pid, addr);
    if key < 0 {
        return key;
    }
    return wait_wake_futex_key(key, count);
}

fn wait_wake_one_ipc(channel_id: t40) -> t40 {
    var wait_channel: t40 = wait_channel_ipc(channel_id);
    var slot: t40 = wait_queue_pop(wait_channel);
    if slot < 0 {
        return 0;
    }
    var pid: t40 = kload(process_addr(slot) + PROC_PID);
    var out_addr: t40 = kload(WAIT_ARG1_BASE + slot);
    var namespace_id: t40 = process_namespace_for_pid(pid);
    var received: t40 = ipc_recv_user(pid, channel_id, namespace_id, out_addr);
    if received > 0 {
        wait_complete_slot(slot, 1, received, 0);
        return 1;
    }
    if received < 0 {
        wait_complete_slot(slot, -1, 0, received);
        return 1;
    }
    wait_queue_push(wait_channel, slot);
    return 0;
}

fn wait_wake_window(window_id: t40) -> t40 {
    var wait_channel: t40 = wait_channel_window(window_id);
    var slot: t40 = wait_queue_pop(wait_channel);
    if slot < 0 {
        return 0;
    }
    var pid: t40 = kload(process_addr(slot) + PROC_PID);
    var out_addr: t40 = kload(WAIT_ARG1_BASE + slot);
    var event_read: t40 = window_read_event(pid, window_id, out_addr);
    if event_read > 0 {
        wait_complete_slot(slot, 1, event_read, 0);
        return 1;
    }
    if event_read < 0 {
        wait_complete_slot(slot, -1, 0, event_read);
        return 1;
    }
    wait_queue_push(wait_channel, slot);
    return 0;
}

fn wait_store_event(pid: t40, out_addr: t40, kind: t40, x_or_key: t40, y: t40, modifiers: t40) -> t40 {
    if user_validate_span(pid, out_addr, WINDOW_EVENT_WORDS, 1) <= 0 {
        return ERR_BAD_PTR;
    }
    if user_store_word(pid, out_addr + EVENT_KIND, kind) < 0 { return ERR_BAD_PTR; }
    if user_store_word(pid, out_addr + EVENT_X_OR_KEY, x_or_key) < 0 { return ERR_BAD_PTR; }
    if user_store_word(pid, out_addr + EVENT_Y, y) < 0 { return ERR_BAD_PTR; }
    if user_store_word(pid, out_addr + EVENT_MODIFIERS, modifiers) < 0 { return ERR_BAD_PTR; }
    return 1;
}

fn wait_read_input_event(pid: t40, out_addr: t40) -> t40 {
    var available: t40 = 0;
    unsafe { available = csr_read(console_in_ctrl); }
    if available > 0 {
        var key: t40 = 0;
        unsafe { key = csr_read(console_in); }
        unsafe { csr_write(console_in_ctrl, 1); }
        return wait_store_event(pid, out_addr, EVENT_KIND_KEY, key, 0, 0);
    }

    var mx: t40 = 0;
    var my: t40 = 0;
    var btn: t40 = 0;
    unsafe { mx = csr_read(mouse_x); }
    unsafe { my = csr_read(mouse_y); }
    unsafe { btn = csr_read(mouse_btn); }
    if mx - kload(INPUT_LAST_MOUSE_X_ADDR) != 0 {
        kstore(INPUT_LAST_MOUSE_X_ADDR, mx);
        kstore(INPUT_LAST_MOUSE_Y_ADDR, my);
        kstore(INPUT_LAST_MOUSE_BTN_ADDR, btn);
        return wait_store_event(pid, out_addr, EVENT_KIND_MOUSE, mx, my, btn);
    }
    if my - kload(INPUT_LAST_MOUSE_Y_ADDR) != 0 {
        kstore(INPUT_LAST_MOUSE_X_ADDR, mx);
        kstore(INPUT_LAST_MOUSE_Y_ADDR, my);
        kstore(INPUT_LAST_MOUSE_BTN_ADDR, btn);
        return wait_store_event(pid, out_addr, EVENT_KIND_MOUSE, mx, my, btn);
    }
    if btn - kload(INPUT_LAST_MOUSE_BTN_ADDR) != 0 {
        kstore(INPUT_LAST_MOUSE_X_ADDR, mx);
        kstore(INPUT_LAST_MOUSE_Y_ADDR, my);
        kstore(INPUT_LAST_MOUSE_BTN_ADDR, btn);
        return wait_store_event(pid, out_addr, EVENT_KIND_MOUSE, mx, my, btn);
    }
    return 0;
}

fn wait_wake_input() -> t40 {
    var woke: t40 = 0;
    var slot: t40 = wait_queue_pop(WAIT_CHAN_INPUT);
    while slot >= 0 {
        var pid: t40 = kload(process_addr(slot) + PROC_PID);
        var out_addr: t40 = kload(WAIT_ARG1_BASE + slot);
        var delivered: t40 = wait_read_input_event(pid, out_addr);
        if delivered > 0 {
            wait_complete_slot(slot, 1, delivered, 0);
            woke = woke + 1;
            slot = wait_queue_pop(WAIT_CHAN_INPUT);
        } else {
            if delivered < 0 {
                wait_complete_slot(slot, -1, 0, delivered);
                woke = woke + 1;
                slot = wait_queue_pop(WAIT_CHAN_INPUT);
            } else {
                wait_queue_push(WAIT_CHAN_INPUT, slot);
                return woke;
            }
        }
    }
    return woke;
}

fn wait_timeout_slot(slot: t40) -> t40 {
    var kind: t40 = kload(WAIT_KIND_BASE + slot);
    if kind - WAIT_KIND_SLEEP == 0 {
        return wait_complete_slot(slot, 1, 1, 0);
    }
    return wait_complete_slot(slot, 0, 0, ERR_TIMEOUT);
}

fn wait_expire_timeouts() -> t40 {
    var now: t40 = kload(KERNEL_TICK_ADDR);
    var bucket: t40 = timer_wheel_bucket(now);
    var slot: t40 = kload(TIMER_WHEEL_HEAD_BASE + bucket);
    kstore(TIMER_WHEEL_HEAD_BASE + bucket, -1);
    var expired: t40 = 0;
    while slot >= 0 {
        var next: t40 = kload(TIMER_WHEEL_NEXT_BASE + slot);
        kstore(TIMER_WHEEL_NEXT_BASE + slot, -1);
        var deadline: t40 = kload(WAIT_DEADLINE_BASE + slot);
        if deadline >= 0 {
            if now - deadline >= 0 {
                var state: t40 = kload(process_addr(slot) + PROC_STATE);
                if state - PROC_BLOCKED == 0 {
                    wait_timeout_slot(slot);
                    expired = expired + 1;
                } else {
                    if state - PROC_SLEEPING == 0 {
                        wait_timeout_slot(slot);
                        expired = expired + 1;
                    }
                }
            } else {
                timer_wheel_add(slot, deadline);
            }
        }
        slot = next;
    }
    return expired;
}

fn kernel_timer_tick() -> t40 {
    kstore(KERNEL_TICK_ADDR, kload(KERNEL_TICK_ADDR) + 1);
    var first_pending_tick: t40 = kload(WAL_FIRST_PENDING_TICK_ADDR);
    if first_pending_tick >= 0 {
        if kload(KERNEL_TICK_ADDR) - first_pending_tick > 0 {
            if vfs_disk_available() > 0 {
                wal_sync_to_disk();
            }
        }
    }
    wait_wake_input();
    window_poll_input_driver();
    wait_expire_timeouts();
    return kload(KERNEL_TICK_ADDR);
}

fn scheduler_switch_to_slot(process_slot: t40) -> t40 {
    if process_slot < 0 { return process_slot; }
    if process_slot - PROCESS_MAX >= 0 { return ERR_INVALID; }
    var row: t40 = process_addr(process_slot);
    var state: t40 = kload(row + PROC_STATE);
    if state - PROC_RUNNABLE != 0 {
    if state - PROC_RUNNING != 0 {
            return ERR_INVALID;
        }
    }
    var current_pid: t40 = kload(CURRENT_PID_ADDR);
    var current_slot: t40 = process_find_pid(current_pid);
    if current_slot >= 0 {
        process_vector_context_save(current_slot);
    }
    var ctx: t40 = kload(row + PROC_CONTEXT);
    if ctx <= 0 {
        return ERR_INVALID;
    }
    kstore(CURRENT_CONTEXT_ADDR, ctx);
    var pid: t40 = kload(row + PROC_PID);
    kstore(CURRENT_PID_ADDR, pid);
    process_vector_context_restore(process_slot);
    tier1_enqueue(process_slot);
    return pid;
}

fn scheduler_switch_to_pid(pid: t40) -> t40 {
    return scheduler_switch_to_slot(process_find_pid(pid));
}

fn scheduler_pick_next() -> t40 {
    var process_slot: t40 = tier1_dequeue();
    while process_slot >= 0 {
        var row: t40 = process_addr(process_slot);
        if kload(row + PROC_STATE) - PROC_RUNNABLE == 0 {
            if kload(row + PROC_CONTEXT) > 0 {
                return process_slot;
            }
        }
        process_slot = tier1_dequeue();
    }
    return ERR_NOT_FOUND;
}

fn kernel_schedule_next() -> t40 {
    var process_slot: t40 = scheduler_pick_next();
    if process_slot < 0 {
        // Relational reconciliation is a repair path, not part of an
        // ordinary context switch.
        macro_reconcile_processes();
        macro_publish();
        process_slot = scheduler_pick_next();
    }
    while process_slot < 0 {
        unsafe { arch_wait(); }
        kernel_timer_tick();
        process_slot = scheduler_pick_next();
    }
    return scheduler_switch_to_slot(process_slot);
}

fn quota_set_limit(quota_id: t40, limit: t40) -> t40 {
    if quota_id < 0 {
        return ERR_INVALID;
    }
    if quota_id - QUOTA_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = quota_addr(quota_id);
    var old_limit: t40 = kload(row + QUOTA_LIMIT);
    var txid: t40 = log_begin();
    var logged: t40 = log_write(txid, row + QUOTA_LIMIT, old_limit, limit);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, row + QUOTA_VERSION,
                       kload(row + QUOTA_VERSION),
                       kload(row + QUOTA_VERSION) + 1);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var commit_status: t40 = log_commit(txid);
    if commit_status < 0 { return commit_status; }
    return limit;
}

fn quota_remaining(quota_id: t40) -> t40 {
    if quota_id < 0 {
        return ERR_INVALID;
    }
    if quota_id - QUOTA_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = quota_addr(quota_id);
    return kload(row + QUOTA_LIMIT) - kload(row + QUOTA_USED);
}

fn quota_charge(quota_id: t40, amount: t40) -> t40 {
    if quota_id < 0 {
        return ERR_INVALID;
    }
    if quota_id - QUOTA_MAX >= 0 {
        return ERR_INVALID;
    }
    if amount < 0 {
        return ERR_INVALID;
    }
    var row: t40 = quota_addr(quota_id);
    var used: t40 = kload(row + QUOTA_USED);
    var limit: t40 = kload(row + QUOTA_LIMIT);
    if used + amount - limit > 0 {
        return ERR_NO_SPACE;
    }
    // QUOTA_LIMIT is configured policy and is logged; instantaneous usage is
    // reconstructed control-plane state and must not enter the WAL hot path.
    kstore(row + QUOTA_USED, used + amount);
    kstore(row + QUOTA_VERSION, kload(row + QUOTA_VERSION) + 1);
    return used + amount;
}

fn quota_release(quota_id: t40, amount: t40) -> t40 {
    if quota_id < 0 {
        return ERR_INVALID;
    }
    if quota_id - QUOTA_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = quota_addr(quota_id);
    var used: t40 = kload(row + QUOTA_USED);
    var next_used: t40 = used - amount;
    if next_used < 0 {
        next_used = 0;
    }
    kstore(row + QUOTA_USED, next_used);
    kstore(row + QUOTA_VERSION, kload(row + QUOTA_VERSION) + 1);
    return next_used;
}

fn process_release_windows(pid: t40) -> t40 {
    var slot: t40 = 0;
    var released: t40 = 0;
    while WINDOW_MAX - slot > 0 {
        var row: t40 = window_addr(slot);
        if kload(row + WIN_ACTIVE) > 0 {
            if kload(row + WIN_OWNER_PID) - pid == 0 {
                if kload(WINDOW_FOCUS_ID_ADDR) - kload(row + WIN_ID) == 0 {
                    kstore(WINDOW_FOCUS_ID_ADDR, -1);
                }
                kclear(row, WINDOW_ROW_WORDS);
                kclear(window_event_addr(slot, 0), WINDOW_EVENT_CAPACITY * WINDOW_EVENT_WORDS);
                kclear(window_buffer_addr(slot), WINDOW_BUFFER_WORDS);
                released = released + 1;
            }
        }
        slot = slot + 1;
    }
    return released;
}

fn process_release_fds(pid: t40) -> t40 {
    var fd: t40 = 0;
    var released: t40 = 0;
    while VFS_MAX_FDS - fd > 0 {
        var row: t40 = fd_addr(fd);
        if kload(row + FD_REFCOUNT) > 0 {
            if kload(row + FD_PID) - pid == 0 {
                kclear(row, VFS_FD_WORDS);
                released = released + 1;
            }
        }
        fd = fd + 1;
    }
    // Closing a process-owned descriptor can make an unlinked inode
    // reclaimable.  The pass is intentionally best-effort; WAL-full or a
    // pinned cache frame leaves the orphan for the next lazy/mount pass.
    vfs_reclaim_pending();
    return released;
}

fn process_release_ipc(pid: t40) -> t40 {
    var channel_id: t40 = 0;
    var released: t40 = 0;
    while IPC_MAX_CHANNELS - channel_id > 0 {
        if kload(IPC_OWNER_BASE + channel_id) - pid == 0 {
            kclear(ipc_channel_addr(channel_id), IPC_CHANNEL_WORDS);
            kclear(ipc_buffer_addr(channel_id), IPC_CAPACITY);
            kstore(IPC_OWNER_BASE + channel_id, -1);
            released = released + 1;
        }
        channel_id = channel_id + 1;
    }
    return released;
}

fn process_release_net(pid: t40) -> t40 {
    var socket_id: t40 = 0;
    var released: t40 = 0;
    while NET_MAX_SOCKETS - socket_id > 0 {
        var row: t40 = net_socket_row(socket_id);
        if kload(row + NET_SOCK_STATE) > 0 {
            if kload(row + NET_SOCK_OWNER) - pid == 0 {
                kclear(row, NET_SOCKET_WORDS);
                kclear(net_rx_base(socket_id), NET_RX_CAPACITY);
                released = released + 1;
            }
        }
        socket_id = socket_id + 1;
    }
    return released;
}

fn process_release_memory(process_slot: t40) -> t40 {
    exec_clear_hw_page_tables(process_slot);
    var vpn: t40 = 0;
    while PTE_MAX_VPN - vpn > 0 {
        kclear(pte_entry_addr(process_slot, vpn), PTE_ROW_WORDS);
        vpn = vpn + 1;
    }
    var heap: t40 = process_heap_addr(process_slot);
    var mapped_pages: t40 = kload(heap + PROC_HEAP_MAPPED_PAGES);
    if mapped_pages <= 0 {
        mapped_pages = 1;
    }
    if mapped_pages - PROCESS_DMEM_PAGES_MAX > 0 {
        mapped_pages = PROCESS_DMEM_PAGES_MAX;
    }
    kclear(exec_process_dmem_ppn(process_slot) * MMU_PAGE_WORDS, mapped_pages * MMU_PAGE_WORDS);
    kclear(exec_image_addr(process_slot), EXEC_IMAGE_WORDS);
    kclear(process_arch_addr(process_slot), PROCESS_ARCH_WORDS);
    process_vector_context_reset(process_slot);
    kclear(heap, PROCESS_HEAP_WORDS);
    process_cache_invalidate(process_slot);
    translation_cache_invalidate(process_slot);
    return 1;
}

fn process_release_resources(process_slot: t40) -> t40 {
    if process_slot < 0 {
        return ERR_INVALID;
    }
    if process_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    if kload(PROC_CLEANED_BASE + process_slot) > 0 {
        return 0;
    }
    var row: t40 = process_addr(process_slot);
    var pid: t40 = kload(row + PROC_PID);
    process_release_windows(pid);
    process_release_fds(pid);
    process_release_ipc(pid);
    process_release_net(pid);
    process_clear_wait(process_slot);
    quota_release(kload(row + PROC_QUOTA), 1);
    process_release_memory(process_slot);
    kstore(PROC_CLEANED_BASE + process_slot, 1);
    return 1;
}

fn process_reap_slot(process_slot: t40) -> t40 {
    if process_slot < 0 {
        return ERR_INVALID;
    }
    if process_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var reaped_pid: t40 =
        kload(process_addr(process_slot) + PROC_PID);
    scheduler_invalidate_slot(process_slot);
    pid_index_remove(reaped_pid);
    wait_clear_slot(process_slot);
    process_release_resources(process_slot);
    kclear(process_addr(process_slot), PROCESS_ROW_WORDS);
    kstore(DESIRED_PROCESS_BASE + process_slot, 0);
    kstore(WAIT_CHANNEL_BASE + process_slot, 0);
    kstore(PROC_PARENT_PID_BASE + process_slot, -1);
    kstore(PROC_EXIT_STATUS_BASE + process_slot, 0);
    kstore(PROC_SIGNAL_PENDING_BASE + process_slot, 0);
    kstore(PROC_CLEANED_BASE + process_slot, 0);
    kstore(PROC_CAPS_BASE + process_slot, 0);
    translation_cache_invalidate(process_slot);
    return 1;
}

fn process_cleanup_orphans(parent_pid: t40) -> t40 {
    var slot: t40 = 0;
    var cleaned: t40 = 0;
    while PROCESS_MAX - slot > 0 {
        if kload(PROC_PARENT_PID_BASE + slot) - parent_pid == 0 {
            var state: t40 = process_state(slot);
            if process_terminal_state(state) > 0 {
                process_reap_slot(slot);
                cleaned = cleaned + 1;
            } else {
                process_set_parent(slot, -1);
                cleaned = cleaned + 1;
            }
        }
        slot = slot + 1;
    }
    return cleaned;
}

fn process_finish_exit(process_slot: t40, status: t40, final_state: t40) -> t40 {
    if process_slot < 0 {
        return ERR_INVALID;
    }
    if process_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = process_addr(process_slot);
    var pid: t40 = kload(row + PROC_PID);
    var parent_pid: t40 = kload(PROC_PARENT_PID_BASE + process_slot);
    kstore(PROC_EXIT_STATUS_BASE + process_slot, status);
    wait_clear_slot(process_slot);
    process_release_resources(process_slot);
    process_cleanup_orphans(pid);
    if parent_pid > 0 {
        if process_find_pid(parent_pid) >= 0 {
            process_set_state(process_slot, final_state);
            wait_wake_waitpid(pid, status);
            process_wake_channel(pid);
            process_wake_channel(parent_pid);
            return final_state;
        }
    }
    process_reap_slot(process_slot);
    return PROC_FREE;
}

fn process_wait_child(parent_pid: t40, child_pid: t40) -> t40 {
    var caller_slot: t40 = process_find_pid(parent_pid);
    if caller_slot < 0 {
        return caller_slot;
    }
    var target_slot: t40 = process_find_pid(child_pid);
    if target_slot < 0 {
        return ERR_NOT_FOUND;
    }
    if kload(PROC_PARENT_PID_BASE + target_slot) - parent_pid != 0 {
        return ERR_INVALID;
    }
    var target_state: t40 = process_state(target_slot);
    if process_terminal_state(target_state) > 0 {
        var status: t40 = kload(PROC_EXIT_STATUS_BASE + target_slot);
        process_reap_slot(target_slot);
        return status;
    }
    process_wait(caller_slot, child_pid);
    return 0;
}

fn process_request_close(pid: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return slot;
    }
    process_add_signal(slot, SIGNAL_CLOSE_REQUEST);
    process_wake_for_signal(slot);
    var win_slot: t40 = 0;
    var queued: t40 = 0;
    while WINDOW_MAX - win_slot > 0 {
        var row: t40 = window_addr(win_slot);
        if kload(row + WIN_ACTIVE) > 0 {
            if kload(row + WIN_OWNER_PID) - pid == 0 {
                var window_id: t40 = kload(row + WIN_ID);
                if window_queue_event(win_slot, EVENT_KIND_CLOSE, window_id, 0, 0) > 0 {
                    queued = queued + 1;
                }
            }
        }
        win_slot = win_slot + 1;
    }
    return queued;
}

fn process_signal(pid: t40, signal: t40) -> t40 {
    if signal_valid(signal) <= 0 {
        return ERR_INVALID;
    }
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return slot;
    }
    var state: t40 = process_state(slot);
    if process_terminal_state(state) > 0 {
        return ERR_INVALID;
    }
    process_add_signal(slot, signal);
    if signal - SIGNAL_KILL == 0 {
        process_set_state(slot, PROC_KILLING);
        return process_finish_exit(slot, SIGNAL_KILL, PROC_ZOMBIE);
    }
    if signal - SIGNAL_STOP == 0 {
        process_clear_wait(slot);
        return process_set_state(slot, PROC_STOPPED);
    }
    if signal - SIGNAL_CONT == 0 {
        var pending: t40 = kload(PROC_SIGNAL_PENDING_BASE + slot);
        pending = signal_remove(pending, SIGNAL_STOP);
        kstore(PROC_SIGNAL_PENDING_BASE + slot, signal_remove(pending, SIGNAL_CONT));
        if state - PROC_STOPPED == 0 {
            return process_set_state(slot, PROC_RUNNABLE);
        }
        return process_wake_for_signal(slot);
    }
    if signal - SIGNAL_CLOSE_REQUEST == 0 {
        return process_request_close(pid);
    }
    if signal - SIGNAL_TERM == 0 {
        process_add_signal(slot, SIGNAL_CLOSE_REQUEST);
        var queued: t40 = process_request_close(pid);
        if queued <= 0 {
            process_wake_for_signal(slot);
        }
        return queued;
    }
    return ERR_INVALID;
}

fn kernel_getproc_user(caller_pid: t40, target_pid: t40, out_addr: t40) -> t40 {
    var slot: t40 = process_find_pid(target_pid);
    if slot < 0 {
        return slot;
    }
    if user_validate_span(caller_pid, out_addr, PROCINFO_WORDS, 1) <= 0 {
        return ERR_BAD_PTR;
    }
    var row: t40 = process_addr(slot);
    if user_store_word(caller_pid, out_addr + PROCINFO_PID, kload(row + PROC_PID)) < 0 { return ERR_BAD_PTR; }
    if user_store_word(caller_pid, out_addr + PROCINFO_STATE, kload(row + PROC_STATE)) < 0 { return ERR_BAD_PTR; }
    if user_store_word(caller_pid, out_addr + PROCINFO_PARENT_PID, kload(PROC_PARENT_PID_BASE + slot)) < 0 { return ERR_BAD_PTR; }
    if user_store_word(caller_pid, out_addr + PROCINFO_EXIT_STATUS, kload(PROC_EXIT_STATUS_BASE + slot)) < 0 { return ERR_BAD_PTR; }
    if user_store_word(caller_pid, out_addr + PROCINFO_PENDING_SIGNALS, kload(PROC_SIGNAL_PENDING_BASE + slot)) < 0 { return ERR_BAD_PTR; }
    if user_store_word(caller_pid, out_addr + PROCINFO_PRIORITY, kload(row + PROC_PRIORITY)) < 0 { return ERR_BAD_PTR; }
    var qid: t40 = kload(row + PROC_QUOTA);
    if user_store_word(caller_pid, out_addr + PROCINFO_QUOTA_REMAINING, quota_remaining(qid)) < 0 { return ERR_BAD_PTR; }
    if user_store_word(caller_pid, out_addr + PROCINFO_NAMESPACE, kload(row + PROC_NAMESPACE)) < 0 { return ERR_BAD_PTR; }
    return PROCINFO_WORDS;
}

fn macro_reconcile_processes() -> t40 {
    var slot: t40 = 0;
    var staged: t40 = 0;
    while PROCESS_MAX - slot > 0 {
        if kload(DESIRED_PROCESS_BASE + slot) > 0 {
            var row: t40 = process_addr(slot);
            if kload(row + PROC_STATE) - PROC_RUNNABLE == 0 {
                var quota_id: t40 = kload(row + PROC_QUOTA);
                if quota_remaining(quota_id) > 0 {
                    if macro_stage_thread(slot) > 0 {
                        quota_charge(quota_id, 1);
                        staged = staged + 1;
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return staged;
}

fn namespace_addr(namespace_id: t40) -> t40 {
    return NAMESPACE_BASE + namespace_id * NAMESPACE_ROW_WORDS;
}

fn namespace_table_init() -> t40 {
    kclear(NAMESPACE_BASE, NAMESPACE_MAX * NAMESPACE_ROW_WORDS);
    var row: t40 = namespace_addr(0);
    kstore(row + NS_ID, 0);
    kstore(row + NS_ROOT_INODE, 0);
    kstore(row + NS_VERSION, 1);
    kstore(row + NS_ACTIVE, 1);
    return 1;
}

fn namespace_create(namespace_id: t40, root_inode: t40) -> t40 {
    if namespace_id < 0 {
        return ERR_INVALID;
    }
    if namespace_id - NAMESPACE_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = namespace_addr(namespace_id);
    var txid: t40 = log_begin();
    var logged: t40 = log_write(txid, row + NS_ACTIVE, kload(row + NS_ACTIVE), 1);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, row + NS_ID,
                       kload(row + NS_ID), namespace_id);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, row + NS_ROOT_INODE,
                       kload(row + NS_ROOT_INODE), root_inode);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, row + NS_VERSION,
                       kload(row + NS_VERSION),
                       kload(row + NS_VERSION) + 1);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var commit_status: t40 = log_commit(txid);
    if commit_status < 0 { return commit_status; }
    return namespace_id;
}

fn namespace_is_active(namespace_id: t40) -> t40 {
    if namespace_id < 0 {
        return 0;
    }
    if namespace_id - NAMESPACE_MAX >= 0 {
        return 0;
    }
    return kload(namespace_addr(namespace_id) + NS_ACTIVE);
}

fn pte_entry_addr(process_slot: t40, vpn: t40) -> t40 {
    return PTE_BASE + (process_slot * PTE_MAX_VPN + vpn) * PTE_ROW_WORDS;
}

fn pte_table_init() -> t40 {
    kclear(PROCESS_CACHE_BASE, PROCESS_MAX * PROCESS_CACHE_WORDS);
    kclear(TRANSLATION_CACHE_BASE, PROCESS_MAX * TRANSLATION_CACHE_WORDS);
    kstore(METRIC_TLB_HITS_ADDR, 0);
    kstore(METRIC_TLB_MISSES_ADDR, 0);
    kstore(METRIC_SPAN_CACHE_HITS_ADDR, 0);
    kstore(METRIC_SLOW_PATH_FAULTS_ADDR, 0);
    kstore(METRIC_VFS_LOOKUPS_ADDR, 0);
    return 1;
}

fn pte_map(process_slot: t40, vpn: t40, ppn: t40, flags: t40) -> t40 {
    if process_slot < 0 {
        return ERR_INVALID;
    }
    if process_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    if vpn < 0 {
        return ERR_INVALID;
    }
    if vpn - PTE_MAX_VPN >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = pte_entry_addr(process_slot, vpn);
    var ns: t40 = kload(process_addr(process_slot) + PROC_NAMESPACE);
    kstore(row + PTE_WORD, 1);
    kstore(row + PTE_PPN, ppn);
    kstore(row + PTE_FLAGS, flags);
    kstore(row + PTE_VERSION, kload(row + PTE_VERSION) + 1);
    kstore(row + PTE_NAMESPACE, ns);
    translation_cache_invalidate(process_slot);
    return 1;
}

fn pte_mark_fault(process_slot: t40, vpn: t40) -> t40 {
    var row: t40 = pte_entry_addr(process_slot, vpn);
    kstore(row + PTE_WORD, -1);
    kstore(row + PTE_PPN, 0);
    kstore(row + PTE_FLAGS, 0);
    kstore(row + PTE_VERSION, kload(row + PTE_VERSION) + 1);
    translation_cache_invalidate(process_slot);
    return 1;
}

fn pte_entry_faults(process_slot: t40, vpn: t40) -> t40 {
    var row: t40 = pte_entry_addr(process_slot, vpn);
    if kload(row + PTE_WORD) > 0 {
        return 0;
    }
    return 1;
}

fn pte_flags_has(flags: t40, flag: t40) -> t40 {
    if flags - flag == 0 {
        return 1;
    }
    if flags - PTE_FLAG_MMIO - PTE_FLAG_COW == 0 {
        return 1;
    }
    return 0;
}

fn fork_process(parent_slot: t40, child_slot: t40, child_pid: t40) -> t40 {
    if parent_slot < 0 {
        return ERR_INVALID;
    }
    if parent_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    if child_slot < 0 {
        return ERR_INVALID;
    }
    if child_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var parent_row: t40 = process_addr(parent_slot);
    var ns: t40 = kload(parent_row + PROC_NAMESPACE);
    var quota_id: t40 = kload(parent_row + PROC_QUOTA);
    var vpn: t40 = 0;
    while PTE_MAX_VPN - vpn > 0 {
        var src: t40 = pte_entry_addr(parent_slot, vpn);
        if kload(src + PTE_WORD) > 0 {
            var flags: t40 = kload(src + PTE_FLAGS);
            if pte_flags_has(flags, PTE_FLAG_MMIO) <= 0 {
                var ppn: t40 = kload(src + PTE_PPN);
                if page_is_evictable(ppn) <= 0 {
                    return ERR_INVALID;
                }
            }
        }
        vpn = vpn + 1;
    }
    process_create(child_slot, child_pid, ns, kload(parent_row + PROC_PRIORITY), quota_id, 0);
    process_arch_copy(child_slot, parent_slot);
    process_vector_context_copy(child_slot, parent_slot);
    process_set_parent(child_slot, kload(parent_row + PROC_PID));
    process_set_caps(child_slot, kload(PROC_CAPS_BASE + parent_slot));
    vpn = 0;
    while PTE_MAX_VPN - vpn > 0 {
        var src_row: t40 = pte_entry_addr(parent_slot, vpn);
        var dst_row: t40 = pte_entry_addr(child_slot, vpn);
        if kload(src_row + PTE_WORD) > 0 {
            var src_flags: t40 = kload(src_row + PTE_FLAGS);
            if pte_flags_has(src_flags, PTE_FLAG_MMIO) > 0 {
                pte_mark_fault(child_slot, vpn);
            } else {
                kstore(src_row + PTE_FLAGS, PTE_FLAG_COW);
                kstore(dst_row + PTE_WORD, kload(src_row + PTE_WORD));
                kstore(dst_row + PTE_PPN, kload(src_row + PTE_PPN));
                kstore(dst_row + PTE_FLAGS, PTE_FLAG_COW);
                kstore(dst_row + PTE_VERSION, kload(dst_row + PTE_VERSION) + 1);
                kstore(dst_row + PTE_NAMESPACE, ns);
                translation_cache_invalidate(parent_slot);
                translation_cache_invalidate(child_slot);
            }
        }
        vpn = vpn + 1;
    }
    return child_pid;
}

fn cow_fault_resolve(process_slot: t40, vpn: t40, new_ppn: t40) -> t40 {
    var row: t40 = pte_entry_addr(process_slot, vpn);
    if kload(row + PTE_WORD) <= 0 {
        return ERR_INVALID;
    }
    var flags: t40 = kload(row + PTE_FLAGS);
    if pte_flags_has(flags, PTE_FLAG_COW) <= 0 {
        return ERR_INVALID;
    }
    var old_ppn: t40 = kload(row + PTE_PPN);
    if page_is_evictable(old_ppn) <= 0 {
        return ERR_INVALID;
    }
    kstore(row + PTE_PPN, new_ppn);
    kstore(row + PTE_FLAGS, 0);
    kstore(row + PTE_VERSION, kload(row + PTE_VERSION) + 1);
    translation_cache_invalidate(process_slot);
    return 1;
}

fn process_cache_addr(process_slot: t40) -> t40 {
    return PROCESS_CACHE_BASE + process_slot * PROCESS_CACHE_WORDS;
}

fn process_cache_observe(process_slot: t40, key: t40, value: t40) -> t40 {
    var row: t40 = process_cache_addr(process_slot);
    kstore(row + CACHE_KEY, key);
    kstore(row + CACHE_VALUE, value);
    kstore(row + CACHE_VERSION, kload(row + CACHE_VERSION) + 1);
    kstore(row + CACHE_VALID, 1);
    return value;
}

fn process_cache_read(process_slot: t40, key: t40) -> t40 {
    var row: t40 = process_cache_addr(process_slot);
    if kload(row + CACHE_VALID) <= 0 {
        return ERR_NOT_FOUND;
    }
    if kload(row + CACHE_KEY) - key != 0 {
        return ERR_NOT_FOUND;
    }
    return kload(row + CACHE_VALUE);
}

fn process_cache_invalidate(process_slot: t40) -> t40 {
    var row: t40 = process_cache_addr(process_slot);
    kstore(row + CACHE_VALID, 0);
    unsafe { fence(0); }
    return 1;
}

fn translation_cache_addr(process_slot: t40) -> t40 {
    return TRANSLATION_CACHE_BASE + process_slot * TRANSLATION_CACHE_WORDS;
}

fn translation_cache_invalidate(process_slot: t40) -> t40 {
    if process_slot < 0 {
        return ERR_INVALID;
    }
    if process_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = translation_cache_addr(process_slot);
    kstore(row + TC_TLB_VALID, 0);
    kstore(row + TC_SPAN_VALID, 0);
    var target_asid: t40 =
        exec_hw_dmem_ptbr(process_slot);
    while target_asid - 19683 >= 0 {
        target_asid = target_asid - 19683;
    }
    unsafe { tlbinv(-1, target_asid, 1); }
    unsafe { fence(0); }
    return 1;
}

fn hw_pte_flags(word: t40) -> t40 {
    if word <= 0 { return 0; }
    var flags: t40 = 0;
    unsafe { flags = tmod(word, 19683); }
    return flags;
}

fn hw_pte_flag(flags: t40, place: t40) -> t40 {
    var window: t40 = flags;
    var next_place: t40 = place * 3;
    while window - next_place >= 0 {
        window = window - next_place;
    }
    if window - place >= 0 {
        return 1;
    }
    return 0;
}

fn hw_pte_allows(flags: t40, write: t40) -> t40 {
    if hw_pte_flag(flags, 1) <= 0 {
        return 0;
    }
    if hw_pte_flag(flags, 3) <= 0 {
        return 0;
    }
    if write > 0 {
        return hw_pte_flag(flags, 27);
    }
    return hw_pte_flag(flags, 9);
}

fn translation_tlb_lookup(process_slot: t40, ptbr: t40, vpn: t40, write: t40) -> t40 {
    var row: t40 = translation_cache_addr(process_slot);
    if kload(row + TC_TLB_VALID) <= 0 {
        return ERR_NOT_FOUND;
    }
    if kload(row + TC_TLB_VPN) - vpn != 0 {
        return ERR_NOT_FOUND;
    }
    if kload(row + TC_TLB_PTBR) - ptbr != 0 {
        return ERR_NOT_FOUND;
    }
    var pte_word: t40 = kload(ptbr + vpn);
    if pte_word - kload(row + TC_TLB_PTE_WORD) != 0 {
        translation_cache_invalidate(process_slot);
        return ERR_NOT_FOUND;
    }
    if hw_pte_allows(kload(row + TC_TLB_FLAGS), write) <= 0 {
        return ERR_NOT_FOUND;
    }
    metric_inc(METRIC_TLB_HITS_ADDR);
    return kload(row + TC_TLB_PPN);
}

fn translation_tlb_store(process_slot: t40, ptbr: t40, vpn: t40, pte_word: t40, flags: t40) -> t40 {
    var row: t40 = translation_cache_addr(process_slot);
    kstore(row + TC_TLB_VPN, vpn);
    kstore(row + TC_TLB_PPN, hw_pte_phys_base(pte_word));
    kstore(row + TC_TLB_FLAGS, flags);
    kstore(row + TC_TLB_PTE_WORD, pte_word);
    kstore(row + TC_TLB_PTBR, ptbr);
    kstore(row + TC_TLB_VALID, 1);
    return 1;
}

fn translation_span_lookup(process_slot: t40, ptbr: t40, addr: t40, count_words: t40, write: t40) -> t40 {
    var row: t40 = translation_cache_addr(process_slot);
    if kload(row + TC_SPAN_VALID) <= 0 {
        return 0;
    }
    if kload(row + TC_SPAN_WRITE) - write != 0 {
        return 0;
    }
    if addr - kload(row + TC_SPAN_START) < 0 {
        return 0;
    }
    if addr + count_words - kload(row + TC_SPAN_END) > 0 {
        return 0;
    }
    if ptbr > 0 {
        if kload(row + TC_SPAN_PTBR) - ptbr != 0 {
            return 0;
        }
        var vpn: t40 = kload(row + TC_SPAN_VPN);
        if (addr / MMU_PAGE_WORDS) - vpn != 0 {
            return 0;
        }
        var last_addr: t40 = addr + count_words - 1;
        if (last_addr / MMU_PAGE_WORDS) - vpn != 0 {
            return 0;
        }
        if kload(ptbr + vpn) - kload(row + TC_SPAN_PTE_WORD) != 0 {
            translation_cache_invalidate(process_slot);
            return 0;
        }
    }
    metric_inc(METRIC_SPAN_CACHE_HITS_ADDR);
    return 1;
}

fn translation_span_store(process_slot: t40, ptbr: t40, addr: t40, count_words: t40, write: t40) -> t40 {
    var row: t40 = translation_cache_addr(process_slot);
    var vpn: t40 = -1;
    var pte_word: t40 = 0;
    if ptbr > 0 {
        vpn = addr / MMU_PAGE_WORDS;
        var last_addr: t40 = addr + count_words - 1;
        if (last_addr / MMU_PAGE_WORDS) - vpn != 0 {
            kstore(row + TC_SPAN_VALID, 0);
            return 1;
        }
        pte_word = kload(ptbr + vpn);
    }
    kstore(row + TC_SPAN_START, addr);
    kstore(row + TC_SPAN_END, addr + count_words);
    kstore(row + TC_SPAN_WRITE, write);
    kstore(row + TC_SPAN_VPN, vpn);
    kstore(row + TC_SPAN_PTE_WORD, pte_word);
    kstore(row + TC_SPAN_PTBR, ptbr);
    kstore(row + TC_SPAN_VALID, 1);
    return 1;
}

fn validate_user_span(addr: t40, count_words: t40, write: t40) -> t40 {
    if addr <= 0 {
        return 0;
    }
    if count_words < 0 {
        return 0;
    }
    if addr - USER_MEM_BASE < 0 {
        return 0;
    }
    if addr + count_words - USER_MEM_LIMIT > 0 {
        return 0;
    }
    return 1;
}

fn user_has_dmem_mmu(pid: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return 0;
    }
    var ctx: t40 = kload(process_addr(slot) + PROC_CONTEXT);
    if ctx <= 0 {
        return 0;
    }
    var ptbr: t40 = kload(ctx + TASK_CONTEXT_DMEM_PTBR);
    if ptbr <= 0 {
        return 0;
    }
    if ptbr - HW_PT_BASE < 0 {
        return 0;
    }
    if ptbr - (HW_PT_BASE + PROCESS_MAX * HW_PT_WORDS) >= 0 {
        return 0;
    }
    return 1;
}

fn hw_pte_phys_base(word: t40) -> t40 {
    if word <= 0 { return 0; }
    var flags: t40 = 0;
    unsafe { flags = tmod(word, 19683); }
    return ((word - flags) / 19683) * MMU_PAGE_WORDS;
}

fn user_page_offset(addr: t40) -> t40 {
    var offset: t40 = addr;
    while offset - MMU_PAGE_WORDS >= 0 {
        offset = offset - MMU_PAGE_WORDS;
    }
    return offset;
}

fn user_translate_dmem_addr(pid: t40, addr: t40, write: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return slot;
    }
    return user_translate_slot_dmem_addr(slot, addr, write);
}

fn user_translate_slot_dmem_addr(slot: t40, addr: t40, write: t40) -> t40 {
    if addr < 0 {
        metric_inc(METRIC_SLOW_PATH_FAULTS_ADDR);
        return ERR_BAD_PTR;
    }
    var ctx: t40 = kload(process_addr(slot) + PROC_CONTEXT);
    if ctx <= 0 {
        // The kernel process uses the direct-DMEM compatibility path, but
        // syscall pointers are still guest virtual addresses.  Keep the
        // same user window contract as the MMU path; otherwise a malformed
        // pointer can alias arbitrary kernel state in direct mode.
        if validate_user_span(addr, 1, write) <= 0 {
            metric_inc(METRIC_SLOW_PATH_FAULTS_ADDR);
            return ERR_BAD_PTR;
        }
        return addr;
    }
    var ptbr: t40 = kload(ctx + TASK_CONTEXT_DMEM_PTBR);
    if ptbr <= 0 {
        if validate_user_span(addr, 1, write) <= 0 {
            metric_inc(METRIC_SLOW_PATH_FAULTS_ADDR);
            return ERR_BAD_PTR;
        }
        return addr;
    }
    if ptbr - HW_PT_BASE < 0 {
        if validate_user_span(addr, 1, write) <= 0 {
            metric_inc(METRIC_SLOW_PATH_FAULTS_ADDR);
            return ERR_BAD_PTR;
        }
        return addr;
    }
    if ptbr - (HW_PT_BASE + PROCESS_MAX * HW_PT_WORDS) >= 0 {
        if validate_user_span(addr, 1, write) <= 0 {
            metric_inc(METRIC_SLOW_PATH_FAULTS_ADDR);
            return ERR_BAD_PTR;
        }
        return addr;
    }
    var pages: t40 = kload(ctx + TASK_CONTEXT_DMEM_PAGES);
    var vpn: t40 = addr / MMU_PAGE_WORDS;
    if vpn - pages >= 0 {
        metric_inc(METRIC_SLOW_PATH_FAULTS_ADDR);
        return ERR_BAD_PTR;
    }
    var offset: t40 = user_page_offset(addr);
    var cached_phys_base: t40 = translation_tlb_lookup(slot, ptbr, vpn, write);
    if cached_phys_base >= 0 {
        return cached_phys_base + offset;
    }
    metric_inc(METRIC_TLB_MISSES_ADDR);
    var pte_word: t40 = kload(ptbr + vpn);
    if pte_word <= 0 {
        metric_inc(METRIC_SLOW_PATH_FAULTS_ADDR);
        return ERR_BAD_PTR;
    }
    var flags: t40 = hw_pte_flags(pte_word);
    if hw_pte_allows(flags, write) <= 0 {
        metric_inc(METRIC_SLOW_PATH_FAULTS_ADDR);
        return ERR_BAD_PTR;
    }
    // Hardware-visible PTE v2 accessed/dirty trits.
    if hw_pte_flag(flags, 729) <= 0 {
        pte_word = pte_word + 729;
        flags = flags + 729;
    }
    if write > 0 {
        if hw_pte_flag(flags, 2187) <= 0 {
            pte_word = pte_word + 2187;
            flags = flags + 2187;
        }
    }
    kstore(ptbr + vpn, pte_word);
    translation_tlb_store(slot, ptbr, vpn, pte_word, flags);
    var phys: t40 = hw_pte_phys_base(pte_word) + offset;
    return phys;
}

fn user_validate_span(pid: t40, addr: t40, count_words: t40, write: t40) -> t40 {
    if count_words < 0 {
        return 0;
    }
    if count_words == 0 {
        return 1;
    }
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return validate_user_span(addr, count_words, write);
    }
    var ctx: t40 = kload(process_addr(slot) + PROC_CONTEXT);
    var ptbr: t40 = 0;
    var has_mmu: t40 = 0;
    if ctx > 0 {
        ptbr = kload(ctx + TASK_CONTEXT_DMEM_PTBR);
        if ptbr > 0 {
            if ptbr - HW_PT_BASE >= 0 {
                if ptbr - (HW_PT_BASE + PROCESS_MAX * HW_PT_WORDS) < 0 {
                    has_mmu = 1;
                }
            }
        }
    }
    if has_mmu <= 0 {
        if translation_span_lookup(slot, 0, addr, count_words, write) > 0 {
            return 1;
        }
        var direct_ok: t40 = validate_user_span(addr, count_words, write);
        if direct_ok > 0 {
            translation_span_store(slot, 0, addr, count_words, write);
        }
        return direct_ok;
    }
    if translation_span_lookup(slot, ptbr, addr, count_words, write) > 0 {
        return 1;
    }
    var remaining: t40 = count_words;
    var cursor: t40 = addr;
    while remaining > 0 {
        if user_translate_slot_dmem_addr(slot, cursor, write) < 0 {
            return 0;
        }
        var page_left: t40 = MMU_PAGE_WORDS - user_page_offset(cursor);
        if page_left - remaining > 0 {
            page_left = remaining;
        }
        cursor = cursor + page_left;
        remaining = remaining - page_left;
    }
    translation_span_store(slot, ptbr, addr, count_words, write);
    return 1;
}

fn user_load_word(pid: t40, addr: t40) -> t40 {
    var phys: t40 = user_translate_dmem_addr(pid, addr, 0);
    if phys < 0 {
        return phys;
    }
    return kload(phys);
}

fn user_store_word(pid: t40, addr: t40, value: t40) -> t40 {
    var phys: t40 = user_translate_dmem_addr(pid, addr, 1);
    if phys < 0 {
        return phys;
    }
    kstore(phys, value);
    return 1;
}

fn user_copy_from_kernel_validated(pid: t40, dst_addr: t40, src_addr: t40, count_words: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return slot;
    }
    var remaining: t40 = count_words;
    var copied: t40 = 0;
    while remaining > 0 {
        var dst_phys: t40 = user_translate_slot_dmem_addr(slot, dst_addr + copied, 1);
        if dst_phys < 0 {
            return dst_phys;
        }
        var chunk: t40 = MMU_PAGE_WORDS - user_page_offset(dst_addr + copied);
        if chunk - remaining > 0 {
            chunk = remaining;
        }
        var i: t40 = 0;
        while chunk - i > 0 {
            kstore(dst_phys + i, kload(src_addr + copied + i));
            i = i + 1;
        }
        copied = copied + chunk;
        remaining = remaining - chunk;
    }
    return copied;
}

fn user_copy_to_kernel_validated(pid: t40, src_addr: t40, dst_addr: t40, count_words: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return slot;
    }
    var remaining: t40 = count_words;
    var copied: t40 = 0;
    while remaining > 0 {
        var src_phys: t40 = user_translate_slot_dmem_addr(slot, src_addr + copied, 0);
        if src_phys < 0 {
            return src_phys;
        }
        var chunk: t40 = MMU_PAGE_WORDS - user_page_offset(src_addr + copied);
        if chunk - remaining > 0 {
            chunk = remaining;
        }
        var i: t40 = 0;
        while chunk - i > 0 {
            kstore(dst_addr + copied + i, kload(src_phys + i));
            i = i + 1;
        }
        copied = copied + chunk;
        remaining = remaining - chunk;
    }
    return copied;
}

fn user_copy_cstring_to_kernel(pid: t40, src_addr: t40, dst_addr: t40, max_words: t40) -> t40 {
    if max_words <= 0 {
        return ERR_BAD_PTR;
    }
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return ERR_BAD_PTR;
    }
    var i: t40 = 0;
    while max_words - i > 0 {
        var src_phys: t40 = user_translate_slot_dmem_addr(slot, src_addr + i, 0);
        if src_phys < 0 {
            return ERR_BAD_PTR;
        }
        var chunk: t40 = MMU_PAGE_WORDS - user_page_offset(src_addr + i);
        if chunk - (max_words - i) > 0 {
            chunk = max_words - i;
        }
        var j: t40 = 0;
        while chunk - j > 0 {
            var word: t40 = kload(src_phys + j);
            kstore(dst_addr + i + j, word);
            if word == 0 {
                return i + j + 1;
            }
            j = j + 1;
        }
        i = i + chunk;
    }
    kstore(dst_addr + max_words - 1, 0);
    return ERR_BAD_PTR;
}

fn validate_user_cstring(addr: t40, max_words: t40) -> t40 {
    if validate_user_span(addr, 1, 0) <= 0 {
        return 0;
    }
    var i: t40 = 0;
    while max_words - i > 0 {
        var c: t40 = kload(addr + i);
        if c == 0 {
            return i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn inode_addr(inode: t40) -> t40 {
    return VFS_INODE_BASE + inode * VFS_INODE_WORDS;
}

fn dirent_addr(slot: t40) -> t40 {
    return VFS_DIRENT_BASE + slot * VFS_DIRENT_WORDS;
}

fn dirent_name_addr(slot: t40) -> t40 {
    return VFS_DIRENT_NAME_BASE + slot * VFS_MAX_NAME_WORDS;
}

fn extent_addr(slot: t40) -> t40 {
    return VFS_EXTENT_BASE + slot * VFS_EXTENT_WORDS;
}

fn fd_addr(fd: t40) -> t40 {
    return VFS_FD_BASE + fd * VFS_FD_WORDS;
}

fn vfs_component_hash(start: t40, len: t40) -> t40 {
    var h: t40 = 17;
    var i: t40 = 0;
    while len - i > 0 {
        var c: t40 = kload(start + i);
        h = h * 31 + c;
        i = i + 1;
    }
    return h;
}

fn vfs_name_equal(slot: t40, start: t40, len: t40) -> t40 {
    var stored_len: t40 = kload(dirent_addr(slot) + DIRENT_NAME_LEN);
    if stored_len - len != 0 {
        return 0;
    }
    var i: t40 = 0;
    while len - i > 0 {
        var a: t40 = kload(dirent_name_addr(slot) + i);
        var b: t40 = kload(start + i);
        if a - b != 0 {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

fn vfs_dirent_limit() -> t40 {
    var limit: t40 = kload(VFS_NEXT_DIRENT_ADDR);
    if limit < 0 {
        return 0;
    }
    if limit - VFS_MAX_DIRENTS > 0 {
        return VFS_MAX_DIRENTS;
    }
    return limit;
}

fn vfs_find_child(namespace_id: t40, parent_inode: t40, name_start: t40, name_len: t40, name_hash: t40) -> t40 {
    var slot: t40 = 0;
    var dirent_limit: t40 = vfs_dirent_limit();
    while dirent_limit - slot > 0 {
        var row: t40 = dirent_addr(slot);
        var child: t40 = kload(row + DIRENT_CHILD);
        if child > 0 {
            if kload(row + DIRENT_NAMESPACE) - namespace_id == 0 {
                if kload(row + DIRENT_PARENT) - parent_inode == 0 {
                    if kload(row + DIRENT_HASH) - name_hash == 0 {
                        if vfs_name_equal(slot, name_start, name_len) > 0 {
                            return child;
                        }
                    } else {
                        if vfs_name_equal(slot, name_start, name_len) > 0 {
                            return child;
                        }
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

fn vfs_parent_of(inode: t40) -> t40 {
    if inode == 0 {
        return 0;
    }
    return kload(inode_addr(inode) + INODE_FLAGS);
}

fn vfs_resolve_component(namespace_id: t40, current: t40, start: t40, len: t40) -> t40 {
    if len == 1 {
        if kload(start) - 46 == 0 {
            return current;
        }
    }
    if len == 2 {
        if kload(start) - 46 == 0 {
            if kload(start + 1) - 46 == 0 {
                return vfs_parent_of(current);
            }
        }
    }
    var h: t40 = vfs_component_hash(start, len);
    return vfs_find_child(namespace_id, current, start, len, h);
}

fn vfs_lookup(namespace_id: t40, path_addr: t40) -> t40 {
    metric_inc(METRIC_VFS_LOOKUPS_ADDR);
    if validate_user_cstring(path_addr, VFS_MAX_PATH_WORDS) <= 0 {
        return ERR_BAD_PTR;
    }
    if kload(path_addr) - 47 != 0 {
        return ERR_INVALID;
    }
    var current: t40 = 0;
    var pos: t40 = path_addr;
    var done: t40 = 0;
    while 1 - done > 0 {
        var c: t40 = kload(pos);
        while c - 47 == 0 {
            pos = pos + 1;
            c = kload(pos);
        }
        if c == 0 {
            return current;
        }
        var start: t40 = pos;
        var len: t40 = 0;
        var scanning: t40 = 1;
        while scanning > 0 {
            c = kload(pos);
            if c == 0 {
                scanning = 0;
            } else {
                if c - 47 == 0 {
                    scanning = 0;
                } else {
                    len = len + 1;
                    pos = pos + 1;
                }
            }
        }
        if len <= 0 {
            return ERR_INVALID;
        }
        current = vfs_resolve_component(namespace_id, current, start, len);
        if current < 0 {
            return current;
        }
    }
    return current;
}

fn vfs_path_parent(namespace_id: t40, path_addr: t40) -> t40 {
    if validate_user_cstring(path_addr, VFS_MAX_PATH_WORDS) <= 0 {
        return ERR_BAD_PTR;
    }
    var current: t40 = 0;
    var pos: t40 = path_addr;
    var done: t40 = 0;
    while 1 - done > 0 {
        var c: t40 = kload(pos);
        while c - 47 == 0 {
            pos = pos + 1;
            c = kload(pos);
        }
        if c == 0 {
            return ERR_INVALID;
        }
        var start: t40 = pos;
        var len: t40 = 0;
        var scanning: t40 = 1;
        while scanning > 0 {
            c = kload(pos);
            if c == 0 {
                scanning = 0;
            } else {
                if c - 47 == 0 {
                    scanning = 0;
                } else {
                    len = len + 1;
                    pos = pos + 1;
                }
            }
        }
        if c == 0 {
            return current;
        }
        current = vfs_resolve_component(namespace_id, current, start, len);
        if current < 0 {
            return current;
        }
    }
    return current;
}

fn vfs_leaf_start(path_addr: t40) -> t40 {
    var pos: t40 = path_addr;
    var last: t40 = 0;
    var done: t40 = 0;
    while 1 - done > 0 {
        var c: t40 = kload(pos);
        if c == 0 {
            return last;
        }
        if c - 47 == 0 {
            pos = pos + 1;
        } else {
            last = pos;
            while c != 0 {
                if c - 47 == 0 {
                    c = 0;
                } else {
                    pos = pos + 1;
                    c = kload(pos);
                }
            }
        }
    }
    return last;
}

fn vfs_leaf_len(start: t40) -> t40 {
    var len: t40 = 0;
    var c: t40 = kload(start);
    while c != 0 {
        if c - 47 == 0 {
            return len;
        }
        len = len + 1;
        c = kload(start + len);
    }
    return len;
}

fn vfs_paths_equal(a: t40, b: t40) -> t40 {
    var i: t40 = 0;
    while VFS_MAX_PATH_WORDS - i > 0 {
        var left: t40 = kload(a + i);
        var right: t40 = kload(b + i);
        if left - right != 0 {
            return 0;
        }
        if left == 0 {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

fn vfs_find_extent(inode: t40) -> t40 {
    var slot: t40 = 0;
    while VFS_MAX_EXTENTS - slot > 0 {
        var row: t40 = extent_addr(slot);
        if kload(row + EXTENT_INODE) - inode == 0 {
            if kload(row + EXTENT_VERSION) > 0 {
                return slot;
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

fn vfs_find_extent_covering(inode: t40, logical_word: t40) -> t40 {
    var slot: t40 = 0;
    while VFS_MAX_EXTENTS - slot > 0 {
        var row: t40 = extent_addr(slot);
        if kload(row + EXTENT_INODE) - inode == 0 {
            if kload(row + EXTENT_VERSION) > 0 {
                var start: t40 = kload(row + EXTENT_LOGICAL_START);
                var length_words: t40 = kload(row + EXTENT_LENGTH);
                if logical_word - start >= 0 {
                    if start + length_words - logical_word > 0 {
                        return slot;
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

fn vfs_readahead(namespace_id: t40, inode: t40, logical_word: t40, size_words: t40) -> t40 {
    if logical_word - size_words >= 0 {
        return 0;
    }
    var extent_slot: t40 = vfs_find_extent_covering(inode, logical_word);
    if extent_slot < 0 {
        return 0;
    }
    var ex: t40 = extent_addr(extent_slot);
    var start: t40 = kload(ex + EXTENT_LOGICAL_START);
    var data: t40 = kload(ex + EXTENT_DATA_ADDR);
    var in_extent: t40 = logical_word - start;
    var buffer_slot: t40 = buffer_pin(namespace_id, inode, logical_word, data + in_extent);
    if buffer_slot < 0 {
        return 0;
    }
    buffer_unpin(buffer_slot);
    return 1;
}

fn vfs_extent_count(inode: t40) -> t40 {
    var slot: t40 = 0;
    var count: t40 = 0;
    while VFS_MAX_EXTENTS - slot > 0 {
        var row: t40 = extent_addr(slot);
        if kload(row + EXTENT_INODE) - inode == 0 {
            if kload(row + EXTENT_VERSION) > 0 {
                if kload(row + EXTENT_LENGTH) > 0 {
                    count = count + 1;
                }
            }
        }
        slot = slot + 1;
    }
    return count;
}

// Allocation rows are reusable tombstones.  The high-water cursors remain
// monotonic so old v2 images and WAL recovery keep their layout contract.
fn vfs_find_free_inode_slot() -> t40 {
    var limit: t40 = kload(VFS_NEXT_INODE_ADDR);
    if limit - 1 < 0 { limit = 1; }
    if limit - VFS_MAX_INODES > 0 { limit = VFS_MAX_INODES; }
    var slot: t40 = 1;
    while limit - slot > 0 {
        if kload(inode_addr(slot) + INODE_KIND) - KIND_FREE == 0 {
            return slot;
        }
        slot = slot + 1;
    }
    if kload(VFS_NEXT_INODE_ADDR) - VFS_MAX_INODES < 0 {
        return kload(VFS_NEXT_INODE_ADDR);
    }
    return ERR_NO_SPACE;
}

fn vfs_find_free_dirent_slot() -> t40 {
    var limit: t40 = vfs_dirent_limit();
    var slot: t40 = 0;
    while limit - slot > 0 {
        var row: t40 = dirent_addr(slot);
        if kload(row + DIRENT_VERSION) <= 0 {
            return slot;
        }
        if kload(row + DIRENT_CHILD) <= 0 {
            return slot;
        }
        slot = slot + 1;
    }
    if kload(VFS_NEXT_DIRENT_ADDR) - VFS_MAX_DIRENTS < 0 {
        return kload(VFS_NEXT_DIRENT_ADDR);
    }
    return ERR_NO_SPACE;
}

fn vfs_find_free_extent_for_length(length_words: t40) -> t40 {
    if length_words <= 0 { return ERR_INVALID; }
    var limit: t40 = kload(VFS_NEXT_EXTENT_ADDR);
    if limit - VFS_MAX_EXTENTS > 0 { limit = VFS_MAX_EXTENTS; }
    var slot: t40 = 0;
    while limit - slot > 0 {
        var row: t40 = extent_addr(slot);
        if kload(row + EXTENT_VERSION) <= 0 {
            var old_length: t40 = kload(row + EXTENT_LENGTH);
            var old_data: t40 = kload(row + EXTENT_DATA_ADDR);
            if old_length - length_words >= 0 {
                if old_data - VFS_DATA_BASE >= 0 {
                    if old_data + old_length - VFS_DATA_BASE - VFS_PAYLOAD_WORDS <= 0 {
                        return slot;
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

// Return the directory-entry slot for an exact child name. Lookup returns
// only the inode, while rename must reuse the existing source slot so open
// descriptors and allocator cursors remain untouched.
fn vfs_find_child_slot(namespace_id: t40, parent_inode: t40,
                        name_start: t40, name_len: t40, name_hash: t40) -> t40 {
    var slot: t40 = 0;
    var dirent_limit: t40 = vfs_dirent_limit();
    while dirent_limit - slot > 0 {
        var row: t40 = dirent_addr(slot);
        var child: t40 = kload(row + DIRENT_CHILD);
        if child > 0 {
            if kload(row + DIRENT_NAMESPACE) - namespace_id == 0 {
                if kload(row + DIRENT_PARENT) - parent_inode == 0 {
                    if kload(row + DIRENT_HASH) - name_hash == 0 {
                        if vfs_name_equal(slot, name_start, name_len) > 0 {
                            return slot;
                        }
                    } else {
                        if vfs_name_equal(slot, name_start, name_len) > 0 {
                            return slot;
                        }
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return ERR_NOT_FOUND;
}

fn vfs_free_extent_rows() -> t40 {
    var limit: t40 = kload(VFS_NEXT_EXTENT_ADDR);
    if limit - VFS_MAX_EXTENTS > 0 { limit = VFS_MAX_EXTENTS; }
    var slot: t40 = 0;
    var free_rows: t40 = 0;
    while limit - slot > 0 {
        if kload(extent_addr(slot) + EXTENT_VERSION) <= 0 {
            free_rows = free_rows + 1;
        }
        slot = slot + 1;
    }
    return free_rows;
}

fn vfs_free_extent_words() -> t40 {
    var limit: t40 = kload(VFS_NEXT_EXTENT_ADDR);
    if limit - VFS_MAX_EXTENTS > 0 { limit = VFS_MAX_EXTENTS; }
    var slot: t40 = 0;
    var words: t40 = 0;
    while limit - slot > 0 {
        var row: t40 = extent_addr(slot);
        if kload(row + EXTENT_VERSION) <= 0 {
            var length_words: t40 = kload(row + EXTENT_LENGTH);
            if length_words > 0 {
                words = words + length_words;
            }
        }
        slot = slot + 1;
    }
    return words;
}

// Compact the metadata allocator after reclamation.  Allocation rows remain
// stable (open descriptors and extent references never change), while trailing
// free rows are removed from the durable high-water cursors.  A trailing data
// hole is reclaimed only after its tombstone span is trimmed/cleared in the
// same WAL transaction; this prevents a later tail allocation from aliasing a
// stale tombstone.  The helper is intentionally bounded by the existing WAL
// capacity preflight and is safe to call as a best-effort post-reclaim pass.
fn vfs_compact_allocator() -> t40 {
    var inode_limit: t40 = kload(VFS_NEXT_INODE_ADDR);
    if inode_limit - 1 < 0 { inode_limit = 1; }
    if inode_limit - VFS_MAX_INODES > 0 { inode_limit = VFS_MAX_INODES; }
    var inode_cursor: t40 = 1;
    var inode_slot: t40 = 1;
    while inode_limit - inode_slot > 0 {
        if kload(inode_addr(inode_slot) + INODE_KIND) - KIND_FREE != 0 {
            inode_cursor = inode_slot + 1;
        }
        inode_slot = inode_slot + 1;
    }

    var dirent_limit: t40 = vfs_dirent_limit();
    var dirent_cursor: t40 = 0;
    var dirent_slot: t40 = 0;
    while dirent_limit - dirent_slot > 0 {
        var dirent_row: t40 = dirent_addr(dirent_slot);
        if kload(dirent_row + DIRENT_CHILD) > 0 {
            if kload(dirent_row + DIRENT_VERSION) > 0 {
                dirent_cursor = dirent_slot + 1;
            }
        }
        dirent_slot = dirent_slot + 1;
    }

    var extent_limit: t40 = kload(VFS_NEXT_EXTENT_ADDR);
    if extent_limit < 0 { extent_limit = 0; }
    if extent_limit - VFS_MAX_EXTENTS > 0 { extent_limit = VFS_MAX_EXTENTS; }
    var extent_cursor: t40 = 0;
    var extent_slot: t40 = 0;
    var data_cursor: t40 = VFS_DATA_BASE;
    while VFS_MAX_EXTENTS - extent_slot > 0 {
        var extent_row: t40 = extent_addr(extent_slot);
        var extent_version: t40 = kload(extent_row + EXTENT_VERSION);
        var extent_length: t40 = kload(extent_row + EXTENT_LENGTH);
        var extent_data: t40 = kload(extent_row + EXTENT_DATA_ADDR);
        if extent_version > 0 {
            if extent_slot - extent_cursor >= 0 {
                extent_cursor = extent_slot + 1;
            }
            if extent_length > 0 {
                if extent_data - VFS_DATA_BASE >= 0 {
                    if extent_data + extent_length - data_cursor > 0 {
                        data_cursor = extent_data + extent_length;
                    }
                }
            }
        }
        extent_slot = extent_slot + 1;
    }
    // A malformed image must not move the data cursor outside its arena.
    if data_cursor - VFS_DATA_BASE < 0 { data_cursor = VFS_DATA_BASE; }
    if data_cursor - VFS_DATA_BASE - VFS_PAYLOAD_WORDS > 0 {
        data_cursor = VFS_DATA_BASE + VFS_PAYLOAD_WORDS;
    }

    // Free rows that lie wholly (or partly) beyond the live data frontier are
    // normalized before the cursor moves.  Keep the pass bounded so a nearly
    // full WAL simply defers the remaining cleanup to the next close/mount.
    var cleanup_rows: t40 = 0;
    var cleanup_slot: t40 = 0;
    while VFS_MAX_EXTENTS - cleanup_slot > 0 {
        var cleanup_row: t40 = extent_addr(cleanup_slot);
        if kload(cleanup_row + EXTENT_VERSION) <= 0 {
            var cleanup_length: t40 = kload(cleanup_row + EXTENT_LENGTH);
            var cleanup_data: t40 = kload(cleanup_row + EXTENT_DATA_ADDR);
            if cleanup_length > 0 {
                if cleanup_data - data_cursor >= 0 {
                    cleanup_rows = cleanup_rows + 1;
                } else {
                    if cleanup_data + cleanup_length - data_cursor > 0 {
                        cleanup_rows = cleanup_rows + 1;
                    }
                }
            }
        }
        cleanup_slot = cleanup_slot + 1;
    }

    var cursor_writes: t40 = 0;
    if inode_cursor - kload(VFS_NEXT_INODE_ADDR) != 0 {
        cursor_writes = cursor_writes + 1;
    }
    if dirent_cursor - kload(VFS_NEXT_DIRENT_ADDR) != 0 {
        cursor_writes = cursor_writes + 1;
    }
    if extent_cursor - kload(VFS_NEXT_EXTENT_ADDR) != 0 {
        cursor_writes = cursor_writes + 1;
    }
    if data_cursor - kload(VFS_NEXT_DATA_ADDR) != 0 {
        cursor_writes = cursor_writes + 1;
    }
    var required_records: t40 = cursor_writes + cleanup_rows * 2;
    if required_records <= 0 {
        return 1;
    }
    if log_capacity_for(required_records + 1) <= 0 {
        return ERR_NO_SPACE;
    }

    var txid: t40 = log_begin();
    var logged: t40 = 1;
    var normalize_slot: t40 = 0;
    while VFS_MAX_EXTENTS - normalize_slot > 0 {
        var normalize_row: t40 = extent_addr(normalize_slot);
        if kload(normalize_row + EXTENT_VERSION) <= 0 {
            var normalize_length: t40 = kload(normalize_row + EXTENT_LENGTH);
            var normalize_data: t40 = kload(normalize_row + EXTENT_DATA_ADDR);
            if normalize_length > 0 {
                var target_length: t40 = normalize_length;
                var target_data: t40 = normalize_data;
                if normalize_data - data_cursor >= 0 {
                    target_length = 0;
                    target_data = 0;
                } else {
                    if normalize_data + normalize_length - data_cursor > 0 {
                        target_length = data_cursor - normalize_data;
                    }
                }
                if target_length - normalize_length != 0 {
                    logged = log_write(txid, normalize_row + EXTENT_LENGTH,
                                       normalize_length, target_length);
                    if logged < 0 { log_abort(txid); return logged; }
                }
                if target_data - normalize_data != 0 {
                    logged = log_write(txid, normalize_row + EXTENT_DATA_ADDR,
                                       normalize_data, target_data);
                    if logged < 0 { log_abort(txid); return logged; }
                }
            }
        }
        normalize_slot = normalize_slot + 1;
    }
    if inode_cursor - kload(VFS_NEXT_INODE_ADDR) != 0 {
        logged = log_write(txid, VFS_NEXT_INODE_ADDR,
                           kload(VFS_NEXT_INODE_ADDR), inode_cursor);
        if logged < 0 { log_abort(txid); return logged; }
    }
    if dirent_cursor - kload(VFS_NEXT_DIRENT_ADDR) != 0 {
        logged = log_write(txid, VFS_NEXT_DIRENT_ADDR,
                           kload(VFS_NEXT_DIRENT_ADDR), dirent_cursor);
        if logged < 0 { log_abort(txid); return logged; }
    }
    if extent_cursor - kload(VFS_NEXT_EXTENT_ADDR) != 0 {
        logged = log_write(txid, VFS_NEXT_EXTENT_ADDR,
                           kload(VFS_NEXT_EXTENT_ADDR), extent_cursor);
        if logged < 0 { log_abort(txid); return logged; }
    }
    if data_cursor - kload(VFS_NEXT_DATA_ADDR) != 0 {
        logged = log_write(txid, VFS_NEXT_DATA_ADDR,
                           kload(VFS_NEXT_DATA_ADDR), data_cursor);
        if logged < 0 { log_abort(txid); return logged; }
    }
    var committed: t40 = log_commit(txid);
    if committed < 0 { return committed; }
    return 1;
}

fn vfs_inode_open_refs(namespace_id: t40, inode: t40) -> t40 {
    if inode < 0 { return 0; }
    if inode - VFS_MAX_INODES >= 0 { return 0; }
    var generation: t40 = kload(inode_addr(inode) + INODE_VERSION);
    var fd: t40 = 0;
    var refs: t40 = 0;
    while VFS_MAX_FDS - fd > 0 {
        var row: t40 = fd_addr(fd);
        if kload(row + FD_REFCOUNT) > 0 {
            if namespace_id < 0 {
                if kload(row + FD_INODE) - inode == 0 {
                    if kload(row + FD_INODE_VERSION) - generation == 0 {
                        refs = refs + 1;
                    }
                }
            } else {
                if kload(row + FD_NAMESPACE) - namespace_id == 0 {
                    if kload(row + FD_INODE) - inode == 0 {
                        if kload(row + FD_INODE_VERSION) - generation == 0 {
                            refs = refs + 1;
                        }
                    }
                }
            }
        }
        fd = fd + 1;
    }
    return refs;
}

fn vfs_inode_active_extent_count(inode: t40) -> t40 {
    var slot: t40 = 0;
    var count: t40 = 0;
    var limit: t40 = kload(VFS_NEXT_EXTENT_ADDR);
    if limit - VFS_MAX_EXTENTS > 0 { limit = VFS_MAX_EXTENTS; }
    while limit - slot > 0 {
        var row: t40 = extent_addr(slot);
        if kload(row + EXTENT_INODE) - inode == 0 {
            if kload(row + EXTENT_VERSION) > 0 {
                count = count + 1;
            }
        }
        slot = slot + 1;
    }
    return count;
}

// Record a complete extent reservation in the caller's transaction.  This is
// the only path that advances the extent/data cursors: log_write records
// after-images and log_commit publishes them atomically, while log_abort (or a
// failed log_write) leaves both the row and cursors untouched.
fn vfs_reserve_extent_tx(txid: t40, namespace_id: t40, inode: t40,
                         logical_start: t40, length_words: t40) -> t40 {
    if length_words <= 0 {
        return ERR_INVALID;
    }
    if inode < 0 { return ERR_INVALID; }
    if inode - VFS_MAX_INODES >= 0 { return ERR_INVALID; }
    var next: t40 = kload(VFS_NEXT_EXTENT_ADDR);
    var slot: t40 = vfs_find_free_extent_for_length(length_words);
    var reused: t40 = 0;
    if slot >= 0 {
        reused = 1;
    } else {
        slot = next;
        if slot - VFS_MAX_EXTENTS >= 0 {
            return ERR_NO_SPACE;
        }
    }
    var data: t40 = kload(VFS_NEXT_DATA_ADDR);
    if reused > 0 {
        data = kload(extent_addr(slot) + EXTENT_DATA_ADDR);
    } else {
        if data + length_words - VFS_DATA_BASE - VFS_PAYLOAD_WORDS > 0 {
            return ERR_NO_SPACE;
        }
    }
    // A direct helper call must fail before the first after-image when the WAL
    // cannot hold the complete row plus commit record.
    var required_records: t40 = 7;
    if reused <= 0 { required_records = 9; }
    if log_capacity_for(required_records) <= 0 {
        return ERR_NO_SPACE;
    }
    var row: t40 = extent_addr(slot);
    var logged: t40 = log_write(txid, row + EXTENT_NAMESPACE,
                                 kload(row + EXTENT_NAMESPACE), namespace_id);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + EXTENT_INODE,
                       kload(row + EXTENT_INODE), inode);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + EXTENT_LOGICAL_START,
                       kload(row + EXTENT_LOGICAL_START), logical_start);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + EXTENT_LENGTH,
                       kload(row + EXTENT_LENGTH), length_words);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + EXTENT_DATA_ADDR,
                       kload(row + EXTENT_DATA_ADDR), data);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + EXTENT_VERSION,
                       kload(row + EXTENT_VERSION), 1);
    if logged < 0 { return logged; }
    if reused <= 0 {
        logged = log_write(txid, VFS_NEXT_EXTENT_ADDR,
                           kload(VFS_NEXT_EXTENT_ADDR), next + 1);
        if logged < 0 { return logged; }
        logged = log_write(txid, VFS_NEXT_DATA_ADDR,
                           kload(VFS_NEXT_DATA_ADDR), data + length_words);
        if logged < 0 { return logged; }
    }
    return slot;
}

// Grow an extent only when it is the most recently allocated extent.  A
// non-tail extent cannot be enlarged in place without overlapping a later
// allocation; callers receive ERR_NO_SPACE and no state is changed.
fn vfs_grow_extent_tx(txid: t40, slot: t40, needed_words: t40) -> t40 {
    if slot < 0 { return ERR_INVALID; }
    if slot - VFS_MAX_EXTENTS >= 0 { return ERR_INVALID; }
    if needed_words <= 0 { return ERR_INVALID; }
    var row: t40 = extent_addr(slot);
    if kload(row + EXTENT_VERSION) <= 0 { return ERR_NOT_FOUND; }
    var old_length: t40 = kload(row + EXTENT_LENGTH);
    if old_length - needed_words >= 0 { return slot; }
    var data_end: t40 = kload(row + EXTENT_DATA_ADDR) + old_length;
    var next_data: t40 = kload(VFS_NEXT_DATA_ADDR);
    if data_end - next_data != 0 { return ERR_NO_SPACE; }
    if next_data + needed_words - old_length - VFS_DATA_BASE - VFS_PAYLOAD_WORDS > 0 {
        return ERR_NO_SPACE;
    }
    var logged: t40 = log_write(txid, row + EXTENT_LENGTH,
                                 old_length, needed_words);
    if logged < 0 { return logged; }
    logged = log_write(txid, VFS_NEXT_DATA_ADDR, next_data,
                       next_data + needed_words - old_length);
    if logged < 0 { return logged; }
    return slot;
}

fn vfs_alloc_extent_at(namespace_id: t40, inode: t40, logical_start: t40, length_words: t40) -> t40 {
    var txid: t40 = log_begin();
    var slot: t40 = vfs_reserve_extent_tx(txid, namespace_id, inode,
                                          logical_start, length_words);
    if slot < 0 {
        log_abort(txid);
        return slot;
    }
    var committed: t40 = log_commit(txid);
    if committed < 0 { return committed; }
    var tracked: t40 = inode_track_required_lsn(inode, committed);
    if tracked < 0 { return tracked; }
    return slot;
}

fn vfs_alloc_extent(namespace_id: t40, inode: t40, length_words: t40) -> t40 {
    return vfs_alloc_extent_at(namespace_id, inode, 0, length_words);
}

fn vfs_ensure_extent(namespace_id: t40, inode: t40, needed_words: t40) -> t40 {
    if needed_words <= 0 { return ERR_INVALID; }
    var slot: t40 = vfs_find_extent(inode);
    if slot >= 0 {
        var existing_row: t40 = extent_addr(slot);
        if kload(existing_row + EXTENT_LENGTH) - needed_words >= 0 {
            return slot;
        }
    }
    var txid: t40 = log_begin();
    if slot >= 0 {
        var grown: t40 = vfs_grow_extent_tx(txid, slot, needed_words);
        if grown < 0 {
            log_abort(txid);
            return grown;
        }
    } else {
        slot = vfs_reserve_extent_tx(txid, namespace_id, inode, 0,
                                     needed_words);
        if slot < 0 {
            log_abort(txid);
            return slot;
        }
    }
    var committed: t40 = log_commit(txid);
    if committed < 0 { return committed; }
    var tracked: t40 = inode_track_required_lsn(inode, committed);
    if tracked < 0 { return tracked; }
    return slot;
}

fn vfs_ensure_extent_covering(namespace_id: t40, inode: t40, logical_word: t40, remaining_words: t40) -> t40 {
    var slot: t40 = vfs_find_extent_covering(inode, logical_word);
    if slot >= 0 { return slot; }
    var length_words: t40 = remaining_words;
    if length_words - STORAGE_BLOCK_WORDS > 0 {
        length_words = STORAGE_BLOCK_WORDS;
    }
    return vfs_alloc_extent_at(namespace_id, inode, logical_word, length_words);
}

fn vfs_can_reserve_extents(inode: t40, offset_words: t40, count_words: t40) -> t40 {
    var missing_windows: t40 = 0;
    var missing_words: t40 = 0;
    var i: t40 = 0;
    while count_words - i > 0 {
        var logical_word: t40 = offset_words + i;
        var slot: t40 = vfs_find_extent_covering(inode, logical_word);
        var chunk: t40 = count_words - i;
        if slot >= 0 {
            var ex: t40 = extent_addr(slot);
            var start: t40 = kload(ex + EXTENT_LOGICAL_START);
            var length_words: t40 = kload(ex + EXTENT_LENGTH);
            var in_extent: t40 = logical_word - start;
            var window: t40 = length_words - in_extent;
            var remaining: t40 = count_words - i;
            if window - remaining > 0 {
                i = count_words;
            } else {
                i = i + window;
            }
            } else {
            if chunk - STORAGE_BLOCK_WORDS > 0 {
                chunk = STORAGE_BLOCK_WORDS;
            }
            missing_windows = missing_windows + 1;
            missing_words = missing_words + chunk;
            i = i + chunk;
        }
    }
    var free_rows: t40 = vfs_free_extent_rows();
    if kload(VFS_NEXT_EXTENT_ADDR) + missing_windows - VFS_MAX_EXTENTS > 0 {
        if free_rows - missing_windows < 0 {
            return 0;
        }
    }
    if kload(VFS_NEXT_DATA_ADDR) + missing_words - VFS_DATA_BASE - VFS_PAYLOAD_WORDS > 0 {
        if vfs_free_extent_words() - missing_words < 0 {
            return 0;
        }
    }
    return 1;
}

fn vfs_clear_tables() -> t40 {
    kclear(VFS_INODE_BASE, VFS_MAX_INODES * VFS_INODE_WORDS);
    kclear(VFS_DIRENT_BASE, VFS_MAX_DIRENTS * VFS_DIRENT_WORDS);
    kclear(VFS_DIRENT_NAME_BASE, VFS_MAX_DIRENTS * VFS_MAX_NAME_WORDS);
    kclear(VFS_EXTENT_BASE, VFS_MAX_EXTENTS * VFS_EXTENT_WORDS);
    kclear(VFS_FD_BASE, VFS_MAX_FDS * VFS_FD_WORDS);
    kclear(VFS_DATA_BASE, VFS_PAYLOAD_WORDS);
    return 1;
}

fn disk_block_count() -> t40 {
    unsafe { return csr_read(block_count); }
}

fn disk_read_block(block_no: t40, dst_addr: t40) -> t40 {
    unsafe {
        csr_write(block_index, block_no);
        csr_write(block_addr, dst_addr);
        csr_write(block_cmd, 1);
        return csr_read(block_status);
    }
}

fn disk_write_block(block_no: t40, src_addr: t40) -> t40 {
    unsafe {
        csr_write(block_index, block_no);
        csr_write(block_addr, src_addr);
        csr_write(block_cmd, 2);
        return csr_read(block_status);
    }
}

fn disk_flush() -> t40 {
    unsafe {
        csr_write(block_cmd, 4);
        return csr_read(block_status);
    }
}

fn disk_read_imem_block(block_no: t40, dst_pc: t40) -> t40 {
    unsafe {
        csr_write(block_index, block_no);
        csr_write(block_addr, dst_pc);
        csr_write(block_cmd, 3);
        return csr_read(block_status);
    }
}

fn vfs_disk_available() -> t40 {
    if disk_block_count() - VFS_DISK_REQUIRED_BLOCKS >= 0 {
        return 1;
    }
    return 0;
}

fn wal_addr_in_range(addr: t40, base: t40, words: t40) -> t40 {
    if addr - base >= 0 {
        if base + words - addr > 0 {
            return 1;
        }
    }
    return 0;
}

fn wal_addr_is_persistent(addr: t40) -> t40 {
    if wal_addr_in_range(addr, VFS_MAGIC_ADDR, 5) > 0 { return 1; }
    if wal_addr_in_range(addr, VFS_INODE_BASE, VFS_MAX_INODES * VFS_INODE_WORDS) > 0 { return 1; }
    if wal_addr_in_range(addr, VFS_DIRENT_BASE, VFS_MAX_DIRENTS * VFS_DIRENT_WORDS) > 0 { return 1; }
    if wal_addr_in_range(addr, VFS_DIRENT_NAME_BASE, VFS_MAX_DIRENTS * VFS_MAX_NAME_WORDS) > 0 { return 1; }
    if wal_addr_in_range(addr, VFS_EXTENT_BASE, VFS_MAX_EXTENTS * VFS_EXTENT_WORDS) > 0 { return 1; }
    if wal_addr_in_range(addr, VFS_DATA_BASE, VFS_PAYLOAD_WORDS) > 0 { return 1; }
    if wal_addr_in_range(addr, NAMESPACE_BASE, NAMESPACE_MAX * NAMESPACE_ROW_WORDS) > 0 { return 1; }
    if wal_addr_in_range(addr, QUOTA_BASE, QUOTA_MAX * QUOTA_ROW_WORDS) > 0 {
        var quota_field: t40 = addr - QUOTA_BASE;
        while quota_field - QUOTA_ROW_WORDS >= 0 {
            quota_field = quota_field - QUOTA_ROW_WORDS;
        }
        if quota_field - QUOTA_USED != 0 { return 1; }
    }
    return 0;
}

fn wal_record_is_persistent(slot: t40) -> t40 {
    if wal_record_valid(slot) <= 0 { return 0; }
    var rec: t40 = wal_record_addr(slot);
    if kload(rec + WAL_TYPE) - WAL_DATA == 0 {
        return wal_addr_is_persistent(kload(rec + WAL_OFFSET));
    }
    if kload(rec + WAL_TYPE) - WAL_COMMIT == 0 {
        return 1;
    }
    if kload(rec + WAL_TYPE) - WAL_CHECKPOINT == 0 {
        return 1;
    }
    return 0;
}

fn vfs_sync_range_to_disk(src_addr: t40, word_count: t40, first_block: t40, block_count: t40) -> t40 {
    var block: t40 = 0;
    var copied: t40 = 0;
    while block_count - block > 0 {
        var i: t40 = 0;
        while STORAGE_BLOCK_WORDS - i > 0 {
            var value: t40 = 0;
            if word_count - copied > 0 {
                value = kload(src_addr + copied);
                copied = copied + 1;
            }
            kstore(VFS_DISK_SCRATCH + i, value);
            i = i + 1;
        }
        if disk_write_block(first_block + block, VFS_DISK_SCRATCH) - 1 != 0 {
            return ERR_INVALID;
        }
        block = block + 1;
    }
    return copied;
}

fn vfs_blocks_for_words(word_count: t40) -> t40 {
    if word_count <= 0 {
        return 0;
    }
    var blocks: t40 = 0;
    var remaining: t40 = word_count;
    while remaining > 0 {
        blocks = blocks + 1;
        remaining = remaining - STORAGE_BLOCK_WORDS;
    }
    return blocks;
}

fn vfs_sync_used_range_to_disk(src_addr: t40, word_count: t40, first_block: t40, max_blocks: t40) -> t40 {
    var blocks: t40 = vfs_blocks_for_words(word_count);
    if blocks - max_blocks > 0 {
        return ERR_INVALID;
    }
    return vfs_sync_range_to_disk(src_addr, word_count, first_block, blocks);
}

fn vfs_load_range_from_disk(dst_addr: t40, word_count: t40, first_block: t40, block_count: t40) -> t40 {
    var block: t40 = 0;
    var copied: t40 = 0;
    while block_count - block > 0 {
        if disk_read_block(first_block + block, VFS_DISK_SCRATCH) - 1 != 0 {
            return ERR_INVALID;
        }
        var i: t40 = 0;
        while STORAGE_BLOCK_WORDS - i > 0 {
            if word_count - copied > 0 {
                kstore(dst_addr + copied, kload(VFS_DISK_SCRATCH + i));
                copied = copied + 1;
            }
            i = i + 1;
        }
        block = block + 1;
    }
    return copied;
}

fn vfs_load_used_range_from_disk(dst_addr: t40, word_count: t40, first_block: t40, max_blocks: t40) -> t40 {
    var blocks: t40 = vfs_blocks_for_words(word_count);
    if blocks - max_blocks > 0 {
        return ERR_INVALID;
    }
    return vfs_load_range_from_disk(dst_addr, word_count, first_block, blocks);
}

fn vfs_sync_quota_policy_to_disk() -> t40 {
    var quota_slot: t40 = 0;
    var policy_field: t40 = 0;
    var block: t40 = 0;
    while VFS_DISK_QUOTA_POLICY_BLOCKS - block > 0 {
        kclear(VFS_DISK_SCRATCH, STORAGE_BLOCK_WORDS);
        var word: t40 = 0;
        while STORAGE_BLOCK_WORDS - word > 0 {
            if QUOTA_MAX - quota_slot > 0 {
                var row: t40 = quota_addr(quota_slot);
                var value: t40 = kload(row + QUOTA_ID);
                if policy_field - 1 == 0 {
                    value = kload(row + QUOTA_LIMIT);
                } else if policy_field - 2 == 0 {
                    value = kload(row + QUOTA_VERSION);
                }
                kstore(VFS_DISK_SCRATCH + word, value);
                policy_field = policy_field + 1;
                if policy_field - VFS_DISK_QUOTA_POLICY_WORDS == 0 {
                    policy_field = 0;
                    quota_slot = quota_slot + 1;
                }
            }
            word = word + 1;
        }
        if disk_write_block(VFS_DISK_QUOTA_POLICY_BLOCK + block,
                            VFS_DISK_SCRATCH) - 1 != 0 {
            return ERR_INVALID;
        }
        block = block + 1;
    }
    return quota_slot;
}

fn vfs_load_quota_policy_from_disk() -> t40 {
    var quota_slot: t40 = 0;
    var policy_field: t40 = 0;
    var block: t40 = 0;
    while VFS_DISK_QUOTA_POLICY_BLOCKS - block > 0 {
        if disk_read_block(VFS_DISK_QUOTA_POLICY_BLOCK + block,
                           VFS_DISK_SCRATCH) - 1 != 0 {
            return ERR_INVALID;
        }
        var word: t40 = 0;
        while STORAGE_BLOCK_WORDS - word > 0 {
            if QUOTA_MAX - quota_slot > 0 {
                var row: t40 = quota_addr(quota_slot);
                var value: t40 = kload(VFS_DISK_SCRATCH + word);
                if policy_field == 0 {
                    if value - quota_slot != 0 { return ERR_INVALID; }
                    kstore(row + QUOTA_ID, value);
                    kstore(row + QUOTA_USED, 0);
                } else if policy_field - 1 == 0 {
                    kstore(row + QUOTA_LIMIT, value);
                } else {
                    kstore(row + QUOTA_VERSION, value);
                }
                policy_field = policy_field + 1;
                if policy_field - VFS_DISK_QUOTA_POLICY_WORDS == 0 {
                    policy_field = 0;
                    quota_slot = quota_slot + 1;
                }
            }
            word = word + 1;
        }
        block = block + 1;
    }
    return quota_slot;
}

fn wal_sync_to_disk() -> t40 {
    if vfs_disk_available() <= 0 {
        kstore(WAL_LAST_ERROR_ADDR, ERR_NO_SPACE);
        return ERR_NO_SPACE;
    }
    var durable_head: t40 = kload(WAL_DURABLE_HEAD_ADDR);
    var head: t40 = kload(WAL_HEAD_ADDR);
    var last_lsn: t40 = kload(WAL_DURABLE_LSN_ADDR);
    while durable_head - head != 0 {
        var rec: t40 = wal_record_addr(durable_head);
        if wal_record_valid(durable_head) <= 0 {
            kstore(WAL_LAST_ERROR_ADDR, ERR_INVALID);
            return ERR_INVALID;
        }
        if disk_write_block(WAL_DISK_RECORD_BLOCK + durable_head, rec) - 1 != 0 {
            kstore(WAL_LAST_ERROR_ADDR, ERR_INVALID);
            return ERR_INVALID;
        }
        last_lsn = kload(rec + WAL_LSN);
        durable_head = kwrap_inc(durable_head, WAL_CAPACITY);
    }

    var generation: t40 = kload(WAL_GENERATION_ADDR) + 1;
    var next_super: t40 = 1 - kload(WAL_ACTIVE_SUPER_ADDR);
    kclear(VFS_DISK_SCRATCH, STORAGE_BLOCK_WORDS);
    kstore(VFS_DISK_SCRATCH + 0, WAL_DISK_MAGIC);
    kstore(VFS_DISK_SCRATCH + 1, WAL_DISK_VERSION);
    kstore(VFS_DISK_SCRATCH + 2, generation);
    kstore(VFS_DISK_SCRATCH + 3, head);
    kstore(VFS_DISK_SCRATCH + 4, kload(WAL_TAIL_ADDR));
    kstore(VFS_DISK_SCRATCH + 5, last_lsn);
    kstore(VFS_DISK_SCRATCH + 6, kload(WAL_CHECKPOINT_ADDR));
    kstore(VFS_DISK_SCRATCH + 7, WAL_CAPACITY);
    kstore(VFS_DISK_SCRATCH + 8, WAL_RECORD_WORDS);
    kstore(VFS_DISK_SCRATCH + 9, kload(WAL_NEXT_TXID_ADDR));
    kstore(VFS_DISK_SCRATCH + 10, kload(WAL_NEXT_LSN_ADDR));
    var checksum: t40 = 17;
    var i: t40 = 0;
    while 11 - i > 0 {
        checksum = checksum + kload(VFS_DISK_SCRATCH + i) * (i + 1);
        i = i + 1;
    }
    kstore(VFS_DISK_SCRATCH + 11, checksum);
    var super_block: t40 = WAL_DISK_SUPER_A_BLOCK;
    if next_super > 0 {
        super_block = WAL_DISK_SUPER_B_BLOCK;
    }
    if disk_write_block(super_block, VFS_DISK_SCRATCH) - 1 != 0 {
        kstore(WAL_LAST_ERROR_ADDR, ERR_INVALID);
        return ERR_INVALID;
    }
    if disk_flush() - 1 != 0 {
        kstore(WAL_LAST_ERROR_ADDR, ERR_INVALID);
        return ERR_INVALID;
    }
    kstore(WAL_DURABLE_HEAD_ADDR, head);
    kstore(WAL_DURABLE_LSN_ADDR, last_lsn);
    kstore(WAL_GENERATION_ADDR, generation);
    kstore(WAL_ACTIVE_SUPER_ADDR, next_super);
    kstore(WAL_PENDING_TX_ADDR, 0);
    kstore(WAL_PENDING_BLOCK_ADDR, 0);
    kstore(WAL_FIRST_PENDING_TICK_ADDR, -1);
    kstore(WAL_LAST_ERROR_ADDR, 0);
    return 1;
}

fn wal_super_valid(addr: t40) -> t40 {
    if kload(addr + 0) - WAL_DISK_MAGIC != 0 { return 0; }
    if kload(addr + 1) - WAL_DISK_VERSION != 0 { return 0; }
    if kload(addr + 7) - WAL_CAPACITY != 0 { return 0; }
    if kload(addr + 8) - WAL_RECORD_WORDS != 0 { return 0; }
    var checksum: t40 = 17;
    var i: t40 = 0;
    while 11 - i > 0 {
        checksum = checksum + kload(addr + i) * (i + 1);
        i = i + 1;
    }
    if checksum - kload(addr + 11) != 0 { return 0; }
    return 1;
}

fn wal_load_from_disk() -> t40 {
    if vfs_disk_available() <= 0 {
        return ERR_NO_SPACE;
    }
    var super_copy: t40 = WAL_BASE - STORAGE_BLOCK_WORDS;
    if disk_read_block(WAL_DISK_SUPER_A_BLOCK, super_copy) - 1 != 0 {
        return ERR_INVALID;
    }
    if disk_read_block(WAL_DISK_SUPER_B_BLOCK, VFS_DISK_SCRATCH) - 1 != 0 {
        return ERR_INVALID;
    }
    var chosen: t40 = super_copy;
    var active: t40 = 0;
    var valid_a: t40 = wal_super_valid(super_copy);
    var valid_b: t40 = wal_super_valid(VFS_DISK_SCRATCH);
    if valid_a <= 0 {
        if valid_b <= 0 {
            // Release images intentionally start with an empty WAL region;
            // distinguish that format state from a torn WAL by requiring the
            // entire ring to be zero before bootstrapping fresh metadata.
            var empty_slot: t40 = 0;
            var empty_wal: t40 = 1;
            while WAL_CAPACITY - empty_slot > 0 {
                if disk_read_block(WAL_DISK_RECORD_BLOCK + empty_slot,
                                   wal_record_addr(empty_slot)) - 1 != 0 {
                    return ERR_INVALID;
                }
                var empty_word: t40 = 0;
                while WAL_RECORD_WORDS - empty_word > 0 {
                    if kload(wal_record_addr(empty_slot) + empty_word) != 0 {
                        empty_wal = 0;
                    }
                    empty_word = empty_word + 1;
                }
                empty_slot = empty_slot + 1;
            }
            if empty_wal > 0 {
                wal_init();
                return 1;
            }
            return ERR_INVALID;
        }
        chosen = VFS_DISK_SCRATCH;
        active = 1;
    } else {
        if valid_b > 0 {
            if kload(VFS_DISK_SCRATCH + 2) - kload(super_copy + 2) > 0 {
                chosen = VFS_DISK_SCRATCH;
                active = 1;
            }
        }
    }

    // Reject a checksummed but structurally impossible superblock.  A power
    // loss can preserve an old checksum word alongside a newer torn field;
    // selecting such a boundary would let stale ring slots masquerade as a
    // committed transaction.
    if kload(chosen + 2) <= 0 {
        return ERR_INVALID;
    }
    if kload(chosen + 3) < 0 {
        return ERR_INVALID;
    }
    if kload(chosen + 3) - WAL_CAPACITY >= 0 {
        return ERR_INVALID;
    }
    if kload(chosen + 4) < 0 {
        return ERR_INVALID;
    }
    if kload(chosen + 4) - WAL_CAPACITY >= 0 {
        return ERR_INVALID;
    }
    if kload(chosen + 5) - kload(chosen + 6) < 0 {
        return ERR_INVALID;
    }
    if kload(chosen + 10) - kload(chosen + 5) <= 0 {
        return ERR_INVALID;
    }

    kstore(WAL_GENERATION_ADDR, kload(chosen + 2));
    kstore(WAL_HEAD_ADDR, kload(chosen + 3));
    kstore(WAL_DURABLE_HEAD_ADDR, kload(chosen + 3));
    kstore(WAL_TAIL_ADDR, kload(chosen + 4));
    kstore(WAL_DURABLE_LSN_ADDR, kload(chosen + 5));
    kstore(WAL_CHECKPOINT_ADDR, kload(chosen + 6));
    kstore(WAL_NEXT_TXID_ADDR, kload(chosen + 9));
    kstore(WAL_NEXT_LSN_ADDR, kload(chosen + 10));
    kstore(WAL_ACTIVE_SUPER_ADDR, active);
    kstore(WAL_PENDING_TX_ADDR, 0);
    kstore(WAL_PENDING_BLOCK_ADDR, 0);
    kstore(WAL_FIRST_PENDING_TICK_ADDR, -1);

    var slot: t40 = kload(WAL_TAIL_ADDR);
    var head: t40 = kload(WAL_HEAD_ADDR);
    var previous_lsn: t40 = kload(WAL_CHECKPOINT_ADDR);
    while slot - head != 0 {
        if disk_read_block(WAL_DISK_RECORD_BLOCK + slot, wal_record_addr(slot)) - 1 != 0 {
            return ERR_INVALID;
        }
        if wal_record_valid(slot) <= 0 {
            kstore(WAL_HEAD_ADDR, slot);
            kstore(WAL_DURABLE_HEAD_ADDR, slot);
            return 1;
        }
        var record_lsn: t40 = kload(wal_record_addr(slot) + WAL_LSN);
        if record_lsn - previous_lsn <= 0 {
            kstore(WAL_HEAD_ADDR, slot);
            kstore(WAL_DURABLE_HEAD_ADDR, slot);
            return 1;
        }
        previous_lsn = record_lsn;
        slot = kwrap_inc(slot, WAL_CAPACITY);
    }
    return 1;
}

fn vfs_sync_state_to_disk() -> t40 {
    kclear(VFS_DISK_SCRATCH, STORAGE_BLOCK_WORDS);
    kstore(VFS_DISK_SCRATCH + 0, VFS_DISK_MAGIC);
    kstore(VFS_DISK_SCRATCH + 1, VFS_DISK_VERSION);
    kstore(VFS_DISK_SCRATCH + 2, STORAGE_BLOCK_WORDS);
    kstore(VFS_DISK_SCRATCH + 3, VFS_MAX_INODES);
    kstore(VFS_DISK_SCRATCH + 4, VFS_MAX_DIRENTS);
    kstore(VFS_DISK_SCRATCH + 5, VFS_MAX_EXTENTS);
    kstore(VFS_DISK_SCRATCH + 6, VFS_PAYLOAD_WORDS);
    kstore(VFS_DISK_SCRATCH + 7, kload(VFS_MAGIC_ADDR));
    kstore(VFS_DISK_SCRATCH + 8, kload(VFS_NEXT_INODE_ADDR));
    kstore(VFS_DISK_SCRATCH + 9, kload(VFS_NEXT_DIRENT_ADDR));
    kstore(VFS_DISK_SCRATCH + 10, kload(VFS_NEXT_EXTENT_ADDR));
    kstore(VFS_DISK_SCRATCH + 11, kload(VFS_NEXT_DATA_ADDR));
    kstore(VFS_DISK_SCRATCH + 12, NAMESPACE_MAX);
    kstore(VFS_DISK_SCRATCH + 13, QUOTA_MAX);
    kstore(VFS_DISK_SCRATCH + 14, VFS_DISK_QUOTA_POLICY_WORDS);
    kstore(VFS_DISK_SCRATCH + 15, VFS_DISK_REQUIRED_BLOCKS);
    return disk_write_block(VFS_DISK_SUPER_BLOCK, VFS_DISK_SCRATCH);
}

fn vfs_load_state_from_disk() -> t40 {
    if disk_read_block(VFS_DISK_SUPER_BLOCK, VFS_DISK_SCRATCH) - 1 != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 0) - VFS_DISK_MAGIC != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 1) - VFS_DISK_VERSION != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 2) - STORAGE_BLOCK_WORDS != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 3) - VFS_MAX_INODES != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 4) - VFS_MAX_DIRENTS != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 5) - VFS_MAX_EXTENTS != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 6) - VFS_PAYLOAD_WORDS != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 12) - NAMESPACE_MAX != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 13) - QUOTA_MAX != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 14) - VFS_DISK_QUOTA_POLICY_WORDS != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 15) - VFS_DISK_REQUIRED_BLOCKS != 0 {
        return ERR_INVALID;
    }
    if kload(VFS_DISK_SCRATCH + 7) - KERNEL_MAGIC != 0 {
        return ERR_INVALID;
    }
    kstore(VFS_MAGIC_ADDR, kload(VFS_DISK_SCRATCH + 7));
    kstore(VFS_NEXT_INODE_ADDR, kload(VFS_DISK_SCRATCH + 8));
    kstore(VFS_NEXT_DIRENT_ADDR, kload(VFS_DISK_SCRATCH + 9));
    kstore(VFS_NEXT_EXTENT_ADDR, kload(VFS_DISK_SCRATCH + 10));
    kstore(VFS_NEXT_DATA_ADDR, kload(VFS_DISK_SCRATCH + 11));
    return 1;
}

fn vfs_sync_partial_range_to_disk(src_addr: t40, word_count: t40, array_base: t40, first_block: t40) -> t40 {
    if word_count <= 0 { return 0; }
    var relative: t40 = src_addr - array_base;
    if relative < 0 { return ERR_INVALID; }
    var copied: t40 = 0;
    while word_count - copied > 0 {
        var block_index: t40 = 0;
        var block_offset: t40 = relative;
        while block_offset - STORAGE_BLOCK_WORDS >= 0 {
            block_offset = block_offset - STORAGE_BLOCK_WORDS;
            block_index = block_index + 1;
        }
        var take: t40 = STORAGE_BLOCK_WORDS - block_offset;
        if take - (word_count - copied) > 0 {
            take = word_count - copied;
        }
        if disk_read_block(first_block + block_index, VFS_DISK_SCRATCH) - 1 != 0 {
            return ERR_INVALID;
        }
        var i: t40 = 0;
        while take - i > 0 {
            kstore(VFS_DISK_SCRATCH + block_offset + i, kload(src_addr + copied + i));
            i = i + 1;
        }
        if disk_write_block(first_block + block_index, VFS_DISK_SCRATCH) - 1 != 0 {
            return ERR_INVALID;
        }
        copied = copied + take;
        relative = relative + take;
    }
    return copied;
}

fn vfs_sync_inode_to_disk(namespace_id: t40, inode: t40) -> t40 {
    if inode < 0 { return ERR_INVALID; }
    if inode - VFS_MAX_INODES >= 0 { return ERR_INVALID; }
    if vfs_disk_available() <= 0 { return ERR_NO_SPACE; }

    // A targeted home-page write may only follow the WAL barrier for this
    // inode's dependency.  This also makes direct callers safe.
    var required_lsn: t40 = inode_required_lsn(inode);
    if required_lsn - kload(WAL_DURABLE_LSN_ADDR) > 0 {
        var wal_status: t40 = wal_sync_to_disk();
        if wal_status < 0 { return wal_status; }
    }
    if vfs_sync_state_to_disk() - 1 != 0 { return ERR_INVALID; }
    if vfs_sync_partial_range_to_disk(
            inode_addr(inode), VFS_INODE_WORDS, VFS_INODE_BASE,
            VFS_DISK_INODE_BLOCK) < 0 {
        return ERR_INVALID;
    }

    // A newly created inode is reachable through its directory entry.  Sync
    // that entry and name, but leave unrelated namespace entries untouched.
    var dir_slot: t40 = 0;
    var dir_limit: t40 = kload(VFS_NEXT_DIRENT_ADDR);
    while dir_limit - dir_slot > 0 {
        var dir_row: t40 = dirent_addr(dir_slot);
        if kload(dir_row + DIRENT_NAMESPACE) - namespace_id == 0 {
            if kload(dir_row + DIRENT_CHILD) - inode == 0 {
                if vfs_sync_partial_range_to_disk(
                        dir_row, VFS_DIRENT_WORDS, VFS_DIRENT_BASE,
                        VFS_DISK_DIRENT_BLOCK) < 0 {
                    return ERR_INVALID;
                }
                if vfs_sync_partial_range_to_disk(
                        dirent_name_addr(dir_slot), VFS_MAX_NAME_WORDS,
                        VFS_DIRENT_NAME_BASE, VFS_DISK_DIRENT_NAME_BLOCK) < 0 {
                    return ERR_INVALID;
                }
            }
            // Unlink clears CHILD before the final close.  v2 has no separate
            // inode owner in a tombstone, so a descriptor fsync conservatively
            // persists all tombstones in this namespace as well.
            if kload(dir_row + DIRENT_CHILD) <= 0 {
                if kload(dir_row + DIRENT_VERSION) <= 0 {
                    if vfs_sync_partial_range_to_disk(
                            dir_row, VFS_DIRENT_WORDS, VFS_DIRENT_BASE,
                            VFS_DISK_DIRENT_BLOCK) < 0 {
                        return ERR_INVALID;
                    }
                    if vfs_sync_partial_range_to_disk(
                            dirent_name_addr(dir_slot), VFS_MAX_NAME_WORDS,
                            VFS_DIRENT_NAME_BASE, VFS_DISK_DIRENT_NAME_BLOCK) < 0 {
                        return ERR_INVALID;
                    }
                }
            }
        }
        dir_slot = dir_slot + 1;
    }

    // Extent rows and their payload blocks are the inode's data and metadata.
    var extent_slot: t40 = 0;
    var extent_limit: t40 = kload(VFS_NEXT_EXTENT_ADDR);
    while extent_limit - extent_slot > 0 {
        var extent_row: t40 = extent_addr(extent_slot);
        if kload(extent_row + EXTENT_NAMESPACE) - namespace_id == 0 {
            if kload(extent_row + EXTENT_INODE) - inode == 0 {
                if vfs_sync_partial_range_to_disk(
                        extent_row, VFS_EXTENT_WORDS, VFS_EXTENT_BASE,
                        VFS_DISK_EXTENT_BLOCK) < 0 {
                    return ERR_INVALID;
                }
                if kload(extent_row + EXTENT_VERSION) > 0 {
                    var data_addr: t40 = kload(extent_row + EXTENT_DATA_ADDR);
                    var length_words: t40 = kload(extent_row + EXTENT_LENGTH);
                    if vfs_sync_partial_range_to_disk(
                            data_addr, length_words, VFS_DATA_BASE,
                            VFS_DISK_DATA_BLOCK) < 0 {
                        return ERR_INVALID;
                    }
                }
            }
        }
        extent_slot = extent_slot + 1;
    }
    return 1;
}

fn vfs_prepare_inode_reclaim(namespace_id: t40, inode: t40) -> t40 {
    var required_lsn: t40 = inode_required_lsn(inode);
    if vfs_disk_available() > 0 {
        if required_lsn - kload(WAL_DURABLE_LSN_ADDR) > 0 {
            var wal_status: t40 = wal_sync_to_disk();
            if wal_status < 0 { return wal_status; }
        }
    }
    return buffer_invalidate_inode(namespace_id, inode);
}

fn vfs_reclaim_inode_step(namespace_id: t40, inode: t40) -> t40 {
    if inode <= 0 { return 0; }
    if inode - VFS_MAX_INODES >= 0 { return ERR_INVALID; }
    var row: t40 = inode_addr(inode);
    if kload(row + INODE_KIND) - KIND_FREE == 0 {
        return 0;
    }
    if kload(row + INODE_LINKS) > 0 {
        return 0;
    }
    if vfs_inode_open_refs(-1, inode) > 0 {
        return ERR_AGAIN;
    }

    var active: t40 = vfs_inode_active_extent_count(inode);
    if active > 0 {
        var take: t40 = active;
        if take - VFS_RECLAIM_EXTENTS_PER_TX > 0 {
            take = VFS_RECLAIM_EXTENTS_PER_TX;
        }
        if log_capacity_for(take + 1) <= 0 {
            return ERR_NO_SPACE;
        }
        var prepared: t40 = vfs_prepare_inode_reclaim(namespace_id, inode);
        if prepared < 0 { return prepared; }
        var txid: t40 = log_begin();
        var slot: t40 = 0;
        var freed: t40 = 0;
        var limit: t40 = kload(VFS_NEXT_EXTENT_ADDR);
        if limit - VFS_MAX_EXTENTS > 0 { limit = VFS_MAX_EXTENTS; }
        while limit - slot > 0 {
            var extent_row: t40 = extent_addr(slot);
            if kload(extent_row + EXTENT_INODE) - inode == 0 {
                if kload(extent_row + EXTENT_VERSION) > 0 {
                    var logged: t40 = log_write(
                        txid, extent_row + EXTENT_VERSION,
                        kload(extent_row + EXTENT_VERSION), 0);
                    if logged < 0 {
                        log_abort(txid);
                        return logged;
                    }
                    freed = freed + 1;
                    if freed - take >= 0 {
                        slot = limit;
                    }
                }
            }
            slot = slot + 1;
        }
        var commit_lsn: t40 = log_commit(txid);
        if commit_lsn < 0 { return commit_lsn; }
        var tracked: t40 = inode_track_required_lsn(inode, commit_lsn);
        if tracked < 0 { return tracked; }
        return freed;
    }

    // Keep INODE_VERSION as a durable allocation generation.  Reclamation
    // advances it once, so descriptors from the old lifetime fail validation
    // even though the on-disk row is otherwise a free slot.
    if log_capacity_for(8) <= 0 {
        return ERR_NO_SPACE;
    }
    var prepared_final: t40 = vfs_prepare_inode_reclaim(namespace_id, inode);
    if prepared_final < 0 { return prepared_final; }
    var old_generation: t40 = kload(row + INODE_VERSION);
    var next_generation: t40 = old_generation + 1;
    if next_generation <= 0 { next_generation = 1; }
    var tx_final: t40 = log_begin();
    var logged_final: t40 = log_write(tx_final, row + INODE_KIND,
                                      kload(row + INODE_KIND), KIND_FREE);
    if logged_final < 0 { log_abort(tx_final); return logged_final; }
    logged_final = log_write(tx_final, row + INODE_MODE,
                             kload(row + INODE_MODE), 0);
    if logged_final < 0 { log_abort(tx_final); return logged_final; }
    logged_final = log_write(tx_final, row + INODE_SIZE,
                             kload(row + INODE_SIZE), 0);
    if logged_final < 0 { log_abort(tx_final); return logged_final; }
    logged_final = log_write(tx_final, row + INODE_LINKS,
                             kload(row + INODE_LINKS), 0);
    if logged_final < 0 { log_abort(tx_final); return logged_final; }
    logged_final = log_write(tx_final, row + INODE_VERSION,
                             kload(row + INODE_VERSION), next_generation);
    if logged_final < 0 { log_abort(tx_final); return logged_final; }
    logged_final = log_write(tx_final, row + INODE_MTIME,
                             kload(row + INODE_MTIME), kload(KERNEL_TICK_ADDR));
    if logged_final < 0 { log_abort(tx_final); return logged_final; }
    logged_final = log_write(tx_final, row + INODE_FLAGS,
                             kload(row + INODE_FLAGS), 0);
    if logged_final < 0 { log_abort(tx_final); return logged_final; }
    var final_lsn: t40 = log_commit(tx_final);
    if final_lsn < 0 { return final_lsn; }
    var final_tracked: t40 = inode_track_required_lsn(inode, final_lsn);
    if final_tracked < 0 { return final_tracked; }
    return 1;
}

fn vfs_inode_namespace(inode: t40) -> t40 {
    var fd: t40 = 0;
    while VFS_MAX_FDS - fd > 0 {
        var fdrow: t40 = fd_addr(fd);
        if kload(fdrow + FD_REFCOUNT) > 0 {
            if kload(fdrow + FD_INODE) - inode == 0 {
                return kload(fdrow + FD_NAMESPACE);
            }
        }
        fd = fd + 1;
    }
    var extent_limit: t40 = kload(VFS_NEXT_EXTENT_ADDR);
    if extent_limit - VFS_MAX_EXTENTS > 0 { extent_limit = VFS_MAX_EXTENTS; }
    var extent_slot: t40 = 0;
    while extent_limit - extent_slot > 0 {
        var extent_row: t40 = extent_addr(extent_slot);
        if kload(extent_row + EXTENT_INODE) - inode == 0 {
            return kload(extent_row + EXTENT_NAMESPACE);
        }
        extent_slot = extent_slot + 1;
    }
    return 0;
}

fn vfs_reclaim_pending() -> t40 {
    var limit: t40 = kload(VFS_NEXT_INODE_ADDR);
    if limit - VFS_MAX_INODES > 0 { limit = VFS_MAX_INODES; }
    var inode: t40 = 1;
    var reclaimed: t40 = 0;
    while limit - inode > 0 {
        var row: t40 = inode_addr(inode);
        if kload(row + INODE_KIND) - KIND_FREE != 0 {
            if kload(row + INODE_LINKS) <= 0 {
                // The inode row does not encode namespace; reclaim uses the
                // wildcard cache scope and FD generation scan.
                var rounds: t40 = 0;
                var max_rounds: t40 = VFS_MAX_EXTENTS /
                                      VFS_RECLAIM_EXTENTS_PER_TX + 1;
                while max_rounds - rounds > 0 {
                    var status: t40 = vfs_reclaim_inode_step(-1, inode);
                    if status > 0 {
                        reclaimed = reclaimed + status;
                        rounds = rounds + 1;
                        if kload(row + INODE_KIND) - KIND_FREE == 0 {
                            rounds = max_rounds;
                        }
                    } else {
                        rounds = max_rounds;
                    }
                }
            }
        }
        inode = inode + 1;
    }
    if reclaimed > 0 {
        // Cursor/data-hole compaction is independent of inode generation
        // reclamation.  Treat WAL pressure as a deferred best-effort cleanup;
        // the caller has already completed any successful reclaim commits.
        vfs_compact_allocator();
    }
    return reclaimed;
}

fn vfs_sync_to_disk() -> t40 {
    if vfs_disk_available() <= 0 {
        return ERR_NO_SPACE;
    }
    var required_lsn: t40 = buffer_required_lsn_all();
    var inode_required: t40 = inode_required_lsn_all();
    if inode_required - required_lsn > 0 {
        required_lsn = inode_required;
    }
    if required_lsn - kload(WAL_DURABLE_LSN_ADDR) > 0 {
        var wal_status: t40 = wal_sync_to_disk();
        if wal_status < 0 { return wal_status; }
    }
    if vfs_sync_state_to_disk() - 1 != 0 { return ERR_INVALID; }
    var inode_words: t40 = kload(VFS_NEXT_INODE_ADDR) * VFS_INODE_WORDS;
    var dirent_words: t40 = kload(VFS_NEXT_DIRENT_ADDR) * VFS_DIRENT_WORDS;
    var name_words: t40 = kload(VFS_NEXT_DIRENT_ADDR) * VFS_MAX_NAME_WORDS;
    var extent_words: t40 = kload(VFS_NEXT_EXTENT_ADDR) * VFS_EXTENT_WORDS;
    var data_words: t40 = kload(VFS_NEXT_DATA_ADDR) - VFS_DATA_BASE;
    if vfs_sync_used_range_to_disk(VFS_INODE_BASE, inode_words, VFS_DISK_INODE_BLOCK, VFS_DISK_INODE_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_sync_used_range_to_disk(VFS_DIRENT_BASE, dirent_words, VFS_DISK_DIRENT_BLOCK, VFS_DISK_DIRENT_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_sync_used_range_to_disk(VFS_DIRENT_NAME_BASE, name_words, VFS_DISK_DIRENT_NAME_BLOCK, VFS_DISK_DIRENT_NAME_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_sync_used_range_to_disk(VFS_EXTENT_BASE, extent_words, VFS_DISK_EXTENT_BLOCK, VFS_DISK_EXTENT_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_sync_used_range_to_disk(VFS_DATA_BASE, data_words, VFS_DISK_DATA_BLOCK, VFS_DISK_DATA_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_sync_range_to_disk(NAMESPACE_BASE,
            NAMESPACE_MAX * NAMESPACE_ROW_WORDS,
            VFS_DISK_NAMESPACE_BLOCK, VFS_DISK_NAMESPACE_BLOCKS) < 0 {
        return ERR_INVALID;
    }
    if vfs_sync_quota_policy_to_disk() - QUOTA_MAX != 0 { return ERR_INVALID; }
    if disk_flush() - 1 != 0 { return ERR_INVALID; }
    if buffer_flush_all() < 0 { return ERR_AGAIN; }
    return 1;
}

fn vfs_load_from_disk() -> t40 {
    if vfs_disk_available() <= 0 {
        return ERR_NO_SPACE;
    }
    if vfs_load_state_from_disk() - 1 != 0 { return ERR_INVALID; }
    var inode_words: t40 = kload(VFS_NEXT_INODE_ADDR) * VFS_INODE_WORDS;
    var dirent_words: t40 = kload(VFS_NEXT_DIRENT_ADDR) * VFS_DIRENT_WORDS;
    var name_words: t40 = kload(VFS_NEXT_DIRENT_ADDR) * VFS_MAX_NAME_WORDS;
    var extent_words: t40 = kload(VFS_NEXT_EXTENT_ADDR) * VFS_EXTENT_WORDS;
    var data_words: t40 = kload(VFS_NEXT_DATA_ADDR) - VFS_DATA_BASE;
    if vfs_load_used_range_from_disk(VFS_INODE_BASE, inode_words, VFS_DISK_INODE_BLOCK, VFS_DISK_INODE_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_load_used_range_from_disk(VFS_DIRENT_BASE, dirent_words, VFS_DISK_DIRENT_BLOCK, VFS_DISK_DIRENT_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_load_used_range_from_disk(VFS_DIRENT_NAME_BASE, name_words, VFS_DISK_DIRENT_NAME_BLOCK, VFS_DISK_DIRENT_NAME_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_load_used_range_from_disk(VFS_EXTENT_BASE, extent_words, VFS_DISK_EXTENT_BLOCK, VFS_DISK_EXTENT_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_load_used_range_from_disk(VFS_DATA_BASE, data_words, VFS_DISK_DATA_BLOCK, VFS_DISK_DATA_BLOCKS) < 0 { return ERR_INVALID; }
    if vfs_load_range_from_disk(NAMESPACE_BASE,
            NAMESPACE_MAX * NAMESPACE_ROW_WORDS,
            VFS_DISK_NAMESPACE_BLOCK, VFS_DISK_NAMESPACE_BLOCKS) < 0 {
        return ERR_INVALID;
    }
    if vfs_load_quota_policy_from_disk() - QUOTA_MAX != 0 { return ERR_INVALID; }
    kclear(VFS_FD_BASE, VFS_MAX_FDS * VFS_FD_WORDS);
    return 1;
}

fn vfs_format(device_id: t40) -> t40 {
    vfs_clear_tables();
    kstore(VFS_MAGIC_ADDR, KERNEL_MAGIC);
    kstore(VFS_NEXT_INODE_ADDR, 1);
    kstore(VFS_NEXT_DIRENT_ADDR, 0);
    kstore(VFS_NEXT_EXTENT_ADDR, 0);
    kstore(VFS_NEXT_DATA_ADDR, VFS_DATA_BASE);
    var root: t40 = inode_addr(0);
    kstore(root + INODE_KIND, KIND_DIR);
    kstore(root + INODE_MODE, 1);
    kstore(root + INODE_SIZE, 0);
    kstore(root + INODE_LINKS, 1);
    kstore(root + INODE_VERSION, 1);
    kstore(root + INODE_FLAGS, 0);
    var checkpoint_status: t40 = log_checkpoint();
    if checkpoint_status < 0 { return checkpoint_status; }
    return 1;
}

fn vfs_mount(namespace_id: t40, device_id: t40) -> t40 {
    var loaded: t40 = vfs_load_from_disk();
    if loaded > 0 {
        var wal_loaded: t40 = wal_load_from_disk();
        if wal_loaded > 0 {
            log_recover();
            // Reboot clears volatile descriptors; orphan rows are therefore
            // eligible for one bounded reclaim pass before the home image is
            // checkpointed.  WAL-full/pinned-cache cases remain pending.
            vfs_reclaim_pending();
            var synced: t40 = vfs_sync_to_disk();
            if synced < 0 { return synced; }
            var checkpointed: t40 = log_checkpoint();
            if checkpointed < 0 { return checkpointed; }
        } else if wal_loaded < 0 {
            return wal_loaded;
        }
        return 1;
    }
    if loaded < 0 {
        if loaded - ERR_NO_SPACE != 0 {
            // A zeroed device has no VFS superblock yet and is formatted on
            // first mount.  Preserve hard failures for a non-zero malformed
            // superblock so recovery errors are not silently hidden.
            if kload(VFS_DISK_SCRATCH + 0) != 0 {
                return loaded;
            }
        }
    }
    if kload(VFS_MAGIC_ADDR) - KERNEL_MAGIC == 0 {
        return 1;
    }
    var formatted: t40 = vfs_format(device_id);
    if formatted > 0 {
        if vfs_disk_available() > 0 {
            var synced: t40 = vfs_sync_to_disk();
            if synced < 0 { return synced; }
        }
    }
    return formatted;
}

fn vfs_add_dirent(txid: t40, namespace_id: t40, parent: t40, child: t40, name_start: t40, name_len: t40) -> t40 {
    if name_len <= 0 {
        return ERR_INVALID;
    }
    if name_len - VFS_MAX_NAME_WORDS > 0 {
        return ERR_INVALID;
    }
    var slot: t40 = vfs_find_free_dirent_slot();
    if slot < 0 { return slot; }
    var h: t40 = vfs_component_hash(name_start, name_len);
    var row: t40 = dirent_addr(slot);
    var logged: t40 = log_write(txid, row + DIRENT_NAMESPACE,
                                 kload(row + DIRENT_NAMESPACE), namespace_id);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + DIRENT_PARENT,
                       kload(row + DIRENT_PARENT), parent);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + DIRENT_HASH,
                       kload(row + DIRENT_HASH), h);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + DIRENT_NAME_LEN,
                       kload(row + DIRENT_NAME_LEN), name_len);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + DIRENT_CHILD,
                       kload(row + DIRENT_CHILD), child);
    if logged < 0 { return logged; }
    logged = log_write(txid, row + DIRENT_VERSION,
                       kload(row + DIRENT_VERSION), 1);
    if logged < 0 { return logged; }
    var i: t40 = 0;
    while name_len - i > 0 {
        logged = log_write(txid, dirent_name_addr(slot) + i,
                           kload(dirent_name_addr(slot) + i),
                           kload(name_start + i));
        if logged < 0 { return logged; }
        i = i + 1;
    }
    if slot - kload(VFS_NEXT_DIRENT_ADDR) == 0 {
        logged = log_write(txid, VFS_NEXT_DIRENT_ADDR,
                           kload(VFS_NEXT_DIRENT_ADDR), slot + 1);
        if logged < 0 { return logged; }
    }
    return slot;
}

fn vfs_create(namespace_id: t40, path_addr: t40, kind: t40) -> t40 {
    var parent: t40 = vfs_path_parent(namespace_id, path_addr);
    if parent < 0 {
        return parent;
    }
    var parent_kind: t40 = kload(inode_addr(parent) + INODE_KIND);
    if parent_kind - KIND_DIR != 0 {
        return ERR_NOT_DIR;
    }
    var start: t40 = vfs_leaf_start(path_addr);
    if start <= 0 {
        return ERR_INVALID;
    }
    var len: t40 = vfs_leaf_len(start);
    if len <= 0 {
        return ERR_INVALID;
    }
    var h: t40 = vfs_component_hash(start, len);
    var existing: t40 = vfs_find_child(namespace_id, parent, start, len, h);
    if existing >= 0 {
        return ERR_EXISTS;
    }
    var inode: t40 = vfs_find_free_inode_slot();
    if inode < 0 { return inode; }
    var dir_candidate: t40 = vfs_find_free_dirent_slot();
    if dir_candidate < 0 { return dir_candidate; }
    var inode_records: t40 = 8;
    if inode - kload(VFS_NEXT_INODE_ADDR) == 0 {
        inode_records = inode_records + 1;
    }
    var dir_records: t40 = 6 + len;
    if dir_candidate - kload(VFS_NEXT_DIRENT_ADDR) == 0 {
        dir_records = dir_records + 1;
    }
    if log_capacity_for(inode_records + dir_records + 1) <= 0 {
        return ERR_NO_SPACE;
    }
    // A free inode may still have cache frames from a pre-v2 tombstone.  The
    // volatile cache is never part of the image, so invalidate it before the
    // new generation becomes visible.
    var cache_status: t40 = buffer_invalidate_inode(-1, inode);
    if cache_status < 0 { return cache_status; }
    var old_generation: t40 = kload(inode_addr(inode) + INODE_VERSION);
    var generation: t40 = old_generation + 1;
    if generation <= 0 { generation = 1; }
    var txid: t40 = log_begin();
    var inode_row: t40 = inode_addr(inode);
    var logged: t40 = log_write(txid, inode_row + INODE_KIND, 0, kind);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, inode_row + INODE_MODE,
                       kload(inode_row + INODE_MODE), 1);
    if logged < 0 { log_abort(txid); return logged; }
    logged = log_write(txid, inode_row + INODE_SIZE,
                       kload(inode_row + INODE_SIZE), 0);
    if logged < 0 { log_abort(txid); return logged; }
    logged = log_write(txid, inode_row + INODE_LINKS,
                       kload(inode_row + INODE_LINKS), 1);
    if logged < 0 { log_abort(txid); return logged; }
    logged = log_write(txid, inode_row + INODE_VERSION,
                       kload(inode_row + INODE_VERSION), generation);
    if logged < 0 { log_abort(txid); return logged; }
    logged = log_write(txid, inode_row + INODE_CTIME,
                       kload(inode_row + INODE_CTIME), kload(KERNEL_TICK_ADDR));
    if logged < 0 { log_abort(txid); return logged; }
    logged = log_write(txid, inode_row + INODE_MTIME,
                       kload(inode_row + INODE_MTIME), kload(KERNEL_TICK_ADDR));
    if logged < 0 { log_abort(txid); return logged; }
    logged = log_write(txid, inode_row + INODE_FLAGS,
                       kload(inode_row + INODE_FLAGS), parent);
    if logged < 0 { log_abort(txid); return logged; }
    if inode - kload(VFS_NEXT_INODE_ADDR) == 0 {
        logged = log_write(txid, VFS_NEXT_INODE_ADDR,
                           kload(VFS_NEXT_INODE_ADDR), inode + 1);
        if logged < 0 { log_abort(txid); return logged; }
    }
    var dir_slot: t40 = vfs_add_dirent(txid, namespace_id, parent, inode, start, len);
    if dir_slot < 0 {
        log_abort(txid);
        return dir_slot;
    }
    var commit_lsn: t40 = log_commit(txid);
    if commit_lsn < 0 { return commit_lsn; }
    var tracked: t40 = inode_track_required_lsn(inode, commit_lsn);
    if tracked < 0 { return tracked; }
    return inode;
}

fn fd_is_open_for_pid(pid: t40, fd: t40) -> t40 {
    if fd < 0 {
        return 0;
    }
    if fd - VFS_MAX_FDS >= 0 {
        return 0;
    }
    var row: t40 = fd_addr(fd);
    if kload(row + FD_REFCOUNT) <= 0 {
        return 0;
    }
    if kload(row + FD_PID) - pid != 0 {
        return 0;
    }
    var inode: t40 = kload(row + FD_INODE);
    if inode < 0 {
        return 0;
    }
    if inode - VFS_MAX_INODES >= 0 {
        return 0;
    }
    if kload(row + FD_INODE_VERSION) -
            kload(inode_addr(inode) + INODE_VERSION) != 0 {
        return 0;
    }
    return 1;
}

fn fd_alloc(pid: t40) -> t40 {
    var fd: t40 = 0;
    while VFS_MAX_FDS - fd > 0 {
        var row: t40 = fd_addr(fd);
        if kload(row + FD_REFCOUNT) <= 0 {
            return fd;
        }
        fd = fd + 1;
    }
    return ERR_NO_SPACE;
}

fn vfs_truncate_inode(inode: t40) -> t40 {
    if inode < 0 { return ERR_INVALID; }
    if inode - VFS_MAX_INODES >= 0 { return ERR_INVALID; }
    var row: t40 = inode_addr(inode);
    if log_capacity_for(vfs_inode_active_extent_count(inode) + 3) <= 0 {
        return ERR_NO_SPACE;
    }
    var prepared: t40 = vfs_prepare_inode_reclaim(-1, inode);
    if prepared < 0 { return prepared; }
    var txid: t40 = log_begin();
    var old_size: t40 = kload(row + INODE_SIZE);
    var logged: t40 = log_write(txid, row + INODE_SIZE, old_size, 0);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var slot: t40 = 0;
    while VFS_MAX_EXTENTS - slot > 0 {
        var ex: t40 = extent_addr(slot);
        if kload(ex + EXTENT_INODE) - inode == 0 {
            if kload(ex + EXTENT_VERSION) > 0 {
                logged = log_write(txid, ex + EXTENT_VERSION,
                                   kload(ex + EXTENT_VERSION), 0);
                if logged < 0 {
                    log_abort(txid);
                    return logged;
                }
            }
        }
        slot = slot + 1;
    }
    logged = log_write(txid, row + INODE_MTIME,
                       kload(row + INODE_MTIME), kload(KERNEL_TICK_ADDR));
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var commit_lsn: t40 = log_commit(txid);
    if commit_lsn < 0 { return commit_lsn; }
    var tracked: t40 = inode_track_required_lsn(inode, commit_lsn);
    if tracked < 0 { return tracked; }
    return 1;
}

fn vfs_open(pid: t40, path_addr: t40, mode: t40) -> t40 {
    var namespace_id: t40 = process_namespace_for_pid(pid);
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 {
        if mode - 2 == 0 {
            inode = vfs_create(namespace_id, path_addr, KIND_FILE);
        } else {
            if mode - 3 == 0 {
                inode = vfs_create(namespace_id, path_addr, KIND_FILE);
            } else {
                return inode;
            }
        }
    }
    if inode < 0 {
        return inode;
    }
    if mode - 3 == 0 {
        var truncated: t40 = vfs_truncate_inode(inode);
        if truncated < 0 { return truncated; }
    }
    var kind: t40 = kload(inode_addr(inode) + INODE_KIND);
    if kind - KIND_DIR == 0 {
        return ERR_IS_DIR;
    }
    var fd: t40 = fd_alloc(pid);
    if fd < 0 {
        return fd;
    }
    var row: t40 = fd_addr(fd);
    kstore(row + FD_PID, pid);
    kstore(row + FD_NAMESPACE, namespace_id);
    kstore(row + FD_INODE, inode);
    kstore(row + FD_OFFSET, 0);
    kstore(row + FD_FLAGS, mode);
    kstore(row + FD_REFCOUNT, 1);
    kstore(row + FD_VERSION, 1);
    kstore(row + FD_INODE_VERSION,
           kload(inode_addr(inode) + INODE_VERSION));
    return fd;
}

fn vfs_close(pid: t40, fd: t40) -> t40 {
    if fd_is_open_for_pid(pid, fd) <= 0 {
        return ERR_BAD_FD;
    }
    var row: t40 = fd_addr(fd);
    kclear(row, VFS_FD_WORDS);
    // If this was the final descriptor for an unlinked inode, reclaim now;
    // failures are deferred to the next close/process/mount pass.
    vfs_reclaim_pending();
    return 1;
}

fn vfs_read(pid: t40, fd: t40, dst_addr: t40, count_words: t40) -> t40 {
    if fd_is_open_for_pid(pid, fd) <= 0 {
        return ERR_BAD_FD;
    }
    if user_validate_span(pid, dst_addr, count_words, 1) <= 0 {
        return ERR_BAD_PTR;
    }
    var fdrow: t40 = fd_addr(fd);
    var offset: t40 = kacq(fdrow + FD_OFFSET);
    var namespace_id: t40 = kload(fdrow + FD_NAMESPACE);
    var inode: t40 = kload(fdrow + FD_INODE);
    var kind: t40 = kload(inode_addr(inode) + INODE_KIND);
    if kind - KIND_DIR == 0 {
        return ERR_IS_DIR;
    }
    var size_words: t40 = kload(inode_addr(inode) + INODE_SIZE);
    if offset - size_words >= 0 {
        return 0;
    }
    var to_read: t40 = count_words;
    var available: t40 = size_words - offset;
    if to_read - available > 0 {
        to_read = available;
    }
    var i: t40 = 0;
    while to_read - i > 0 {
        var logical_word: t40 = offset + i;
        var extent_slot: t40 = vfs_find_extent_covering(inode, logical_word);
        if extent_slot < 0 {
            return ERR_NOT_FOUND;
        }
        var ex: t40 = extent_addr(extent_slot);
        var start: t40 = kload(ex + EXTENT_LOGICAL_START);
        var length_words: t40 = kload(ex + EXTENT_LENGTH);
        var data: t40 = kload(ex + EXTENT_DATA_ADDR);
        var in_extent: t40 = logical_word - start;
        var window: t40 = length_words - in_extent;
        var chunk: t40 = to_read - i;
        if chunk - window > 0 {
            chunk = window;
        }
        var buffer_slot: t40 = buffer_pin(namespace_id, inode, logical_word, data + in_extent);
        if buffer_slot < 0 {
            return buffer_slot;
        }
        var copied: t40 = user_copy_from_kernel_validated(pid, dst_addr + i, data + in_extent, chunk);
        if copied < 0 {
            buffer_unpin(buffer_slot);
            return copied;
        }
        buffer_unpin(buffer_slot);
        var next_logical: t40 = logical_word + chunk;
        if next_logical - size_words < 0 {
            vfs_readahead(namespace_id, inode, next_logical, size_words);
        }
        i = i + chunk;
    }
    var version: t40 = kacq(fdrow + FD_VERSION);
    kstore(fdrow + FD_OFFSET, offset + to_read);
    kcas(fdrow + FD_VERSION, version, version + 1);
    return to_read;
}

fn vfs_read_kernel(pid: t40, fd: t40, dst_addr: t40, count_words: t40) -> t40 {
    if fd_is_open_for_pid(pid, fd) <= 0 {
        return ERR_BAD_FD;
    }
    if dst_addr <= 0 {
        return ERR_BAD_PTR;
    }
    if count_words < 0 {
        return ERR_BAD_PTR;
    }
    var fdrow: t40 = fd_addr(fd);
    var offset: t40 = kacq(fdrow + FD_OFFSET);
    var namespace_id: t40 = kload(fdrow + FD_NAMESPACE);
    var inode: t40 = kload(fdrow + FD_INODE);
    var kind: t40 = kload(inode_addr(inode) + INODE_KIND);
    if kind - KIND_DIR == 0 {
        return ERR_IS_DIR;
    }
    var size_words: t40 = kload(inode_addr(inode) + INODE_SIZE);
    if offset - size_words >= 0 {
        return 0;
    }
    var to_read: t40 = count_words;
    var available: t40 = size_words - offset;
    if to_read - available > 0 {
        to_read = available;
    }
    var i: t40 = 0;
    while to_read - i > 0 {
        var logical_word: t40 = offset + i;
        var extent_slot: t40 = vfs_find_extent_covering(inode, logical_word);
        if extent_slot < 0 {
            return ERR_NOT_FOUND;
        }
        var ex: t40 = extent_addr(extent_slot);
        var start: t40 = kload(ex + EXTENT_LOGICAL_START);
        var length_words: t40 = kload(ex + EXTENT_LENGTH);
        var data: t40 = kload(ex + EXTENT_DATA_ADDR);
        var in_extent: t40 = logical_word - start;
        var window: t40 = length_words - in_extent;
        var chunk: t40 = to_read - i;
        if chunk - window > 0 {
            chunk = window;
        }
        var buffer_slot: t40 = buffer_pin(namespace_id, inode, logical_word, data + in_extent);
        if buffer_slot < 0 {
            return buffer_slot;
        }
        var j: t40 = 0;
        while chunk - j > 0 {
            kstore(dst_addr + i + j, kload(data + in_extent + j));
            j = j + 1;
        }
        buffer_unpin(buffer_slot);
        var next_logical: t40 = logical_word + chunk;
        if next_logical - size_words < 0 {
            vfs_readahead(namespace_id, inode, next_logical, size_words);
        }
        i = i + chunk;
    }
    var version: t40 = kacq(fdrow + FD_VERSION);
    kstore(fdrow + FD_OFFSET, offset + to_read);
    kcas(fdrow + FD_VERSION, version, version + 1);
    return to_read;
}

fn vfs_read_inode_kernel(namespace_id: t40, inode: t40, offset: t40, dst_addr: t40, count_words: t40) -> t40 {
    if dst_addr <= 0 {
        return ERR_BAD_PTR;
    }
    if count_words < 0 {
        return ERR_BAD_PTR;
    }
    if inode < 0 {
        return ERR_NOT_FOUND;
    }
    if inode - VFS_MAX_INODES >= 0 {
        return ERR_NOT_FOUND;
    }
    var kind: t40 = kload(inode_addr(inode) + INODE_KIND);
    if kind - KIND_DIR == 0 {
        return ERR_IS_DIR;
    }
    var size_words: t40 = kload(inode_addr(inode) + INODE_SIZE);
    if offset - size_words >= 0 {
        return 0;
    }
    var to_read: t40 = count_words;
    var available: t40 = size_words - offset;
    if to_read - available > 0 {
        to_read = available;
    }
    var i: t40 = 0;
    while to_read - i > 0 {
        var logical_word: t40 = offset + i;
        var extent_slot: t40 = vfs_find_extent_covering(inode, logical_word);
        if extent_slot < 0 {
            return ERR_NOT_FOUND;
        }
        var ex: t40 = extent_addr(extent_slot);
        var start: t40 = kload(ex + EXTENT_LOGICAL_START);
        var length_words: t40 = kload(ex + EXTENT_LENGTH);
        var data: t40 = kload(ex + EXTENT_DATA_ADDR);
        var in_extent: t40 = logical_word - start;
        var window: t40 = length_words - in_extent;
        var chunk: t40 = to_read - i;
        if chunk - window > 0 {
            chunk = window;
        }
        var buffer_slot: t40 = buffer_pin(namespace_id, inode, logical_word, data + in_extent);
        if buffer_slot < 0 {
            return buffer_slot;
        }
        var j: t40 = 0;
        while chunk - j > 0 {
            kstore(dst_addr + i + j, kload(data + in_extent + j));
            j = j + 1;
        }
        buffer_unpin(buffer_slot);
        var next_logical: t40 = logical_word + chunk;
        if next_logical - size_words < 0 {
            vfs_readahead(namespace_id, inode, next_logical, size_words);
        }
        i = i + chunk;
    }
    return to_read;
}

fn vfs_write_partial_result(fdrow: t40, offset: t40, written: t40, status: t40) -> t40 {
    if written <= 0 {
        return status;
    }
    var version: t40 = kacq(fdrow + FD_VERSION);
    kstore(fdrow + FD_OFFSET, offset + written);
    kcas(fdrow + FD_VERSION, version, version + 1);
    return written;
}

fn vfs_write(pid: t40, fd: t40, src_addr: t40, count_words: t40) -> t40 {
    if fd_is_open_for_pid(pid, fd) <= 0 {
        return ERR_BAD_FD;
    }
    if user_validate_span(pid, src_addr, count_words, 0) <= 0 {
        return ERR_BAD_PTR;
    }
    var process_slot: t40 = process_find_pid(pid);
    if process_slot < 0 {
        return ERR_BAD_PTR;
    }
    var fdrow: t40 = fd_addr(fd);
    var mode: t40 = kload(fdrow + FD_FLAGS);
    if mode == 0 {
        return ERR_INVALID;
    }
    var offset: t40 = kacq(fdrow + FD_OFFSET);
    var namespace_id: t40 = kload(fdrow + FD_NAMESPACE);
    var inode: t40 = kload(fdrow + FD_INODE);
    var kind: t40 = kload(inode_addr(inode) + INODE_KIND);
    if kind - KIND_DIR == 0 {
        return ERR_IS_DIR;
    }
    if vfs_can_reserve_extents(inode, offset, count_words) <= 0 {
        return ERR_NO_SPACE;
    }
    var inode_row: t40 = inode_addr(inode);
    var old_size: t40 = kload(inode_row + INODE_SIZE);
    var i: t40 = 0;
    while count_words - i > 0 {
        var logical_word: t40 = offset + i;
        var remaining: t40 = count_words - i;
        var extent_slot: t40 = vfs_find_extent_covering(inode, logical_word);
        var new_extent: t40 = 0;
        var existing_ex: t40 = 0;
        var start: t40 = logical_word;
        var length_words: t40 = remaining;
        var data: t40 = 0;
        if extent_slot < 0 {
            if length_words - STORAGE_BLOCK_WORDS > 0 {
                length_words = STORAGE_BLOCK_WORDS;
            }
            extent_slot = vfs_find_free_extent_for_length(length_words);
            if extent_slot >= 0 {
                data = kload(extent_addr(extent_slot) + EXTENT_DATA_ADDR);
            } else {
                extent_slot = kload(VFS_NEXT_EXTENT_ADDR);
                if extent_slot - VFS_MAX_EXTENTS >= 0 {
                    return vfs_write_partial_result(fdrow, offset, i, ERR_NO_SPACE);
                }
                data = kload(VFS_NEXT_DATA_ADDR);
                if data + length_words - VFS_DATA_BASE - VFS_PAYLOAD_WORDS > 0 {
                    return vfs_write_partial_result(fdrow, offset, i, ERR_NO_SPACE);
                }
            }
            new_extent = 1;
        } else {
            existing_ex = extent_addr(extent_slot);
            start = kload(existing_ex + EXTENT_LOGICAL_START);
            length_words = kload(existing_ex + EXTENT_LENGTH);
            data = kload(existing_ex + EXTENT_DATA_ADDR);
        }
        var ex: t40 = extent_addr(extent_slot);
        var in_extent: t40 = logical_word - start;
        var window: t40 = length_words - in_extent;
        var chunk: t40 = remaining;
        if chunk - window > 0 {
            chunk = window;
        }
        // Reserve six extent fields and two cursors for a new extent, one
        // mtime field, one possible size field, and the commit record.  The
        // extra size slot is conservative when overwriting existing data and
        // ensures a failed transaction never consumes a partial reservation.
        var extent_records: t40 = 0;
        if new_extent > 0 { extent_records = 8; }
        var log_room: t40 = wal_free_blocks() - extent_records - 3;
        if log_room <= 0 {
            return vfs_write_partial_result(fdrow, offset, i, ERR_NO_SPACE);
        }
        if chunk - log_room > 0 {
            chunk = log_room;
        }
        var buffer_slot: t40 = buffer_pin(namespace_id, inode, logical_word,
                                           data + in_extent);
        if buffer_slot < 0 {
            return vfs_write_partial_result(fdrow, offset, i, buffer_slot);
        }
        var txid: t40 = log_begin();
        if new_extent > 0 {
            var extent_slot_logged: t40 = vfs_reserve_extent_tx(
                txid, namespace_id, inode, start, length_words);
            if extent_slot_logged < 0 {
                log_abort(txid);
                buffer_unpin(buffer_slot);
                return vfs_write_partial_result(fdrow, offset, i,
                                                 extent_slot_logged);
            }
        }
        var j: t40 = 0;
        while chunk - j > 0 {
            var src_phys: t40 = user_translate_slot_dmem_addr(
                process_slot, src_addr + i + j, 0);
            if src_phys < 0 {
                log_abort(txid);
                buffer_unpin(buffer_slot);
                return vfs_write_partial_result(fdrow, offset, i, src_phys);
            }
            var copy_chunk: t40 = MMU_PAGE_WORDS -
                                  user_page_offset(src_addr + i + j);
            if copy_chunk - (chunk - j) > 0 {
                copy_chunk = chunk - j;
            }
            var copy_i: t40 = 0;
            while copy_chunk - copy_i > 0 {
                var dst: t40 = data + in_extent + j + copy_i;
                var logged: t40 = log_write(txid, dst, kload(dst),
                                            kload(src_phys + copy_i));
                if logged < 0 {
                    log_abort(txid);
                    buffer_unpin(buffer_slot);
                    return vfs_write_partial_result(fdrow, offset, i, logged);
                }
                copy_i = copy_i + 1;
            }
            j = j + copy_chunk;
        }
        var chunk_end: t40 = logical_word + chunk;
        if chunk_end - old_size > 0 {
            var logged_size: t40 = log_write(txid, inode_row + INODE_SIZE,
                                             old_size, chunk_end);
            if logged_size < 0 {
                log_abort(txid);
                buffer_unpin(buffer_slot);
                return vfs_write_partial_result(fdrow, offset, i, logged_size);
            }
            old_size = chunk_end;
        }
        var logged_mtime: t40 = log_write(
            txid, inode_row + INODE_MTIME, kload(inode_row + INODE_MTIME),
            kload(KERNEL_TICK_ADDR));
        if logged_mtime < 0 {
            log_abort(txid);
            buffer_unpin(buffer_slot);
            return vfs_write_partial_result(fdrow, offset, i, logged_mtime);
        }
        var commit_lsn: t40 = log_commit(txid);
        if commit_lsn < 0 {
            buffer_unpin(buffer_slot);
            return vfs_write_partial_result(fdrow, offset, i, commit_lsn);
        }
        // The WAL commit has published this chunk.  Count it before the
        // post-commit cache bookkeeping so any later failure is reported as a
        // precise short write and the descriptor offset can be advanced.
        i = i + chunk;
        var marked: t40 = buffer_mark_dirty(buffer_slot, commit_lsn);
        if marked < 0 {
            buffer_unpin(buffer_slot);
            return vfs_write_partial_result(fdrow, offset, i, marked);
        }
        var tracked: t40 = inode_track_required_lsn(inode, commit_lsn);
        if tracked < 0 {
            buffer_unpin(buffer_slot);
            return vfs_write_partial_result(fdrow, offset, i, tracked);
        }
        buffer_unpin(buffer_slot);
    }
    return vfs_write_partial_result(fdrow, offset, i, i);
}

fn vfs_stat(namespace_id: t40, path_addr: t40, out_addr: t40) -> t40 {
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 {
        return inode;
    }
    var row: t40 = inode_addr(inode);
    var size_words: t40 = kload(row + INODE_SIZE);
    if out_addr > 0 {
        if validate_user_span(out_addr, 6, 1) <= 0 {
            return ERR_BAD_PTR;
        }
        kstore(out_addr, inode);
        kstore(out_addr + 1, kload(row + INODE_KIND));
        kstore(out_addr + 2, size_words);
        kstore(out_addr + 3, 1);
        kstore(out_addr + 4, kload(row + INODE_FLAGS));
        kstore(out_addr + 5, kload(row + INODE_VERSION));
    }
    return size_words;
}

fn vfs_stat_user(pid: t40, namespace_id: t40, path_addr: t40, out_addr: t40) -> t40 {
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 {
        return inode;
    }
    var row: t40 = inode_addr(inode);
    var size_words: t40 = kload(row + INODE_SIZE);
    // A zero output address means the caller intentionally requested only
    // the size.  Negative values are never a valid optional pointer and
    // must not be treated as the no-output sentinel.
    if out_addr < 0 {
        return ERR_BAD_PTR;
    }
    if out_addr > 0 {
        if user_validate_span(pid, out_addr, 6, 1) <= 0 {
            return ERR_BAD_PTR;
        }
        var stored: t40 = user_store_word(pid, out_addr, inode);
        if stored < 0 {
            return stored;
        }
        stored = user_store_word(pid, out_addr + 1, kload(row + INODE_KIND));
        if stored < 0 {
            return stored;
        }
        stored = user_store_word(pid, out_addr + 2, size_words);
        if stored < 0 {
            return stored;
        }
        stored = user_store_word(pid, out_addr + 3, 1);
        if stored < 0 {
            return stored;
        }
        stored = user_store_word(pid, out_addr + 4, kload(row + INODE_FLAGS));
        if stored < 0 {
            return stored;
        }
        stored = user_store_word(pid, out_addr + 5, kload(row + INODE_VERSION));
        if stored < 0 {
            return stored;
        }
    }
    return size_words;
}

fn vfs_readdir(namespace_id: t40, path_addr: t40, out_addr: t40, max_words: t40) -> t40 {
    if validate_user_span(out_addr, max_words, 1) <= 0 {
        return ERR_BAD_PTR;
    }
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 {
        return inode;
    }
    if kload(inode_addr(inode) + INODE_KIND) - KIND_DIR != 0 {
        return ERR_NOT_DIR;
    }
    var written: t40 = 0;
    var slot: t40 = 0;
    var dirent_limit: t40 = vfs_dirent_limit();
    while dirent_limit - slot > 0 {
        var row: t40 = dirent_addr(slot);
        var child: t40 = kload(row + DIRENT_CHILD);
        if child > 0 {
            if kload(row + DIRENT_NAMESPACE) - namespace_id == 0 {
                if kload(row + DIRENT_PARENT) - inode == 0 {
                    var len: t40 = kload(row + DIRENT_NAME_LEN);
                    var needed: t40 = 3 + len;
                    if written + needed - max_words > 0 {
                        return written;
                    }
                    kstore(out_addr + written, child);
                    kstore(out_addr + written + 1, kload(inode_addr(child) + INODE_KIND));
                    kstore(out_addr + written + 2, len);
                    var i: t40 = 0;
                    while len - i > 0 {
                        kstore(out_addr + written + 3 + i, kload(dirent_name_addr(slot) + i));
                        i = i + 1;
                    }
                    written = written + needed;
                }
            }
        }
        slot = slot + 1;
    }
    return written;
}

fn vfs_readdir_user(pid: t40, namespace_id: t40, path_addr: t40, out_addr: t40, max_words: t40) -> t40 {
    if user_validate_span(pid, out_addr, max_words, 1) <= 0 {
        return ERR_BAD_PTR;
    }
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 {
        return inode;
    }
    if kload(inode_addr(inode) + INODE_KIND) - KIND_DIR != 0 {
        return ERR_NOT_DIR;
    }
    var written: t40 = 0;
    var slot: t40 = 0;
    var dirent_limit: t40 = vfs_dirent_limit();
    while dirent_limit - slot > 0 {
        var row: t40 = dirent_addr(slot);
        var child: t40 = kload(row + DIRENT_CHILD);
        if child > 0 {
            if kload(row + DIRENT_NAMESPACE) - namespace_id == 0 {
                if kload(row + DIRENT_PARENT) - inode == 0 {
                    var len: t40 = kload(row + DIRENT_NAME_LEN);
                    var needed: t40 = 3 + len;
                    if written + needed - max_words > 0 {
                        return written;
                    }
                    var stored: t40 = user_store_word(pid, out_addr + written, child);
                    if stored < 0 {
                        return stored;
                    }
                    stored = user_store_word(pid, out_addr + written + 1, kload(inode_addr(child) + INODE_KIND));
                    if stored < 0 {
                        return stored;
                    }
                    stored = user_store_word(pid, out_addr + written + 2, len);
                    if stored < 0 {
                        return stored;
                    }
                    var i: t40 = 0;
                    while len - i > 0 {
                        stored = user_store_word(pid, out_addr + written + 3 + i, kload(dirent_name_addr(slot) + i));
                        if stored < 0 {
                            return stored;
                        }
                        i = i + 1;
                    }
                    written = written + needed;
                }
            }
        }
        slot = slot + 1;
    }
    return written;
}

fn vfs_fsync(pid: t40, fd: t40) -> t40 {
    if fd_is_open_for_pid(pid, fd) <= 0 {
        return ERR_BAD_FD;
    }
    var fdrow: t40 = fd_addr(fd);
    var namespace_id: t40 = kload(fdrow + FD_NAMESPACE);
    var inode: t40 = kload(fdrow + FD_INODE);
    if vfs_disk_available() > 0 {
        // Flush WAL through this inode's dependency, write only this inode's
        // data/metadata, then issue exactly one home-page barrier.
        var required_lsn: t40 = inode_required_lsn(inode);
        if required_lsn - kload(WAL_DURABLE_LSN_ADDR) > 0 {
            var wal_status: t40 = wal_sync_to_disk();
            if wal_status < 0 { return wal_status; }
        }
        var synced: t40 = vfs_sync_inode_to_disk(namespace_id, inode);
        if synced < 0 { return synced; }
        if disk_flush() - 1 != 0 { return ERR_INVALID; }
        var flushed: t40 = buffer_flush_inode(namespace_id, inode);
        if flushed < 0 { return flushed; }
        return 1;
    }
    // With no persistent device, there is no home-page ordering obligation;
    // keep the existing in-memory test/bring-up behavior.
    var flushed: t40 = buffer_flush_all();
    if flushed < 0 { return flushed; }
    return 1;
}

fn exec_image_addr(process_slot: t40) -> t40 {
    return EXEC_IMAGE_BASE + process_slot * EXEC_IMAGE_WORDS;
}

fn exec_hw_imem_ptbr(process_slot: t40) -> t40 {
    return HW_PT_BASE + process_slot * HW_PT_WORDS;
}

fn exec_hw_dmem_ptbr(process_slot: t40) -> t40 {
    return exec_hw_imem_ptbr(process_slot) + HW_PT_MAX_PAGES;
}

fn exec_process_dmem_ppn(process_slot: t40) -> t40 {
    return PROCESS_DMEM_PPN_BASE + process_slot * PROCESS_DMEM_PAGES_MAX;
}

fn exec_encode_pte(ppn: t40, user: t40, readable: t40, writable: t40, executable: t40) -> t40 {
    var word: t40 = ppn * 19683 + 1;
    if user > 0 {
        word = word + 3;
    }
    if readable > 0 {
        word = word + 9;
    }
    if writable > 0 {
        word = word + 27;
    }
    if executable > 0 {
        word = word + 81;
    }
    return word;
}

fn exec_clear_hw_page_tables(process_slot: t40) -> t40 {
    kclear(exec_hw_imem_ptbr(process_slot), HW_PT_WORDS);
    translation_cache_invalidate(process_slot);
    return 1;
}

fn exec_pages_for_words(words: t40) -> t40 {
    if words <= 0 { return 0; }
    var pages: t40 = 0;
    var remaining: t40 = words;
    while remaining > 0 {
        pages = pages + 1;
        remaining = remaining - MMU_PAGE_WORDS;
    }
    return pages;
}

fn exec_is_v3(image_addr: t40) -> t40 {
    if kload(image_addr + EXEC_V2_VERSION_INDEX) - EXEC_V3_VERSION == 0 {
        return 1;
    }
    return 0;
}

fn exec_descriptor_base(image_addr: t40) -> t40 {
    if exec_is_v3(image_addr) > 0 {
        return image_addr + EXEC_V3_HEADER_WORDS;
    }
    return image_addr + EXEC_V2_HEADER_WORDS;
}

fn exec_descriptor_words(image_addr: t40) -> t40 {
    if exec_is_v3(image_addr) > 0 {
        return EXEC_V3_HEADER_WORDS + 3;
    }
    return EXEC_V2_HEADER_WORDS + 3;
}

fn exec_descriptor_text_ppn(image_addr: t40) -> t40 {
    return kload(exec_descriptor_base(image_addr) + 0);
}

fn exec_descriptor_text_disk_block(image_addr: t40) -> t40 {
    return kload(exec_descriptor_base(image_addr) + 1);
}

fn exec_descriptor_text_words(image_addr: t40) -> t40 {
    return kload(exec_descriptor_base(image_addr) + 2);
}

// Executable feature words are canonical positional base-3 masks, not binary
// integers.  v3 applications may request additional supported ISA features,
// so validation must require the v3 baseline bits without demanding an exact
// feature word.
fn exec_v3_feature_word_valid(word: t40) -> t40 {
    if word < 0 { return 0; }
    var remaining: t40 = word;
    var place: t40 = 1;
    var trit: t40 = 0;
    while 13 - trit > 0 {
        var digit: t40 = 0;
        unsafe { digit = tmod(tdiv(remaining, place), 3); }
        if digit < 0 { return 0; }
        if digit > 1 { return 0; }
        if trit == 0 {
            if digit <= 0 { return 0; }
        }
        if trit == 3 {
            if digit <= 0 { return 0; }
        }
        if trit == 11 {
            if digit <= 0 { return 0; }
        }
        place = place * 3;
        trit = trit + 1;
    }
    if tdiv(remaining, place) > 0 { return 0; }
    return 1;
}

fn exec_v2_header_valid(image_addr: t40, size_words: t40) -> t40 {
    if size_words - EXEC_DESC_WORDS < 0 {
        return 0;
    }
    var header: t40 = image_addr;
    if kload(header + EXEC_V2_MAGIC_INDEX) - EXEC_MAGIC != 0 {
        return 0;
    }
    if kload(header + EXEC_V2_VERSION_INDEX) - EXEC_V2_VERSION != 0 {
        return 0;
    }
    if kload(header + EXEC_V2_FUNCTION_ABI_INDEX) - EXEC_V2_FUNCTION_ABI != 0 {
        return 0;
    }
    if kload(header + EXEC_V2_HEADER_SIZE_INDEX) - EXEC_V2_HEADER_WORDS != 0 {
        return 0;
    }
    if kload(header + EXEC_V2_ISA_INDEX) - EXEC_V2_ISA != 0 {
        return 0;
    }
    if kload(header + EXEC_V2_FEATURES_INDEX) <= 0 {
        return 0;
    }
    if kload(header + EXEC_V2_ENTRY_PC_INDEX) < 0 {
        return 0;
    }
    if kload(header + EXEC_V2_TEXT_WORDS_INDEX) <= 0 {
        return 0;
    }
    if kload(header + EXEC_V2_TEXT_WORDS_INDEX) -
           exec_descriptor_text_words(image_addr) != 0 {
        return 0;
    }
    if kload(header + EXEC_V2_DATA_WORDS_INDEX) < 0 {
        return 0;
    }
    if kload(header + EXEC_V2_STACK_WORDS_INDEX) <= 0 {
        return 0;
    }
    if kload(header + EXEC_V2_SYSCALL_ABI_INDEX) - EXEC_V2_SYSCALL_ABI != 0 {
        return 0;
    }
    if kload(header + EXEC_V2_SCALAR_WIDTH_INDEX) - EXEC_V2_SCALAR_TRITS != 0 {
        return 0;
    }
    if kload(header + EXEC_V2_BASE_PAGE_INDEX) - EXEC_V2_BASE_PAGE_WORDS != 0 {
        return 0;
    }
    var checksum: t40 = 0;
    var word: t40 = 0;
    while EXEC_V2_HEADER_WORDS - word > 0 {
        checksum = checksum + kload(header + word);
        word = word + 1;
    }
    if checksum != 0 {
        return 0;
    }
    return 1;
}

fn exec_v3_header_valid(image_addr: t40, size_words: t40) -> t40 {
    if size_words - (EXEC_V3_HEADER_WORDS + 3) < 0 { return 0; }
    var header: t40 = image_addr;
    if kload(header + EXEC_V2_MAGIC_INDEX) - EXEC_MAGIC != 0 { return 0; }
    if kload(header + EXEC_V2_VERSION_INDEX) - EXEC_V3_VERSION != 0 { return 0; }
    if kload(header + EXEC_V2_FUNCTION_ABI_INDEX) - EXEC_V3_FUNCTION_ABI != 0 { return 0; }
    if kload(header + EXEC_V2_HEADER_SIZE_INDEX) - EXEC_V3_HEADER_WORDS != 0 { return 0; }
    if kload(header + EXEC_V2_ISA_INDEX) - EXEC_V3_ISA != 0 { return 0; }
    if exec_v3_feature_word_valid(
            kload(header + EXEC_V2_FEATURES_INDEX)) <= 0 { return 0; }
    if kload(header + EXEC_V2_ENTRY_PC_INDEX) < 0 { return 0; }
    if kload(header + EXEC_V2_TEXT_WORDS_INDEX) <= 0 { return 0; }
    if kload(header + EXEC_V2_TEXT_WORDS_INDEX) -
           exec_descriptor_text_words(image_addr) != 0 { return 0; }
    if kload(header + EXEC_V2_DATA_WORDS_INDEX) < 0 { return 0; }
    if kload(header + EXEC_V2_STACK_WORDS_INDEX) <= 0 { return 0; }
    if kload(header + EXEC_V2_SYSCALL_ABI_INDEX) - EXEC_V3_SYSCALL_ABI != 0 { return 0; }
    if kload(header + EXEC_V2_SCALAR_WIDTH_INDEX) - EXEC_V2_SCALAR_TRITS != 0 { return 0; }
    if kload(header + EXEC_V2_BASE_PAGE_INDEX) - EXEC_V2_BASE_PAGE_WORDS != 0 { return 0; }
    if kload(header + EXEC_V3_VECTOR_REGISTER_COUNT_INDEX) - EXEC_V3_VECTOR_REGISTER_COUNT != 0 { return 0; }
    if kload(header + EXEC_V3_VECTOR_LANE_COUNT_INDEX) - EXEC_V3_VECTOR_LANE_COUNT != 0 { return 0; }
    if kload(header + EXEC_V3_VECTOR_LANE_WORD_TRITS_INDEX) - EXEC_V3_VECTOR_LANE_WORD_TRITS != 0 { return 0; }
    if kload(header + EXEC_V3_VECTOR_CONTEXT_WORDS_INDEX) - EXEC_V3_VECTOR_CONTEXT_WORDS != 0 { return 0; }
    if kload(header + EXEC_V3_VECTOR_SPILL_WORDS_INDEX) - EXEC_V3_VECTOR_SPILL_WORDS != 0 { return 0; }
    var checksum: t40 = 0;
    var word: t40 = 0;
    while EXEC_V3_HEADER_WORDS - word > 0 {
        checksum = checksum + kload(header + word);
        word = word + 1;
    }
    if checksum != 0 { return 0; }
    return 1;
}

fn exec_header_valid(image_addr: t40, size_words: t40) -> t40 {
    if exec_is_v3(image_addr) > 0 {
        return exec_v3_header_valid(image_addr, size_words);
    }
    return exec_v2_header_valid(image_addr, size_words);
}

fn exec_install_architecture(process_slot: t40, image_addr: t40, size_words: t40) -> t40 {
    if exec_header_valid(image_addr, size_words) <= 0 {
        return ERR_INVALID;
    }
    var header: t40 = image_addr;
    var arch: t40 = process_arch_addr(process_slot);
    kstore(arch + PROC_ARCH_EXEC_VERSION,
           kload(header + EXEC_V2_VERSION_INDEX));
    kstore(arch + PROC_ARCH_FUNCTION_ABI,
           kload(header + EXEC_V2_FUNCTION_ABI_INDEX));
    kstore(arch + PROC_ARCH_SYSCALL_ABI,
           kload(header + EXEC_V2_SYSCALL_ABI_INDEX));
    kstore(arch + PROC_ARCH_ISA,
           kload(header + EXEC_V2_ISA_INDEX));
    kstore(arch + PROC_ARCH_FEATURES,
           kload(header + EXEC_V2_FEATURES_INDEX));
    kstore(arch + PROC_ARCH_FLAGS,
           kload(header + EXEC_V2_FLAGS_INDEX));
    return 1;
}

fn exec_descriptor_valid(image_addr: t40, size_words: t40) -> t40 {
    if size_words - exec_descriptor_words(image_addr) < 0 {
        return 0;
    }
    if exec_header_valid(image_addr, size_words) <= 0 {
        return 0;
    }
    var text_words: t40 = kload(image_addr + EXEC_V2_TEXT_WORDS_INDEX);
    var text_pages: t40 = exec_pages_for_words(text_words);
    if text_pages <= 0 {
        return 0;
    }
    if text_pages - HW_PT_MAX_PAGES > 0 {
        return 0;
    }
    var writable_words: t40 = kload(image_addr + EXEC_V2_DATA_WORDS_INDEX);
    if kload(image_addr + EXEC_V2_STACK_WORDS_INDEX) - writable_words > 0 {
        writable_words = kload(image_addr + EXEC_V2_STACK_WORDS_INDEX);
    }
    var data_pages: t40 = exec_pages_for_words(writable_words);
    if data_pages <= 0 {
        data_pages = 1;
    }
    if data_pages <= 0 {
        return 0;
    }
    if data_pages - PROCESS_DATA_PAGES_MAX > 0 {
        return 0;
    }
    if exec_descriptor_text_ppn(image_addr) <= 0 {
        return 0;
    }
    var disk_block: t40 = exec_descriptor_text_disk_block(image_addr);
    if disk_block <= 0 {
        return 0;
    }
    if exec_descriptor_text_words(image_addr) - text_words != 0 {
        return 0;
    }
    return 1;
}

fn exec_load_text_image(image_addr: t40, size_words: t40) -> t40 {
    if size_words - exec_descriptor_words(image_addr) < 0 {
        return ERR_INVALID;
    }
    var disk_block: t40 = exec_descriptor_text_disk_block(image_addr);
    var text_words: t40 = exec_descriptor_text_words(image_addr);
    if disk_block <= 0 {
        return ERR_INVALID;
    }
    if text_words <= 0 {
        return ERR_INVALID;
    }
    var text_pages: t40 = exec_pages_for_words(text_words);
    if text_words - (text_pages * MMU_PAGE_WORDS) > 0 {
        return ERR_INVALID;
    }
    var text_ppn: t40 = exec_descriptor_text_ppn(image_addr);
    var dst_pc: t40 = text_ppn * MMU_PAGE_WORDS;
    var remaining: t40 = text_words;
    var block: t40 = 0;
    while remaining > 0 {
        if disk_read_imem_block(
                disk_block + block,
                dst_pc + block * STORAGE_BLOCK_WORDS) - 1 != 0 {
            return ERR_INVALID;
        }
        remaining = remaining - STORAGE_BLOCK_WORDS;
        block = block + 1;
    }
    return text_words;
}

fn is_gui_app(path_addr: t40) -> t40 {
    if path_addr <= 0 {
        return 0;
    }
    var is_calc: t40 = 1;
    if kload(path_addr + 0) - 47 != 0 { is_calc = 0; }
    if kload(path_addr + 1) - 98 != 0 { is_calc = 0; }
    if kload(path_addr + 2) - 105 != 0 { is_calc = 0; }
    if kload(path_addr + 3) - 110 != 0 { is_calc = 0; }
    if kload(path_addr + 4) - 47 != 0 { is_calc = 0; }
    if kload(path_addr + 5) - 99 != 0 { is_calc = 0; }
    if kload(path_addr + 6) - 97 != 0 { is_calc = 0; }
    if kload(path_addr + 7) - 108 != 0 { is_calc = 0; }
    if kload(path_addr + 8) - 99 != 0 { is_calc = 0; }
    if is_calc > 0 {
        return 1;
    }

    var is_task: t40 = 1;
    if kload(path_addr + 0) - 47 != 0 { is_task = 0; }
    if kload(path_addr + 1) - 98 != 0 { is_task = 0; }
    if kload(path_addr + 2) - 105 != 0 { is_task = 0; }
    if kload(path_addr + 3) - 110 != 0 { is_task = 0; }
    if kload(path_addr + 4) - 47 != 0 { is_task = 0; }
    if kload(path_addr + 5) - 116 != 0 { is_task = 0; }
    if kload(path_addr + 6) - 97 != 0 { is_task = 0; }
    if kload(path_addr + 7) - 115 != 0 { is_task = 0; }
    if kload(path_addr + 8) - 107 != 0 { is_task = 0; }
    if is_task > 0 {
        return 1;
    }

    var is_paint: t40 = 1;
    if kload(path_addr + 0) - 47 != 0 { is_paint = 0; }
    if kload(path_addr + 1) - 98 != 0 { is_paint = 0; }
    if kload(path_addr + 2) - 105 != 0 { is_paint = 0; }
    if kload(path_addr + 3) - 110 != 0 { is_paint = 0; }
    if kload(path_addr + 4) - 47 != 0 { is_paint = 0; }
    if kload(path_addr + 5) - 112 != 0 { is_paint = 0; }
    if kload(path_addr + 6) - 97 != 0 { is_paint = 0; }
    if kload(path_addr + 7) - 105 != 0 { is_paint = 0; }
    if kload(path_addr + 8) - 110 != 0 { is_paint = 0; }
    if is_paint > 0 {
        return 1;
    }

    var is_desktop: t40 = 1;
    if kload(path_addr + 0) - 47 != 0 { is_desktop = 0; }
    if kload(path_addr + 1) - 98 != 0 { is_desktop = 0; }
    if kload(path_addr + 2) - 105 != 0 { is_desktop = 0; }
    if kload(path_addr + 3) - 110 != 0 { is_desktop = 0; }
    if kload(path_addr + 4) - 47 != 0 { is_desktop = 0; }
    if kload(path_addr + 5) - 100 != 0 { is_desktop = 0; }
    if kload(path_addr + 6) - 101 != 0 { is_desktop = 0; }
    if kload(path_addr + 7) - 115 != 0 { is_desktop = 0; }
    if kload(path_addr + 8) - 107 != 0 { is_desktop = 0; }
    if is_desktop > 0 {
        return 1;
    }

    // Consumer shell apps use the text/GPU memory range even when their
    // executable path is discovered dynamically from /bin.
    var is_bin_child: t40 = 1;
    if kload(path_addr + 0) - 47 != 0 { is_bin_child = 0; }
    if kload(path_addr + 1) - 98 != 0 { is_bin_child = 0; }
    if kload(path_addr + 2) - 105 != 0 { is_bin_child = 0; }
    if kload(path_addr + 3) - 110 != 0 { is_bin_child = 0; }
    if kload(path_addr + 4) - 47 != 0 { is_bin_child = 0; }
    if is_bin_child > 0 {
        return 1;
    }

    return 0;
}

fn exec_map_descriptor(process_slot: t40, image_addr: t40, is_gui: t40) -> t40 {
    var text_pages: t40 =
        exec_pages_for_words(kload(image_addr + EXEC_V2_TEXT_WORDS_INDEX));
    var writable_words: t40 = kload(image_addr + EXEC_V2_DATA_WORDS_INDEX);
    if kload(image_addr + EXEC_V2_STACK_WORDS_INDEX) - writable_words > 0 {
        writable_words = kload(image_addr + EXEC_V2_STACK_WORDS_INDEX);
    }
    var data_pages: t40 = exec_pages_for_words(writable_words);
    if data_pages <= 0 { data_pages = 1; }
    var text_ppn: t40 = exec_descriptor_text_ppn(image_addr);
    var data_ppn: t40 = exec_process_dmem_ppn(process_slot);
    exec_clear_hw_page_tables(process_slot);
    kclear(data_ppn * MMU_PAGE_WORDS, data_pages * MMU_PAGE_WORDS);
    var vpn: t40 = 0;
    while text_pages - vpn > 0 {
        kstore(exec_hw_imem_ptbr(process_slot) + vpn, exec_encode_pte(text_ppn + vpn, 1, 0, 0, 1));
        pte_map(process_slot, vpn, text_ppn + vpn, 0);
        vpn = vpn + 1;
    }
    vpn = 0;
    while data_pages - vpn > 0 {
        kstore(exec_hw_dmem_ptbr(process_slot) + vpn, exec_encode_pte(data_ppn + vpn, 1, 1, 1, 0));
        vpn = vpn + 1;
    }
    var scratch_page: t40 = 0;
    while USER_SCRATCH_PAGES - scratch_page > 0 {
        var scratch_ppn: t40 = data_ppn + PROCESS_SCRATCH_PPN_OFFSET + scratch_page;
        kclear(scratch_ppn * MMU_PAGE_WORDS, MMU_PAGE_WORDS);
        kstore(
            exec_hw_dmem_ptbr(process_slot) + USER_SCRATCH_VPN_BASE + scratch_page,
            exec_encode_pte(scratch_ppn, 1, 1, 1, 0));
        scratch_page = scratch_page + 1;
    }
    if is_gui > 0 {
        // The legacy 27-word-page range 49977..62018 becomes VPN 68..85
        // with 729-word architectural pages. This covers OS_TEXT_BASE and
        // the complete 2000-word text surface without mapping thousands of
        // unrelated pages.
        var vram_vpn: t40 = 68;
        while 86 - vram_vpn > 0 {
            kstore(exec_hw_dmem_ptbr(process_slot) + vram_vpn, exec_encode_pte(vram_vpn, 1, 1, 1, 0));
            vram_vpn = vram_vpn + 1;
        }
    }
    translation_cache_invalidate(process_slot);
    return text_pages + data_pages;
}

fn exec_install_context(process_slot: t40, image_addr: t40, is_gui: t40) -> t40 {
    if exec_header_valid(image_addr, EXEC_IMAGE_WORDS) <= 0 {
        return ERR_INVALID;
    }
    if exec_is_v3(image_addr) > 0 {
        if process_vector_context_reset(process_slot) < 0 {
            return ERR_INVALID;
        }
    }
    var row: t40 = process_addr(process_slot);
    var ctx: t40 = kload(row + PROC_CONTEXT);
    var writable_words: t40 = kload(image_addr + EXEC_V2_DATA_WORDS_INDEX);
    if kload(image_addr + EXEC_V2_STACK_WORDS_INDEX) - writable_words > 0 {
        writable_words = kload(image_addr + EXEC_V2_STACK_WORDS_INDEX);
    }
    var data_pages: t40 = exec_pages_for_words(writable_words);
    if data_pages <= 0 { data_pages = 1; }
    if ctx <= 0 {
        ctx = process_default_context_addr(process_slot);
        kstore(row + PROC_CONTEXT, ctx);
    }
    kclear(ctx, TASK_CONTEXT_WORDS);
    kstore(ctx + TASK_CONTEXT_EPC, kload(image_addr + EXEC_V2_ENTRY_PC_INDEX));
    kstore(ctx + TASK_CONTEXT_STATUS, TASK_STATUS_USER_RESUME);
    kstore(ctx + TASK_CONTEXT_IMEM_PTBR, exec_hw_imem_ptbr(process_slot));
    kstore(
        ctx + TASK_CONTEXT_IMEM_PAGES,
        exec_pages_for_words(kload(image_addr + EXEC_V2_TEXT_WORDS_INDEX)));
    kstore(ctx + TASK_CONTEXT_DMEM_PTBR, exec_hw_dmem_ptbr(process_slot));
    var dmem_pages: t40 = data_pages;
    if dmem_pages - (USER_SCRATCH_VPN_BASE + USER_SCRATCH_PAGES) < 0 {
        dmem_pages = USER_SCRATCH_VPN_BASE + USER_SCRATCH_PAGES;
    }
    if is_gui > 0 {
        dmem_pages = 86;
    }
    kstore(ctx + TASK_CONTEXT_DMEM_PAGES, dmem_pages);
    kstore(ctx + TASK_CONTEXT_SP, kload(image_addr + EXEC_V2_STACK_WORDS_INDEX));
    var heap: t40 = process_heap_addr(process_slot);
    var heap_start: t40 = data_pages * MMU_PAGE_WORDS;
    kstore(heap + PROC_HEAP_START, heap_start);
    kstore(heap + PROC_HEAP_BREAK, heap_start);
    kstore(heap + PROC_HEAP_LIMIT, PROCESS_DATA_PAGES_MAX * MMU_PAGE_WORDS);
    kstore(heap + PROC_HEAP_MAPPED_PAGES, data_pages);
    kstore(CURRENT_CONTEXT_ADDR, ctx);
    kstore(CURRENT_PID_ADDR, kload(row + PROC_PID));
    translation_cache_invalidate(process_slot);
    return ctx;
}

fn process_map_heap_pages(process_slot: t40, required_pages: t40) -> t40 {
    if required_pages <= 0 {
        return ERR_INVALID;
    }
    if required_pages - PROCESS_DATA_PAGES_MAX > 0 {
        return ERR_NO_SPACE;
    }
    var heap: t40 = process_heap_addr(process_slot);
    var mapped: t40 = kload(heap + PROC_HEAP_MAPPED_PAGES);
    var data_ppn: t40 = exec_process_dmem_ppn(process_slot);
    while required_pages - mapped > 0 {
        kclear((data_ppn + mapped) * MMU_PAGE_WORDS, MMU_PAGE_WORDS);
        kstore(exec_hw_dmem_ptbr(process_slot) + mapped, exec_encode_pte(data_ppn + mapped, 1, 1, 1, 0));
        mapped = mapped + 1;
    }
    kstore(heap + PROC_HEAP_MAPPED_PAGES, mapped);
    translation_cache_invalidate(process_slot);
    return mapped;
}

fn process_brk(pid: t40, new_break: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return slot;
    }
    var heap: t40 = process_heap_addr(slot);
    var heap_start: t40 = kload(heap + PROC_HEAP_START);
    var heap_limit: t40 = kload(heap + PROC_HEAP_LIMIT);
    if new_break - heap_start < 0 {
        return ERR_INVALID;
    }
    if new_break - heap_limit > 0 {
        return ERR_NO_SPACE;
    }
    var required_pages: t40 = exec_pages_for_words(new_break);
    var mapped: t40 = process_map_heap_pages(slot, required_pages);
    if mapped < 0 {
        return mapped;
    }
    kstore(heap + PROC_HEAP_BREAK, new_break);
    var ctx: t40 = kload(process_addr(slot) + PROC_CONTEXT);
    if ctx > 0 {
        var current_pages: t40 = kload(ctx + TASK_CONTEXT_DMEM_PAGES);
        if required_pages - current_pages > 0 {
            kstore(ctx + TASK_CONTEXT_DMEM_PAGES, required_pages);
        }
    }
    process_cache_invalidate(slot);
    translation_cache_invalidate(slot);
    return new_break;
}

fn process_sbrk(pid: t40, delta: t40) -> t40 {
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return slot;
    }
    var heap: t40 = process_heap_addr(slot);
    var old_break: t40 = kload(heap + PROC_HEAP_BREAK);
    var next_break: t40 = old_break + delta;
    var status: t40 = process_brk(pid, next_break);
    if status < 0 {
        return status;
    }
    return old_break;
}

fn exec_process_inode(process_slot: t40, namespace_id: t40, inode: t40, path_addr: t40) -> t40 {
    if process_slot < 0 {
        return ERR_INVALID;
    }
    if process_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = process_addr(process_slot);
    if kload(row + PROC_PID) <= 0 {
        return ERR_NOT_FOUND;
    }
    if inode < 0 {
        return inode;
    }
    if inode - VFS_MAX_INODES >= 0 {
        return ERR_NOT_FOUND;
    }
    if kload(inode_addr(inode) + INODE_KIND) - KIND_EXEC != 0 {
        return ERR_INVALID;
    }
    var size_words: t40 = kload(inode_addr(inode) + INODE_SIZE);
    if size_words < 0 {
        return size_words;
    }
    if size_words - EXEC_IMAGE_WORDS > 0 {
        return ERR_NO_SPACE;
    }
    var dst: t40 = exec_image_addr(process_slot);
    kclear(dst, EXEC_IMAGE_WORDS);
    var read_count: t40 = vfs_read_inode_kernel(namespace_id, inode, 0, dst, size_words);
    if read_count < 0 {
        return read_count;
    }
    if exec_descriptor_valid(dst, read_count) <= 0 {
        return ERR_INVALID;
    }
    if exec_install_architecture(process_slot, dst, read_count) < 0 {
        return ERR_INVALID;
    }
    var text_loaded: t40 = exec_load_text_image(dst, read_count);
    if text_loaded < 0 {
        return text_loaded;
    }
    var is_gui: t40 = is_gui_app(path_addr);
    if exec_map_descriptor(process_slot, dst, is_gui) < 0 {
        return ERR_INVALID;
    }
    if exec_install_context(process_slot, dst, is_gui) < 0 {
        return ERR_INVALID;
    }
    unsafe { csr_write(mmu_enable, 1); }
    process_cache_invalidate(process_slot);
    process_set_state(process_slot, PROC_RUNNABLE);
    return read_count;
}

fn exec_process(process_slot: t40, path_addr: t40) -> t40 {
    if process_slot < 0 {
        return ERR_INVALID;
    }
    if process_slot - PROCESS_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = process_addr(process_slot);
    var namespace_id: t40 = kload(row + PROC_NAMESPACE);
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 {
        return inode;
    }
    return exec_process_inode(process_slot, namespace_id, inode, path_addr);
}

fn app_addr(app_id: t40) -> t40 {
    return APP_REGISTRY_BASE + app_id * APP_ROW_WORDS;
}

fn app_registry_init() -> t40 {
    kclear(APP_REGISTRY_BASE, APP_MAX * APP_ROW_WORDS);
    return 1;
}

fn app_seed_bin_path(path_addr: t40) -> t40 {
    kstore(path_addr + 0, 47);
    kstore(path_addr + 1, 98);
    kstore(path_addr + 2, 105);
    kstore(path_addr + 3, 110);
    kstore(path_addr + 4, 0);
    return path_addr;
}

fn app_seed_bin_child_path(path_addr: t40, dirent_slot: t40) -> t40 {
    kstore(path_addr + 0, 47);
    kstore(path_addr + 1, 98);
    kstore(path_addr + 2, 105);
    kstore(path_addr + 3, 110);
    kstore(path_addr + 4, 47);
    var len: t40 = kload(dirent_addr(dirent_slot) + DIRENT_NAME_LEN);
    var i: t40 = 0;
    while len - i > 0 {
        kstore(path_addr + 5 + i, kload(dirent_name_addr(dirent_slot) + i));
        i = i + 1;
    }
    kstore(path_addr + 5 + len, 0);
    return path_addr;
}

fn app_registry_autoload_bin() -> t40 {
    var path_addr: t40 = SYSCALL_PATH_COPY_BASE;
    app_seed_bin_path(path_addr);
    var bin_inode: t40 = vfs_lookup(0, path_addr);
    if bin_inode < 0 {
        return 0;
    }
    var loaded: t40 = 0;
    var slot: t40 = 0;
    var dirent_limit: t40 = vfs_dirent_limit();
    while dirent_limit - slot > 0 {
        var row: t40 = dirent_addr(slot);
        var child: t40 = kload(row + DIRENT_CHILD);
        if child > 0 {
            if kload(row + DIRENT_NAMESPACE) == 0 {
                if kload(row + DIRENT_PARENT) - bin_inode == 0 {
                    if kload(inode_addr(child) + INODE_KIND) - KIND_EXEC == 0 {
                        app_seed_bin_child_path(path_addr, slot);
                        var registered: t40 = app_register(0, path_addr, APP_CAP_SYSTEM, 0, 1, EXEC_IMAGE_WORDS);
                        if registered >= 0 {
                            loaded = loaded + 1;
                        }
                    }
                }
            }
        }
        slot = slot + 1;
    }
    return loaded;
}

fn app_path_hash(path_addr: t40) -> t40 {
    var words: t40 = validate_user_cstring(path_addr, VFS_MAX_PATH_WORDS);
    if words <= 0 {
        return ERR_BAD_PTR;
    }
    var hash: t40 = vfs_component_hash(path_addr, words - 1);
    if hash < 0 {
        return 0 - hash;
    }
    return hash;
}

fn app_cap_has(caps: t40, cap: t40) -> t40 {
    var remaining: t40 = caps;
    if remaining - APP_CAP_IPC >= 0 {
        if cap - APP_CAP_IPC == 0 {
            return 1;
        }
        remaining = remaining - APP_CAP_IPC;
    }
    if remaining - APP_CAP_PROCESS >= 0 {
        if cap - APP_CAP_PROCESS == 0 {
            return 1;
        }
        remaining = remaining - APP_CAP_PROCESS;
    }
    if remaining - APP_CAP_GRAPHICS >= 0 {
        if cap - APP_CAP_GRAPHICS == 0 {
            return 1;
        }
        remaining = remaining - APP_CAP_GRAPHICS;
    }
    if remaining - APP_CAP_FS_WRITE >= 0 {
        if cap - APP_CAP_FS_WRITE == 0 {
            return 1;
        }
        remaining = remaining - APP_CAP_FS_WRITE;
    }
    if remaining - APP_CAP_FS_READ >= 0 {
        if cap - APP_CAP_FS_READ == 0 {
            return 1;
        }
        remaining = remaining - APP_CAP_FS_READ;
    }
    if remaining - APP_CAP_CONSOLE >= 0 {
        if cap - APP_CAP_CONSOLE == 0 {
            return 1;
        }
    }
    return 0;
}

fn app_caps_allow(granted: t40, required: t40) -> t40 {
    var cap: t40 = APP_CAP_CONSOLE;
    while APP_CAP_IPC - cap >= 0 {
        if app_cap_has(required, cap) > 0 {
            if app_cap_has(granted, cap) <= 0 {
                return 0;
            }
        }
        cap = cap * 2;
    }
    return 1;
}

fn app_find_by_inode(namespace_id: t40, hash: t40, inode: t40) -> t40 {
    var app_id: t40 = 0;
    while APP_MAX - app_id > 0 {
        var row: t40 = app_addr(app_id);
        if kacq(row + APP_VERSION) > 0 {
            if kload(row + APP_NAMESPACE) - namespace_id == 0 {
                if kload(row + APP_PATH_HASH) - hash == 0 {
                    if kload(row + APP_INODE) - inode == 0 {
                        return app_id;
                    }
                }
            }
        } else {
            return ERR_NOT_FOUND;
        }
        app_id = app_id + 1;
    }
    return ERR_NOT_FOUND;
}

fn app_find(namespace_id: t40, path_addr: t40) -> t40 {
    var hash: t40 = app_path_hash(path_addr);
    if hash < 0 {
        return hash;
    }
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 {
        return inode;
    }
    return app_find_by_inode(namespace_id, hash, inode);
}

fn app_first_free() -> t40 {
    var app_id: t40 = 0;
    while APP_MAX - app_id > 0 {
        var row: t40 = app_addr(app_id);
        if kacq(row + APP_VERSION) <= 0 {
            return app_id;
        }
        app_id = app_id + 1;
    }
    return ERR_NO_SPACE;
}

fn app_register(namespace_id: t40, path_addr: t40, caps: t40, quota_id: t40, trusted: t40, max_image_words: t40) -> t40 {
    if namespace_is_active(namespace_id) <= 0 {
        return ERR_INVALID;
    }
    if quota_id < 0 {
        return ERR_INVALID;
    }
    if quota_id - QUOTA_MAX >= 0 {
        return ERR_INVALID;
    }
    if max_image_words <= 0 {
        return ERR_INVALID;
    }
    if max_image_words - EXEC_IMAGE_WORDS > 0 {
        return ERR_INVALID;
    }
    var hash: t40 = app_path_hash(path_addr);
    if hash < 0 {
        return hash;
    }
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 {
        return inode;
    }
    if kload(inode_addr(inode) + INODE_KIND) - KIND_EXEC != 0 {
        return ERR_INVALID;
    }
    if kload(inode_addr(inode) + INODE_SIZE) - EXEC_DESC_WORDS < 0 {
        return ERR_INVALID;
    }
    if app_find_by_inode(namespace_id, hash, inode) >= 0 {
        return ERR_EXISTS;
    }
    var app_id: t40 = app_first_free();
    if app_id < 0 {
        return app_id;
    }
    var row: t40 = app_addr(app_id);
    kstore(row + APP_NAMESPACE, namespace_id);
    kstore(row + APP_PATH_HASH, hash);
    kstore(row + APP_INODE, inode);
    kstore(row + APP_CAPS, caps);
    kstore(row + APP_QUOTA, quota_id);
    kstore(row + APP_TRUSTED, trusted);
    kstore(row + APP_LAUNCH_COUNT, 0);
    kstore(row + APP_MAX_IMAGE, max_image_words);
    kstore(row + APP_FLAGS, 0);
    unsafe { fence(1); }
    kcas(row + APP_VERSION, 0, 1);
    return app_id;
}

fn app_launch_count(app_id: t40) -> t40 {
    if app_id < 0 {
        return ERR_INVALID;
    }
    if app_id - APP_MAX >= 0 {
        return ERR_INVALID;
    }
    var row: t40 = app_addr(app_id);
    if kacq(row + APP_VERSION) <= 0 {
        return ERR_NOT_FOUND;
    }
    return kload(row + APP_LAUNCH_COUNT);
}

fn app_launch(pid: t40, path_addr: t40, required_caps: t40) -> t40 {
    var process_slot: t40 = process_find_pid(pid);
    if process_slot < 0 {
        return process_slot;
    }
    var proc_row: t40 = process_addr(process_slot);
    var namespace_id: t40 = kload(proc_row + PROC_NAMESPACE);
    var app_id: t40 = app_find(namespace_id, path_addr);
    if app_id < 0 {
        return app_id;
    }
    var row: t40 = app_addr(app_id);
    if kload(row + APP_TRUSTED) <= 0 {
        return ERR_INVALID;
    }
    if app_caps_allow(kload(row + APP_CAPS), required_caps) <= 0 {
        return ERR_INVALID;
    }
    var inode: t40 = kload(row + APP_INODE);
    if inode < 0 {
        return ERR_INVALID;
    }
    if inode - VFS_MAX_INODES >= 0 {
        return ERR_INVALID;
    }
    if kload(inode_addr(inode) + INODE_KIND) - KIND_EXEC != 0 {
        return ERR_INVALID;
    }
    var size_words: t40 = kload(inode_addr(inode) + INODE_SIZE);
    if size_words - kload(row + APP_MAX_IMAGE) > 0 {
        return ERR_NO_SPACE;
    }
    var quota_id: t40 = kload(row + APP_QUOTA);
    if quota_charge(quota_id, 1) < 0 {
        return ERR_NO_SPACE;
    }
    var loaded: t40 = exec_process_inode(process_slot, namespace_id, inode, path_addr);
    if loaded < 0 {
        quota_release(quota_id, 1);
        return loaded;
    }
    process_set_caps(process_slot, kload(row + APP_CAPS));
    var version: t40 = kacq(row + APP_VERSION);
    kstore(row + APP_LAUNCH_COUNT, kload(row + APP_LAUNCH_COUNT) + 1);
    kcas(row + APP_VERSION, version, version + 1);
    return loaded;
}

fn app_spawn(parent_pid: t40, path_addr: t40, child_slot: t40, child_pid: t40) -> t40 {
    if child_slot <= 0 {
        return 0 - ERR_INVALID;
    }
    if child_slot - PROCESS_MAX >= 0 {
        return 0 - ERR_INVALID;
    }
    if child_pid <= 1 {
        return 0 - ERR_INVALID;
    }
    var parent_slot: t40 = process_find_pid(parent_pid);
    if parent_slot < 0 {
        return parent_slot;
    }

    var child_state: t40 = kload(process_addr(child_slot) + PROC_STATE);
    if child_state > 0 {
        if process_terminal_state(child_state) > 0 {
            process_reap_slot(child_slot);
        } else {
            return 0 - ERR_EXISTS;
        }
    }

    var slot: t40 = 0;
    while PROCESS_MAX - slot > 0 {
        if slot - child_slot != 0 {
            var row: t40 = process_addr(slot);
            if kload(row + PROC_STATE) > 0 {
                if kload(row + PROC_PID) - child_pid == 0 {
                    return 0 - ERR_EXISTS;
                }
            }
        }
        slot = slot + 1;
    }

    var parent_row: t40 = process_addr(parent_slot);
    process_create(child_slot, child_pid, kload(parent_row + PROC_NAMESPACE), kload(parent_row + PROC_PRIORITY), kload(parent_row + PROC_QUOTA), 0);
    process_set_parent(child_slot, parent_pid);
    var loaded: t40 = app_launch(child_pid, path_addr, 0);
    if loaded < 0 {
        process_reap_slot(child_slot);
        return loaded;
    }
    if loaded - EXEC_DESC_WORDS < 0 {
        process_reap_slot(child_slot);
        return 0 - loaded;
    }
    return child_pid;
}

fn kernel_set_return(status: t40, payload: t40, detail: t40) -> t40 {
    kstore(SYS_STATUS_ADDR, status);
    kstore(SYS_PAYLOAD_ADDR, payload);
    kstore(SYS_DETAIL_ADDR, detail);
    return status;
}

fn kernel_syscall_dispatch(pid: t40, service: t40, arg0: t40, arg1: t40, arg2: t40, arg3: t40) -> t40 {
    if service - 1 == 0 {
        unsafe { csr_write(console_ctrl, 3); }
        unsafe { csr_write(console_out, arg0); }
        return kernel_set_return(1, arg0, 0);
    }
    if service - 2 == 0 {
        unsafe { csr_write(console_ctrl, 1); }
        return kernel_set_return(1, 0, 0);
    }
    if service - 3 == 0 {
        unsafe { csr_write(console_ctrl, -1); }
        return kernel_set_return(1, 0, 0);
    }
    if service - 6 == 0 {
        return kernel_set_return(ERR_INVALID, 0, 6);
    }
    if service - 7 == 0 {
        return kernel_set_return(1, pid, 0);
    }
    if service - 8 == 0 {
        var cycles: t40 = 0;
        unsafe { cycles = csr_read(cycle); }
        return kernel_set_return(1, cycles, 0);
    }
    if service - 9 == 0 {
        var available: t40 = 0;
        unsafe { available = csr_read(console_in_ctrl); }
        if available <= 0 {
            return kernel_set_return(0, 0, ERR_EOF);
        }
        var key: t40 = 0;
        unsafe { key = csr_read(console_in); }
        unsafe { csr_write(console_in_ctrl, 1); }
        return kernel_set_return(1, key, 0);
    }
    if service - 12 == 0 {
        var path_words: t40 = user_copy_cstring_to_kernel(pid, arg0, SYSCALL_PATH_COPY_BASE, VFS_MAX_PATH_WORDS);
        if path_words < 0 {
            return kernel_set_return(-1, 0, path_words);
        }
        var fd: t40 = vfs_open(pid, SYSCALL_PATH_COPY_BASE, arg1);
        if fd < 0 {
            return kernel_set_return(-1, 0, fd);
        }
        return kernel_set_return(1, fd, 0);
    }
    if service - 13 == 0 {
        var closed: t40 = vfs_close(pid, arg0);
        if closed < 0 {
            return kernel_set_return(-1, 0, closed);
        }
        return kernel_set_return(1, 0, 0);
    }
    if service - 14 == 0 {
        var read_count: t40 = vfs_read(pid, arg0, arg1, arg2);
        if read_count < 0 {
            return kernel_set_return(-1, 0, read_count);
        }
        if read_count == 0 {
            return kernel_set_return(0, 0, ERR_EOF);
        }
        return kernel_set_return(1, read_count, 0);
    }
    if service - 15 == 0 {
        var write_count: t40 = vfs_write(pid, arg0, arg1, arg2);
        if write_count < 0 {
            return kernel_set_return(-1, 0, write_count);
        }
        return kernel_set_return(1, write_count, 0);
    }
    if service - 16 == 0 {
        var stat_ns: t40 = process_namespace_for_pid(pid);
        var stat_path_words: t40 = user_copy_cstring_to_kernel(pid, arg0, SYSCALL_PATH_COPY_BASE, VFS_MAX_PATH_WORDS);
        if stat_path_words < 0 {
            return kernel_set_return(-1, 0, stat_path_words);
        }
        var size_words: t40 = vfs_stat_user(pid, stat_ns, SYSCALL_PATH_COPY_BASE, arg1);
        if size_words < 0 {
            return kernel_set_return(-1, 0, size_words);
        }
        return kernel_set_return(1, size_words, 0);
    }
    if service - 17 == 0 {
        var dir_ns: t40 = process_namespace_for_pid(pid);
        var dir_path_words: t40 = user_copy_cstring_to_kernel(pid, arg0, SYSCALL_PATH_COPY_BASE, VFS_MAX_PATH_WORDS);
        if dir_path_words < 0 {
            return kernel_set_return(-1, 0, dir_path_words);
        }
        var written: t40 = vfs_readdir_user(pid, dir_ns, SYSCALL_PATH_COPY_BASE, arg1, arg2);
        if written < 0 {
            return kernel_set_return(-1, 0, written);
        }
        return kernel_set_return(1, written, 0);
    }
    if service - 18 == 0 {
        var brk_status: t40 = process_brk(pid, arg0);
        if brk_status < 0 {
            return kernel_set_return(-1, 0, brk_status);
        }
        return kernel_set_return(1, brk_status, 0);
    }
    if service - 19 == 0 {
        var old_break: t40 = process_sbrk(pid, arg0);
        if old_break < 0 {
            return kernel_set_return(-1, 0, old_break);
        }
        return kernel_set_return(1, old_break, 0);
    }
    if service - 20 == 0 {
        var parent_slot: t40 = process_find_pid(pid);
        if parent_slot < 0 {
            return kernel_set_return(-1, 0, parent_slot);
        }
        var child_pid: t40 = fork_process(parent_slot, arg0, arg1);
        if child_pid < 0 {
            return kernel_set_return(-1, 0, child_pid);
        }
        return kernel_set_return(1, child_pid, 0);
    }
    if service - 21 == 0 {
        var exec_path_words: t40 = user_copy_cstring_to_kernel(pid, arg0, SYSCALL_PATH_COPY_BASE, VFS_MAX_PATH_WORDS);
        if exec_path_words < 0 {
            return kernel_set_return(-1, 0, exec_path_words);
        }
        var exec_words: t40 = app_launch(pid, SYSCALL_PATH_COPY_BASE, 0);
        if exec_words < 0 {
            return kernel_set_return(-1, 0, exec_words);
        }
        return kernel_set_return(1, exec_words, 0);
    }
    if service - 22 == 0 {
        unsafe { csr_write(console_ctrl, 2); }
        unsafe { csr_write(console_out, arg0); }
        unsafe { csr_write(console_ctrl, 3); }
        return kernel_set_return(1, arg0, 0);
    }
    if service - 23 == 0 {
        var send_ns: t40 = process_namespace_for_pid(pid);
        var sent: t40 = ipc_send(arg0, send_ns, arg1);
        if sent < 0 {
            return kernel_set_return(-1, 0, sent);
        }
        return kernel_set_return(1, sent, 0);
    }
    if service - 24 == 0 {
        var recv_ns: t40 = process_namespace_for_pid(pid);
        var received: t40 = ipc_recv_user(pid, arg0, recv_ns, arg1);
        if received < 0 {
            return kernel_set_return(-1, 0, received);
        }
        if received == 0 {
            return kernel_set_return(0, 0, ERR_EOF);
        }
        return kernel_set_return(1, received, 0);
    }
    if service - 25 == 0 {
        var fb_base: t40 = framebuffer_init(arg0, arg1);
        if fb_base < 0 {
            return kernel_set_return(-1, 0, fb_base);
        }
        return kernel_set_return(1, fb_base, 0);
    }
    if service - 26 == 0 {
        var flips: t40 = framebuffer_flip();
        if flips < 0 {
            return kernel_set_return(-1, 0, flips);
        }
        return kernel_set_return(1, flips, 0);
    }
    if service - 27 == 0 {
        var window_id: t40 = window_create(pid, arg0, arg1, arg2, arg3);
        if window_id < 0 {
            return kernel_set_return(-1, 0, window_id);
        }
        return kernel_set_return(1, window_id, 0);
    }
    if service - 28 == 0 {
        var window_buffer: t40 = window_get_buffer(pid, arg0);
        if window_buffer < 0 {
            return kernel_set_return(-1, 0, window_buffer);
        }
        return kernel_set_return(1, window_buffer, 0);
    }
    if service - 29 == 0 {
        var present_count: t40 = window_present(pid, arg0);
        if present_count < 0 {
            return kernel_set_return(-1, 0, present_count);
        }
        return kernel_set_return(1, present_count, 0);
    }
    if service - 30 == 0 {
        var moved: t40 = window_move(pid, arg0, arg1, arg2);
        if moved < 0 {
            return kernel_set_return(-1, 0, moved);
        }
        return kernel_set_return(1, moved, 0);
    }
    if service - 31 == 0 {
        var zed: t40 = window_set_z(pid, arg0, arg1);
        if zed < 0 {
            return kernel_set_return(-1, 0, zed);
        }
        return kernel_set_return(1, zed, 0);
    }
    if service - 32 == 0 {
        var destroyed: t40 = window_destroy(pid, arg0);
        if destroyed < 0 {
            return kernel_set_return(-1, 0, destroyed);
        }
        return kernel_set_return(1, destroyed, 0);
    }
    if service - 33 == 0 {
        var event_read: t40 = window_read_event(pid, arg0, arg1);
        if event_read < 0 {
            return kernel_set_return(-1, 0, event_read);
        }
        if event_read == 0 {
            return kernel_set_return(0, 0, ERR_EOF);
        }
        return kernel_set_return(1, event_read, 0);
    }
    if service - 34 == 0 {
        var resized: t40 = window_resize(pid, arg0, arg1, arg2);
        if resized < 0 {
            return kernel_set_return(-1, 0, resized);
        }
        return kernel_set_return(1, resized, 0);
    }
    if service - 35 == 0 {
        var close_requested: t40 = window_request_close(pid, arg0);
        if close_requested < 0 {
            return kernel_set_return(-1, 0, close_requested);
        }
        return kernel_set_return(1, close_requested, 0);
    }
    // Net syscalls
    if service - 36 == 0 {
        var sock_id: t40 = net_socket_create(pid, arg0);
        if sock_id < 0 {
            return kernel_set_return(-1, 0, sock_id);
        }
        return kernel_set_return(1, sock_id, 0);
    }
    if service - 37 == 0 {
        var bound: t40 = net_bind(arg0, pid, arg1);
        if bound < 0 {
            return kernel_set_return(-1, 0, bound);
        }
        return kernel_set_return(1, bound, 0);
    }
    if service - 38 == 0 {
        var connected: t40 = net_connect(arg0, pid, arg1);
        if connected < 0 {
            return kernel_set_return(-1, 0, connected);
        }
        return kernel_set_return(1, connected, 0);
    }
    if service - 39 == 0 {
        var sent: t40 = net_send(arg0, pid, arg1);
        if sent < 0 {
            return kernel_set_return(-1, 0, sent);
        }
        return kernel_set_return(1, sent, 0);
    }
    if service - 40 == 0 {
        var recvd: t40 = net_recv_user(arg0, pid, arg1);
        if recvd < 0 {
            return kernel_set_return(-1, 0, recvd);
        }
        if recvd == 0 {
            return kernel_set_return(0, 0, ERR_EOF);
        }
        return kernel_set_return(1, recvd, 0);
    }
    // VFS mkdir / unlink
    if service - 41 == 0 {
        var mkdir_ns: t40 = process_namespace_for_pid(pid);
        var mkdir_path_words: t40 = user_copy_cstring_to_kernel(pid, arg0, SYSCALL_PATH_COPY_BASE, VFS_MAX_PATH_WORDS);
        if mkdir_path_words < 0 {
            return kernel_set_return(-1, 0, mkdir_path_words);
        }
        var new_inode: t40 = vfs_create(mkdir_ns, SYSCALL_PATH_COPY_BASE, KIND_DIR);
        if new_inode < 0 {
            return kernel_set_return(-1, 0, new_inode);
        }
        return kernel_set_return(1, new_inode, 0);
    }
    if service - 42 == 0 {
        var unlink_path_words: t40 = user_copy_cstring_to_kernel(pid, arg0, SYSCALL_PATH_COPY_BASE, VFS_MAX_PATH_WORDS);
        if unlink_path_words < 0 {
            return kernel_set_return(-1, 0, unlink_path_words);
        }
        var unlinked: t40 = vfs_unlink(pid, SYSCALL_PATH_COPY_BASE);
        if unlinked < 0 {
            return kernel_set_return(-1, 0, unlinked);
        }
        return kernel_set_return(1, unlinked, 0);
    }
    if service - 59 == 0 {
        // Copy both user strings before any VFS lookup.  The scratch ranges
        // are disjoint and each copy validates the complete bounded C string,
        // so a malformed second pointer cannot partially mutate metadata.
        var old_path_words: t40 = user_copy_cstring_to_kernel(
            pid, arg0, SYSCALL_RENAME_OLD_COPY_BASE, VFS_MAX_PATH_WORDS);
        if old_path_words < 0 {
            return kernel_set_return(-1, 0, old_path_words);
        }
        var new_path_words: t40 = user_copy_cstring_to_kernel(
            pid, arg1, SYSCALL_RENAME_NEW_COPY_BASE, VFS_MAX_PATH_WORDS);
        if new_path_words < 0 {
            return kernel_set_return(-1, 0, new_path_words);
        }
        var renamed: t40 = vfs_rename(
            pid, SYSCALL_RENAME_OLD_COPY_BASE, SYSCALL_RENAME_NEW_COPY_BASE);
        if renamed < 0 {
            return kernel_set_return(-1, 0, renamed);
        }
        return kernel_set_return(1, renamed, 0);
    }
    // Process lifecycle: waitpid, exit, sleep
    if service - 43 == 0 {
        var caller_slot: t40 = process_find_pid(pid);
        if caller_slot < 0 {
            return kernel_set_return(-1, 0, caller_slot);
        }
        var target_slot: t40 = process_find_pid(arg0);
        if target_slot < 0 {
            return kernel_set_return(-1, 0, target_slot);
        }
        if kload(PROC_PARENT_PID_BASE + target_slot) - pid != 0 {
            return kernel_set_return(-1, 0, ERR_INVALID);
        }
        var target_state: t40 = process_state(target_slot);
        if process_terminal_state(target_state) > 0 {
            var child_status: t40 = kload(PROC_EXIT_STATUS_BASE + target_slot);
            process_reap_slot(target_slot);
            return kernel_set_return(1, child_status, 0);
        }
        var wait_child: t40 = process_block_on(caller_slot, wait_channel_waitpid(arg0), WAIT_KIND_LEGACY, 0, arg0, 0, 0, PROC_BLOCKED);
        if wait_child < 0 {
            return kernel_set_return(-1, 0, wait_child);
        }
        return kernel_set_return(SYS_BLOCKED, 0, 0);
    }
    if service - 44 == 0 {
        var exit_slot: t40 = process_find_pid(pid);
        if exit_slot < 0 {
            return kernel_set_return(-1, 0, exit_slot);
        }
        process_finish_exit(exit_slot, arg0, PROC_ZOMBIE);
        return kernel_set_return(1, arg0, 0);
    }
    if service - 45 == 0 {
        var sleep_slot: t40 = process_find_pid(pid);
        if sleep_slot < 0 {
            return kernel_set_return(-1, 0, sleep_slot);
        }
        var slept: t40 = process_block_on(sleep_slot, wait_channel_sleep(pid), WAIT_KIND_SLEEP, 1, 0, 0, 0, PROC_SLEEPING);
        if slept < 0 {
            return kernel_set_return(-1, 0, slept);
        }
        return kernel_set_return(SYS_BLOCKED, 0, 0);
    }
    // Process snapshot
    if service - 46 == 0 {
        var ps_count: t40 = kernel_ps_user(pid, arg0, arg1);
        if ps_count < 0 {
            return kernel_set_return(-1, 0, ps_count);
        }
        return kernel_set_return(1, ps_count, 0);
    }
    // VFS sync
    if service - 47 == 0 {
        var fsynced: t40 = vfs_fsync(pid, arg0);
        if fsynced < 0 {
            return kernel_set_return(-1, 0, fsynced);
        }
        return kernel_set_return(1, fsynced, 0);
    }
    // Process control
    if service - 48 == 0 {
        var kill_auth: t40 = process_control_authorized(pid, arg0);
        if kill_auth < 0 {
            return kernel_set_return(-1, 0, kill_auth);
        }
        var killed: t40 = process_signal(arg0, arg1);
        if killed < 0 {
            return kernel_set_return(-1, 0, killed);
        }
        return kernel_set_return(1, killed, 0);
    }
    if service - 49 == 0 {
        var suspend_auth: t40 = process_control_authorized(pid, arg0);
        if suspend_auth < 0 {
            return kernel_set_return(-1, 0, suspend_auth);
        }
        var suspended: t40 = process_signal(arg0, SIGNAL_STOP);
        if suspended < 0 {
            return kernel_set_return(-1, 0, suspended);
        }
        return kernel_set_return(1, suspended, 0);
    }
    if service - 50 == 0 {
        var resume_auth: t40 = process_control_authorized(pid, arg0);
        if resume_auth < 0 {
            return kernel_set_return(-1, 0, resume_auth);
        }
        var resumed: t40 = process_signal(arg0, SIGNAL_CONT);
        if resumed < 0 {
            return kernel_set_return(-1, 0, resumed);
        }
        return kernel_set_return(1, resumed, 0);
    }
    if service - 51 == 0 {
        var procinfo: t40 = kernel_getproc_user(pid, arg0, arg1);
        if procinfo < 0 {
            return kernel_set_return(-1, 0, procinfo);
        }
        return kernel_set_return(1, procinfo, 0);
    }
    if service - 52 == 0 {
        var futex_key: t40 = wait_futex_key(pid, arg0);
        if futex_key < 0 {
            return kernel_set_return(-1, 0, futex_key);
        }
        var futex_word: t40 = user_load_word(pid, arg0);
        if futex_word - arg1 != 0 {
            return kernel_set_return(0, 0, ERR_AGAIN);
        }
        var futex_slot: t40 = process_find_pid(pid);
        if futex_slot < 0 {
            return kernel_set_return(-1, 0, futex_slot);
        }
        var futex_blocked: t40 = process_block_on(futex_slot, wait_channel_futex_key(futex_key), WAIT_KIND_FUTEX, arg2, arg0, arg1, 0, PROC_BLOCKED);
        if futex_blocked < 0 {
            return kernel_set_return(-1, 0, futex_blocked);
        }
        return kernel_set_return(SYS_BLOCKED, 0, 0);
    }
    if service - 53 == 0 {
        var futex_woke: t40 = wait_wake_futex(pid, arg0, arg1);
        if futex_woke < 0 {
            return kernel_set_return(-1, 0, futex_woke);
        }
        return kernel_set_return(1, futex_woke, 0);
    }
    if service - 54 == 0 {
        var block_recv_ns: t40 = process_namespace_for_pid(pid);
        var block_received: t40 = ipc_recv_user(pid, arg0, block_recv_ns, arg1);
        if block_received < 0 {
            return kernel_set_return(-1, 0, block_received);
        }
        if block_received > 0 {
            return kernel_set_return(1, block_received, 0);
        }
        var block_recv_slot: t40 = process_find_pid(pid);
        if block_recv_slot < 0 {
            return kernel_set_return(-1, 0, block_recv_slot);
        }
        var block_recv_wait: t40 = process_block_on(block_recv_slot, wait_channel_ipc(arg0), WAIT_KIND_IPC, arg2, arg0, arg1, 0, PROC_BLOCKED);
        if block_recv_wait < 0 {
            return kernel_set_return(-1, 0, block_recv_wait);
        }
        return kernel_set_return(SYS_BLOCKED, 0, 0);
    }
    if service - 55 == 0 {
        if arg0 >= 0 {
            var wait_event_read: t40 = window_read_event(pid, arg0, arg1);
            if wait_event_read < 0 {
                return kernel_set_return(-1, 0, wait_event_read);
            }
            if wait_event_read > 0 {
                return kernel_set_return(1, wait_event_read, 0);
            }
            if arg2 <= 0 {
                return kernel_set_return(0, 0, ERR_AGAIN);
            }
            var wait_event_slot: t40 = process_find_pid(pid);
            if wait_event_slot < 0 {
                return kernel_set_return(-1, 0, wait_event_slot);
            }
            var wait_event_blocked: t40 = process_block_on(wait_event_slot, wait_channel_window(arg0), WAIT_KIND_WINDOW, arg2, arg0, arg1, 0, PROC_BLOCKED);
            if wait_event_blocked < 0 {
                return kernel_set_return(-1, 0, wait_event_blocked);
            }
            return kernel_set_return(SYS_BLOCKED, 0, 0);
        }
        var input_event: t40 = wait_read_input_event(pid, arg1);
        if input_event < 0 {
            return kernel_set_return(-1, 0, input_event);
        }
        if input_event > 0 {
            return kernel_set_return(1, input_event, 0);
        }
        if arg2 <= 0 {
            return kernel_set_return(0, 0, ERR_AGAIN);
        }
        var input_wait_slot: t40 = process_find_pid(pid);
        if input_wait_slot < 0 {
            return kernel_set_return(-1, 0, input_wait_slot);
        }
        var input_wait_blocked: t40 = process_block_on(input_wait_slot, WAIT_CHAN_INPUT, WAIT_KIND_INPUT, arg2, arg0, arg1, 0, PROC_BLOCKED);
        if input_wait_blocked < 0 {
            return kernel_set_return(-1, 0, input_wait_blocked);
        }
        return kernel_set_return(SYS_BLOCKED, 0, 0);
    }
    if service - 56 == 0 {
        if arg0 <= 0 {
            return kernel_set_return(1, 1, 0);
        }
        var sleep_ms_slot: t40 = process_find_pid(pid);
        if sleep_ms_slot < 0 {
            return kernel_set_return(-1, 0, sleep_ms_slot);
        }
        var sleep_ms_blocked: t40 = process_block_on(sleep_ms_slot, wait_channel_sleep(pid), WAIT_KIND_SLEEP, arg0, 0, 0, 0, PROC_SLEEPING);
        if sleep_ms_blocked < 0 {
            return kernel_set_return(-1, 0, sleep_ms_blocked);
        }
        return kernel_set_return(SYS_BLOCKED, 0, 0);
    }
    if service - 57 == 0 {
        var spawn_path_words: t40 = user_copy_cstring_to_kernel(pid, arg0, SYSCALL_PATH_COPY_BASE, VFS_MAX_PATH_WORDS);
        if spawn_path_words < 0 {
            return kernel_set_return(-1, 0, spawn_path_words);
        }
        var spawned: t40 = app_spawn(pid, SYSCALL_PATH_COPY_BASE, arg1, arg2);
        if spawned < 0 {
            return kernel_set_return(-1, 0, 0 - spawned);
        }
        return kernel_set_return(1, spawned, 0);
    }
    if service - 58 == 0 {
        var reboot_slot: t40 = process_find_pid(pid);
        if reboot_slot < 0 {
            return kernel_set_return(-1, 0, reboot_slot);
        }
        if app_caps_allow(kload(PROC_CAPS_BASE + reboot_slot), APP_CAP_SYSTEM) <= 0 {
            return kernel_set_return(-1, 0, ERR_INVALID);
        }
        unsafe { csr_write(power_control, 1); }
        return kernel_set_return(1, 1, 0);
    }
    return kernel_set_return(-1, 0, ERR_INVALID);
}

fn kernel_bind_context(context_addr: t40, pid: t40) -> t40 {
    kstore(CURRENT_CONTEXT_ADDR, context_addr);
    kstore(CURRENT_PID_ADDR, pid);
    return 1;
}

fn kernel_crash_current_process(cause_value: t40) -> t40 {
    var pid: t40 = kload(CURRENT_PID_ADDR);
    if pid <= 0 {
        return ERR_INVALID;
    }
    var slot: t40 = process_find_pid(pid);
    if slot < 0 {
        return slot;
    }
    if process_terminal_state(process_state(slot)) > 0 {
        return ERR_INVALID;
    }
    process_finish_exit(slot, cause_value, PROC_CRASHED);
    return kernel_schedule_next();
}

fn kernel_dispatch(cause_value: t40) -> t40 {
    if cause_value - KCAUSE_SYSCALL == 0 {
        var service: t40 = 0;
        unsafe { service = csr_read(syscall_id); }
        var ctx: t40 = kload(CURRENT_CONTEXT_ADDR);
        var pid: t40 = kload(CURRENT_PID_ADDR);
        var arg0: t40 = kload(ctx + 18);
        var arg1: t40 = kload(ctx + 19);
        var arg2: t40 = kload(ctx + 20);
        var arg3: t40 = kload(ctx + 21);
        var status: t40 =
            kernel_syscall_dispatch(pid, service, arg0, arg1, arg2, arg3);
        if status - SYS_BLOCKED == 0 {
            kernel_schedule_next();
            return status;
        }
        if service - 44 == 0 {
            if status > 0 {
                kernel_schedule_next();
            }
            return status;
        }
        if status > 0 {
            if service - 21 == 0 {
                if kload(SYS_PAYLOAD_ADDR) > 0 {
                    return status;
                }
            }
        }
        kstore(ctx, kload(ctx) + 1);
        kstore(ctx + 18, kload(SYS_STATUS_ADDR));
        kstore(ctx + 19, kload(SYS_PAYLOAD_ADDR));
        kstore(ctx + 20, kload(SYS_DETAIL_ADDR));
        return status;
    }
    if cause_value - KCAUSE_TIMER_IRQ == 0 {
        kernel_timer_tick();
        return kernel_schedule_next();
    }
    return kernel_crash_current_process(cause_value);
}

fn pte_valid_state(pte_word: t40) -> t40 {
    if pte_word > 0 {
        return 1;
    }
    return -1;
}

fn pte_faults(pte_word: t40) -> t40 {
    if pte_valid_state(pte_word) > 0 {
        return 0;
    }
    return 1;
}

fn pte_is_present(pte_word: t40) -> t40 {
    if pte_valid_state(pte_word) > 0 {
        return 1;
    }
    return 0;
}

fn mmu_page_walk_valid(pte_addr: t40) -> t40 {
    var pte_word: t40 = kload(pte_addr);
    return pte_is_present(pte_word);
}

fn cow_fault_can_remap(pte_addr: t40, ppn: t40) -> t40 {
    if mmu_page_walk_valid(pte_addr) <= 0 {
        return 0;
    }
    return cow_can_remap(ppn);
}

fn ipc_channel_addr(channel_id: t40) -> t40 {
    return IPC_BASE + channel_id * IPC_CHANNEL_WORDS;
}

fn ipc_buffer_addr(channel_id: t40) -> t40 {
    return IPC_BUFFER_BASE + channel_id * IPC_CAPACITY;
}

fn ipc_init() -> t40 {
    kclear(IPC_BASE, IPC_MAX_CHANNELS * IPC_CHANNEL_WORDS);
    kclear(IPC_BUFFER_BASE, IPC_MAX_CHANNELS * IPC_CAPACITY);
    kclear(IPC_OWNER_BASE, IPC_MAX_CHANNELS);
    return 1;
}

fn ipc_open(channel_id: t40, namespace_a: t40, namespace_b: t40) -> t40 {
    if channel_id < 0 {
        return ERR_INVALID;
    }
    if channel_id - IPC_MAX_CHANNELS >= 0 {
        return ERR_INVALID;
    }
    var ch: t40 = ipc_channel_addr(channel_id);
    kstore(ch + IPC_NS_A, namespace_a);
    kstore(ch + IPC_NS_B, namespace_b);
    kstore(ch + IPC_BUF, ipc_buffer_addr(channel_id));
    kstore(ch + IPC_CAP, IPC_CAPACITY);
    kstore(ch + IPC_READ, 0);
    kstore(ch + IPC_WRITE, 0);
    kstore(ch + IPC_COUNT, 0);
    kstore(ch + IPC_VERSION, 1);
    kstore(IPC_OWNER_BASE + channel_id, -1);
    return 1;
}

fn ipc_open_owned(channel_id: t40, owner_pid: t40, namespace_a: t40, namespace_b: t40) -> t40 {
    var opened: t40 = ipc_open(channel_id, namespace_a, namespace_b);
    if opened < 0 {
        return opened;
    }
    kstore(IPC_OWNER_BASE + channel_id, owner_pid);
    return 1;
}

fn ipc_namespace_allowed(channel_id: t40, namespace_id: t40) -> t40 {
    var ch: t40 = ipc_channel_addr(channel_id);
    if kload(ch + IPC_VERSION) <= 0 {
        return 0;
    }
    if kload(ch + IPC_NS_A) - namespace_id == 0 {
        return 1;
    }
    if kload(ch + IPC_NS_B) - namespace_id == 0 {
        return 1;
    }
    return 0;
}

fn ipc_send(channel_id: t40, namespace_id: t40, word: t40) -> t40 {
    if ipc_namespace_allowed(channel_id, namespace_id) <= 0 {
        return ERR_INVALID;
    }
    var ch: t40 = ipc_channel_addr(channel_id);
    var count: t40 = kacq(ch + IPC_COUNT);
    if count - IPC_CAPACITY >= 0 {
        return ERR_NO_SPACE;
    }
    var write_pos: t40 = kacq(ch + IPC_WRITE);
    var buf: t40 = kload(ch + IPC_BUF);
    kstore(buf + write_pos, word);
    kstore(ch + IPC_WRITE, kwrap_inc(write_pos, IPC_CAPACITY));
    kcas(ch + IPC_COUNT, count, count + 1);
    wait_wake_one_ipc(channel_id);
    return 1;
}

fn ipc_recv(channel_id: t40, namespace_id: t40, out_addr: t40) -> t40 {
    if ipc_namespace_allowed(channel_id, namespace_id) <= 0 {
        return ERR_INVALID;
    }
    if validate_user_span(out_addr, 1, 1) <= 0 {
        return ERR_BAD_PTR;
    }
    var ch: t40 = ipc_channel_addr(channel_id);
    var count: t40 = kacq(ch + IPC_COUNT);
    if count <= 0 {
        return 0;
    }
    var read_pos: t40 = kacq(ch + IPC_READ);
    var buf: t40 = kload(ch + IPC_BUF);
    var word: t40 = kacq(buf + read_pos);
    kstore(out_addr, word);
    kstore(ch + IPC_READ, kwrap_inc(read_pos, IPC_CAPACITY));
    kcas(ch + IPC_COUNT, count, count - 1);
    return 1;
}

fn ipc_recv_user(pid: t40, channel_id: t40, namespace_id: t40, out_addr: t40) -> t40 {
    if ipc_namespace_allowed(channel_id, namespace_id) <= 0 {
        return ERR_INVALID;
    }
    if user_validate_span(pid, out_addr, 1, 1) <= 0 {
        return ERR_BAD_PTR;
    }
    var ch: t40 = ipc_channel_addr(channel_id);
    var count: t40 = kacq(ch + IPC_COUNT);
    if count <= 0 {
        return 0;
    }
    var read_pos: t40 = kacq(ch + IPC_READ);
    var buf: t40 = kload(ch + IPC_BUF);
    var word: t40 = kacq(buf + read_pos);
    var stored: t40 = user_store_word(pid, out_addr, word);
    if stored < 0 {
        return stored;
    }
    kstore(ch + IPC_READ, kwrap_inc(read_pos, IPC_CAPACITY));
    kcas(ch + IPC_COUNT, count, count - 1);
    return 1;
}

fn net_socket_row(socket_id: t40) -> t40 {
    return NET_BASE + socket_id * NET_SOCKET_WORDS;
}

fn net_rx_base(socket_id: t40) -> t40 {
    return NET_RX_BASE + socket_id * NET_RX_CAPACITY;
}

fn net_init() -> t40 {
    kclear(NET_BASE, NET_MAX_SOCKETS * NET_SOCKET_WORDS);
    kclear(NET_RX_BASE, NET_MAX_SOCKETS * NET_RX_CAPACITY);
    return NET_MAX_SOCKETS;
}

fn net_socket_create(owner_pid: t40, kind: t40) -> t40 {
    var slot: t40 = 0;
    while NET_MAX_SOCKETS - slot > 0 {
        var row: t40 = net_socket_row(slot);
        if kload(row + NET_SOCK_STATE) - NET_STATE_FREE == 0 {
            kstore(row + NET_SOCK_STATE, NET_STATE_OPEN);
            kstore(row + NET_SOCK_OWNER, owner_pid);
            kstore(row + NET_SOCK_KIND, kind);
            kstore(row + NET_SOCK_LOCAL_PORT, 0);
            kstore(row + NET_SOCK_REMOTE_PORT, 0);
            kstore(row + NET_SOCK_RX_READ, 0);
            kstore(row + NET_SOCK_RX_WRITE, 0);
            kstore(row + NET_SOCK_RX_BASE, net_rx_base(slot));
            return slot;
        }
        slot = slot + 1;
    }
    return ERR_NO_SPACE;
}

fn net_authorized(socket_id: t40, pid: t40) -> t40 {
    if socket_id < 0 { return 0; }
    if socket_id - NET_MAX_SOCKETS >= 0 { return 0; }
    var row: t40 = net_socket_row(socket_id);
    if kload(row + NET_SOCK_STATE) <= 0 { return 0; }
    if kload(row + NET_SOCK_OWNER) - pid != 0 { return 0; }
    return 1;
}

fn net_bind(socket_id: t40, pid: t40, port: t40) -> t40 {
    if net_authorized(socket_id, pid) <= 0 { return ERR_INVALID; }
    var row: t40 = net_socket_row(socket_id);
    kstore(row + NET_SOCK_LOCAL_PORT, port);
    kstore(row + NET_SOCK_STATE, NET_STATE_BOUND);
    return 1;
}

fn net_connect(socket_id: t40, pid: t40, remote_port: t40) -> t40 {
    if net_authorized(socket_id, pid) <= 0 { return ERR_INVALID; }
    var row: t40 = net_socket_row(socket_id);
    kstore(row + NET_SOCK_REMOTE_PORT, remote_port);
    kstore(row + NET_SOCK_STATE, NET_STATE_CONNECTED);
    return 1;
}

fn net_ring_next(pos: t40, capacity: t40) -> t40 {
    var next: t40 = pos + 1;
    if next - capacity >= 0 { return 0; }
    return next;
}

fn net_send(socket_id: t40, pid: t40, word: t40) -> t40 {
    if net_authorized(socket_id, pid) <= 0 { return ERR_INVALID; }
    var row: t40 = net_socket_row(socket_id);
    var rp: t40 = kload(row + NET_SOCK_RX_READ);
    var wp: t40 = kload(row + NET_SOCK_RX_WRITE);
    var next_wp: t40 = net_ring_next(wp, NET_RX_CAPACITY);
    if next_wp - rp == 0 { return ERR_NO_SPACE; }
    kstore(kload(row + NET_SOCK_RX_BASE) + wp, word);
    kstore(row + NET_SOCK_RX_WRITE, next_wp);
    return 1;
}

fn net_recv_user(socket_id: t40, pid: t40, out_addr: t40) -> t40 {
    if net_authorized(socket_id, pid) <= 0 { return ERR_INVALID; }
    if user_validate_span(pid, out_addr, 1, 1) <= 0 { return ERR_BAD_PTR; }
    var row: t40 = net_socket_row(socket_id);
    var rp: t40 = kload(row + NET_SOCK_RX_READ);
    var wp: t40 = kload(row + NET_SOCK_RX_WRITE);
    if rp - wp == 0 { return 0; }
    var word: t40 = kload(kload(row + NET_SOCK_RX_BASE) + rp);
    user_store_word(pid, out_addr, word);
    kstore(row + NET_SOCK_RX_READ, net_ring_next(rp, NET_RX_CAPACITY));
    return 1;
}

fn vfs_unlink(pid: t40, path_addr: t40) -> t40 {
    var namespace_id: t40 = process_namespace_for_pid(pid);
    var inode: t40 = vfs_lookup(namespace_id, path_addr);
    if inode < 0 { return inode; }
    var row: t40 = inode_addr(inode);
    if kload(row + INODE_KIND) - KIND_DIR == 0 { return ERR_IS_DIR; }
    var links: t40 = kload(row + INODE_LINKS) - 1;
    var dirent_records: t40 = 0;
    var count_slot: t40 = 0;
    var count_limit: t40 = vfs_dirent_limit();
    while count_limit - count_slot > 0 {
        var count_row: t40 = dirent_addr(count_slot);
        if kload(count_row + DIRENT_CHILD) - inode == 0 {
            if kload(count_row + DIRENT_NAMESPACE) - namespace_id == 0 {
                dirent_records = dirent_records + 2;
            }
        }
        count_slot = count_slot + 1;
    }
    if log_capacity_for(dirent_records + 3) <= 0 {
        return ERR_NO_SPACE;
    }
    var txid: t40 = log_begin();
    var logged: t40 = log_write(txid, row + INODE_LINKS,
                                kload(row + INODE_LINKS), links);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var slot: t40 = 0;
    var dirent_limit: t40 = vfs_dirent_limit();
    while dirent_limit - slot > 0 {
        var dr: t40 = dirent_addr(slot);
        if kload(dr + DIRENT_CHILD) - inode == 0 {
            if kload(dr + DIRENT_NAMESPACE) - namespace_id == 0 {
                logged = log_write(txid, dr + DIRENT_CHILD,
                                   kload(dr + DIRENT_CHILD), 0);
                if logged < 0 {
                    log_abort(txid);
                    return logged;
                }
                logged = log_write(txid, dr + DIRENT_VERSION,
                                   kload(dr + DIRENT_VERSION), 0);
                if logged < 0 {
                    log_abort(txid);
                    return logged;
                }
            }
        }
        slot = slot + 1;
    }
    logged = log_write(txid, row + INODE_MTIME,
                       kload(row + INODE_MTIME), kload(KERNEL_TICK_ADDR));
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var commit_lsn: t40 = log_commit(txid);
    if commit_lsn < 0 { return commit_lsn; }
    var tracked: t40 = inode_track_required_lsn(inode, commit_lsn);
    if tracked < 0 { return tracked; }
    // Open descriptors retain the inode and its extents.  With no matching
    // descriptor this best-effort pass reclaims immediately; otherwise the
    // row remains a links=0 orphan for close/process/mount cleanup.
    vfs_reclaim_pending();
    return 1;
}

fn vfs_directory_empty(namespace_id: t40, inode: t40) -> t40 {
    var slot: t40 = 0;
    var limit: t40 = vfs_dirent_limit();
    while limit - slot > 0 {
        var row: t40 = dirent_addr(slot);
        if kload(row + DIRENT_CHILD) > 0 {
            if kload(row + DIRENT_NAMESPACE) - namespace_id == 0 {
                if kload(row + DIRENT_PARENT) - inode == 0 {
                    return 0;
                }
            }
        }
        slot = slot + 1;
    }
    return 1;
}

// Return zero when candidate is the source directory or one of its
// descendants. Parent links are stored in INODE_FLAGS, so a moved subtree
// needs only the source inode's parent metadata rewritten.
fn vfs_rename_destination_safe(source_inode: t40, candidate: t40) -> t40 {
    var cursor: t40 = candidate;
    var steps: t40 = 0;
    while VFS_MAX_INODES - steps > 0 {
        if cursor - source_inode == 0 {
            return 0;
        }
        if cursor <= 0 {
            return 1;
        }
        if cursor - VFS_MAX_INODES >= 0 {
            return 0;
        }
        cursor = vfs_parent_of(cursor);
        steps = steps + 1;
    }
    return 0;
}

// Rename a file or directory without allocating a new inode. Source and
// destination dirent changes, destination replacement tombstoning, and the
// moved inode's parent metadata are committed in one redo transaction. Open
// descriptors retain a replaced inode until final close, while a moved source
// keeps its generation and extent map unchanged.
fn vfs_rename(pid: t40, old_path_addr: t40, new_path_addr: t40) -> t40 {
    var namespace_id: t40 = process_namespace_for_pid(pid);

    // Resolve and classify the source before handling the root path.
    var source_inode: t40 = vfs_lookup(namespace_id, old_path_addr);
    if source_inode < 0 {
        return source_inode;
    }
    var source_row: t40 = inode_addr(source_inode);
    var source_kind: t40 = kload(source_row + INODE_KIND);
    if source_kind - KIND_FILE != 0 {
        if source_kind - KIND_DIR != 0 {
            return ERR_INVALID;
        }
        if source_inode == 0 {
            return ERR_IS_DIR;
        }
    }

    var source_parent: t40 = vfs_path_parent(namespace_id, old_path_addr);
    if source_parent < 0 {
        return source_parent;
    }
    if kload(inode_addr(source_parent) + INODE_KIND) - KIND_DIR != 0 {
        return ERR_NOT_DIR;
    }
    var source_start: t40 = vfs_leaf_start(old_path_addr);
    if source_start <= 0 {
        return ERR_INVALID;
    }
    var source_len: t40 = vfs_leaf_len(source_start);
    if source_len <= 0 {
        return ERR_INVALID;
    }
    if source_len - VFS_MAX_NAME_WORDS > 0 {
        return ERR_INVALID;
    }
    var source_hash: t40 = vfs_component_hash(source_start, source_len);
    var source_slot: t40 = vfs_find_child_slot(
        namespace_id, source_parent, source_start, source_len, source_hash);
    if source_slot < 0 {
        return source_slot;
    }
    var source_dirent: t40 = dirent_addr(source_slot);
    if kload(source_dirent + DIRENT_CHILD) - source_inode != 0 {
        return ERR_NOT_FOUND;
    }

    // A byte-for-byte identical pathname is explicitly a no-op, but still
    // required the source to resolve and pass the regular-file checks above.
    if vfs_paths_equal(old_path_addr, new_path_addr) > 0 {
        return 1;
    }

    var destination_parent: t40 = vfs_path_parent(namespace_id, new_path_addr);
    if destination_parent < 0 {
        return destination_parent;
    }
    if kload(inode_addr(destination_parent) + INODE_KIND) - KIND_DIR != 0 {
        return ERR_NOT_DIR;
    }
    var destination_start: t40 = vfs_leaf_start(new_path_addr);
    if destination_start <= 0 {
        return ERR_INVALID;
    }
    var destination_len: t40 = vfs_leaf_len(destination_start);
    if destination_len <= 0 {
        return ERR_INVALID;
    }
    if destination_len - VFS_MAX_NAME_WORDS > 0 {
        return ERR_INVALID;
    }
    var destination_hash: t40 = vfs_component_hash(destination_start,
                                                     destination_len);
    var destination_inode: t40 = vfs_find_child(
        namespace_id, destination_parent, destination_start, destination_len,
        destination_hash);
    if destination_inode - source_inode == 0 {
        // This also covers equivalent aliases such as "/a" and "/a/".
        return 1;
    }

    var destination_kind: t40 = KIND_FREE;
    var destination_row: t40 = 0;
    var destination_slot: t40 = ERR_NOT_FOUND;
    if destination_inode >= 0 {
        destination_row = inode_addr(destination_inode);
        destination_kind = kload(destination_row + INODE_KIND);
        if source_kind - KIND_FILE == 0 {
            if destination_kind - KIND_FILE != 0 {
                return ERR_IS_DIR;
            }
        } else {
            if destination_kind - KIND_DIR != 0 {
                return ERR_NOT_DIR;
            }
            if vfs_directory_empty(namespace_id, destination_inode) <= 0 {
                return ERR_EXISTS;
            }
        }
        destination_slot = vfs_find_child_slot(
            namespace_id, destination_parent, destination_start,
            destination_len, destination_hash);
        if destination_slot < 0 {
            return ERR_NOT_FOUND;
        }
    }

    if source_kind - KIND_DIR == 0 {
        if vfs_rename_destination_safe(source_inode, destination_parent) <= 0 {
            return ERR_INVALID;
        }
    }

    // Include every name word that may contain old data so shortening a name
    // cannot leave stale payload visible after recovery. The final WAL commit
    // record is included in this capacity preflight.
    var name_words: t40 = source_len;
    if destination_len - name_words > 0 {
        name_words = destination_len;
    }
    var record_count: t40 = 7 + name_words;
    if destination_inode >= 0 {
        // Destination dirent child/version plus replaced inode link/mtime.
        record_count = record_count + 4;
    }
    if log_capacity_for(record_count + 1) <= 0 {
        return ERR_NO_SPACE;
    }

    var txid: t40 = log_begin();
    var logged: t40 = 1;
    if destination_inode >= 0 {
        // Tombstone only the namespace edge. The replaced inode's extents and
        // generation remain valid for open descriptors until close-triggered
        // reclamation observes links=0 and no matching FD generations.
        var destination_dirent: t40 = dirent_addr(destination_slot);
        logged = log_write(txid, destination_dirent + DIRENT_CHILD,
                           kload(destination_dirent + DIRENT_CHILD), 0);
        if logged < 0 { log_abort(txid); return logged; }
        logged = log_write(txid, destination_dirent + DIRENT_VERSION,
                           kload(destination_dirent + DIRENT_VERSION), 0);
        if logged < 0 { log_abort(txid); return logged; }
        var destination_links: t40 = kload(destination_row + INODE_LINKS) - 1;
        logged = log_write(txid, destination_row + INODE_LINKS,
                           kload(destination_row + INODE_LINKS),
                           destination_links);
        if logged < 0 { log_abort(txid); return logged; }
        logged = log_write(txid, destination_row + INODE_MTIME,
                           kload(destination_row + INODE_MTIME),
                           kload(KERNEL_TICK_ADDR));
        if logged < 0 { log_abort(txid); return logged; }
    }
    logged = log_write(txid, source_dirent + DIRENT_PARENT,
                                kload(source_dirent + DIRENT_PARENT),
                                destination_parent);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, source_dirent + DIRENT_HASH,
                       kload(source_dirent + DIRENT_HASH), destination_hash);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, source_dirent + DIRENT_NAME_LEN,
                       kload(source_dirent + DIRENT_NAME_LEN),
                       destination_len);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var old_version: t40 = kload(source_dirent + DIRENT_VERSION);
    var new_version: t40 = old_version + 1;
    if new_version <= 0 {
        new_version = 1;
    }
    logged = log_write(txid, source_dirent + DIRENT_VERSION, old_version,
                       new_version);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var name_index: t40 = 0;
    while name_words - name_index > 0 {
        var desired_name: t40 = 0;
        if destination_len - name_index > 0 {
            desired_name = kload(destination_start + name_index);
        }
        var name_addr: t40 = dirent_name_addr(source_slot) + name_index;
        logged = log_write(txid, name_addr, kload(name_addr), desired_name);
        if logged < 0 {
            log_abort(txid);
            return logged;
        }
        name_index = name_index + 1;
    }
    logged = log_write(txid, source_row + INODE_FLAGS,
                       kload(source_row + INODE_FLAGS), destination_parent);
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, source_row + INODE_CTIME,
                       kload(source_row + INODE_CTIME),
                       kload(KERNEL_TICK_ADDR));
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    logged = log_write(txid, source_row + INODE_MTIME,
                       kload(source_row + INODE_MTIME),
                       kload(KERNEL_TICK_ADDR));
    if logged < 0 {
        log_abort(txid);
        return logged;
    }
    var commit_lsn: t40 = log_commit(txid);
    if commit_lsn < 0 {
        log_abort(txid);
        return commit_lsn;
    }
    var tracked: t40 = inode_track_required_lsn(source_inode, commit_lsn);
    if tracked < 0 {
        return tracked;
    }
    if destination_inode >= 0 {
        // Best-effort physical reclamation is deferred by open FD generations;
        // a WAL-full pass leaves the replaced inode as a durable orphan.
        vfs_reclaim_pending();
    }
    return 1;
}

fn kernel_ps_user(pid: t40, out_addr: t40, max_entries: t40) -> t40 {
    if max_entries < 0 {
        return ERR_BAD_PTR;
    }
    // The user window is 6,000 words wide and each record is five words.
    // Bound the count before multiplying so a hostile T40 value cannot wrap
    // into a small, apparently valid span.
    if max_entries - 1200 > 0 {
        return ERR_BAD_PTR;
    }
    if max_entries > 0 {
        // Validate the complete output span before publishing any process
        // record.  A malformed pointer must be an error, never a partial
        // successful snapshot with a silently short payload.
        if user_validate_span(pid, out_addr, max_entries * 5, 1) <= 0 {
            return ERR_BAD_PTR;
        }
    }
    var written: t40 = 0;
    var slot: t40 = 0;
    while PROCESS_MAX - slot > 0 {
        var row: t40 = process_addr(slot);
        var state: t40 = kload(row + PROC_STATE);
        if state > 0 {
            if written - max_entries < 0 {
                var base: t40 = out_addr + written * 5;
                if user_store_word(pid, base, kload(row + PROC_PID)) < 0 { return written; }
                if user_store_word(pid, base + 1, state) < 0 { return written; }
                if user_store_word(pid, base + 2, kload(row + PROC_PRIORITY)) < 0 { return written; }
                var qid: t40 = kload(row + PROC_QUOTA);
                if user_store_word(pid, base + 3, quota_remaining(qid)) < 0 { return written; }
                if user_store_word(pid, base + 4, kload(row + PROC_NAMESPACE)) < 0 { return written; }
                written = written + 1;
            }
        }
        slot = slot + 1;
    }
    return written;
}

fn kernel_init() -> t40 {
    kstore(KERNEL_BOOTED_ADDR, 0);
    kstore(BUFFER_CLOCK_HAND_ADDR, 0);
    kclear(NS_DIRTY_VERSION_BASE, NS_DIRTY_VERSION_WORDS);
    kclear(WAL_SNAPSHOT_BASE, WAL_SNAPSHOT_MAX * WAL_SNAPSHOT_WORDS);
    bootstrap_allocator_init();
    buffer_pool_init();
    wal_init();
    rel_store_init();
    attr_store_init();
    scheduler_init();
    process_table_init();
    namespace_table_init();
    pte_table_init();
    process_create(0, 1, 0, 1, 0, 0);
    process_set_caps(0, APP_CAP_SYSTEM);
    var mounted: t40 = vfs_mount(0, 0);
    if mounted < 0 { return mounted; }
    // Tag the kernel process in attr_store so rel_join_proc_attr works from boot.
    attr_insert(1, ATTR_TYPE_PROCESS, ATTR_KEY_CREATED_TXID, 0);
    attr_insert(1, ATTR_TYPE_PROCESS, ATTR_KEY_DESIRED_STATE, PROC_RUNNABLE);
    app_registry_init();
    app_registry_autoload_bin();
    ipc_init();
    net_init();
    kclear(FB_STATE_BASE, FB_STATE_WORDS);
    kstore(FB_STATE_BASE + FB_FRONT_INDEX, 0);
    window_table_init();
    kstore(CURRENT_CONTEXT_ADDR, 0);
    kstore(CURRENT_PID_ADDR, 1);
    kstore(KERNEL_BOOTED_ADDR, 1);
    unsafe { csr_write(timer_reload, KERNEL_TIMER_RELOAD); }
    unsafe { csr_write(timer_counter, KERNEL_TIMER_RELOAD); }
    unsafe { csr_write(timer_enable, 1); }
    return 1;
}
