#version 450

layout (local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Gate {
    float gate[];
};

layout(set = 0, binding = 1) readonly buffer Up {
    float up[];
};

layout(set = 0, binding = 2) writeonly buffer Output {
    float activated[];
};

layout(push_constant) uniform PushConstants {
    int num_elements;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.num_elements) {
        return;
    }

    float g = gate[i];
    float u = up[i];
    
    // SiLU gate for Qwen's SwiGLU MLP: x * sigmoid(x)
    float gelu = g * (1.0 / (1.0 + exp(-g)));
    
    activated[i] = gelu * u;
}
