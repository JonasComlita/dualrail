fn print_bool(b: t40) -> t40 {
    match b {
        zero => { print_int(0); }
        pos => { print_int(1); }
        neg => { print_int(0); }
    }
    return 0;
}

fn main() -> t40 {
    // 1. Create a dummy tokens vector & source string
    var tokens: t40 = tcl_token_stream_new();
    var src: t40 = vec_new();

    // src: "x foo y Point a b"
    vec_push(src, 120); // 'x'
    vec_push(src, 32);  // ' '
    vec_push(src, 102); // 'f'
    vec_push(src, 111); // 'o'
    vec_push(src, 111); // 'o'
    vec_push(src, 32);  // ' '
    vec_push(src, 121); // 'y'
    vec_push(src, 32);  // ' '
    vec_push(src, 80);  // 'P'
    vec_push(src, 111); // 'o'
    vec_push(src, 105); // 'i'
    vec_push(src, 110); // 'n'
    vec_push(src, 116); // 't'
    vec_push(src, 32);  // ' '
    vec_push(src, 97);  // 'a'
    vec_push(src, 32);  // ' '
    vec_push(src, 98);  // 'b'

    // Emit tokens:
    tcl_token_emit(tokens, TCL_TK_IDENT, 0, 1);  // Token 0: x
    tcl_token_emit(tokens, TCL_TK_IDENT, 2, 3);  // Token 1: foo
    tcl_token_emit(tokens, TCL_TK_IDENT, 6, 1);  // Token 2: y
    tcl_token_emit(tokens, TCL_TK_IDENT, 8, 5);  // Token 3: Point
    tcl_token_emit(tokens, TCL_TK_IDENT, 14, 1); // Token 4: a
    tcl_token_emit(tokens, TCL_TK_IDENT, 16, 1); // Token 5: b

    // 2. Create type checker context
    var ctx: t40 = tcl_type_ctx_new(tokens, src);

    // 3. Create AST master block
    var ast: t40 = tcl_ast_new(0);

    // Create environment
    var env: t40 = tcl_env_new();
    var fn_env: t40 = tcl_env_push(env);

    // 4. Test: infer number literal
    var num_expr: t40 = tcl_expr_new(ast, TCL_EXPR_NUMBER, 0, 0, 0, 0);
    var t_num: t40 = tcl_infer_expr(ctx, fn_env, ast, num_expr);
    print_int(tcl_type_kind(ast, t_num)); // Should print 2 (TCL_TYPE_NUMERIC)
    newline();
    print_int(tcl_type_extra(ast, t_num)); // Should print 4 (width of t40)
    newline();

    // 5. Test: unbound variable reference
    var var_expr: t40 = tcl_expr_new(ast, TCL_EXPR_NAME, 0, 0, 0, 0); // Reference to token 0 (x)
    var t_var: t40 = tcl_infer_expr(ctx, fn_env, ast, var_expr);
    print_int(tcl_type_kind(ast, t_var)); // Should print 0 (TCL_TYPE_UNKNOWN)
    newline();
    print_int(tcl_type_ctx_errors(ctx)); // Should print 1 (unbound error)
    newline();

    // Reset error count for further tests
    unsafe { store(ctx + 2, 0); }

    // 6. Test: bound variable reference
    var t_t40: t40 = tcl_type_new(ast, TCL_TYPE_NUMERIC, 0, 4, 0);
    var scheme_x: t40 = tcl_generalize(ctx, ast, t_t40);
    tcl_env_insert(fn_env, 0, scheme_x); // Bind Token 0 (x) -> t40
    
    var t_var2: t40 = tcl_infer_expr(ctx, fn_env, ast, var_expr);
    print_int(tcl_type_kind(ast, t_var2)); // Should print 2 (TCL_TYPE_NUMERIC)
    newline();
    print_int(tcl_type_ctx_errors(ctx)); // Should print 0
    newline();

    // 7. Test: struct definition and field access
    var fields_vec: t40 = vec_new();
    vec_push(fields_vec, 4); // 'a' (token 4)
    vec_push(fields_vec, t_t40);
    vec_push(fields_vec, 5); // 'b' (token 5)
    vec_push(fields_vec, t_t40);
    
    var struct_id: t40 = tcl_struct_new(ast, 3, fields_vec, 1); // struct Point (token 3)
    vec_push(tcl_ast_structs(ast), struct_id);

    // Create variable y with type Point struct
    var t_struct: t40 = tcl_type_new(ast, TCL_TYPE_STRUCT, 0, 0, 3);
    var scheme_y: t40 = tcl_generalize(ctx, ast, t_struct);
    tcl_env_insert(fn_env, 2, scheme_y); // Bind Token 2 (y) -> Point struct

    // Field access expression: y.a (y is Token 2, field name is Token 4 'a')
    var y_expr: t40 = tcl_expr_new(ast, TCL_EXPR_NAME, 2, 0, 0, 0);
    var field_expr: t40 = tcl_expr_new(ast, TCL_EXPR_FIELD, 4, y_expr, 0, 0);
    var t_field: t40 = tcl_infer_expr(ctx, fn_env, ast, field_expr);
    print_int(tcl_type_kind(ast, t_field)); // Should print 2 (TCL_TYPE_NUMERIC)
    newline();
    print_int(tcl_type_extra(ast, t_field)); // Should print 4
    newline();
    print_int(tcl_type_ctx_errors(ctx)); // Should print 0
    newline();

    // Clean up
    tcl_env_pop(fn_env);
    tcl_ast_free(ast);
    tcl_type_ctx_free(ctx);
    tcl_token_free(tokens);
    vec_free(src);

    return 0;
}
