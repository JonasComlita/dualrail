    var id: t40 = raw_len / 4 + 1;
    match (cap - raw_len - 4) {
        neg => { data = tcl_ast_vec_grow(arena, raw_len, cap, 4, data); }
        zero => {}
        pos => {}
    }
    unsafe {
        store(data + raw_len, name_token);
        store(data + raw_len + 1, type_id);
        store(data + raw_len + 2, expr_id);
        store(data + raw_len + 3, is_pub);
        store(arena + 1, raw_len + 4);
    }
    return id;
}
fn tcl_const_base(id: t40) -> t40 { return (id - 1) * 4; }
fn tcl_const_name_token(ast: t40, id: t40) -> t40 { var arena: t40 = tcl_ast_const_arena(ast); var base: t40 = tcl_const_base(id); return vec_get(arena, base); }
fn tcl_const_type(ast: t40, id: t40) -> t40 { var arena: t40 = tcl_ast_const_arena(ast); var base: t40 = tcl_const_base(id); return vec_get(arena, base + 1); }
fn tcl_const_expr(ast: t40, id: t40) -> t40 { var arena: t40 = tcl_ast_const_arena(ast); var base: t40 = tcl_const_base(id); return vec_get(arena, base + 2); }
fn tcl_const_is_pub(ast: t40, id: t40) -> t40 { var arena: t40 = tcl_ast_const_arena(ast); var base: t40 = tcl_const_base(id); return vec_get(arena, base + 3); }

// =============================================================================
// Import Node APIs (Slot Size: 2 words)
// =============================================================================
fn tcl_import_new(ast: t40, name_token: t40) -> t40 {
    var arena: t40 = tcl_ast_import_arena(ast);
    var raw_len: t40 = 0;
    var cap: t40 = 0;
    var data: t40 = 0;
    unsafe { data = load(arena); raw_len = load(arena + 1); cap = load(arena + 2); }
    var id: t40 = raw_len / 2 + 1;
    match (cap - raw_len - 2) {
        neg => { data = tcl_ast_vec_grow(arena, raw_len, cap, 2, data); }
        zero => {}
        pos => {}
    }
    unsafe {
        store(data + raw_len, name_token);
        store(data + raw_len + 1, 0);
        store(arena + 1, raw_len + 2);
    }
    return id;
}
fn tcl_import_name_token(ast: t40, id: t40) -> t40 { var arena: t40 = tcl_ast_import_arena(ast); var base: t40 = (id - 1) * 2; return vec_get(arena, base); }
