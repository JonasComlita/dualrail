fn tcl_backend_emit_reg_reg(text: t40, op_kind: t40, rd: t40, r1: t40, r2: t40) -> t40 {
    tcl_backend_append_indent(text);
    match op_kind {
        zero => { tcl_backend_append_add(text); }
        pos => { tcl_backend_append_sub(text); }
        neg => { tcl_backend_append_tcmp(text); }
    }
    tcl_backend_append_reg(text, rd);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_reg(text, r1);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_reg(text, r2);
    tcl_backend_append_newline(text);
    return 0;
}

