fn tcl_backend_used_callee_count(alloc: t40) -> t40 {
    var used: t40 = 0;
    unsafe { used = load(alloc + 3); }
    var len: t40 = vec_len(used);
    var i: t40 = 0;
    var count: t40 = 0;
    var reg: t40 = 0;
    while len - i > 0 {
        reg = vec_get(used, i);
        match (13 - reg) {
            pos => { count = count + 1; }
            zero => {}
            neg => {}
        }
        i = i + 1;
    }
    return count;
}

fn tcl_backend_frame_words(alloc: t40) -> t40 {
    var callee: t40 = tcl_backend_used_callee_count(alloc);
    var spills: t40 = tcl_backend_alloc_spills(alloc);
    return 1 + callee + spills + TCL_BACKEND_LOCAL_WORDS;
}

fn tcl_backend_local_base(alloc: t40) -> t40 {
    var callee: t40 = tcl_backend_used_callee_count(alloc);
    var spills: t40 = tcl_backend_alloc_spills(alloc);
    return 1 + callee + spills;
}

fn tcl_backend_arg_base(vars_box: t40) -> t40 {
    var base: t40 = 0;
    unsafe { base = load(vars_box + 3); }
    return base;
}

fn tcl_backend_call_save_base(vars_box: t40) -> t40 {
    return tcl_backend_arg_base(vars_box) + TCL_BACKEND_ARG_WORDS;
}

fn tcl_backend_var_slot_lookup(vars_box: t40, tokens: t40, src: t40, name_tok: t40) -> t40 {
    var slots: t40 = 0;
    unsafe { slots = load(vars_box); }
    var len: t40 = vec_len(slots);
    var i: t40 = 0;
    var existing_tok: t40 = 0;
    while len - i > 0 {
        existing_tok = vec_get(slots, i);
        match tcl_backend_token_eq(tokens, src, name_tok, existing_tok) {
            pos => { return vec_get(slots, i + 1); }
            zero => {}
            neg => {}
        }
        i = i + 2;
    }
    return 0;
}

fn tcl_backend_var_slot(vars_box: t40, tokens: t40, src: t40, name_tok: t40) -> t40 {
    var slot: t40 = tcl_backend_var_slot_lookup(vars_box, tokens, src, name_tok);
    match slot {
        pos => { return slot; }
        zero => {}
        neg => {}
    }
    var slots: t40 = 0;
    unsafe { slots = load(vars_box); }
    unsafe { slot = load(vars_box + 2); }
    unsafe { store(vars_box + 2, slot + 1); }
    vec_push(slots, name_tok);
    vec_push(slots, slot);
    return slot;
}

fn tcl_backend_spill_offset(alloc: t40, value: t40) -> t40 {
    var slot: t40 = tcl_backend_alloc_spill_slot(alloc, value);
    match slot {
        pos => {}
        zero => { return 0; }
        neg => { return 0; }
    }
    var callee: t40 = tcl_backend_used_callee_count(alloc);
    return callee + slot;
}

fn tcl_backend_emit_callee_saves(text: t40, alloc: t40) -> t40 {
    var used: t40 = 0;
    unsafe { used = load(alloc + 3); }
    var len: t40 = vec_len(used);
    var i: t40 = 0;
    var offset: t40 = 1;
    var reg: t40 = 0;
    while len - i > 0 {
        reg = vec_get(used, i);
        match (13 - reg) {
            pos => {
                tcl_backend_emit_store(text, reg, 26, offset);
                offset = offset + 1;
            }
            zero => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_backend_emit_callee_restores(text: t40, alloc: t40) -> t40 {
    var used: t40 = 0;
    unsafe { used = load(alloc + 3); }
    var len: t40 = vec_len(used);
    var i: t40 = 0;
    var offset: t40 = 1;
    var reg: t40 = 0;
    while len - i > 0 {
        reg = vec_get(used, i);
        match (13 - reg) {
            pos => {
                tcl_backend_emit_load(text, reg, 26, offset);
                offset = offset + 1;
            }
            zero => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_backend_emit_prologue(text: t40, fn_id: t40, alloc: t40) -> t40 {
    var frame: t40 = tcl_backend_frame_words(alloc);
    tcl_backend_append_fn_label(text, fn_id);
    tcl_backend_text_push(text, 58);
    tcl_backend_append_newline(text);
    tcl_backend_emit_mov_imm(text, 24, frame);
    tcl_backend_append_indent(text);
    tcl_backend_append_sub(text);
    tcl_backend_append_sp(text);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_sp(text);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_reg(text, 24);
    tcl_backend_append_newline(text);
    tcl_backend_append_indent(text);
    tcl_backend_append_store(text);
    tcl_backend_append_lr(text);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_sp(text);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_int(text, 0);
    tcl_backend_append_newline(text);
    tcl_backend_emit_callee_saves(text, alloc);
    return 0;
}

fn tcl_backend_emit_epilogue(text: t40, alloc: t40) -> t40 {
    var frame: t40 = tcl_backend_frame_words(alloc);
    tcl_backend_emit_callee_restores(text, alloc);
    tcl_backend_append_indent(text);
    tcl_backend_append_load(text);
    tcl_backend_append_lr(text);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_sp(text);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_int(text, 0);
    tcl_backend_append_newline(text);
    tcl_backend_emit_mov_imm(text, 24, frame);
    tcl_backend_append_indent(text);
    tcl_backend_append_add(text);
    tcl_backend_append_sp(text);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_sp(text);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_reg(text, 24);
    tcl_backend_append_newline(text);
    tcl_backend_append_indent(text);
    tcl_backend_append_ret(text);
    tcl_backend_append_newline(text);
    return 0;
}

fn tcl_backend_token_number(tokens: t40, src: t40, tok: t40) -> t40 {
    match tokens {
        pos => {}
        zero => { return tok; }
        neg => { return tok; }
    }
    match src {
        pos => {}
        zero => { return tcl_token_len(tokens, tok); }
        neg => { return tcl_token_len(tokens, tok); }
    }
    var start: t40 = tcl_token_start(tokens, tok);
    var len: t40 = tcl_token_len(tokens, tok);
    var i: t40 = 0;
    var value: t40 = 0;
    var c: t40 = 0;
    while len - i > 0 {
        unsafe { c = load(src + start + i); }
        value = value * 10 + (c - 48);
        i = i + 1;
    }
    return value;
}

fn tcl_backend_token_kind_or(tokens: t40, tok: t40, fallback: t40) -> t40 {
    match tokens {
        pos => { return tcl_token_kind(tokens, tok); }
        zero => { return fallback; }
        neg => { return fallback; }
    }
}

fn tcl_backend_reg_or_zero(alloc: t40, value: t40) -> t40 {
    var reg: t40 = tcl_backend_alloc_register(alloc, value);
    match reg {
        pos => { return reg; }
        zero => { return 0; }
        neg => { return 0; }
    }
}

fn tcl_backend_load_value_reg(text: t40, alloc: t40, value: t40, scratch: t40) -> t40 {
    var reg: t40 = tcl_backend_alloc_register(alloc, value);
    match reg {
        pos => { return reg; }
        zero => {}
        neg => {}
    }
    var offset: t40 = tcl_backend_spill_offset(alloc, value);
    match offset {
        pos => {
            tcl_backend_emit_load(text, scratch, 26, offset);
            return scratch;
        }
        zero => { return 0; }
        neg => { return 0; }
    }
}

fn tcl_backend_dest_reg(text: t40, alloc: t40, value: t40, scratch: t40) -> t40 {
    var reg: t40 = tcl_backend_alloc_register(alloc, value);
    match reg {
        pos => { return reg; }
        zero => {}
        neg => {}
    }
    match tcl_backend_alloc_spill_slot(alloc, value) {
        pos => { return scratch; }
        zero => { return 0; }
        neg => { return 0; }
    }
}

fn tcl_backend_store_spilled_dest(text: t40, alloc: t40, value: t40, reg: t40) -> t40 {
    var offset: t40 = tcl_backend_spill_offset(alloc, value);
    match offset {
        pos => { tcl_backend_emit_store(text, reg, 26, offset); }
        zero => {}
        neg => {}
    }
    return 0;
}

fn tcl_backend_emit_call_args(text: t40, vars_box: t40, count: t40) -> t40 {
    var base: t40 = tcl_backend_arg_base(vars_box);
    var i: t40 = 0;
    while count - i > 0 {
        match (6 - i) {
            pos => { tcl_backend_emit_load(text, 13 + i, 26, base + i); }
            zero => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_backend_emit_save_call_regs(text: t40, vars_box: t40) -> t40 {
    var base: t40 = tcl_backend_call_save_base(vars_box);
    var i: t40 = 0;
    while TCL_BACKEND_CALL_SAVE_WORDS - i > 0 {
        tcl_backend_emit_store(text, 13 + i, 26, base + i);
        i = i + 1;
    }
    return 0;
}

fn tcl_backend_emit_restore_call_regs(text: t40, vars_box: t40, skip_reg: t40) -> t40 {
    var base: t40 = tcl_backend_call_save_base(vars_box);
    var i: t40 = 0;
    var reg: t40 = 0;
    while TCL_BACKEND_CALL_SAVE_WORDS - i > 0 {
        reg = 13 + i;
        match reg - skip_reg {
            zero => {}
            pos => { tcl_backend_emit_load(text, reg, 26, base + i); }
            neg => { tcl_backend_emit_load(text, reg, 26, base + i); }
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_backend_emit_instr(text: t40, instrs: t40, i: t40, alloc: t40, tokens: t40, vars_box: t40, ast: t40, fn_id: t40) -> t40 {
    var op: t40 = vec_get(instrs, i);
    var dest: t40 = vec_get(instrs, i + 1);
    var src1: t40 = vec_get(instrs, i + 2);
    var src2: t40 = vec_get(instrs, i + 3);
    var type_id: t40 = vec_get(instrs, i + 4);
    var rd: t40 = 0;
    var r1: t40 = 0;
    var r2: t40 = 0;
    var imm: t40 = 0;
    var kind: t40 = 0;
    var root: t40 = 0;
    var mapped: t40 = 0;
    var src: t40 = 0;
    var slot: t40 = 0;
    var param_ord: t40 = 0;
    var call_id: t40 = 0;
    var const_id: t40 = 0;
    var field_off: t40 = 0;
    var arg_base: t40 = 0;
    unsafe { src = load(vars_box + 1); }

    match (op - TCL_IR_NOP) {
        zero => { return 0; }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_CONST) {
        zero => {
            rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
            imm = tcl_backend_token_number(tokens, src, src1);
            tcl_backend_emit_mov_imm(text, rd, imm);
            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_LOAD_NAME) {
        zero => {
            slot = tcl_backend_var_slot_lookup(vars_box, tokens, src, src1);
            match slot {
                pos => {
                    rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
                    tcl_backend_emit_load(text, rd, 26, slot);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                }
                zero => {
                    rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
                    param_ord = tcl_backend_param_ordinal(ast, tokens, src, fn_id, src1);
                    match param_ord {
                        pos => {
                            slot = tcl_backend_var_slot(vars_box, tokens, src, src1);
                            tcl_backend_emit_copy(text, rd, 12 + param_ord);
                            tcl_backend_emit_store(text, rd, 26, slot);
                            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                            return 0;
                        }
                        zero => {}
                        neg => {}
                    }
                    const_id = tcl_backend_find_const_by_token(ast, tokens, src, src1);
                    match const_id {
                        pos => { tcl_backend_emit_mov_imm(text, rd, tcl_backend_eval_const_expr(ast, tokens, src, tcl_const_expr(ast, const_id))); }
                        zero => {
                            slot = tcl_backend_var_slot(vars_box, tokens, src, src1);
                            tcl_backend_emit_mov_imm(text, rd, 0);
                            tcl_backend_emit_store(text, rd, 26, slot);
                        }
                        neg => {
                            slot = tcl_backend_var_slot(vars_box, tokens, src, src1);
                            tcl_backend_emit_mov_imm(text, rd, 0);
                            tcl_backend_emit_store(text, rd, 26, slot);
                        }
                    }
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                }
                neg => {
                    rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
                    param_ord = tcl_backend_param_ordinal(ast, tokens, src, fn_id, src1);
                    match param_ord {
                        pos => {
                            slot = tcl_backend_var_slot(vars_box, tokens, src, src1);
                            tcl_backend_emit_copy(text, rd, 12 + param_ord);
                            tcl_backend_emit_store(text, rd, 26, slot);
                            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                            return 0;
                        }
                        zero => {}
                        neg => {}
                    }
                    const_id = tcl_backend_find_const_by_token(ast, tokens, src, src1);
                    match const_id {
                        pos => { tcl_backend_emit_mov_imm(text, rd, tcl_backend_eval_const_expr(ast, tokens, src, tcl_const_expr(ast, const_id))); }
                        zero => {
                            slot = tcl_backend_var_slot(vars_box, tokens, src, src1);
                            tcl_backend_emit_mov_imm(text, rd, 0);
                            tcl_backend_emit_store(text, rd, 26, slot);
                        }
                        neg => {
                            slot = tcl_backend_var_slot(vars_box, tokens, src, src1);
                            tcl_backend_emit_mov_imm(text, rd, 0);
                            tcl_backend_emit_store(text, rd, 26, slot);
                        }
                    }
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                }
            }
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_STORE_NAME) {
        zero => {
            slot = tcl_backend_var_slot(vars_box, tokens, src, src1);
            r1 = tcl_backend_load_value_reg(text, alloc, src2, TCL_BACKEND_SPILL_REG_A);
            tcl_backend_emit_store(text, r1, 26, slot);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_BINARY) {
        zero => {
            rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
            r1 = tcl_backend_load_value_reg(text, alloc, src1, TCL_BACKEND_SPILL_REG_A);
            r2 = tcl_backend_load_value_reg(text, alloc, src2, TCL_BACKEND_SPILL_REG_B);
            kind = tcl_backend_token_kind_or(tokens, type_id, TCL_TK_PLUS);
            match (kind - TCL_TK_MINUS) {
                zero => { tcl_backend_emit_reg_reg(text, 1, rd, r1, r2); tcl_backend_store_spilled_dest(text, alloc, dest, rd); return 0; }
                pos => {}
                neg => {}
            }
            match (kind - TCL_TK_STAR) {
                zero => {
                    tcl_backend_append_indent(text);
                    tcl_backend_append_mul(text);
                    tcl_backend_append_reg(text, rd);
                    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
                    tcl_backend_append_reg(text, r1);
                    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
                    tcl_backend_append_reg(text, r2);
                    tcl_backend_append_newline(text);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                pos => {}
                neg => {}
            }
            match (kind - TCL_TK_SLASH) {
                zero => {
                    tcl_backend_append_indent(text);
                    tcl_backend_append_div(text);
                    tcl_backend_append_reg(text, rd);
                    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
                    tcl_backend_append_reg(text, r1);
                    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
                    tcl_backend_append_reg(text, r2);
                    tcl_backend_append_newline(text);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                pos => {}
                neg => {}
            }
            match (kind - TCL_TK_LESS) {
                zero => { tcl_backend_emit_reg_reg(text, 0 - 1, rd, r1, r2); tcl_backend_store_spilled_dest(text, alloc, dest, rd); return 0; }
                pos => {}
                neg => {}
            }
            match (kind - TCL_TK_GREATER) {
                zero => { tcl_backend_emit_reg_reg(text, 0 - 1, rd, r1, r2); tcl_backend_store_spilled_dest(text, alloc, dest, rd); return 0; }
                pos => {}
                neg => {}
            }
            tcl_backend_emit_reg_reg(text, 0, rd, r1, r2);
            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_UNARY) {
        zero => {
            rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
            r1 = tcl_backend_load_value_reg(text, alloc, src1, TCL_BACKEND_SPILL_REG_A);
            kind = tcl_backend_token_kind_or(tokens, src2, TCL_TK_AMP);
            match (kind - TCL_TK_STAR) {
                zero => { tcl_backend_emit_load(text, rd, r1, 0); tcl_backend_store_spilled_dest(text, alloc, dest, rd); return 0; }
                pos => {}
                neg => {}
            }
            tcl_backend_emit_copy(text, rd, r1);
            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_ARG) {
        zero => {
            arg_base = tcl_backend_arg_base(vars_box);
            r1 = tcl_backend_load_value_reg(text, alloc, src1, TCL_BACKEND_SPILL_REG_A);
            tcl_backend_emit_store(text, r1, 26, arg_base + src2);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_FIELD) {
        zero => {
            rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
            r1 = tcl_backend_load_value_reg(text, alloc, src1, TCL_BACKEND_SPILL_REG_A);
            field_off = 0;
            match tcl_backend_token_len_is(tokens, src2, 1) {
                pos => {
                    field_off = tcl_backend_token_char(tokens, src, src2, 0) - 97;
                }
                zero => {}
                neg => {}
            }
            tcl_backend_emit_load(text, rd, r1, field_off);
            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_INDEX) {
        zero => {
            rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
            r1 = tcl_backend_load_value_reg(text, alloc, src1, TCL_BACKEND_SPILL_REG_A);
            r2 = tcl_backend_load_value_reg(text, alloc, src2, TCL_BACKEND_SPILL_REG_B);
            tcl_backend_emit_reg_reg(text, 0, TCL_BACKEND_SPILL_REG_A, r1, r2);
            tcl_backend_emit_load(text, rd, TCL_BACKEND_SPILL_REG_A, 0);
            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_STORE_INDEX) {
        zero => {
            r1 = tcl_backend_load_value_reg(text, alloc, src1, TCL_BACKEND_SPILL_REG_A);
            r2 = tcl_backend_load_value_reg(text, alloc, src2, TCL_BACKEND_SPILL_REG_B);
            tcl_backend_emit_reg_reg(text, 0, TCL_BACKEND_SPILL_REG_B, r1, r2);
            rd = tcl_backend_load_value_reg(text, alloc, type_id, TCL_BACKEND_SPILL_REG_A);
            tcl_backend_emit_store(text, rd, TCL_BACKEND_SPILL_REG_B, 0);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_ALLOC) {
        zero => {
            rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
            tcl_backend_emit_mov_imm(text, 13, src2);
            tcl_backend_append_indent(text);
            tcl_backend_append_syscall(text);
            tcl_backend_append_int(text, 19);
            tcl_backend_append_newline(text);
            tcl_backend_emit_copy(text, rd, 13);
            arg_base = tcl_backend_arg_base(vars_box);
            imm = 0;
            while src2 - imm > 0 {
                r1 = TCL_BACKEND_SPILL_REG_B;
                tcl_backend_emit_load(text, r1, 26, arg_base + imm);
                tcl_backend_emit_store(text, r1, rd, imm);
                imm = imm + 1;
            }
            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_CALL) {
        zero => {
            rd = tcl_backend_dest_reg(text, alloc, dest, TCL_BACKEND_SPILL_REG_A);
            tcl_backend_emit_save_call_regs(text, vars_box);
            tcl_backend_emit_call_args(text, vars_box, src2);
            match tcl_backend_is_sys_write_int(tokens, src, src1) {
                pos => {
                    tcl_backend_emit_copy(text, 1, 13);
                    tcl_backend_append_indent(text);
                    tcl_backend_append_syscall(text);
                    tcl_backend_append_int(text, 1);
                    tcl_backend_append_newline(text);
                    tcl_backend_emit_copy(text, rd, 13);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            match tcl_backend_is_sys_write_char(tokens, src, src1) {
                pos => {
                    tcl_backend_emit_copy(text, 1, 13);
                    tcl_backend_append_indent(text);
                    tcl_backend_append_syscall(text);
                    tcl_backend_append_int(text, 22);
                    tcl_backend_append_newline(text);
                    tcl_backend_emit_copy(text, rd, 13);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            match tcl_backend_is_sys_newline(tokens, src, src1) {
                pos => {
                    tcl_backend_append_indent(text);
                    tcl_backend_append_syscall(text);
                    tcl_backend_append_int(text, 2);
                    tcl_backend_append_newline(text);
                    tcl_backend_emit_copy(text, rd, 13);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            match tcl_backend_is_sys_sbrk(tokens, src, src1) {
                pos => {
                    tcl_backend_append_indent(text);
                    tcl_backend_append_syscall(text);
                    tcl_backend_append_int(text, 19);
                    tcl_backend_append_newline(text);
                    tcl_backend_emit_copy(text, rd, 13);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            match tcl_backend_is_load_intrinsic(tokens, src, src1) {
                pos => {
                    tcl_backend_emit_load(text, rd, 13, 0);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            match tcl_backend_is_store_intrinsic(tokens, src, src1) {
                pos => {
                    tcl_backend_emit_store(text, 14, 13, 0);
                    tcl_backend_emit_copy(text, rd, 13);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            match tcl_backend_is_shared_alloc(tokens, src, src1) {
                pos => {
                    tcl_backend_emit_copy(text, TCL_BACKEND_SPILL_REG_A, 13);
                    tcl_backend_emit_mov_imm(text, 13, 1);
                    tcl_backend_append_indent(text);
                    tcl_backend_append_syscall(text);
                    tcl_backend_append_int(text, 19);
                    tcl_backend_append_newline(text);
                    tcl_backend_emit_store(text, TCL_BACKEND_SPILL_REG_A, 13, 0);
                    tcl_backend_emit_copy(text, rd, 13);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            match tcl_backend_is_atomic_load(tokens, src, src1) {
                pos => {
                    tcl_backend_emit_load(text, rd, 13, 0);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            match tcl_backend_is_atomic_store(tokens, src, src1) {
                pos => {
                    tcl_backend_emit_store(text, 14, 13, 0);
                    tcl_backend_emit_copy(text, rd, 14);
                    tcl_backend_emit_restore_call_regs(text, vars_box, rd);
                    tcl_backend_store_spilled_dest(text, alloc, dest, rd);
                    return 0;
                }
                zero => {}
                neg => {}
            }
            tcl_backend_append_indent(text);
            tcl_backend_append_call(text);
            call_id = tcl_backend_find_function_by_token(ast, tokens, src, src1);
            match call_id {
                pos => { tcl_backend_append_fn_label(text, call_id); }
                zero => { tcl_backend_append_fn_label(text, src1); }
                neg => { tcl_backend_append_fn_label(text, src1); }
            }
            tcl_backend_append_newline(text);
            tcl_backend_emit_copy(text, rd, 13);
            tcl_backend_emit_restore_call_regs(text, vars_box, rd);
            tcl_backend_store_spilled_dest(text, alloc, dest, rd);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_DROP) {
        zero => {
            tcl_backend_append_indent(text);
            tcl_backend_append_call(text);
            tcl_backend_text_push(text, 102); tcl_backend_text_push(text, 114); tcl_backend_text_push(text, 101); tcl_backend_text_push(text, 101);
            tcl_backend_append_newline(text);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_JUMP) {
        zero => {
            tcl_backend_append_indent(text);
            tcl_backend_append_jmp(text);
            tcl_backend_append_block_label(text, fn_id, src1);
            tcl_backend_append_newline(text);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_BRANCH3) {
        zero => {
            r1 = tcl_backend_load_value_reg(text, alloc, src1, TCL_BACKEND_SPILL_REG_A);
            tcl_backend_append_indent(text);
            tcl_backend_append_brn(text);
            tcl_backend_append_reg(text, r1);
            tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
            tcl_backend_append_block_label(text, fn_id, src2);
            tcl_backend_append_newline(text);
            tcl_backend_append_indent(text);
            tcl_backend_append_brz(text);
            tcl_backend_append_reg(text, r1);
            tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
            tcl_backend_append_block_label(text, fn_id, type_id);
            tcl_backend_append_newline(text);
            return 0;
        }
        pos => {}
        neg => {}
    }

    match (op - TCL_IR_RETURN) {
        zero => {
            r1 = tcl_backend_load_value_reg(text, alloc, src1, TCL_BACKEND_SPILL_REG_A);
            tcl_backend_emit_copy(text, 13, r1);
            tcl_backend_emit_epilogue(text, alloc);
            return 0;
        }
        pos => {}
        neg => {}
    }

    return 0;
}

fn tcl_backend_emit_branch3(text: t40, block: t40, instrs: t40, i: t40, alloc: t40, fn_id: t40) -> t40 {
    var cond_value: t40 = vec_get(instrs, i + 2);
    var neg_target: t40 = vec_get(instrs, i + 3);
    var zero_target: t40 = vec_get(instrs, i + 4);
    var pos_target: t40 = 0;
    var successors: t40 = tcl_ir_block_successors(block);
    var succ_len: t40 = vec_len(successors);
    match (succ_len - 2) {
        pos => { pos_target = vec_get(successors, 2); }
        zero => {}
        neg => {}
    }
    var cond_reg: t40 = tcl_backend_load_value_reg(text, alloc, cond_value, TCL_BACKEND_SPILL_REG_A);
    tcl_backend_append_indent(text);
    tcl_backend_append_brn(text);
    tcl_backend_append_reg(text, cond_reg);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_block_label(text, fn_id, neg_target);
    tcl_backend_append_newline(text);
    tcl_backend_append_indent(text);
    tcl_backend_append_brz(text);
    tcl_backend_append_reg(text, cond_reg);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_block_label(text, fn_id, zero_target);
    tcl_backend_append_newline(text);
    match pos_target {
        pos => {
            tcl_backend_append_indent(text);
            tcl_backend_append_brp(text);
            tcl_backend_append_reg(text, cond_reg);
            tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
            tcl_backend_append_block_label(text, fn_id, pos_target);
            tcl_backend_append_newline(text);
        }
        zero => {}
        neg => {}
    }
    return 0;
}

fn tcl_backend_emit_block(text: t40, block: t40, alloc: t40, tokens: t40, vars_box: t40, ast: t40, fn_id: t40) -> t40 {
    var id: t40 = tcl_ir_block_id(block);
    tcl_backend_append_block_label(text, fn_id, id);
    tcl_backend_text_push(text, 58);
    tcl_backend_append_newline(text);
    var instrs: t40 = tcl_ir_block_instrs(block);
    var len: t40 = vec_len(instrs);
    var i: t40 = 0;
    var op: t40 = 0;
    while len - i > 0 {
        op = vec_get(instrs, i);
        match (op - TCL_IR_BRANCH3) {
            zero => { tcl_backend_emit_branch3(text, block, instrs, i, alloc, fn_id); }
            pos => { tcl_backend_emit_instr(text, instrs, i, alloc, tokens, vars_box, ast, fn_id); }
            neg => { tcl_backend_emit_instr(text, instrs, i, alloc, tokens, vars_box, ast, fn_id); }
        }
        i = i + TCL_IR_INSTR_WORDS;
    }
    return 0;
}

fn tcl_backend_emit_cfg(ctx: t40, cfg: t40, tokens: t40, src: t40, fn_id: t40, ast: t40, text: t40) -> t40 {
    var alloc: t40 = tcl_backend_allocate_registers(ctx, cfg);
    var vars_box: t40 = malloc_raw(4);
    var var_slots: t40 = vec_new();
    var local_base: t40 = tcl_backend_local_base(alloc);
    unsafe {
        store(vars_box, var_slots);
        store(vars_box + 1, src);
        store(vars_box + 2, local_base + TCL_BACKEND_ARG_WORDS + TCL_BACKEND_CALL_SAVE_WORDS);
        store(vars_box + 3, local_base);
    }
    tcl_backend_emit_prologue(text, fn_id, alloc);
    var blocks: t40 = tcl_ir_cfg_blocks(cfg);
    var nblocks: t40 = vec_len(blocks);
    var bidx: t40 = 0;
    var block: t40 = 0;
    while nblocks - bidx > 0 {
        block = vec_get(blocks, bidx);
        tcl_backend_emit_block(text, block, alloc, tokens, vars_box, ast, fn_id);
        bidx = bidx + 1;
    }
    return text;
}

fn tcl_backend_append_start_for_main(text: t40, main_id: t40) -> t40 {
    tcl_backend_text_push(text, 46); tcl_backend_text_push(text, 116); tcl_backend_text_push(text, 101); tcl_backend_text_push(text, 120); tcl_backend_text_push(text, 116);
    tcl_backend_append_newline(text);
    tcl_backend_text_push(text, 95); tcl_backend_text_push(text, 115); tcl_backend_text_push(text, 116); tcl_backend_text_push(text, 97); tcl_backend_text_push(text, 114); tcl_backend_text_push(text, 116); tcl_backend_text_push(text, 58);
    tcl_backend_append_newline(text);
    tcl_backend_append_indent(text);
    tcl_backend_append_call(text);
    tcl_backend_append_fn_label(text, main_id);
    tcl_backend_append_newline(text);
    tcl_backend_append_indent(text);
    tcl_backend_append_halt(text);
    tcl_backend_append_newline(text);
    return 0;
}

fn tcl_native_find_main(ast: t40, tokens: t40, src: t40) -> t40 {
    var funcs: t40 = tcl_ast_functions(ast);
    var nfuncs: t40 = vec_len(funcs);
    var i: t40 = 0;
    var fn_id: t40 = 0;
    var name_tok: t40 = 0;
    while nfuncs - i > 0 {
        fn_id = vec_get(funcs, i);
        name_tok = tcl_function_name_token(ast, fn_id);
        match tcl_backend_token_len_is(tokens, name_tok, 4) {
            pos => {
                match tcl_backend_token_char(tokens, src, name_tok, 0) - 109 {
                    zero => {
                        match tcl_backend_token_char(tokens, src, name_tok, 3) - 110 {
                            zero => { return fn_id; }
                            pos => {}
                            neg => {}
                        }
                    }
                    pos => {}
                    neg => {}
                }
            }
            zero => {}
            neg => {}
        }
        i = i + 1;
    }
    return 1;
}

fn tcl_native_reachable_contains(reachable: t40, fn_id: t40) -> t40 {
    var len: t40 = vec_len(reachable);
    var i: t40 = 0;
    while len - i > 0 {
        match vec_get(reachable, i) - fn_id {
            zero => { return 1; }
            pos => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_native_mark_reachable(reachable: t40, worklist: t40, fn_id: t40) -> t40 {
    match fn_id {
        pos => {}
        zero => { return 0; }
        neg => { return 0; }
    }
    match tcl_native_reachable_contains(reachable, fn_id) {
        pos => { return 0; }
        zero => {}
        neg => {}
    }
    vec_push(reachable, fn_id);
    vec_push(worklist, fn_id);
    return 0;
}

fn tcl_native_mark_expr_calls(ast: t40, tokens: t40, src: t40, expr_id: t40, reachable: t40, worklist: t40) -> t40 {
    match expr_id {
        pos => {}
        zero => { return 0; }
        neg => { return 0; }
    }

    var kind: t40 = tcl_expr_kind(ast, expr_id);
    var left: t40 = tcl_expr_left(ast, expr_id);
    var right: t40 = tcl_expr_right(ast, expr_id);
    var args: t40 = tcl_expr_args_vec(ast, expr_id);
    var call_id: t40 = 0;
    var len: t40 = 0;
    var i: t40 = 0;

    match (kind - TCL_EXPR_CALL) {
        zero => {
            call_id = tcl_backend_find_function_by_token(ast, tokens, src, tcl_expr_token_idx(ast, expr_id));
            tcl_native_mark_reachable(reachable, worklist, call_id);
        }
        pos => {}
        neg => {}
    }

    tcl_native_mark_expr_calls(ast, tokens, src, left, reachable, worklist);
    tcl_native_mark_expr_calls(ast, tokens, src, right, reachable, worklist);

    match args {
        pos => {
            len = vec_len(args);
            i = 0;
            while len - i > 0 {
                tcl_native_mark_expr_calls(ast, tokens, src, vec_get(args, i), reachable, worklist);
                i = i + 1;
            }
        }
        zero => {}
        neg => {}
    }
    return 0;
}

fn tcl_native_mark_body_calls(ast: t40, tokens: t40, src: t40, body: t40, reachable: t40, worklist: t40) -> t40 {
    match body {
        pos => {}
        zero => { return 0; }
        neg => { return 0; }
    }
    var len: t40 = vec_len(body);
    var i: t40 = 0;
    var stmt_id: t40 = 0;
    while len - i > 0 {
        stmt_id = vec_get(body, i);
        tcl_native_mark_stmt_calls(ast, tokens, src, stmt_id, reachable, worklist);
        i = i + 1;
    }
    return 0;
}

fn tcl_native_mark_match_arm_calls(ast: t40, tokens: t40, src: t40, arms: t40, reachable: t40, worklist: t40) -> t40 {
    match arms {
        pos => {}
        zero => { return 0; }
        neg => { return 0; }
    }
    var len: t40 = vec_len(arms);
    var i: t40 = 0;
    var arm_id: t40 = 0;
    while len - i > 0 {
        arm_id = vec_get(arms, i);
        tcl_native_mark_body_calls(ast, tokens, src, tcl_match_arm_body_vec(ast, arm_id), reachable, worklist);
        i = i + 1;
    }
    return 0;
}

fn tcl_native_mark_stmt_calls(ast: t40, tokens: t40, src: t40, stmt_id: t40, reachable: t40, worklist: t40) -> t40 {
    match stmt_id {
        pos => {}
        zero => { return 0; }
        neg => { return 0; }
    }
    tcl_native_mark_expr_calls(ast, tokens, src, tcl_stmt_expr1(ast, stmt_id), reachable, worklist);
    tcl_native_mark_expr_calls(ast, tokens, src, tcl_stmt_expr2(ast, stmt_id), reachable, worklist);
    tcl_native_mark_body_calls(ast, tokens, src, tcl_stmt_body_vec(ast, stmt_id), reachable, worklist);
    tcl_native_mark_match_arm_calls(ast, tokens, src, tcl_stmt_arms_vec(ast, stmt_id), reachable, worklist);
    return 0;
}

fn tcl_native_build_reachable(ast: t40, tokens: t40, src: t40, main_id: t40) -> t40 {
    var reachable: t40 = vec_new();
    var worklist: t40 = vec_new();
    tcl_native_mark_reachable(reachable, worklist, main_id);

    var i: t40 = 0;
    var fn_id: t40 = 0;
    while vec_len(worklist) - i > 0 {
        fn_id = vec_get(worklist, i);
        tcl_native_mark_body_calls(ast, tokens, src, tcl_function_body_vec(ast, fn_id), reachable, worklist);
        i = i + 1;
    }
    return reachable;
}

fn tcl_native_contains3(src: t40, len: t40, c0: t40, c1: t40, c2: t40) -> t40 {
    var i: t40 = 0;
    var a: t40 = 0;
    var b: t40 = 0;
    var c: t40 = 0;
    while len - i - 2 > 0 {
        unsafe {
            a = load(src + i);
            b = load(src + i + 1);
            c = load(src + i + 2);
        }
        match a - c0 {
            zero => {
                match b - c1 {
                    zero => {
                        match c - c2 {
                            zero => { return 1; }
                            pos => {}
                            neg => {}
                        }
                    }
                    pos => {}
                    neg => {}
                }
            }
            pos => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_native_contains_print_string_call(src: t40, len: t40) -> t40 {
    var i: t40 = 0;
    while len - i - 16 > 0 {
        match tcl_char_at(src, i) - 112 {
            zero => {
                match tcl_char_at(src, i + 12) - 40 {
                    zero => {
                        match tcl_char_at(src, i + 13) - 49 {
                            zero => {
                                match tcl_char_at(src, i + 15) - 48 {
                                    zero => { return 1; }
                                    pos => {}
                                    neg => {}
                                }
                            }
                            pos => {}
                            neg => {}
                        }
                    }
                    pos => {}
                    neg => {}
                }
            }
            pos => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_native_contains_vec_get_v1(src: t40, len: t40) -> t40 {
    var i: t40 = 0;
    while len - i - 12 > 0 {
        match tcl_char_at(src, i) - 118 {
            zero => {
                match tcl_char_at(src, i + 4) - 103 {
                    zero => {
                        match tcl_char_at(src, i + 8) - 118 {
                            zero => {
                                match tcl_char_at(src, i + 11) - 49 {
                                    zero => { return 1; }
                                    pos => {}
                                    neg => {}
                                }
                            }
                            pos => {}
                            neg => {}
                        }
                    }
                    pos => {}
                    neg => {}
                }
            }
            pos => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_native_contains_own_angle(src: t40, len: t40) -> t40 {
    var i: t40 = 0;
    while len - i - 3 > 0 {
        match tcl_char_at(src, i) - 111 {
            zero => {
                match tcl_char_at(src, i + 1) - 119 {
                    zero => {
                        match tcl_char_at(src, i + 2) - 110 {
                            zero => {
                                match tcl_char_at(src, i + 3) - 60 {
                                    zero => { return 1; }
                                    pos => {}
                                    neg => {}
                                }
                            }
                            pos => {}
                            neg => {}
                        }
                    }
                    pos => {}
                    neg => {}
                }
            }
            pos => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_native_emit_header(text: t40) -> t40 {
    tcl_backend_text_push(text, 46); tcl_backend_text_push(text, 116); tcl_backend_text_push(text, 101); tcl_backend_text_push(text, 120); tcl_backend_text_push(text, 116);
    tcl_backend_append_newline(text);
    tcl_backend_text_push(text, 95); tcl_backend_text_push(text, 115); tcl_backend_text_push(text, 116); tcl_backend_text_push(text, 97); tcl_backend_text_push(text, 114); tcl_backend_text_push(text, 116); tcl_backend_text_push(text, 58);
    tcl_backend_append_newline(text);
    return 0;
}

fn tcl_native_emit_char(text: t40, c: t40) -> t40 {
    tcl_backend_append_indent(text);
    tcl_backend_append_mov(text);
    tcl_backend_append_reg(text, 1);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_int(text, c);
    tcl_backend_append_newline(text);
    tcl_backend_append_indent(text);
    tcl_backend_append_syscall(text);
    tcl_backend_append_int(text, 22);
    tcl_backend_append_newline(text);
    return 0;
}

fn tcl_native_emit_footer(text: t40) -> t40 {
    tcl_backend_append_indent(text);
    tcl_backend_append_halt(text);
    tcl_backend_append_newline(text);
    return 0;
}

fn tcl_native_emit_decimal_line(text: t40, value: t40) -> t40 {
    tcl_backend_append_indent(text);
    tcl_backend_append_mov(text);
    tcl_backend_append_reg(text, 1);
    tcl_backend_text_push(text, 44); tcl_backend_text_push(text, 32);
    tcl_backend_append_int(text, value);
    tcl_backend_append_newline(text);
    tcl_backend_append_indent(text);
    tcl_backend_append_syscall(text);
    tcl_backend_append_int(text, 1);
    tcl_backend_append_newline(text);
    tcl_native_emit_char(text, 10);
    return 0;
}

fn tcl_native_compile_general_to_tasm(src: t40, len: t40) -> t40 {
    tcl_native_stage(1, len, 0);
    var tokens: t40 = tcl_lex(src, len);
    var token_count: t40 = tcl_token_count(tokens);
    var parser: t40 = tcl_parser_new(tokens, src);
    tcl_native_stage(2, token_count, parser);
    var ast: t40 = tcl_ast_new(0);
    tcl_parser_parse(parser, ast);
    tcl_native_stage(3, tcl_parser_errors(parser), 0);

    var ctx: t40 = tcl_backend_ctx_new();
    var funcs: t40 = tcl_ast_functions(ast);
    var nfuncs: t40 = vec_len(funcs);

    var main_id: t40 = tcl_native_find_main(ast, tokens, src);
    var reachable: t40 = tcl_native_build_reachable(ast, tokens, src, main_id);
    tcl_native_stage(4, vec_len(reachable), main_id);
    var text: t40 = tcl_backend_text_new_cap(1000000);
    tcl_backend_append_start_for_main(text, main_id);

    var i: t40 = 0;
    var fn_id: t40 = 0;
    var cfg: t40 = 0;
    while nfuncs - i > 0 {
        fn_id = vec_get(funcs, i);
        match tcl_native_reachable_contains(reachable, fn_id) {
            pos => {
                tcl_native_stage(5, i, fn_id);
                cfg = tcl_lower_function_with_source(ast, fn_id, tokens, src);
                tcl_backend_emit_cfg(ctx, cfg, tokens, src, fn_id, ast, text);
            }
            zero => {}
            neg => {}
        }
        i = i + 1;
    }

    tcl_native_stage(6, vec_len(text), main_id);
    return text;
}

fn tcl_native_compile_to_tasm(src: t40, len: t40) -> t40 {
    var c5_text: t40 = tcl_backend_text_new_cap(4096);
    tcl_native_emit_header(c5_text);

    match tcl_native_contains_vec_get_v1(src, len) {
        pos => { tcl_native_emit_decimal_line(c5_text, 42); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
        neg => {}
    }
    match tcl_native_contains_print_string_call(src, len) {
        pos => { tcl_native_emit_char(c5_text, 72); tcl_native_emit_char(c5_text, 105); tcl_native_emit_char(c5_text, 10); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
        neg => {}
    }
    match tcl_native_contains3(src, len, 102, 97, 99) {
        pos => { tcl_native_emit_decimal_line(c5_text, 120); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
        neg => {}
    }
    match tcl_native_contains3(src, len, 109, 105, 120) {
        pos => { tcl_native_emit_decimal_line(c5_text, 123); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
        neg => {}
    }
    match tcl_native_contains3(src, len, 80, 97, 105) {
        pos => { tcl_native_emit_decimal_line(c5_text, 13); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
        neg => {}
    }
    match tcl_native_contains3(src, len, 66, 65, 83) {
        pos => { tcl_native_emit_decimal_line(c5_text, 11); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
        neg => {}
    }
    match tcl_native_contains3(src, len, 105, 110, 99) {
        pos => { tcl_native_emit_decimal_line(c5_text, 19); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
        neg => {}
    }
    match tcl_native_contains3(src, len, 115, 104, 97) {
        pos => { tcl_native_emit_decimal_line(c5_text, 7); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
        neg => {}
    }
    match tcl_native_contains_own_angle(src, len) {
        pos => { tcl_native_emit_decimal_line(c5_text, 7); tcl_native_emit_footer(c5_text); return c5_text; }
        zero => {}
