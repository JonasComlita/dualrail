fn tcl_backend_token_char(tokens: t40, src: t40, tok: t40, idx: t40) -> t40 {
    var start: t40 = tcl_token_start(tokens, tok);
    var c: t40 = 0;
    unsafe { c = load(src + start + idx); }
    return c;
}

fn tcl_backend_token_len_is(tokens: t40, tok: t40, len: t40) -> t40 {
    match tcl_token_len(tokens, tok) - len {
        zero => { return 1; }
        pos => { return 0; }
        neg => { return 0; }
    }
}

fn tcl_backend_token_eq(tokens: t40, src: t40, left: t40, right: t40) -> t40 {
    var len: t40 = tcl_token_len(tokens, left);
    match len - tcl_token_len(tokens, right) {
        zero => {}
        pos => { return 0; }
        neg => { return 0; }
    }
    var i: t40 = 0;
    while len - i > 0 {
        match tcl_backend_token_char(tokens, src, left, i) - tcl_backend_token_char(tokens, src, right, i) {
            zero => {}
            pos => { return 0; }
            neg => { return 0; }
        }
        i = i + 1;
    }
    return 1;
}

fn tcl_backend_find_function_by_token(ast: t40, tokens: t40, src: t40, name_tok: t40) -> t40 {
    var funcs: t40 = tcl_ast_functions(ast);
    var len: t40 = vec_len(funcs);
    var i: t40 = 0;
    var fn_id: t40 = 0;
    var fn_tok: t40 = 0;
    while len - i > 0 {
        fn_id = vec_get(funcs, i);
        fn_tok = tcl_function_name_token(ast, fn_id);
        match tcl_backend_token_eq(tokens, src, name_tok, fn_tok) {
            pos => { return fn_id; }
            zero => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_backend_find_const_by_token(ast: t40, tokens: t40, src: t40, name_tok: t40) -> t40 {
    var consts: t40 = tcl_ast_consts(ast);
    var len: t40 = vec_len(consts);
    var i: t40 = 0;
    var const_id: t40 = 0;
    var const_tok: t40 = 0;
    while len - i > 0 {
        const_id = vec_get(consts, i);
        const_tok = tcl_const_name_token(ast, const_id);
        match tcl_backend_token_eq(tokens, src, name_tok, const_tok) {
            pos => { return const_id; }
            zero => {}
            neg => {}
        }
        i = i + 1;
    }
    return 0;
}

fn tcl_backend_eval_const_expr(ast: t40, tokens: t40, src: t40, expr_id: t40) -> t40 {
    var kind: t40 = tcl_expr_kind(ast, expr_id);
    var tok: t40 = tcl_expr_token_idx(ast, expr_id);
    match (kind - TCL_EXPR_NUMBER) {
        zero => { return tcl_backend_token_number(tokens, src, tok); }
        pos => {}
        neg => {}
    }
    match (kind - TCL_EXPR_NAME) {
        zero => {
            var const_id: t40 = tcl_backend_find_const_by_token(ast, tokens, src, tok);
            match const_id {
                pos => { return tcl_backend_eval_const_expr(ast, tokens, src, tcl_const_expr(ast, const_id)); }
                zero => { return 0; }
                neg => { return 0; }
            }
        }
        pos => {}
        neg => {}
    }
    match (kind - TCL_EXPR_BINARY) {
        zero => {
            var left: t40 = tcl_backend_eval_const_expr(ast, tokens, src, tcl_expr_left(ast, expr_id));
            var right: t40 = tcl_backend_eval_const_expr(ast, tokens, src, tcl_expr_right(ast, expr_id));
            var op_kind: t40 = tcl_token_kind(tokens, tok);
            match (op_kind - TCL_TK_MINUS) {
                zero => { return left - right; }
                pos => {}
                neg => {}
            }
            match (op_kind - TCL_TK_STAR) {
                zero => { return left * right; }
                pos => {}
                neg => {}
            }
            match (op_kind - TCL_TK_SLASH) {
                zero => { return left / right; }
                pos => {}
                neg => {}
            }
            return left + right;
        }
        pos => {}
        neg => {}
    }
    return 0;
}

fn tcl_backend_param_ordinal(ast: t40, tokens: t40, src: t40, fn_id: t40, name_tok: t40) -> t40 {
    var params: t40 = tcl_function_params_vec(ast, fn_id);
    var len: t40 = vec_len(params);
    var i: t40 = 0;
    var ordinal: t40 = 1;
    var param_tok: t40 = 0;
    while len - i > 0 {
        param_tok = vec_get(params, i);
        match tcl_backend_token_eq(tokens, src, name_tok, param_tok) {
            pos => { return ordinal; }
            zero => {}
            neg => {}
        }
        ordinal = ordinal + 1;
        i = i + 2;
    }
    return 0;
}

