                                zero => {
                                    match tcl_char_at(src, start + 3) - c3 {
                                        zero => { return 1; }
                                        pos => { return 0; }
                                        neg => { return 0; }
                                    }
                                }
                                pos => { return 0; }
                                neg => { return 0; }
