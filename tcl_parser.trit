// =============================================================================
// tcl_parser.trit - Phase B Native Recursive Descent Parser
// =============================================================================

// Parser Error Codes
const TCL_ERR_EXPECTED_SEMICOLON: t40 = 1;
const TCL_ERR_EXPECTED_RBRACKET: t40 = 2;
const TCL_ERR_ARRAY_LEN_CONST: t40 = 3;
const TCL_ERR_EXPECTED_LESS: t40 = 4;
const TCL_ERR_EXPECTED_GREATER: t40 = 5;
const TCL_ERR_EXPECTED_COMMA: t40 = 6;
const TCL_ERR_EXPECTED_QUALIFIER: t40 = 7;
const TCL_ERR_UNKNOWN_PTR_STATE: t40 = 8;
const TCL_ERR_UNKNOWN_PTR_REGION: t40 = 9;
const TCL_ERR_INVALID_MEM_ORDER: t40 = 10;
const TCL_ERR_EXPECTED_TYPE_NAME: t40 = 11;
const TCL_ERR_UNDEFINED_WIDTH_PARAM: t40 = 12;
const TCL_ERR_CALL_FN_NAME: t40 = 13;
const TCL_ERR_EXPECTED_RPAREN: t40 = 14;
const TCL_ERR_EXPECTED_FIELD_NAME: t40 = 15;
const TCL_ERR_EXPECTED_EXPR: t40 = 16;
const TCL_ERR_EXPECTED_COLON: t40 = 17;
const TCL_ERR_EXPECTED_EQUAL: t40 = 18;
const TCL_ERR_EXPECTED_LBRACE: t40 = 19;
const TCL_ERR_INVALID_MATCH_ARM: t40 = 20;
const TCL_ERR_EXPECTED_FAT_ARROW: t40 = 21;
const TCL_ERR_EXPECTED_RBRACE: t40 = 22;
const TCL_ERR_INVALID_TUPLE_SWAP: t40 = 23;
const TCL_ERR_EXPECTED_DECL: t40 = 24;
const TCL_ERR_EXPECTED_CONSTRAINT: t40 = 25;
const TCL_ERR_EXPECTED_ARROW: t40 = 26;
const TCL_ERR_EXPECTED_IDENT: t40 = 27;
const TCL_ERR_EXPECTED_LPAREN: t40 = 28;
const TCL_ERR_INVALID_GUARD_KEYWORD: t40 = 29;

// =============================================================================
// Parser Struct Accessors & Lifecycle
// =============================================================================

// Parser State Layout (6 words):
// [0] tokens (token stream vector)
// [1] src (pointer to source code string)
// [2] current (current token index)
// [3] errors (errors count)
// [4] diagnostics (diagnostics vector: pairs of [token_idx, error_code])
// [5] width_params (vector of active width parameters for the current function)

fn tcl_parser_tokens(p: t40) -> t40 { var v: t40 = 0; unsafe { v = load(p); } return v; }
fn tcl_parser_src(p: t40) -> t40 { var v: t40 = 0; unsafe { v = load(p + 1); } return v; }
fn tcl_parser_current(p: t40) -> t40 { var v: t40 = 0; unsafe { v = load(p + 2); } return v; }
fn tcl_parser_set_current(p: t40, val: t40) -> t40 { unsafe { store(p + 2, val); } return 0; }
fn tcl_parser_errors(p: t40) -> t40 { var v: t40 = 0; unsafe { v = load(p + 3); } return v; }
fn tcl_parser_set_errors(p: t40, val: t40) -> t40 { unsafe { store(p + 3, val); } return 0; }
fn tcl_parser_diagnostics(p: t40) -> t40 { var v: t40 = 0; unsafe { v = load(p + 4); } return v; }
fn tcl_parser_width_params(p: t40) -> t40 { var v: t40 = 0; unsafe { v = load(p + 5); } return v; }

fn tcl_parser_vec_new_cap(cap: t40) -> t40 {
    match cap - 1 {
        neg => { cap = 1; }
        zero => {}
        pos => {}
    }
    var vec: t40 = malloc_raw(3);
    match vec {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = malloc_raw(cap);
            match data {
                zero => { free_raw(vec); return 0; }
                neg => { free_raw(vec); return 0; }
                pos => {
                    unsafe {
                        store(vec, data);
                        store(vec + 1, 0);
                        store(vec + 2, cap);
                    }
                    return vec;
                }
            }
        }
    }
}

fn tcl_parser_vec_new_small() -> t40 {
    return tcl_parser_vec_new_cap(9);
}

fn tcl_parser_vec_new_medium() -> t40 {
    return tcl_parser_vec_new_cap(27);
}

fn tcl_parser_vec_grow(vec: t40, len: t40, cap: t40, need: t40, data: t40) -> t40 {
    match (cap - len - need) {
        neg => {
            var new_cap: t40 = cap * 3;
            match (new_cap - len - need) {
                neg => { new_cap = len + need; }
                zero => {}
                pos => {}
            }
            var new_data: t40 = malloc_raw(new_cap);
            match new_data {
                zero => { return data; }
                neg => { return data; }
                pos => {
                    memcpy(new_data, data, len);
                    free_raw(data);
                    unsafe {
                        store(vec, new_data);
                        store(vec + 2, new_cap);
                    }
                    return new_data;
                }
            }
        }
        zero => { return data; }
        pos => { return data; }
    }
}

fn tcl_parser_new(tokens: t40, src: t40) -> t40 {
    var p: t40 = malloc_raw(6);
    match p {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            unsafe {
                store(p, tokens);
                store(p + 1, src);
                store(p + 2, 0); // current = 0
                store(p + 3, 0); // errors = 0
                store(p + 4, tcl_parser_vec_new_small()); // diagnostics
                store(p + 5, tcl_parser_vec_new_small()); // width_params
            }
            return p;
        }
    }
}

fn tcl_parser_free(p: t40) -> t40 {
    var diags: t40 = 0;
    var wparams: t40 = 0;
    match p {
        zero => {}
        neg => {}
        pos => {
            diags = tcl_parser_diagnostics(p);
            match diags { pos => { vec_free(diags); } zero => {} neg => {} }
            wparams = tcl_parser_width_params(p);
            match wparams { pos => { vec_free(wparams); } zero => {} neg => {} }
            free_raw(p);
        }
    }
    return 0;
}

fn tcl_parser_clear_width_params(p: t40) -> t40 {
    var wp: t40 = tcl_parser_width_params(p);
    vec_free(wp);
    unsafe { store(p + 5, tcl_parser_vec_new_small()); }
    return 0;
}

// =============================================================================
// Spelling & Token Comparison Helpers
// =============================================================================

fn tcl_token_is_1(p: t40, tok: t40, c0: t40) -> t40 {
    var tokens: t40 = tcl_parser_tokens(p);
    var src: t40 = 0;
    var start: t40 = 0;
    match tcl_token_len(tokens, tok) - 1 {
        zero => {
            src = tcl_parser_src(p);
            start = tcl_token_start(tokens, tok);
            match tcl_char_at(src, start) - c0 {
                zero => { return 1; }
                pos => { return 0; }
                neg => { return 0; }
            }
        }
        pos => { return 0; }
        neg => { return 0; }
    }
}

fn tcl_token_is_2(p: t40, tok: t40, c0: t40, c1: t40) -> t40 {
    var tokens: t40 = tcl_parser_tokens(p);
    var src: t40 = 0;
    var start: t40 = 0;
    match tcl_token_len(tokens, tok) - 2 {
        zero => {
            src = tcl_parser_src(p);
            start = tcl_token_start(tokens, tok);
            match tcl_char_at(src, start) - c0 {
                zero => {
                    match tcl_char_at(src, start + 1) - c1 {
                        zero => { return 1; }
                        pos => { return 0; }
                        neg => { return 0; }
                    }
                }
                pos => { return 0; }
                neg => { return 0; }
            }
        }
        pos => { return 0; }
        neg => { return 0; }
    }
}

fn tcl_token_is_3(p: t40, tok: t40, c0: t40, c1: t40, c2: t40) -> t40 {
    var tokens: t40 = tcl_parser_tokens(p);
    var src: t40 = 0;
    var start: t40 = 0;
    match tcl_token_len(tokens, tok) - 3 {
        zero => {
            src = tcl_parser_src(p);
            start = tcl_token_start(tokens, tok);
            match tcl_char_at(src, start) - c0 {
                zero => {
                    match tcl_char_at(src, start + 1) - c1 {
                        zero => {
                            match tcl_char_at(src, start + 2) - c2 {
                                zero => { return 1; }
                                pos => { return 0; }
                                neg => { return 0; }
                            }
                        }
                        pos => { return 0; }
                        neg => { return 0; }
                    }
                }
                pos => { return 0; }
                neg => { return 0; }
            }
        }
        pos => { return 0; }
        neg => { return 0; }
    }
}

