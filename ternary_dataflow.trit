// =============================================================================
// ternary_dataflow.trit  -  An Optimized Ternary Reactive Dataflow Runtime
// =============================================================================

// =============================================================================
// SECTION 1 — Node Pool Bump Allocator (OPT 1)
// Lay out node slots with inline vectors to avoid heap allocations.
// Slot size = 28 words:
//   node[0..9]: standard fields and traversal scratch (10 words)
//   node[10..15]: inputs vector struct & inline storage (6 words)
//   node[16..21]: outputs vector struct & inline storage (6 words)
//   node[22..27]: dependents vector struct & inline storage (6 words)
// =============================================================================

// The pool is scheduler-owned:
//   sched[4] = node_pool_ptr, sched[5] = used, sched[6] = capacity.
fn node_pool_init(sched: t40, capacity: t40) -> t40 {
    match capacity {
        pos => {
            var pool: t40 = malloc_raw(capacity * 28);
            match pool {
                pos => {
                    unsafe {
                        store(sched + 4, pool);
                        store(sched + 5, 0);
                        store(sched + 6, capacity);
                    }
                    return pool;
                }
                _ => { return 0; }
            }
        }
        _ => { return 0; }
    }
}

fn node_pool_alloc(sched: t40) -> t40 {
    var pool: t40 = 0;
    var used: t40 = 0;
    var capacity: t40 = 0;
    unsafe {
        pool = load(sched + 4);
        used = load(sched + 5);
        capacity = load(sched + 6);
    }
    match pool {
        pos => {
            match capacity - used {
                pos => {
                    var node: t40 = pool + used * 28;
                    unsafe { store(sched + 5, used + 1); }
                    return node;
                }
                _ => { return 0; }
            }
        }
        _ => { return 0; }
    }
}

fn node_pool_free(sched: t40) -> void {
    var pool: t40 = 0;
    unsafe { pool = load(sched + 4); }
    match pool {
        pos => { free_raw(pool); }
        _ => {}
    }
    unsafe {
        store(sched + 4, 0);
        store(sched + 5, 0);
        store(sched + 6, 0);
    }
}

// Sized vector creator (kept for compatibility)
fn df_vec_new_sized(initial_cap: t40) -> t40 {
    var vec: t40 = malloc_raw(3);
    match vec {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = malloc_raw(initial_cap);
            match data {
                zero => { free_raw(vec); return 0; }
                neg => { free_raw(vec); return 0; }
                pos => {
                    unsafe {
                        store(vec,     data);
                        store(vec + 1, 0);
                        store(vec + 2, initial_cap);
                    }
                    return vec;
                }
            }
        }
    }
}

// Safe vector push helper supporting inline array growth
fn df_vec_push_safe(vec: t40, val: t40) -> t40 {
    match vec {
        pos => {}
        _ => { return 0; }
    }
    var len: t40 = 0;
    var cap: t40 = 0;
    var data: t40 = 0;
    unsafe {
        data = load(vec);
        len = load(vec + 1);
        cap = load(vec + 2);
    }
    match cap - len - 1 {
        neg => {
            var new_cap: t40 = 3;
            match cap {
                pos => { new_cap = cap * 3; }
                _ => {}
            }
            var new_data: t40 = malloc_raw(new_cap);
            match new_data {
                pos => {
                    memcpy(new_data, data, len);
                    // Only free if old data was not inline (inline starts at vec + 3)
                    match data - (vec + 3) {
                        zero => {}
                        _ => { free_raw(data); }
                    }
                    unsafe {
                        store(vec, new_data);
                        store(vec + 2, new_cap);
                    }
                    data = new_data;
                }
                _ => { return 0; }
            }
        }
        _ => {}
    }
    unsafe {
        store(data + len, val);
        store(vec + 1, len + 1);
    }
    return 1;
}

// Safe vector free helper (only frees heap data arrays, avoids inline vector structs)
fn df_vec_free_safe(vec: t40) -> void {
    var data: t40 = 0;
    unsafe { data = load(vec); }
    match data {
        zero => {}
        neg => {}
        pos => {
            match data - (vec + 3) {
                zero => {}
                _ => { free_raw(data); }
            }
        }
    }
}


// =============================================================================
// SECTION 2 — Dataflow Channel (DFChannel)
// FIFO of tagged events. Payload sign and value are never control metadata.
// Struct: [0]=event storage, [1]=capacity, [2]=read index,
//         [3]=write index, [4]=event count. Each slot is [tag, value].
// =============================================================================

const DF_EVENT_NONE: t40 = 0;
const DF_EVENT_DATA: t40 = 1;
const DF_EVENT_ANOMALY: t40 = 0 - 1;
const DF_EVENT_UNCERTAIN: t40 = 0 - 2;
const DF_EVENT_EOS: t40 = 0 - 3;

fn df_channel_new(capacity: t40) -> t40 {
    match capacity {
        pos => {
            var chan: t40 = malloc_raw(5);
            match chan {
                pos => {
                    var data: t40 = malloc_raw(capacity * 2);
                    match data {
                        pos => {
                            unsafe {
                                store(chan, data);
                                store(chan + 1, capacity);
                                store(chan + 2, 0);
                                store(chan + 3, 0);
                                store(chan + 4, 0);
                            }
                            return chan;
                        }
                        _ => { free_raw(chan); return 0; }
                    }
                }
                _ => { return 0; }
            }
        }
        _ => { return 0; }
    }
}

fn df_channel_free(chan: t40) -> void {
    match chan {
        pos => {
            var data: t40 = 0;
            unsafe { data = load(chan); }
            match data {
                pos => { free_raw(data); }
                _ => {}
            }
            free_raw(chan);
        }
        _ => {}
    }
}

// Writes one tagged event. Returns 1 on success, 0 for invalid/full channels.
fn df_channel_write_event(chan: t40, tag: t40, val: t40) -> t40 {
    match chan {
        pos => {}
        _ => { return 0; }
    }
    match tag {
        zero => { return 0; }
        _ => {}
    }
    var data: t40 = 0;
    var capacity: t40 = 0;
    var write_pos: t40 = 0;
    var count: t40 = 0;
    unsafe {
        data = load(chan);
        capacity = load(chan + 1);
        write_pos = load(chan + 3);
        count = load(chan + 4);
    }
    match capacity - count {
        pos => {
            unsafe {
                store(data + write_pos * 2, tag);
                store(data + write_pos * 2 + 1, val);
            }
            var next_write: t40 = write_pos + 1;
            match next_write - capacity {
                neg => {}
                _ => { next_write = 0; }
            }
            unsafe {
                store(chan + 3, next_write);
                store(chan + 4, count + 1);
            }
            return 1;
        }
        _ => { return 0; }
    }
}

fn df_channel_write(chan: t40, val: t40) -> t40 {
    return df_channel_write_event(chan, DF_EVENT_DATA, val);
}

fn df_channel_write_signal(chan: t40, tag: t40) -> t40 {
    match tag {
        pos => { return 0; }
        zero => { return 0; }
        neg => { return df_channel_write_event(chan, tag, 0); }
    }
}

// Reads the oldest event, stores its payload at out_value, and returns its tag.
// Returns DF_EVENT_NONE without touching out_value when the channel is empty.
fn df_channel_read(chan: t40, out_value: t40) -> t40 {
    match chan {
        pos => {}
        _ => { return DF_EVENT_NONE; }
    }
    match out_value {
        pos => {}
        _ => { return DF_EVENT_NONE; }
    }
    var data: t40 = 0;
    var capacity: t40 = 0;
    var read_pos: t40 = 0;
    var count: t40 = 0;
    unsafe {
        data = load(chan);
        capacity = load(chan + 1);
        read_pos = load(chan + 2);
        count = load(chan + 4);
    }
    match count {
        pos => {
            var tag: t40 = 0;
            var val: t40 = 0;
            unsafe {
                tag = load(data + read_pos * 2);
                val = load(data + read_pos * 2 + 1);
                store(out_value, val);
            }
            var next_read: t40 = read_pos + 1;
            match next_read - capacity {
                neg => {}
                _ => { next_read = 0; }
            }
            unsafe {
                store(chan + 2, next_read);
                store(chan + 4, count - 1);
            }
            return tag;
        }
        _ => { return DF_EVENT_NONE; }
    }
}


// =============================================================================
// SECTION 3 — Dataflow Node (DFNode)
// Struct (10 words + inline vectors):
//   [0] = state (-1 = NOT_READY/CANCELLED, 0 = READY, 1 = DONE)
//   [1] = kind (node kind / dispatcher selector)
//   [2] = inputs_vec pointer
//   [3] = outputs_vec pointer
//   [4] = dependents_vec pointer
//   [5] = inputs_satisfied_count
//   [6] = name_str (for debugging)
//   [7] = custom_data (context pointer)
//   [8] = required_inputs_threshold (AND-join default: input_len)
//   [9] = graph traversal scratch (white/gray/black; never execution state)
// =============================================================================

fn df_node_new(sched: t40, name: t40, kind: t40, data: t40) -> t40 {
    var node: t40 = node_pool_alloc(sched);
    match node {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var inputs: t40 = node + 10;
            var outputs: t40 = node + 16;
            var deps: t40 = node + 22;
            
            unsafe {
                store(node, 0 - 1); // state = NOT_READY (-1)
                store(node + 1, kind);
                store(node + 2, inputs);
                store(node + 3, outputs);
                store(node + 4, deps);
                store(node + 5, 0); // satisfied count
                store(node + 6, name);
                store(node + 7, data);
                store(node + 8, 0); // threshold = 0 (unset, uses default)
                store(node + 9, 0); // graph traversal scratch = white
                
                // Initialize inputs inline vector
                store(inputs, node + 13);
                store(inputs + 1, 0);
                store(inputs + 2, 3);
                store(node + 13, 0);
                store(node + 14, 0);
                store(node + 15, 0);
                
                // Initialize outputs inline vector
                store(outputs, node + 19);
                store(outputs + 1, 0);
                store(outputs + 2, 3);
                store(node + 19, 0);
                store(node + 20, 0);
                store(node + 21, 0);
                
                // Initialize dependents inline vector
                store(deps, node + 25);
                store(deps + 1, 0);
                store(deps + 2, 3);
                store(node + 25, 0);
                store(node + 26, 0);
                store(node + 27, 0);
            }
            return node;
        }
    }
}

fn df_node_free(node: t40) -> void {
    match node {
        zero => {}
        neg => {}
        pos => {
            var inputs: t40 = 0;
            var outputs: t40 = 0;
            var deps: t40 = 0;
            unsafe {
                inputs = load(node + 2);
                outputs = load(node + 3);
                deps = load(node + 4);
            }
            df_vec_free_safe(inputs);
            df_vec_free_safe(outputs);
            df_vec_free_safe(deps);
            // Node itself is in the pool, do not free_raw(node)
        }
    }
}

fn df_node_add_input(node: t40, chan: t40) -> t40 {
    var inputs: t40 = 0;
    unsafe { inputs = load(node + 2); }
    return df_vec_push_safe(inputs, chan);
}

fn df_node_add_output(node: t40, chan: t40) -> t40 {
    var outputs: t40 = 0;
    unsafe { outputs = load(node + 3); }
    return df_vec_push_safe(outputs, chan);
}

fn df_node_add_dependent(parent: t40, child: t40) -> t40 {
    var deps: t40 = 0;
    unsafe { deps = load(parent + 4); }
    return df_vec_push_safe(deps, child);
}

// Configures OR-join/Threshold trigger (OPT 7)
fn df_node_set_required_threshold(node: t40, threshold: t40) -> void {
    unsafe { store(node + 8, threshold); }
}


// =============================================================================
// SECTION 4 — Dataflow Scheduler (DFScheduler - OPT 3 & OPT 4)
// Ready queue uses two Ring Buffers for O(1) scheduling without CAS.
// [0]=normal queue, [1]=active count, [2]=capacity, [3]=urgent queue,
// [4]=node pool, [5]=pool used, [6]=pool capacity.
// =============================================================================

fn df_sched_new(capacity: t40) -> t40 {
    match capacity - 1 {
        pos => {}
        _ => { return 0; }
    }
    var sched: t40 = malloc_raw(7);
    match sched {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            unsafe {
                store(sched, 0);
                store(sched + 1, 0);
                store(sched + 2, capacity);
                store(sched + 3, 0);
                store(sched + 4, 0);
                store(sched + 5, 0);
                store(sched + 6, 0);
            }
            var rq: t40 = ring_new(capacity);
            match rq {
                pos => {}
                _ => { free_raw(sched); return 0; }
            }
            var uq: t40 = ring_new(capacity);
            match uq {
                pos => {}
                _ => {
                    ring_free(rq);
                    free_raw(sched);
                    return 0;
                }
            }
            unsafe {
                store(sched, rq);
                store(sched + 3, uq);
            }
            var pool: t40 = node_pool_init(sched, capacity);
            match pool {
                pos => {}
                _ => {
                    ring_free(rq);
                    ring_free(uq);
                    free_raw(sched);
                    return 0;
                }
            }
            return sched;
        }
    }
}

fn df_sched_free(sched: t40) -> void {
    match sched {
        zero => {}
        neg => {}
        pos => {
            var rq: t40 = 0;
            var uq: t40 = 0;
            unsafe {
                rq = load(sched);
                uq = load(sched + 3);
            }
            ring_free(rq);
            ring_free(uq);
            
            // Free the node pool
            node_pool_free(sched);
            
            free_raw(sched);
        }
    }
}

// Submits a normal priority node
fn df_sched_submit(sched: t40, node: t40) -> t40 {
    var rq: t40 = 0;
    var active: t40 = 0;
    unsafe {
        rq = load(sched);
        active = load(sched + 1);
    }
    
    var ok: t40 = ring_write(rq, node);
    match ok {
        pos => {
            unsafe {
                store(node, 0); // state = READY (0)
                store(node + 5, 0); // reset inputs_satisfied_count
                store(sched + 1, active + 1);
            }
            return 1;
        }
        _ => { return 0; }
    }
}

// Submits a high priority cancellation node (goes to urgent queue)
fn df_sched_submit_priority(sched: t40, node: t40) -> t40 {
    var uq: t40 = 0;
    var active: t40 = 0;
    unsafe {
        uq = load(sched + 3);
        active = load(sched + 1);
    }
    
    var ok: t40 = ring_write(uq, node);
    match ok {
        pos => {
            unsafe {
                store(node, 0 - 1); // state = CANCELLED (-1)
                store(node + 5, 0); // reset inputs_satisfied_count
                store(sched + 1, active + 1);
            }
            return 1;
        }
        _ => { return 0; }
    }
}

// Executes all submitted nodes in the scheduler to completion.
fn df_sched_run_loop(sched: t40) -> t40 {
    var rq: t40 = 0;
    var uq: t40 = 0;
    unsafe {
        rq = load(sched);
        uq = load(sched + 3);
    }

    var loop_active: t40 = 1;
    var had_error: t40 = 0;
    while loop_active > 0 {
        var active_count: t40 = 0;
        unsafe { active_count = load(sched + 1); }
        
        match active_count {
            zero => { loop_active = 0; }
            neg => { loop_active = 0; }
            pos => {
                var node: t40 = 0;
                var is_uq_empty: t40 = ring_empty(uq);
                match is_uq_empty {
                    pos => {
                        // Urgent empty: read from normal queue
                        var is_rq_empty: t40 = ring_empty(rq);
                        match is_rq_empty {
                            pos => {
                                // Deadlock! active_count > 0 but both queues empty
                                return 0 - 1;
                            }
                            _ => {
                                node = ring_read(rq);
                            }
                        }
                    }
                    _ => {
                        node = ring_read(uq);
                    }
                }

                match node {
                    zero => {
                        return 0 - 1;
                    }
                    neg => { loop_active = 0; }
                    pos => {
                        // Execute node callback. Unknown/failed kinds cancel the node
                        // and make the scheduler report failure after draining work.
                        var execute_ok: t40 = df_node_execute(node);
                        match execute_ok {
                            pos => {}
                            _ => {
                                unsafe { store(node, 0 - 1); }
                                had_error = 0 - 1;
                            }
                        }
                        
                        // Reset satisfied count to support streaming tick loops
                        unsafe { store(node + 5, 0); }
                        
                        // Set state to DONE (1) or preserve CANCELLED state (if state is -1)
                        var current_state: t40 = 0;
                        unsafe { current_state = load(node); }
                        match current_state {
                            neg => {} // keep cancelled state (-1)
                            _ => {
                                unsafe { store(node, 1); } // set state to DONE (1)
                            }
                        }
                        
                        // Decrement active count
                        var new_active: t40 = 0;
                        unsafe {
                            new_active = load(sched + 1) - 1;
                            store(sched + 1, new_active);
                        }
                        
                        // Wake up downstream dependents
                        var deps: t40 = 0;
                        unsafe { deps = load(node + 4); }
                        var dep_len: t40 = vec_len(deps);
                        var i: t40 = 0;
                        while dep_len - i > 0 {
                            var dep_node: t40 = vec_get(deps, i);
                            
                            // Increment input satisfied count
                            var satisfied: t40 = 0;
                            unsafe {
                                satisfied = load(dep_node + 5) + 1;
                                store(dep_node + 5, satisfied);
                            }
                            
                            // Check threshold required inputs (OPT 7)
                            var dep_inputs: t40 = 0;
                            unsafe { dep_inputs = load(dep_node + 2); }
                            var input_len: t40 = vec_len(dep_inputs);
                            
                            var required: t40 = 0;
                            unsafe { required = load(dep_node + 8); }
                            match required {
                                zero => { required = input_len; } // Default: AND-join
                                _ => {}
                            }
                            
                            match required - satisfied {
                                zero => {
                                    // Wake up child. If parent node was cancelled/error, submit with priority
                                    var parent_state: t40 = 0;
                                    unsafe { parent_state = load(node); }
                                    match parent_state {
                                        neg => {
                                            var submitted: t40 = df_sched_submit_priority(sched, dep_node);
                                            match submitted {
                                                pos => {}
                                                _ => { had_error = 0 - 1; }
                                            }
                                        }
                                        _ => {
                                            var submitted: t40 = df_sched_submit(sched, dep_node);
                                            match submitted {
                                                pos => {}
                                                _ => { had_error = 0 - 1; }
                                            }
                                        }
                                    }
                                }
                                _ => {} // Already triggered or not yet ready
                            }
                            i = i + 1;
                        }
                    }
                }
            }
        }
    }
    return had_error;
}


// =============================================================================
// SECTION 5 — Graph Validation Pass (OPT 6)
// Performs cycle checks using ternary coloring.
// =============================================================================

fn df_graph_validate(nodes: t40) -> t40 {
    var count: t40 = vec_len(nodes);
    
    // Phase 1: Initialize traversal scratch to 0 (white). Execution state in
    // node[0] is deliberately left untouched.
    var i: t40 = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        unsafe { store(node + 9, 0); }
        i = i + 1;
    }
    
    // Phase 2: Run DFS checks for cycle detection
    i = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        var state: t40 = 0;
        unsafe { state = load(node + 9); }
        match state {
            zero => {
                var res: t40 = df_dfs_check(node);
                match res {
                    neg => {
                        df_graph_clear_marks(nodes);
                        return 0 - 1; // Cycle detected!
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        i = i + 1;
    }
    
    df_graph_clear_marks(nodes);
    return 0; // Graph is valid!
}

// Clears graph-only traversal state without changing scheduler execution state.
fn df_graph_clear_marks(nodes: t40) -> void {
    var count: t40 = vec_len(nodes);
    var i: t40 = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        unsafe { store(node + 9, 0); }
        i = i + 1;
    }
}

// Internal recursive helper for cycle validation
fn df_dfs_check(node: t40) -> t40 {
    // Color node as gray (1)
    unsafe { store(node + 9, 1); }
    
    var deps: t40 = 0;
    unsafe { deps = load(node + 4); }
    var dep_len: t40 = vec_len(deps);
    
    var i: t40 = 0;
    while dep_len - i > 0 {
        var dep_node: t40 = vec_get(deps, i);
        var state: t40 = 0;
        unsafe { state = load(dep_node + 9); }
        
        match state {
            pos => {
                // Gray node hit: cycle detected!
                return 0 - 1;
            }
            zero => {
                // White node hit: recurse
                var res: t40 = df_dfs_check(dep_node);
                match res {
                    neg => { return 0 - 1; }
                    _ => {}
                }
            }
            _ => {} // Black node: skip
        }
        i = i + 1;
    }
    
    // Color node as black (-1)
    unsafe { store(node + 9, 0 - 1); }
    return 0;
}


// =============================================================================
// SECTION 6 — Static Graph Compilation (OPT 10)
// Performs compile-time topological sort and executes static pipelines.
// =============================================================================

fn df_graph_topo_sort(nodes: t40) -> t40 {
    var count: t40 = vec_len(nodes);
    var topo_order: t40 = vec_new();
    
    // Phase 1: Initialize traversal scratch to 0 (white).
    var i: t40 = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        unsafe { store(node + 9, 0); }
        i = i + 1;
    }
    
    // Phase 2: Run DFS to obtain post-order listing
    i = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        var state: t40 = 0;
        unsafe { state = load(node + 9); }
        match state {
            zero => {
                var result: t40 = df_topo_dfs(node, topo_order);
                match result {
                    neg => {
                        df_graph_clear_marks(nodes);
                        vec_free(topo_order);
                        return 0;
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        i = i + 1;
    }
    
    df_graph_clear_marks(nodes);
    return topo_order;
}

// Internal recursive DFS helper for topological sorting
fn df_topo_dfs(node: t40, topo_order: t40) -> t40 {
    unsafe { store(node + 9, 1); } // Color gray (1)
    
    var deps: t40 = 0;
    unsafe { deps = load(node + 4); }
    var dep_len: t40 = vec_len(deps);
    
    var i: t40 = 0;
    while dep_len - i > 0 {
        var dep_node: t40 = vec_get(deps, i);
        var state: t40 = 0;
        unsafe { state = load(dep_node + 9); }
        match state {
            pos => { return 0 - 1; }
            zero => {
                var result: t40 = df_topo_dfs(dep_node, topo_order);
                match result {
                    neg => { return 0 - 1; }
                    _ => {}
                }
            }
            neg => {}
        }
        i = i + 1;
    }
    
    unsafe { store(node + 9, 0 - 1); } // Color black (-1)
    vec_push(topo_order, node);
    return 0;
}

// Runs a topologically sorted pipeline with zero scheduling overhead.
fn df_sched_run_static(sched: t40, topo_order: t40) -> t40 {
    var len: t40 = vec_len(topo_order);
    var i: t40 = len - 1;
    while i >= 0 {
        var node: t40 = vec_get(topo_order, i);
        var execute_ok: t40 = df_node_execute(node);
        match execute_ok {
            pos => {}
            _ => {
                unsafe { store(node, 0 - 1); }
                return 0 - 1;
            }
        }
        
        // Mark node as DONE (1) and reset satisfied count
        unsafe {
            store(node, 1);
            store(node + 5, 0);
        }
        i = i - 1;
    }
    return 0;
}
