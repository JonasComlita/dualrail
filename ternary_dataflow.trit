// =============================================================================
// ternary_dataflow.trit  -  An Optimized Ternary Reactive Dataflow Runtime
// =============================================================================

const DF_NODE_WORDS: t40 = 38;
const DF_NODE_OWNER: t40 = 28;
const DF_NODE_STREAM_REGISTERED: t40 = 29;
const DF_NODE_PHASE: t40 = 30;
const DF_NODE_PENDING_COUNT: t40 = 31;
const DF_NODE_PENDING0_TAG: t40 = 32;
const DF_NODE_PENDING0_VALUE: t40 = 33;
const DF_NODE_PENDING1_TAG: t40 = 34;
const DF_NODE_PENDING1_VALUE: t40 = 35;
const DF_NODE_SCRATCH_VALUE: t40 = 36;
const DF_NODE_FLAGS: t40 = 37;
const DF_NODE_PHASE_IDLE: t40 = 0;
const DF_NODE_PHASE_RUNNING: t40 = 1;
const DF_NODE_PHASE_EOS_PENDING: t40 = 2;
const DF_NODE_PHASE_DONE: t40 = 3;
const DF_NODE_PHASE_ERROR: t40 = 0 - 1;

const DF_SCHED_WORDS: t40 = 22;
const DF_SCHED_CHANNELS: t40 = 7;
const DF_SCHED_CHANNEL_COUNT: t40 = 8;
const DF_SCHED_STREAMS: t40 = 9;
const DF_SCHED_STREAM_COUNT: t40 = 10;
const DF_SCHED_ROUND_ROBIN: t40 = 11;
const DF_SCHED_LIFECYCLE: t40 = 12;
const DF_SCHED_CANCEL: t40 = 13;
const DF_SCHED_LAST_ATTEMPTS: t40 = 14;
const DF_SCHED_LAST_PROGRESS: t40 = 15;
const DF_SCHED_STARTED: t40 = 16;
const DF_SCHED_CONSTRUCTION_ERROR: t40 = 17;
const DF_SCHED_VALIDATION_RESULT: t40 = 18;
const DF_SCHED_LAST_ERROR_NODE: t40 = 19;
const DF_SCHED_BUDGET_TURN: t40 = 20;
const DF_SCHED_PRIORITY_TURN: t40 = 21;

const DF_CALLBACK_PROGRESS: t40 = 1;
const DF_CALLBACK_BLOCKED_INPUT: t40 = 2;
const DF_CALLBACK_BLOCKED_OUTPUT: t40 = 3;
const DF_CALLBACK_DONE: t40 = 4;
const DF_CALLBACK_ERROR: t40 = 0 - 1;

const DF_SCHED_LIFECYCLE_RUNNING: t40 = 1;
const DF_SCHED_LIFECYCLE_DONE: t40 = 2;
const DF_SCHED_LIFECYCLE_ERROR: t40 = 0 - 1;

// =============================================================================
// SECTION 1 — Node Pool Bump Allocator (OPT 1)
// Lay out node slots with inline vectors and persistent callback scratch.
// Slot size = DF_NODE_WORDS (38); offsets 0..27 keep their legacy meanings:
//   node[0..9]: standard fields and traversal scratch (10 words)
//   node[10..15]: inputs vector struct & inline storage (6 words)
//   node[16..21]: outputs vector struct & inline storage (6 words)
//   node[22..27]: dependents vector struct & inline storage (6 words)
//   node[28..31]: owner, stream registration, lifecycle phase, pending count
//   node[32..35]: two pending tag/value events
//   node[36..37]: callback scratch value and reserved flags
// =============================================================================

// The pool is scheduler-owned:
//   sched[4] = node_pool_ptr, sched[5] = used, sched[6] = capacity.
fn node_pool_init(sched: t40, capacity: t40) -> t40 {
    match capacity {
        pos => {
            var pool: t40 = malloc_raw(capacity * DF_NODE_WORDS);
            match pool {
                pos => {
                    unsafe {
                        store(sched + 4, pool);
                        store(sched + 5, 0);
                        store(sched + 6, capacity);
                    }
                    return pool;
                }
                _ => { return 0; }
            }
        }
        _ => { return 0; }
    }
}

fn node_pool_alloc(sched: t40) -> t40 {
    var pool: t40 = 0;
    var used: t40 = 0;
    var capacity: t40 = 0;
    unsafe {
        pool = load(sched + 4);
        used = load(sched + 5);
        capacity = load(sched + 6);
    }
    match pool {
        pos => {
            match capacity - used {
                pos => {
                    var node: t40 = pool + used * DF_NODE_WORDS;
                    unsafe { store(sched + 5, used + 1); }
                    return node;
                }
                _ => {
                    unsafe { store(sched + DF_SCHED_CONSTRUCTION_ERROR, 1); }
                    return 0;
                }
            }
        }
        _ => {
            unsafe { store(sched + DF_SCHED_CONSTRUCTION_ERROR, 1); }
            return 0;
        }
    }
}

fn node_pool_free(sched: t40) -> void {
    var pool: t40 = 0;
    unsafe { pool = load(sched + 4); }
    match pool {
        pos => { free_raw(pool); }
        _ => {}
    }
    unsafe {
        store(sched + 4, 0);
        store(sched + 5, 0);
        store(sched + 6, 0);
    }
}

fn df_node_kind_valid(kind: t40) -> t40 {
    if df_bool_or(df_bool_or(df_bool_or(kind == 0, kind == 1),
                             df_bool_or(kind == 2, kind == 3)), kind == 4) { return 1; }
    if kind > 4 { return df_service_kind_valid(kind); }
    return 0;
}

fn df_sched_mark_construction_error(sched: t40) -> void {
    if sched > 0 {
        unsafe { store(sched + DF_SCHED_CONSTRUCTION_ERROR, 1); }
    }
}

fn df_sched_owns_node(sched: t40, node: t40) -> t40 {
    if df_bool_or(sched <= 0, node <= 0) { return 0; }
    var pool: t40 = 0;
    var used: t40 = 0;
    unsafe { pool = load(sched + 4); used = load(sched + 5); }
    var i: t40 = 0;
    while used - i > 0 {
        if pool + i * DF_NODE_WORDS == node { return 1; }
        i = i + 1;
    }
    return 0;
}

// Sized vector creator (kept for compatibility)
fn df_vec_new_sized(initial_cap: t40) -> t40 {
    var vec: t40 = malloc_raw(3);
    match vec {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = malloc_raw(initial_cap);
            match data {
                zero => { free_raw(vec); return 0; }
                neg => { free_raw(vec); return 0; }
                pos => {
                    unsafe {
                        store(vec,     data);
                        store(vec + 1, 0);
                        store(vec + 2, initial_cap);
                    }
                    return vec;
                }
            }
        }
    }
}

// Safe vector push helper supporting inline array growth
fn df_vec_push_safe(vec: t40, val: t40) -> t40 {
    match vec {
        pos => {}
        _ => { return 0; }
    }
    var len: t40 = 0;
    var cap: t40 = 0;
    var data: t40 = 0;
    unsafe {
        data = load(vec);
        len = load(vec + 1);
        cap = load(vec + 2);
    }
    match cap - len - 1 {
        neg => {
            var new_cap: t40 = 3;
            match cap {
                pos => { new_cap = cap * 3; }
                _ => {}
            }
            var new_data: t40 = malloc_raw(new_cap);
            match new_data {
                pos => {
                    memcpy(new_data, data, len);
                    // Only free if old data was not inline (inline starts at vec + 3)
                    match data - (vec + 3) {
                        zero => {}
                        _ => { free_raw(data); }
                    }
                    unsafe {
                        store(vec, new_data);
                        store(vec + 2, new_cap);
                    }
                    data = new_data;
                }
                _ => { return 0; }
            }
        }
        _ => {}
    }
    unsafe {
        store(data + len, val);
        store(vec + 1, len + 1);
    }
    return 1;
}

// Safe vector free helper (only frees heap data arrays, avoids inline vector structs)
fn df_vec_free_safe(vec: t40) -> void {
    var data: t40 = 0;
    unsafe { data = load(vec); }
    match data {
        zero => {}
        neg => {}
        pos => {
            match data - (vec + 3) {
                zero => {}
                _ => { free_raw(data); }
            }
        }
    }
}


// =============================================================================
// SECTION 2 — Dataflow Channel (DFChannel)
// FIFO of tagged events. Payload sign and value are never control metadata.
// Struct: [0]=event storage, [1]=capacity, [2]=read index,
//         [3]=write index, [4]=event count. Each slot is [tag, value].
// =============================================================================

const DF_EVENT_NONE: t40 = 0;
const DF_EVENT_DATA: t40 = 1;
const DF_EVENT_ANOMALY: t40 = 0 - 1;
const DF_EVENT_UNCERTAIN: t40 = 0 - 2;
const DF_EVENT_EOS: t40 = 0 - 3;
const DF_EVENT_ERROR: t40 = 0 - 4;
const DF_EVENT_CANCEL: t40 = 0 - 5;

fn df_channel_new(capacity: t40) -> t40 {
    match capacity {
        pos => {
            var chan: t40 = malloc_raw(5);
            match chan {
                pos => {
                    var data: t40 = malloc_raw(capacity * 2);
                    match data {
                        pos => {
                            unsafe {
                                store(chan, data);
                                store(chan + 1, capacity);
                                store(chan + 2, 0);
                                store(chan + 3, 0);
                                store(chan + 4, 0);
                            }
                            return chan;
                        }
                        _ => { free_raw(chan); return 0; }
                    }
                }
                _ => { return 0; }
            }
        }
        _ => { return 0; }
    }
}

fn df_channel_free(chan: t40) -> void {
    match chan {
        pos => {
            var data: t40 = 0;
            unsafe { data = load(chan); }
            match data {
                pos => { free_raw(data); }
                _ => {}
            }
            free_raw(chan);
        }
        _ => {}
    }
}

// Writes one tagged event. Returns 1 on success, 0 for invalid/full channels.
fn df_channel_write_event(chan: t40, tag: t40, val: t40) -> t40 {
    match chan {
        pos => {}
        _ => { return 0; }
    }
    match tag {
        zero => { return 0; }
        _ => {}
    }
    var data: t40 = 0;
    var capacity: t40 = 0;
    var write_pos: t40 = 0;
    var count: t40 = 0;
    unsafe {
        data = load(chan);
        capacity = load(chan + 1);
        write_pos = load(chan + 3);
        count = load(chan + 4);
    }
    match capacity - count {
        pos => {
            unsafe {
                store(data + write_pos * 2, tag);
                store(data + write_pos * 2 + 1, val);
            }
            var next_write: t40 = write_pos + 1;
            match next_write - capacity {
                neg => {}
                _ => { next_write = 0; }
            }
            unsafe {
                store(chan + 3, next_write);
                store(chan + 4, count + 1);
            }
            return 1;
        }
        _ => { return 0; }
    }
}

fn df_channel_write(chan: t40, val: t40) -> t40 {
    return df_channel_write_event(chan, DF_EVENT_DATA, val);
}

fn df_channel_write_signal(chan: t40, tag: t40) -> t40 {
    match tag {
        pos => { return 0; }
        zero => { return 0; }
        neg => { return df_channel_write_event(chan, tag, 0); }
    }
}

// Reads the oldest event, stores its payload at out_value, and returns its tag.
// Returns DF_EVENT_NONE without touching out_value when the channel is empty.
fn df_channel_read(chan: t40, out_value: t40) -> t40 {
    match chan {
        pos => {}
        _ => { return DF_EVENT_NONE; }
    }
    match out_value {
        pos => {}
        _ => { return DF_EVENT_NONE; }
    }
    var data: t40 = 0;
    var capacity: t40 = 0;
    var read_pos: t40 = 0;
    var count: t40 = 0;
    unsafe {
        data = load(chan);
        capacity = load(chan + 1);
        read_pos = load(chan + 2);
        count = load(chan + 4);
    }
    match count {
        pos => {
            var tag: t40 = 0;
            var val: t40 = 0;
            unsafe {
                tag = load(data + read_pos * 2);
                val = load(data + read_pos * 2 + 1);
                store(out_value, val);
            }
            var next_read: t40 = read_pos + 1;
            match next_read - capacity {
                neg => {}
                _ => { next_read = 0; }
            }
            unsafe {
                store(chan + 2, next_read);
                store(chan + 4, count - 1);
            }
            return tag;
        }
        _ => { return DF_EVENT_NONE; }
    }
}


// =============================================================================
// SECTION 3 — Dataflow Node (DFNode)
// Struct (10 words + inline vectors):
//   [0] = state (-1 = NOT_READY/CANCELLED, 0 = READY, 1 = DONE)
//   [1] = kind (node kind / dispatcher selector)
//   [2] = inputs_vec pointer
//   [3] = outputs_vec pointer
//   [4] = dependents_vec pointer
//   [5] = inputs_satisfied_count
//   [6] = name_str (for debugging)
//   [7] = custom_data (context pointer)
//   [8] = required_inputs_threshold (AND-join default: incoming dependency count)
//   [9] = graph traversal scratch (white/gray/black; never execution state)
// =============================================================================

fn df_node_new(sched: t40, name: t40, kind: t40, data: t40) -> t40 {
    if sched <= 0 { return 0; }
    var started: t40 = 0;
    unsafe { started = load(sched + DF_SCHED_STARTED); }
    if df_bool_or(started > 0, df_node_kind_valid(kind) == 0) {
        df_sched_mark_construction_error(sched);
        return 0;
    }
    var node: t40 = node_pool_alloc(sched);
    match node {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var inputs: t40 = node + 10;
            var outputs: t40 = node + 16;
            var deps: t40 = node + 22;
            
            unsafe {
                store(node, 0 - 1); // state = NOT_READY (-1)
                store(node + 1, kind);
                store(node + 2, inputs);
                store(node + 3, outputs);
                store(node + 4, deps);
                store(node + 5, 0); // satisfied count
                store(node + 6, name);
                store(node + 7, data);
                store(node + 8, 0); // threshold = 0 (unset, uses default)
                store(node + 9, 0); // graph traversal scratch = white
                store(node + DF_NODE_OWNER, sched);
                store(node + DF_NODE_STREAM_REGISTERED, 0);
                store(node + DF_NODE_PHASE, DF_NODE_PHASE_IDLE);
                store(node + DF_NODE_PENDING_COUNT, 0);
                store(node + DF_NODE_PENDING0_TAG, 0);
                store(node + DF_NODE_PENDING0_VALUE, 0);
                store(node + DF_NODE_PENDING1_TAG, 0);
                store(node + DF_NODE_PENDING1_VALUE, 0);
                store(node + DF_NODE_SCRATCH_VALUE, 0);
                store(node + DF_NODE_FLAGS, 0);
                
                // Initialize inputs inline vector
                store(inputs, node + 13);
                store(inputs + 1, 0);
                store(inputs + 2, 3);
                store(node + 13, 0);
                store(node + 14, 0);
                store(node + 15, 0);
                
                // Initialize outputs inline vector
                store(outputs, node + 19);
                store(outputs + 1, 0);
                store(outputs + 2, 3);
                store(node + 19, 0);
                store(node + 20, 0);
                store(node + 21, 0);
                
                // Initialize dependents inline vector
                store(deps, node + 25);
                store(deps + 1, 0);
                store(deps + 2, 3);
                store(node + 25, 0);
                store(node + 26, 0);
                store(node + 27, 0);
            }
            return node;
        }
    }
}

fn df_node_free(node: t40) -> void {
    match node {
        zero => {}
        neg => {}
        pos => {
            var inputs: t40 = 0;
            var outputs: t40 = 0;
            var deps: t40 = 0;
            unsafe {
                inputs = load(node + 2);
                outputs = load(node + 3);
                deps = load(node + 4);
            }
            df_vec_free_safe(inputs);
            df_vec_free_safe(outputs);
            df_vec_free_safe(deps);
            // Node itself is in the pool, do not free_raw(node)
        }
    }
}

fn df_node_add_input(node: t40, chan: t40) -> t40 {
    if node <= 0 { return 0; }
    var sched: t40 = 0;
    unsafe { sched = load(node + DF_NODE_OWNER); }
    var started: t40 = 0;
    unsafe { started = load(sched + DF_SCHED_STARTED); }
    if df_bool_or(started > 0, chan <= 0) { df_sched_mark_construction_error(sched); return 0; }
    var inputs: t40 = 0;
    unsafe { inputs = load(node + 2); }
    var result: t40 = df_vec_push_safe(inputs, chan);
    if result == 0 { df_sched_mark_construction_error(sched); }
    return result;
}

fn df_node_add_output(node: t40, chan: t40) -> t40 {
    if node <= 0 { return 0; }
    var sched: t40 = 0;
    unsafe { sched = load(node + DF_NODE_OWNER); }
    var started: t40 = 0;
    unsafe { started = load(sched + DF_SCHED_STARTED); }
    if df_bool_or(started > 0, chan <= 0) { df_sched_mark_construction_error(sched); return 0; }
    var outputs: t40 = 0;
    unsafe { outputs = load(node + 3); }
    var result: t40 = df_vec_push_safe(outputs, chan);
    if result == 0 { df_sched_mark_construction_error(sched); }
    return result;
}

fn df_node_add_dependent(parent: t40, child: t40) -> t40 {
    if df_bool_or(parent <= 0, child <= 0) { return 0; }
    var sched: t40 = 0;
    unsafe { sched = load(parent + DF_NODE_OWNER); }
    var started: t40 = 0;
    unsafe { started = load(sched + DF_SCHED_STARTED); }
    if df_bool_or(started > 0, df_sched_owns_node(sched, child) == 0) {
        df_sched_mark_construction_error(sched);
        return 0;
    }
    var deps: t40 = 0;
    unsafe { deps = load(parent + 4); }
    var result: t40 = df_vec_push_safe(deps, child);
    if result == 0 { df_sched_mark_construction_error(sched); }
    return result;
}

// Configures OR-join/Threshold trigger (OPT 7)
fn df_node_set_required_threshold(node: t40, threshold: t40) -> void {
    if node <= 0 { return; }
    var sched: t40 = 0;
    var started: t40 = 0;
    unsafe { sched = load(node + DF_NODE_OWNER); started = load(sched + DF_SCHED_STARTED); }
    if started > 0 { df_sched_mark_construction_error(sched); return; }
    unsafe { store(node + 8, threshold); }
}


// =============================================================================
// SECTION 4 — Dataflow Scheduler (DFScheduler - OPT 3 & OPT 4)
// Ready queue uses two Ring Buffers for O(1) scheduling without CAS.
// [0]=normal queue, [1]=active count, [2]=capacity, [3]=urgent queue,
// [4]=node pool, [5]=pool used, [6]=pool capacity.
// =============================================================================

// Superseded scheduler implementations were removed; public names resolve only to bounded runners.

// Bounded registry scheduler and stream operation budget.
// =============================================================================

fn df_sched_new(capacity: t40) -> t40 {
    if capacity < 2 { return 0; }
    var sched: t40 = malloc_raw(DF_SCHED_WORDS);
    if sched <= 0 { return 0; }
    var i: t40 = 0;
    while DF_SCHED_WORDS - i > 0 {
        unsafe { store(sched + i, 0); }
        i = i + 1;
    }
    unsafe {
        store(sched + 2, capacity);
        store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_RUNNING);
    }
    var rq: t40 = ring_new(capacity + 1);
    var uq: t40 = ring_new(capacity + 1);
    var channels: t40 = malloc_raw(capacity);
    var streams: t40 = malloc_raw(capacity);
    if df_bool_or(df_bool_or(rq <= 0, uq <= 0),
                  df_bool_or(channels <= 0, streams <= 0)) {
        df_arena_reset();
        return 0;
    }
    unsafe {
        store(sched, rq); store(sched + 3, uq);
        store(sched + DF_SCHED_CHANNELS, channels);
        store(sched + DF_SCHED_STREAMS, streams);
    }
    if node_pool_init(sched, capacity) <= 0 {
        df_arena_reset();
        return 0;
    }
    return sched;
}

fn df_sched_free(sched: t40) -> void {
    if sched > 0 { node_pool_free(sched); }
    df_arena_reset();
}

fn df_sched_register_channel(sched: t40, chan: t40) -> t40 {
    if df_bool_or(sched <= 0, chan <= 0) { df_sched_mark_construction_error(sched); return 0; }
    var started: t40 = 0;
    var list: t40 = 0;
    var count: t40 = 0;
    var capacity: t40 = 0;
    unsafe {
        started = load(sched + DF_SCHED_STARTED);
        list = load(sched + DF_SCHED_CHANNELS);
        count = load(sched + DF_SCHED_CHANNEL_COUNT);
        capacity = load(sched + 2);
    }
    if df_bool_or(started > 0, count >= capacity) { df_sched_mark_construction_error(sched); return 0; }
    var i: t40 = 0;
    while count - i > 0 {
        var existing: t40 = 0;
        unsafe { existing = load(list + i); }
        if existing == chan { df_sched_mark_construction_error(sched); return 0; }
        i = i + 1;
    }
    unsafe { store(list + count, chan); store(sched + DF_SCHED_CHANNEL_COUNT, count + 1); }
    return 1;
}

fn df_sched_register_stream(sched: t40, node: t40) -> t40 {
    if df_bool_or(df_bool_or(sched <= 0, node <= 0), df_sched_owns_node(sched, node) == 0) {
        df_sched_mark_construction_error(sched); return 0;
    }
    var started: t40 = 0;
    var list: t40 = 0;
    var count: t40 = 0;
    var capacity: t40 = 0;
    var registered: t40 = 0;
    var kind: t40 = 0;
    unsafe {
        started = load(sched + DF_SCHED_STARTED);
        list = load(sched + DF_SCHED_STREAMS);
        count = load(sched + DF_SCHED_STREAM_COUNT);
        capacity = load(sched + 2);
        registered = load(node + DF_NODE_STREAM_REGISTERED);
        kind = load(node + 1);
    }
    if df_bool_or(df_bool_or(started > 0, registered > 0),
                  df_bool_or(count >= capacity, df_node_kind_valid(kind) == 0)) {
        df_sched_mark_construction_error(sched); return 0;
    }
    unsafe {
        store(list + count, node);
        store(sched + DF_SCHED_STREAM_COUNT, count + 1);
        store(node + DF_NODE_STREAM_REGISTERED, 1);
        store(node + DF_NODE_PHASE, DF_NODE_PHASE_RUNNING);
        store(node, 0);
    }
    return 1;
}

fn df_node_is_cancel_requested(node: t40) -> t40 {
    if node <= 0 { return 0; }
    var sched: t40 = 0;
    unsafe { sched = load(node + DF_NODE_OWNER); }
    if sched <= 0 { return 0; }
    var value: t40 = 0;
    unsafe { value = load(sched + DF_SCHED_CANCEL); }
    return value;
}

fn df_sched_cancel(sched: t40) -> t40 {
    if sched <= 0 { return 0; }
    unsafe { store(sched + DF_SCHED_CANCEL, 1); }
    return 1;
}

fn df_sched_lifecycle(sched: t40) -> t40 {
    if sched <= 0 { return DF_SCHED_LIFECYCLE_ERROR; }
    var result: t40 = 0;
    unsafe { result = load(sched + DF_SCHED_LIFECYCLE); }
    return result;
}

fn df_sched_last_attempts(sched: t40) -> t40 {
    if sched <= 0 { return 0; }
    var result: t40 = 0;
    unsafe { result = load(sched + DF_SCHED_LAST_ATTEMPTS); }
    return result;
}

fn df_sched_last_progress(sched: t40) -> t40 {
    if sched <= 0 { return 0; }
    var result: t40 = 0;
    unsafe { result = load(sched + DF_SCHED_LAST_PROGRESS); }
    return result;
}

fn df_sched_submit(sched: t40, node: t40) -> t40 {
    if df_bool_or(df_bool_or(sched <= 0, node <= 0), df_sched_owns_node(sched, node) == 0) {
        df_sched_mark_construction_error(sched); return 0;
    }
    var registered: t40 = 0;
    var rq: t40 = 0;
    var active: t40 = 0;
    var kind: t40 = 0;
    var phase: t40 = 0;
    unsafe {
        registered = load(node + DF_NODE_STREAM_REGISTERED);
        rq = load(sched);
        active = load(sched + 1);
        kind = load(node + 1);
        phase = load(node + DF_NODE_PHASE);
    }
    if df_bool_or(df_bool_or(registered > 0, df_node_kind_valid(kind) == 0),
                  phase != DF_NODE_PHASE_IDLE) {
        df_sched_mark_construction_error(sched); return 0;
    }
    if ring_write(rq, node) <= 0 { df_sched_mark_construction_error(sched); return 0; }
    unsafe {
        store(node, 0); store(node + 5, 0);
        store(node + DF_NODE_PHASE, DF_NODE_PHASE_RUNNING);
        store(sched + 1, active + 1);
    }
    return 1;
}

fn df_sched_submit_priority(sched: t40, node: t40) -> t40 {
    if df_bool_or(df_bool_or(sched <= 0, node <= 0), df_sched_owns_node(sched, node) == 0) {
        df_sched_mark_construction_error(sched); return 0;
    }
    var registered: t40 = 0;
    var queue: t40 = 0;
    var active: t40 = 0;
    var kind: t40 = 0;
    var phase: t40 = 0;
    unsafe {
        registered = load(node + DF_NODE_STREAM_REGISTERED);
        queue = load(sched + 3); active = load(sched + 1);
        kind = load(node + 1); phase = load(node + DF_NODE_PHASE);
    }
    if df_bool_or(df_bool_or(registered > 0, df_node_kind_valid(kind) == 0),
                  phase != DF_NODE_PHASE_IDLE) {
        df_sched_mark_construction_error(sched); return 0;
    }
    if ring_write(queue, node) <= 0 { df_sched_mark_construction_error(sched); return 0; }
    unsafe {
        store(node, 0 - 1); store(node + 5, 0);
        store(node + DF_NODE_PHASE, DF_NODE_PHASE_RUNNING);
        store(sched + 1, active + 1);
    }
    return 1;
}

fn df_node_incoming_count(sched: t40, target: t40) -> t40 {
    var pool: t40 = 0;
    var used: t40 = 0;
    unsafe { pool = load(sched + 4); used = load(sched + 5); }
    var incoming: t40 = 0;
    var ni: t40 = 0;
    while used - ni > 0 {
        var parent: t40 = pool + ni * DF_NODE_WORDS;
        var deps: t40 = 0;
        unsafe { deps = load(parent + 4); }
        var len: t40 = vec_len(deps);
        var di: t40 = 0;
        while len - di > 0 {
            if vec_get(deps, di) == target { incoming = incoming + 1; }
            di = di + 1;
        }
        ni = ni + 1;
    }
    return incoming;
}

fn df_sched_release_dependents(sched: t40, node: t40) -> t40 {
    var deps: t40 = 0;
    unsafe { deps = load(node + 4); }
    var len: t40 = vec_len(deps);
    var i: t40 = 0;
    while len - i > 0 {
        var dependent: t40 = vec_get(deps, i);
        var phase: t40 = 0;
        unsafe { phase = load(dependent + DF_NODE_PHASE); }
        if (phase == DF_NODE_PHASE_IDLE) {
            var satisfied: t40 = 0;
            var required: t40 = 0;
            unsafe {
                satisfied = load(dependent + 5) + 1;
                store(dependent + 5, satisfied);
                required = load(dependent + 8);
            }
            if required == 0 { required = df_node_incoming_count(sched, dependent); }
            if df_bool_or(required <= 0, satisfied > required) { return DF_CALLBACK_ERROR; }
            if satisfied == required {
                if df_sched_submit(sched, dependent) <= 0 { return DF_CALLBACK_ERROR; }
            }
        }
        i = i + 1;
    }
    return DF_CALLBACK_PROGRESS;
}

fn df_sched_choose_one_shot_queue(sched: t40) -> t40 {
    var normal: t40 = 0;
    var urgent: t40 = 0;
    var turn: t40 = 0;
    var queue: t40 = 0;
    unsafe {
        normal = load(sched);
        urgent = load(sched + 3);
        turn = load(sched + DF_SCHED_PRIORITY_TURN);
    }
    if df_bool_and(ring_empty(urgent) == 0, ring_empty(normal) == 0) {
        if turn == 0 { queue = urgent; turn = 1; }
        else { queue = normal; turn = 0; }
    } else if ring_empty(urgent) == 0 { queue = urgent; }
    else if ring_empty(normal) == 0 { queue = normal; }
    unsafe { store(sched + DF_SCHED_PRIORITY_TURN, turn); }
    return queue;
}

fn df_sched_run_loop(sched: t40) -> t40 {
    if sched <= 0 { return DF_CALLBACK_ERROR; }
    var lifecycle: t40 = df_sched_lifecycle(sched);
    if (lifecycle == DF_SCHED_LIFECYCLE_ERROR) { return DF_CALLBACK_ERROR; }
    if (lifecycle == DF_SCHED_LIFECYCLE_DONE) { return 0; }
    if df_sched_validate(sched) < 0 {
        unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR); }
        return DF_CALLBACK_ERROR;
    }
    unsafe { store(sched + DF_SCHED_STARTED, 1); }
    var idle_seen: t40 = 0;
    var keep_running: t40 = 1;
    while keep_running > 0 {
        var queue: t40 = df_sched_choose_one_shot_queue(sched);
        if queue <= 0 { keep_running = 0; }
        if queue > 0 {
            var node: t40 = ring_read(queue);
            if node <= 0 {
                unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR); }
                return DF_CALLBACK_ERROR;
            }
            var result: t40 = df_node_execute(node);
            unsafe { store(node + 5, 0); }
            if (result == DF_CALLBACK_DONE) {
                var active: t40 = 0;
                unsafe {
                    store(node, 1); store(node + DF_NODE_PHASE, DF_NODE_PHASE_DONE);
                    active = load(sched + 1);
                    if active > 0 { store(sched + 1, active - 1); }
                }
                if df_sched_release_dependents(sched, node) < 0 {
                    unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR); }
                    return DF_CALLBACK_ERROR;
                }
                idle_seen = 0;
            } else if (result == DF_CALLBACK_ERROR) {
                unsafe {
                    store(node, 0 - 1); store(node + DF_NODE_PHASE, DF_NODE_PHASE_ERROR);
                    store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR);
                    store(sched + DF_SCHED_LAST_ERROR_NODE, node);
                }
                return DF_CALLBACK_ERROR;
            } else {
                unsafe { store(node, 0); }
                if ring_write(queue, node) <= 0 {
                    unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR); }
                    return DF_CALLBACK_ERROR;
                }
                idle_seen = idle_seen + 1;
                var active: t40 = 0;
                unsafe { active = load(sched + 1); }
                if idle_seen >= active { keep_running = 0; }
            }
        }
    }
    var streams: t40 = 0;
    var active_queue: t40 = 0;
    unsafe { streams = load(sched + DF_SCHED_STREAM_COUNT); active_queue = load(sched + 1); }
    if df_bool_and(streams == 0, active_queue == 0) {
        unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_DONE); }
    }
    return 0;
}

fn df_sched_one_shot_ready(sched: t40) -> t40 {
    if sched <= 0 { return 0; }
    var normal: t40 = 0;
    var urgent: t40 = 0;
    unsafe { normal = load(sched); urgent = load(sched + 3); }
    if df_bool_or(ring_empty(urgent) == 0, ring_empty(normal) == 0) { return 1; }
    return 0;
}

fn df_sched_one_shot_operation(sched: t40) -> t40 {
    var queue: t40 = df_sched_choose_one_shot_queue(sched);
    if queue <= 0 { return DF_CALLBACK_BLOCKED_INPUT; }
    var node: t40 = ring_read(queue);
    if node <= 0 { return DF_CALLBACK_ERROR; }
    var result: t40 = df_node_execute(node);
    unsafe { store(node + 5, 0); }
    if (result == DF_CALLBACK_DONE) {
        var active: t40 = 0;
        unsafe {
            store(node, 1); store(node + DF_NODE_PHASE, DF_NODE_PHASE_DONE);
            active = load(sched + 1);
            if active > 0 { store(sched + 1, active - 1); }
        }
        if df_sched_release_dependents(sched, node) < 0 { return DF_CALLBACK_ERROR; }
        return DF_CALLBACK_DONE;
    }
    if (result == DF_CALLBACK_ERROR) {
        unsafe {
            store(node, 0 - 1); store(node + DF_NODE_PHASE, DF_NODE_PHASE_ERROR);
            store(sched + DF_SCHED_LAST_ERROR_NODE, node);
        }
        return DF_CALLBACK_ERROR;
    }
    unsafe { store(node, 0); }
    if ring_write(queue, node) <= 0 { return DF_CALLBACK_ERROR; }
    return result;
}

fn df_sched_run_budget(sched: t40, requested_budget: t40) -> t40 {
    if sched <= 0 { return 0; }
    var lifecycle: t40 = df_sched_lifecycle(sched);
    if df_bool_or(lifecycle == DF_SCHED_LIFECYCLE_DONE,
                  lifecycle == DF_SCHED_LIFECYCLE_ERROR) { return 0; }
    if df_sched_validate(sched) < 0 {
        unsafe {
            store(sched + DF_SCHED_STARTED, 1);
            store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR);
            store(sched + DF_SCHED_LAST_ATTEMPTS, 0);
            store(sched + DF_SCHED_LAST_PROGRESS, 0);
        }
        return 0;
    }
    unsafe { store(sched + DF_SCHED_STARTED, 1); }
    var count: t40 = 0;
    var list: t40 = 0;
    var cursor: t40 = 0;
    unsafe { count = load(sched + DF_SCHED_STREAM_COUNT); list = load(sched + DF_SCHED_STREAMS); cursor = load(sched + DF_SCHED_ROUND_ROBIN); }
    var active_remaining: t40 = count;
    var i: t40 = 0;
    while count - i > 0 {
        var n: t40 = 0;
        unsafe { n = load(list + i); }
        var phase: t40 = 0;
        unsafe { phase = load(n + DF_NODE_PHASE); }
        if df_bool_or(phase == DF_NODE_PHASE_DONE, phase == DF_NODE_PHASE_ERROR) {
            active_remaining = active_remaining - 1;
        }
        i = i + 1;
    }
    var startup_ready: t40 = df_sched_one_shot_ready(sched);
    if df_bool_and(active_remaining == 0, startup_ready == 0) {
        unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_DONE); }
        return 0;
    }
    var budget: t40 = requested_budget;
    if budget <= 0 { return 0; }
    if budget > 32 { budget = 32; }
    var attempts: t40 = 0;
    var progress: t40 = 0;
    var no_progress_scan: t40 = 0;
    var stop: t40 = 0;
    var turn: t40 = 0;
    unsafe { turn = load(sched + DF_SCHED_BUDGET_TURN); }
    while df_bool_and(attempts < budget, stop == 0) {
        var choose_stream: t40 = 0;
        var choose_startup: t40 = 0;
        startup_ready = df_sched_one_shot_ready(sched);
        if df_bool_and(active_remaining > 0, startup_ready > 0) {
            if turn == 0 { choose_stream = 1; turn = 1; }
            else { choose_startup = 1; turn = 0; }
        } else if active_remaining > 0 { choose_stream = 1; }
        else if startup_ready > 0 { choose_startup = 1; }
        else { stop = 1; }
        if choose_stream > 0 {
            var search: t40 = 0;
            var chosen: t40 = 0;
            var node: t40 = 0;
            while df_bool_and(search < count, chosen == 0) {
                if cursor >= count { cursor = 0; }
                unsafe { node = load(list + cursor); }
                cursor = cursor + 1;
                var phase: t40 = 0;
                unsafe { phase = load(node + DF_NODE_PHASE); }
                if df_bool_and(phase != DF_NODE_PHASE_DONE,
                               phase != DF_NODE_PHASE_ERROR) { chosen = 1; }
                search = search + 1;
            }
            unsafe { store(sched + DF_SCHED_ROUND_ROBIN, cursor); }
            if chosen > 0 {
                var result: t40 = df_node_execute(node);
                attempts = attempts + 1;
                if (result == DF_CALLBACK_PROGRESS) {
                    progress = progress + 1; no_progress_scan = 0;
                } else if (result == DF_CALLBACK_DONE) {
                    progress = progress + 1; no_progress_scan = 0;
                    active_remaining = active_remaining - 1;
                    unsafe { store(node, 1); store(node + DF_NODE_PHASE, DF_NODE_PHASE_DONE); }
                } else if df_bool_or(result == DF_CALLBACK_BLOCKED_INPUT,
                                     result == DF_CALLBACK_BLOCKED_OUTPUT) {
                    no_progress_scan = no_progress_scan + 1;
                } else {
                    progress = progress + 1; stop = 1;
                    unsafe {
                        store(node, 0 - 1); store(node + DF_NODE_PHASE, DF_NODE_PHASE_ERROR);
                        store(sched + DF_SCHED_LAST_ERROR_NODE, node);
                        store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR);
                    }
                }
            }
        } else if choose_startup > 0 {
            var result: t40 = df_sched_one_shot_operation(sched);
            attempts = attempts + 1;
            if (result == DF_CALLBACK_DONE) {
                progress = progress + 1; no_progress_scan = 0;
            } else if (result == DF_CALLBACK_ERROR) {
                stop = 1;
                unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR); }
            } else {
                if (result == DF_CALLBACK_PROGRESS) { progress = progress + 1; }
                no_progress_scan = no_progress_scan + 1;
            }
        }
        var startup_count: t40 = 0;
        unsafe { startup_count = load(sched + 1); }
        var scan_limit: t40 = active_remaining + startup_count;
        if scan_limit <= 0 { scan_limit = 1; }
        if no_progress_scan >= scan_limit { stop = 1; }
    }
    unsafe {
        store(sched + DF_SCHED_LAST_ATTEMPTS, attempts);
        store(sched + DF_SCHED_LAST_PROGRESS, progress);
        store(sched + DF_SCHED_BUDGET_TURN, turn);
    }
    if (df_sched_lifecycle(sched) == DF_SCHED_LIFECYCLE_ERROR) { return attempts; }
    var queued_startup: t40 = 0;
    unsafe { queued_startup = load(sched + 1); }
    if df_bool_and(active_remaining == 0, queued_startup == 0) {
        unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_DONE); }
    } else {
        unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_RUNNING); }
    }
    return attempts;
}

fn df_sched_uncommitted_count(sched: t40) -> t40 {
    if sched <= 0 { return 0; }
    var total: t40 = 0;
    var channels: t40 = 0;
    var channel_count: t40 = 0;
    unsafe { channels = load(sched + DF_SCHED_CHANNELS); channel_count = load(sched + DF_SCHED_CHANNEL_COUNT); }
    var ci: t40 = 0;
    while channel_count - ci > 0 {
        var chan: t40 = 0;
        unsafe { chan = load(channels + ci); }
        var data: t40 = 0;
        var cap: t40 = 0;
        var read_pos: t40 = 0;
        var queued: t40 = 0;
        unsafe { data = load(chan); cap = load(chan + 1); read_pos = load(chan + 2); queued = load(chan + 4); }
        var qi: t40 = 0;
        while queued - qi > 0 {
            var slot: t40 = read_pos + qi;
            if slot >= cap { slot = slot - cap; }
            var tag: t40 = 0;
            unsafe { tag = load(data + slot * 2); }
            if (tag != DF_EVENT_EOS) { total = total + 1; }
            qi = qi + 1;
        }
        ci = ci + 1;
    }
    var pool: t40 = 0;
    var used: t40 = 0;
    unsafe { pool = load(sched + 4); used = load(sched + 5); }
    var ni: t40 = 0;
    while used - ni > 0 {
        var node: t40 = pool + ni * DF_NODE_WORDS;
        var pending: t40 = 0;
        unsafe { pending = load(node + DF_NODE_PENDING_COUNT); }
        var pi: t40 = 0;
        while pending - pi > 0 {
            var tag: t40 = 0;
            if pi == 0 { unsafe { tag = load(node + DF_NODE_PENDING0_TAG); } }
            else { unsafe { tag = load(node + DF_NODE_PENDING1_TAG); } }
            if (tag != DF_EVENT_EOS) { total = total + 1; }
            pi = pi + 1;
        }
        var kind: t40 = 0;
        var context: t40 = 0;
        unsafe { kind = load(node + 1); context = load(node + 7); }
        if df_bool_and(kind == 2, context > 0) {
            var partial_count: t40 = 0;
            unsafe { partial_count = load(context + 1); }
            if partial_count > 0 { total = total + 1; }
        }
        ni = ni + 1;
    }
    return total;
}

fn df_node_pending_push(node: t40, tag: t40, value: t40) -> t40 {
    if df_bool_or(node <= 0, tag == DF_EVENT_NONE) { return 0; }
    var count: t40 = 0;
    unsafe { count = load(node + DF_NODE_PENDING_COUNT); }
    if count == 0 {
        unsafe {
            store(node + DF_NODE_PENDING0_TAG, tag);
            store(node + DF_NODE_PENDING0_VALUE, value);
            store(node + DF_NODE_PENDING_COUNT, 1);
        }
        return 1;
    }
    if count == 1 {
        unsafe {
            store(node + DF_NODE_PENDING1_TAG, tag);
            store(node + DF_NODE_PENDING1_VALUE, value);
            store(node + DF_NODE_PENDING_COUNT, 2);
        }
        return 1;
    }
    return 0;
}

fn df_node_pending_flush(node: t40) -> t40 {
    if node <= 0 { return DF_CALLBACK_ERROR; }
    var count: t40 = 0;
    unsafe { count = load(node + DF_NODE_PENDING_COUNT); }
    if count <= 0 { return DF_CALLBACK_PROGRESS; }
    var outputs: t40 = 0;
    unsafe { outputs = load(node + 3); }
    if vec_len(outputs) <= 0 { return DF_CALLBACK_ERROR; }
    var chan: t40 = vec_get(outputs, 0);
    var tag: t40 = 0;
    var value: t40 = 0;
    unsafe { tag = load(node + DF_NODE_PENDING0_TAG); value = load(node + DF_NODE_PENDING0_VALUE); }
    if df_channel_write_event(chan, tag, value) <= 0 { return DF_CALLBACK_BLOCKED_OUTPUT; }
    if count == 2 {
        var tag1: t40 = 0;
        var value1: t40 = 0;
        unsafe { tag1 = load(node + DF_NODE_PENDING1_TAG); value1 = load(node + DF_NODE_PENDING1_VALUE); }
        unsafe {
            store(node + DF_NODE_PENDING0_TAG, tag1);
            store(node + DF_NODE_PENDING0_VALUE, value1);
            store(node + DF_NODE_PENDING1_TAG, 0);
            store(node + DF_NODE_PENDING1_VALUE, 0);
            store(node + DF_NODE_PENDING_COUNT, 1);
        }
    } else {
        unsafe {
            store(node + DF_NODE_PENDING_COUNT, 0);
            store(node + DF_NODE_PENDING0_TAG, 0);
            store(node + DF_NODE_PENDING0_VALUE, 0);
        }
    }
    if df_bool_and(tag == DF_EVENT_EOS, df_node_pending_count(node) == 0) {
        unsafe { store(node + DF_NODE_PHASE, DF_NODE_PHASE_DONE); store(node, 1); }
        return DF_CALLBACK_DONE;
    }
    return DF_CALLBACK_PROGRESS;
}

fn df_node_pending_count(node: t40) -> t40 {
    if node <= 0 { return 0; }
    var count: t40 = 0;
    unsafe { count = load(node + DF_NODE_PENDING_COUNT); }
    return count;
}

// =============================================================================
// SECTION 5 — Graph Validation Pass (OPT 6)
// Performs cycle checks using ternary coloring.
// =============================================================================

fn df_graph_validate(nodes: t40) -> t40 {
    if nodes <= 0 { return 0; }
    var count: t40 = vec_len(nodes);
    if count <= 0 { return 0; }
    var first: t40 = vec_get(nodes, 0);
    if first <= 0 { return 0 - 1; }
    var sched: t40 = 0;
    unsafe { sched = load(first + DF_NODE_OWNER); }
    if sched <= 0 { return 0 - 1; }
    var i: t40 = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        if df_bool_or(node <= 0, df_sched_owns_node(sched, node) == 0) { return 0 - 1; }
        var j: t40 = 0;
        while j < i {
            if vec_get(nodes, j) == node { return 0 - 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    return df_sched_validate(sched);
}

fn df_sched_channel_registered(sched: t40, chan: t40) -> t40 {
    var list: t40 = 0;
    var count: t40 = 0;
    unsafe { list = load(sched + DF_SCHED_CHANNELS); count = load(sched + DF_SCHED_CHANNEL_COUNT); }
    var i: t40 = 0;
    while count - i > 0 {
        var existing: t40 = 0;
        unsafe { existing = load(list + i); }
        if existing == chan { return 1; }
        i = i + 1;
    }
    return 0;
}

fn df_sched_validate(sched: t40) -> t40 {
    if sched <= 0 { return 0 - 1; }
    var construction_error: t40 = 0;
    var pool: t40 = 0;
    var used: t40 = 0;
    var pool_capacity: t40 = 0;
    var channel_count: t40 = 0;
    var stream_count: t40 = 0;
    var sched_capacity: t40 = 0;
    var channel_list: t40 = 0;
    var stream_list: t40 = 0;
    unsafe {
        construction_error = load(sched + DF_SCHED_CONSTRUCTION_ERROR);
        pool = load(sched + 4); used = load(sched + 5); pool_capacity = load(sched + 6);
        sched_capacity = load(sched + 2);
        channel_count = load(sched + DF_SCHED_CHANNEL_COUNT);
        stream_count = load(sched + DF_SCHED_STREAM_COUNT);
        channel_list = load(sched + DF_SCHED_CHANNELS);
        stream_list = load(sched + DF_SCHED_STREAMS);
    }
    if df_bool_or(df_bool_or(df_bool_or(construction_error > 0, pool <= 0),
                             df_bool_or(pool_capacity <= 0, used < 0)),
                  df_bool_or(df_bool_or(used > pool_capacity, channel_count > sched_capacity),
                             stream_count > sched_capacity)) {
        unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
        return 0 - 1;
    }
    var ci: t40 = 0;
    while channel_count - ci > 0 {
        var chan: t40 = 0;
        var chan_cap: t40 = 0;
        var queued: t40 = 0;
        unsafe { chan = load(channel_list + ci); chan_cap = load(chan + 1); queued = load(chan + 4); }
        if df_bool_or(df_bool_or(chan <= 0, chan_cap <= 0),
                      df_bool_or(queued < 0, queued > chan_cap)) {
            unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
            return 0 - 1;
        }
        var cj: t40 = 0;
        while cj < ci {
            var prior_channel: t40 = 0;
            unsafe { prior_channel = load(channel_list + cj); }
            if prior_channel == chan {
                unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
                return 0 - 1;
            }
            cj = cj + 1;
        }
        ci = ci + 1;
    }
    var ni: t40 = 0;
    while used - ni > 0 {
        var node: t40 = pool + ni * DF_NODE_WORDS;
        var owner: t40 = 0;
        var kind: t40 = 0;
        var inputs: t40 = 0;
        var outputs: t40 = 0;
        var deps: t40 = 0;
        var threshold: t40 = 0;
        unsafe {
            owner = load(node + DF_NODE_OWNER); kind = load(node + 1);
            inputs = load(node + 2); outputs = load(node + 3); deps = load(node + 4);
            threshold = load(node + 8);
            store(node + 9, 0);
        }
        if df_bool_or(owner != sched, df_node_kind_valid(kind) == 0) {
            unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
            return 0 - 1;
        }
        var input_len: t40 = vec_len(inputs);
        var vi: t40 = 0;
        while input_len - vi > 0 {
            var chan: t40 = vec_get(inputs, vi);
            if df_sched_channel_registered(sched, chan) == 0 {
                unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
                return 0 - 1;
            }
            vi = vi + 1;
        }
        var output_len: t40 = vec_len(outputs);
        vi = 0;
        while output_len - vi > 0 {
            var chan: t40 = vec_get(outputs, vi);
            if df_sched_channel_registered(sched, chan) == 0 {
                unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
                return 0 - 1;
            }
            vi = vi + 1;
        }
        var dep_len: t40 = vec_len(deps);
        var di: t40 = 0;
        while dep_len - di > 0 {
            var dep: t40 = vec_get(deps, di);
            if df_sched_owns_node(sched, dep) == 0 {
                unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
                return 0 - 1;
            }
            var dj: t40 = 0;
            while dj < di {
                if vec_get(deps, dj) == dep {
                    unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
                    return 0 - 1;
                }
                dj = dj + 1;
            }
            di = di + 1;
        }
        var incoming: t40 = df_node_incoming_count(sched, node);
        if df_bool_or(threshold < 0, threshold > incoming) {
            unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
            return 0 - 1;
        }
        ni = ni + 1;
    }
    ni = 0;
    while used - ni > 0 {
        var node: t40 = pool + ni * DF_NODE_WORDS;
        var dfs: t40 = df_dfs_check(node);
        if dfs < 0 {
            var clear_i: t40 = 0;
            while used - clear_i > 0 {
                unsafe { store(pool + clear_i * DF_NODE_WORDS + 9, 0); }
                clear_i = clear_i + 1;
            }
            unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
            return 0 - 1;
        }
        ni = ni + 1;
    }
    ni = 0;
    while used - ni > 0 {
        unsafe { store(pool + ni * DF_NODE_WORDS + 9, 0); }
        ni = ni + 1;
    }
    var si: t40 = 0;
    while stream_count - si > 0 {
        var node: t40 = 0;
        var flag: t40 = 0;
        unsafe { node = load(stream_list + si); flag = load(node + DF_NODE_STREAM_REGISTERED); }
        if df_bool_or(df_sched_owns_node(sched, node) == 0, flag <= 0) {
            unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
            return 0 - 1;
        }
        var sj: t40 = 0;
        while sj < si {
            var prior_stream: t40 = 0;
            unsafe { prior_stream = load(stream_list + sj); }
            if prior_stream == node {
                unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 0 - 1); }
                return 0 - 1;
            }
            sj = sj + 1;
        }
        si = si + 1;
    }
    unsafe { store(sched + DF_SCHED_VALIDATION_RESULT, 1); }
    return 0;
}

// Clears graph-only traversal state without changing scheduler execution state.
fn df_graph_clear_marks(nodes: t40) -> void {
    var count: t40 = vec_len(nodes);
    var i: t40 = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        unsafe { store(node + 9, 0); }
        i = i + 1;
    }
}

// Internal recursive helper for cycle validation
fn df_dfs_check(node: t40) -> t40 {
    // Color node as gray (1)
    unsafe { store(node + 9, 1); }
    
    var deps: t40 = 0;
    unsafe { deps = load(node + 4); }
    var dep_len: t40 = vec_len(deps);
    
    var i: t40 = 0;
    while dep_len - i > 0 {
        var dep_node: t40 = vec_get(deps, i);
        var state: t40 = 0;
        unsafe { state = load(dep_node + 9); }
        
        match state {
            pos => {
                // Gray node hit: cycle detected!
                return 0 - 1;
            }
            zero => {
                // White node hit: recurse
                var res: t40 = df_dfs_check(dep_node);
                match res {
                    neg => { return 0 - 1; }
                    _ => {}
                }
            }
            _ => {} // Black node: skip
        }
        i = i + 1;
    }
    
    // Color node as black (-1)
    unsafe { store(node + 9, 0 - 1); }
    return 0;
}


// =============================================================================
// SECTION 6 — Static Graph Compilation (OPT 10)
// Performs compile-time topological sort and executes static pipelines.
// =============================================================================

fn df_graph_topo_sort(nodes: t40) -> t40 {
    var count: t40 = vec_len(nodes);
    var topo_order: t40 = vec_new();
    
    // Phase 1: Initialize traversal scratch to 0 (white).
    var i: t40 = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        unsafe { store(node + 9, 0); }
        i = i + 1;
    }
    
    // Phase 2: Run DFS to obtain post-order listing
    i = 0;
    while count - i > 0 {
        var node: t40 = vec_get(nodes, i);
        var state: t40 = 0;
        unsafe { state = load(node + 9); }
        match state {
            zero => {
                var result: t40 = df_topo_dfs(node, topo_order);
                match result {
                    neg => {
                        df_graph_clear_marks(nodes);
                        vec_free(topo_order);
                        return 0;
                    }
                    _ => {}
                }
            }
            _ => {}
        }
        i = i + 1;
    }
    
    df_graph_clear_marks(nodes);
    return topo_order;
}

// Internal recursive DFS helper for topological sorting
fn df_topo_dfs(node: t40, topo_order: t40) -> t40 {
    unsafe { store(node + 9, 1); } // Color gray (1)
    
    var deps: t40 = 0;
    unsafe { deps = load(node + 4); }
    var dep_len: t40 = vec_len(deps);
    
    var i: t40 = 0;
    while dep_len - i > 0 {
        var dep_node: t40 = vec_get(deps, i);
        var state: t40 = 0;
        unsafe { state = load(dep_node + 9); }
        match state {
            pos => { return 0 - 1; }
            zero => {
                var result: t40 = df_topo_dfs(dep_node, topo_order);
                match result {
                    neg => { return 0 - 1; }
                    _ => {}
                }
            }
            neg => {}
        }
        i = i + 1;
    }
    
    unsafe { store(node + 9, 0 - 1); } // Color black (-1)
    vec_push(topo_order, node);
    return 0;
}

// Runs a validated exclusive one-shot topo list; rejects queued/stream modes,
// leaves blocked nodes resumable, and marks DONE only after callback completion.
fn df_sched_static_topology_valid(sched: t40, topo_order: t40) -> t40 {
    if df_bool_or(sched <= 0, topo_order <= 0) { return 0 - 1; }
    if df_sched_validate(sched) < 0 { return 0 - 1; }
    var active: t40 = 0;
    var stream_count: t40 = 0;
    unsafe { active = load(sched + 1); stream_count = load(sched + DF_SCHED_STREAM_COUNT); }
    if df_bool_or(active > 0, stream_count > 0) { return 0 - 1; }
    var len: t40 = vec_len(topo_order);
    var used: t40 = 0;
    unsafe { used = load(sched + 5); }
    if df_bool_or(len < 0, len > used) { return 0 - 1; }
    var validate_index: t40 = 0;
    while len - validate_index > 0 {
        var node: t40 = vec_get(topo_order, validate_index);
        if df_sched_owns_node(sched, node) == 0 { return 0 - 1; }
        var kind: t40 = 0;
        unsafe { kind = load(node + 1); }
        if df_node_kind_valid(kind) == 0 { return 0 - 1; }
        var prior_index: t40 = 0;
        while prior_index < validate_index {
            if vec_get(topo_order, prior_index) == node { return 0 - 1; }
            prior_index = prior_index + 1;
        }
        validate_index = validate_index + 1;
    }
    return 0;
}

fn df_sched_static_node_execute(sched: t40, node: t40) -> t40 {
    var phase: t40 = 0;
    unsafe { phase = load(node + DF_NODE_PHASE); }
    if (phase == DF_NODE_PHASE_DONE) { return DF_CALLBACK_DONE; }
    if (phase == DF_NODE_PHASE_ERROR) { return DF_CALLBACK_ERROR; }
    var result: t40 = df_node_execute(node);
    if (result == DF_CALLBACK_DONE) {
        unsafe {
            store(node, 1);
            store(node + 5, 0);
            store(node + DF_NODE_PHASE, DF_NODE_PHASE_DONE);
        }
        return DF_CALLBACK_DONE;
    }
    if df_bool_or(df_bool_or(result == DF_CALLBACK_PROGRESS,
                             result == DF_CALLBACK_BLOCKED_INPUT),
                  result == DF_CALLBACK_BLOCKED_OUTPUT) {
        unsafe {
            store(node, 0);
            store(node + DF_NODE_PHASE, DF_NODE_PHASE_RUNNING);
        }
        return result;
    }
    unsafe {
        store(node, 0 - 1);
        store(node + DF_NODE_PHASE, DF_NODE_PHASE_ERROR);
        store(sched + DF_SCHED_LAST_ERROR_NODE, node);
    }
    return DF_CALLBACK_ERROR;
}

fn df_sched_static_all_nodes_done(sched: t40) -> t40 {
    var pool: t40 = 0;
    var used: t40 = 0;
    unsafe { pool = load(sched + 4); used = load(sched + 5); }
    var i: t40 = 0;
    while used - i > 0 {
        var phase: t40 = 0;
        unsafe { phase = load(pool + i * DF_NODE_WORDS + DF_NODE_PHASE); }
        if (phase != DF_NODE_PHASE_DONE) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn df_sched_run_static(sched: t40, topo_order: t40) -> t40 {
    var lifecycle: t40 = df_sched_lifecycle(sched);
    if (lifecycle == DF_SCHED_LIFECYCLE_ERROR) { return DF_CALLBACK_ERROR; }
    if (lifecycle == DF_SCHED_LIFECYCLE_DONE) { return 0; }
    if df_sched_static_topology_valid(sched, topo_order) < 0 {
        unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR); }
        return DF_CALLBACK_ERROR;
    }
    unsafe { store(sched + DF_SCHED_STARTED, 1); }
    var len: t40 = vec_len(topo_order);
    var i: t40 = len - 1;
    while i >= 0 {
        var node: t40 = vec_get(topo_order, i);
        var result: t40 = df_sched_static_node_execute(sched, node);
        if (result == DF_CALLBACK_ERROR) {
            unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_ERROR); }
            return DF_CALLBACK_ERROR;
        }
        if df_bool_or(df_bool_or(result == DF_CALLBACK_BLOCKED_INPUT,
                                 result == DF_CALLBACK_BLOCKED_OUTPUT),
                      result == DF_CALLBACK_PROGRESS) {
            unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_RUNNING); }
            return 0;
        }
        i = i - 1;
    }
    if df_sched_static_all_nodes_done(sched) > 0 {
        unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_DONE); }
    } else {
        unsafe { store(sched + DF_SCHED_LIFECYCLE, DF_SCHED_LIFECYCLE_RUNNING); }
    }
    return 0;
}
