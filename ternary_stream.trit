// =============================================================================
// ternary_stream.trit  -  Refined Ternary Stream Processing Library
// =============================================================================

const DF_STREAM_KIND_SOURCE: t40 = 0;
const DF_STREAM_KIND_ANOMALY: t40 = 1;
const DF_STREAM_KIND_WINDOW: t40 = 2;
const DF_STREAM_KIND_FILTER: t40 = 3;
const DF_STREAM_KIND_SINK: t40 = 4;

fn df_stream_abs_diff(a: t40, b: t40) -> t40 {
    var diff: t40 = a - b;
    match diff {
        neg => { return 0 - diff; }
        _ => { return diff; }
    }
}

// History context:
//   [0..2] accepted baseline, [3] baseline count, [4] threshold,
//   [5..7] candidate baseline, [8] candidate count,
//   [9] consistent candidates required (0 defaults to 3, maximum 3).
fn df_stream_hist_add(hist: t40, v: t40) -> void {
    var count: t40 = 0;
    unsafe { count = load(hist + 3); }
    match count - 3 {
        neg => {
            unsafe {
                store(hist + count, v);
                store(hist + 3, count + 1);
            }
        }
        _ => {
            var v1: t40 = 0;
            var v2: t40 = 0;
            unsafe {
                v1 = load(hist + 1);
                v2 = load(hist + 2);
                store(hist, v1);
                store(hist + 1, v2);
                store(hist + 2, v);
            }
        }
    }
}

fn df_stream_candidate_clear(hist: t40) -> void {
    unsafe { store(hist + 8, 0); }
}

// Adds an anomalous sample to a candidate baseline. Isolated outliers never
// enter accepted history. Returns 1 after a consistent streak replaces it.
fn df_stream_candidate_add(hist: t40, v: t40) -> t40 {
    var count: t40 = 0;
    var threshold: t40 = 0;
    var required: t40 = 0;
    unsafe {
        count = load(hist + 8);
        threshold = load(hist + 4);
        required = load(hist + 9);
    }
    match required {
        pos => {
            match required - 3 {
                pos => { required = 3; }
                _ => {}
            }
        }
        _ => { required = 3; }
    }

    match count {
        pos => {
            var sum: t40 = 0;
            var i: t40 = 0;
            while count - i > 0 {
                var sample: t40 = 0;
                unsafe { sample = load(hist + 5 + i); }
                sum = sum + sample;
                i = i + 1;
            }
            var candidate_avg: t40 = sum / count;
            var candidate_diff: t40 = df_stream_abs_diff(v, candidate_avg);
            match candidate_diff - threshold {
                pos => {
                    unsafe {
                        store(hist + 5, v);
                        store(hist + 8, 1);
                    }
                    count = 1;
                }
                _ => {
                    match 3 - count {
                        pos => {
                            unsafe { store(hist + 5 + count, v); }
                            count = count + 1;
                            unsafe { store(hist + 8, count); }
                        }
                        _ => {}
                    }
                }
            }
        }
        _ => {
            unsafe {
                store(hist + 5, v);
                store(hist + 8, 1);
            }
            count = 1;
        }
    }

    match required - count {
        pos => { return 0; }
        _ => {
            unsafe { store(hist + 3, 0); }
            var i: t40 = 0;
            while count - i > 0 {
                var sample: t40 = 0;
                unsafe { sample = load(hist + 5 + i); }
                df_stream_hist_add(hist, sample);
                i = i + 1;
            }
            df_stream_candidate_clear(hist);
            return 1;
        }
    }
}

// A source commits its sequence position only after the channel accepts the
// event. During cancellation it stops generating DATA and emits EOS.
fn df_stream_source_execute(node: t40) -> t40 {
    var outputs: t40 = 0;
    var context: t40 = 0;
    unsafe { outputs = load(node + 3); context = load(node + 7); }
    if df_bool_or(vec_len(outputs) <= 0, context <= 0) { return DF_CALLBACK_ERROR; }
    var channel: t40 = vec_get(outputs, 0);
    var step: t40 = 0;
    var mode: t40 = 0;
    var ended: t40 = 0;
    unsafe { mode = load(context); step = load(context + 1); ended = load(context + 2); }
    if ended > 0 { return DF_CALLBACK_DONE; }

    var tag: t40 = DF_EVENT_DATA;
    var value: t40 = 0;
    if df_node_is_cancel_requested(node) > 0 {
        tag = DF_EVENT_EOS;
    } else if mode == 0 {
        if step == 0 { value = 10; }
        else if step == 1 { value = 15; }
        else if step == 2 { value = 20; }
        else if step == 3 { value = 25; }
        else if step == 4 { value = 30; }
        else if step == 5 { value = 35; }
        else { tag = DF_EVENT_EOS; }
    } else {
        if step == 0 { value = 12; }
        else if step == 1 { tag = DF_EVENT_UNCERTAIN; }
        else if step == 2 { value = 15; }
        else if step == 3 { tag = DF_EVENT_ANOMALY; }
        else if step == 4 { value = 22; }
        else { tag = DF_EVENT_EOS; }
    }
    if df_channel_write_event(channel, tag, value) <= 0 {
        return DF_CALLBACK_BLOCKED_OUTPUT;
    }
    if (tag == DF_EVENT_EOS) {
        unsafe { store(context + 2, 1); }
        return DF_CALLBACK_DONE;
    }
    unsafe { store(context + 1, step + 1); }
    return DF_CALLBACK_PROGRESS;
}

fn df_stream_anomaly_execute(node: t40) -> t40 {
    var inputs: t40 = 0;
    var outputs: t40 = 0;
    var hist: t40 = 0;
    unsafe { inputs = load(node + 2); outputs = load(node + 3); hist = load(node + 7); }
    if df_bool_or(df_bool_or(vec_len(inputs) <= 0, vec_len(outputs) <= 0),
                  hist <= 0) { return DF_CALLBACK_ERROR; }
    var input: t40 = vec_get(inputs, 0);
    var tag: t40 = df_channel_read(input, node + DF_NODE_SCRATCH_VALUE);
    if (tag == DF_EVENT_NONE) { return DF_CALLBACK_BLOCKED_INPUT; }
    var value: t40 = 0;
    unsafe { value = load(node + DF_NODE_SCRATCH_VALUE); }
    if (tag == DF_EVENT_EOS) {
        unsafe { store(node + DF_NODE_PHASE, DF_NODE_PHASE_EOS_PENDING); }
        df_node_pending_push(node, DF_EVENT_EOS, 0);
        return DF_CALLBACK_PROGRESS;
    }
    if (tag != DF_EVENT_DATA) {
        if df_node_pending_push(node, tag, value) <= 0 { return DF_CALLBACK_ERROR; }
        return DF_CALLBACK_PROGRESS;
    }
    var count: t40 = 0;
    var threshold: t40 = 0;
    unsafe { count = load(hist + 3); threshold = load(hist + 4); }
    var output_tag: t40 = DF_EVENT_DATA;
    var output_value: t40 = value;
    if count > 0 {
        var sum: t40 = 0;
        var i: t40 = 0;
        while count - i > 0 {
            unsafe { sum = sum + load(hist + i); }
            i = i + 1;
        }
        var average: t40 = sum / count;
        var difference: t40 = df_stream_abs_diff(value, average);
        if difference - threshold > 0 {
            output_tag = DF_EVENT_ANOMALY;
            output_value = 0;
            df_stream_candidate_add(hist, value);
        } else {
            df_stream_hist_add(hist, value);
            df_stream_candidate_clear(hist);
        }
    } else {
        df_stream_hist_add(hist, value);
        df_stream_candidate_clear(hist);
    }
    if df_node_pending_push(node, output_tag, output_value) <= 0 { return DF_CALLBACK_ERROR; }
    return DF_CALLBACK_PROGRESS;
}

fn df_stream_window_stage_result(node: t40, sum: t40, count: t40,
                                 uncertainty: t40) -> t40 {
    var denominator: t40 = count - uncertainty;
    if denominator <= 0 {
        return df_node_pending_push(node, DF_EVENT_UNCERTAIN, 0);
    }
    return df_node_pending_push(node, DF_EVENT_DATA, sum / denominator);
}

fn df_stream_window_execute(node: t40) -> t40 {
    var inputs: t40 = 0;
    var ctx: t40 = 0;
    unsafe { inputs = load(node + 2); ctx = load(node + 7); }
    if df_bool_or(vec_len(inputs) <= 0, ctx <= 0) { return DF_CALLBACK_ERROR; }
    var limit: t40 = 0;
    unsafe { limit = load(ctx + 2); }
    if limit <= 0 { return DF_CALLBACK_ERROR; }
    var input: t40 = vec_get(inputs, 0);
    var tag: t40 = df_channel_read(input, node + DF_NODE_SCRATCH_VALUE);
    if (tag == DF_EVENT_NONE) { return DF_CALLBACK_BLOCKED_INPUT; }
    var sum: t40 = 0;
    var count: t40 = 0;
    var uncertainty: t40 = 0;
    var value: t40 = 0;
    unsafe {
        sum = load(ctx); count = load(ctx + 1);
        uncertainty = load(ctx + 3); value = load(node + DF_NODE_SCRATCH_VALUE);
    }
    if (tag == DF_EVENT_EOS) {
        if count > 0 {
            if df_stream_window_stage_result(node, sum, count, uncertainty) <= 0 {
                return DF_CALLBACK_ERROR;
            }
            if df_node_pending_push(node, DF_EVENT_EOS, 0) <= 0 { return DF_CALLBACK_ERROR; }
        } else if df_node_pending_push(node, DF_EVENT_EOS, 0) <= 0 {
            return DF_CALLBACK_ERROR;
        }
        unsafe {
            store(ctx, 0); store(ctx + 1, 0); store(ctx + 3, 0);
            store(node + DF_NODE_PHASE, DF_NODE_PHASE_EOS_PENDING);
        }
        return DF_CALLBACK_PROGRESS;
    }
    if (tag == DF_EVENT_DATA) {
        sum = sum + value;
        count = count + 1;
    } else if (tag == DF_EVENT_UNCERTAIN) {
        count = count + 1;
        uncertainty = uncertainty + 1;
    } else {
        if df_node_pending_push(node, tag, value) <= 0 { return DF_CALLBACK_ERROR; }
        return DF_CALLBACK_PROGRESS;
    }
    if count >= limit {
        if df_stream_window_stage_result(node, sum, count, uncertainty) <= 0 {
            return DF_CALLBACK_ERROR;
        }
        sum = 0; count = 0; uncertainty = 0;
    }
    unsafe { store(ctx, sum); store(ctx + 1, count); store(ctx + 3, uncertainty); }
    return DF_CALLBACK_PROGRESS;
}

fn df_stream_filter_execute(node: t40) -> t40 {
    var inputs: t40 = 0;
    var threshold: t40 = 0;
    unsafe { inputs = load(node + 2); threshold = load(node + 7); }
    if vec_len(inputs) <= 0 { return DF_CALLBACK_ERROR; }
    var input: t40 = vec_get(inputs, 0);
    var tag: t40 = df_channel_read(input, node + DF_NODE_SCRATCH_VALUE);
    if (tag == DF_EVENT_NONE) { return DF_CALLBACK_BLOCKED_INPUT; }
    var value: t40 = 0;
    unsafe { value = load(node + DF_NODE_SCRATCH_VALUE); }
    if (tag == DF_EVENT_EOS) {
        unsafe { store(node + DF_NODE_PHASE, DF_NODE_PHASE_EOS_PENDING); }
        df_node_pending_push(node, DF_EVENT_EOS, 0);
        return DF_CALLBACK_PROGRESS;
    }
    if df_bool_and(tag == DF_EVENT_DATA, value - threshold < 0) {
        return DF_CALLBACK_PROGRESS;
    }
    if df_node_pending_push(node, tag, value) <= 0 { return DF_CALLBACK_ERROR; }
    return DF_CALLBACK_PROGRESS;
}

fn df_stream_sink_execute(node: t40) -> t40 {
    var inputs: t40 = 0;
    var cons_str: t40 = 0;
    var err_str: t40 = 0;
    var uncertain_str: t40 = 0;
    unsafe { inputs = load(node + 2); }
    if vec_len(inputs) <= 0 { return DF_CALLBACK_ERROR; }
    var input: t40 = vec_get(inputs, 0);
    var tag: t40 = df_channel_read(input, node + DF_NODE_SCRATCH_VALUE);
    if (tag == DF_EVENT_NONE) { return DF_CALLBACK_BLOCKED_INPUT; }
    var value: t40 = 0;
    unsafe { value = load(node + DF_NODE_SCRATCH_VALUE); }
    if (tag == DF_EVENT_EOS) { return DF_CALLBACK_DONE; }
    if (tag == DF_EVENT_DATA) {
        unsafe { cons_str = load(34); }
        print_string(cons_str);
        print_int(value);
        sys_newline();
    } else if (tag == DF_EVENT_ANOMALY) {
        unsafe { err_str = load(31); }
        print_string(err_str); sys_write_char(33); sys_write_char(33); sys_newline();
    } else if (tag == DF_EVENT_UNCERTAIN) {
        unsafe { uncertain_str = load(32); }
        print_string(uncertain_str); sys_write_char(63); sys_write_char(63); sys_newline();
    }
    return DF_CALLBACK_PROGRESS;
}

// Builtin sink is dispatched here alongside transformed nodes. Each callback
// invocation consumes at most one event; pending output always flushes first.
fn df_node_execute(node: t40) -> t40 {
    if node <= 0 { return DF_CALLBACK_ERROR; }
    if df_node_pending_count(node) > 0 { return df_node_pending_flush(node); }
    var kind: t40 = 0;
    unsafe { kind = load(node + 1); }
    if (kind == DF_STREAM_KIND_SOURCE) { return df_stream_source_execute(node); }
    if (kind == DF_STREAM_KIND_ANOMALY) { return df_stream_anomaly_execute(node); }
    if (kind == DF_STREAM_KIND_WINDOW) { return df_stream_window_execute(node); }
    if (kind == DF_STREAM_KIND_FILTER) { return df_stream_filter_execute(node); }
    if (kind == DF_STREAM_KIND_SINK) { return df_stream_sink_execute(node); }
    return df_service_node_execute(node);
}
