{
  "name": "treatcode",
  "version": "1.0.0",
  "description": "TreatCode DSA Learning and Optimization Platform for Trit",
  "packageManager": "bun@1.4.2",
  "main": "server.ts",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "generate:challenges": "node scripts/generate-challenge-data.mjs",
    "generate:intelligence:v3": "node scripts/generate-intelligence-v3-corpus.mjs",
    "generate:intelligence:v31": "node scripts/generate-intelligence-v31-corpus.mjs",
    "generate:intelligence:v31:pilots": "node scripts/generate-intelligence-v31-pilot-packages.mjs",
    "validate:intelligence:v31": "node scripts/validate-intelligence-v31-corpus.mjs",
    "validate:intelligence:v31:pilots": "node scripts/validate-intelligence-v31-pilot-packages.mjs",
    "prepare:intelligence:v31:pilot": "node scripts/prepare-intelligence-v31-pilot-attempt.mjs",
    "grade:intelligence:v31:pilot": "bun run scripts/grade-intelligence-v31-pilot-attempt.ts",
    "expire:intelligence:v31:pilot": "node scripts/expire-intelligence-v31-pilot-attempt.mjs",
    "aggregate:intelligence:v31:pilots": "node scripts/aggregate-intelligence-v31-pilots.mjs",
    "dispose:intelligence:v31:pilots": "node scripts/dispose-intelligence-v31-pilots.mjs",
    "validate:intelligence:v31:authors": "node scripts/validate-intelligence-v31-author-contributions.mjs",
    "prepare:intelligence:v31:author-shard": "node scripts/prepare-intelligence-v31-author-shard.mjs",
    "checkpoint:intelligence:v31:author-shard": "node scripts/checkpoint-intelligence-v31-author-shard.mjs",
    "ingest:intelligence:v31:authors": "node scripts/ingest-intelligence-v31-author-contributions.mjs",
    "validate:intelligence:v31:reviews": "node scripts/validate-intelligence-v31-reviews.mjs",
    "prepare:intelligence:v31:review-shard": "node scripts/prepare-intelligence-v31-review-shard.mjs",
    "prepare:intelligence:v31:final-base": "node scripts/prepare-intelligence-v31-final-base.mjs",
    "generate:intelligence:v31:final-packages": "node scripts/generate-intelligence-v31-final-packages.mjs",
    "qualify:intelligence:v31:final-packages": "node scripts/qualify-intelligence-v31-final-packages.mjs",
    "aggregate:intelligence:v31:final-calibration": "bun run scripts/aggregate-intelligence-v31-final-calibration.ts",
    "freeze:intelligence:v31": "bun run scripts/freeze-intelligence-v31-suite.ts",
    "prepare:intelligence:v31:final-attempt": "node scripts/prepare-intelligence-v31-final-attempt.mjs",
    "prepare:intelligence:v31:development": "node scripts/prepare-intelligence-v31-final-attempt.mjs --phase=development",
    "grade:intelligence:v31:final-attempt": "bun run scripts/grade-intelligence-v31-final-attempt.ts",
    "grade:intelligence:v31:development": "bun run scripts/grade-intelligence-v31-final-attempt.ts",
    "aggregate:intelligence:v31:development": "bun run scripts/aggregate-intelligence-v31-development.ts",
    "score:intelligence:v31": "node scripts/score-intelligence-v31.mjs",
    "test:intelligence:v31:development": "bun test scripts/intelligence-v31-development.test.ts",
    "aggregate:intelligence:v31:final-subjects": "bun run scripts/aggregate-intelligence-v31-final-subjects.ts",
    "validate:intelligence:v3": "node scripts/validate-intelligence-v3-corpus.mjs",
    "calibrate:intelligence:v3": "bun run scripts/calibrate-intelligence-v3.ts",
    "verify:intelligence:v3:provenance": "bun run scripts/verify-intelligence-v3-provenance.ts",
    "generate:public": "node scripts/generate-public-snapshot.mjs",
    "generate:research": "node scripts/generate-research-catalog.mjs",
    "generate:learning": "node scripts/generate-learning-content.mjs --write-source",
    "generate:compiler-driver": "node scripts/generate-compiler-driver.mjs",
    "prepare:generated": "node scripts/generate-compiler-driver.mjs && node scripts/generate-challenge-data.mjs && node scripts/generate-public-snapshot.mjs && node scripts/generate-learning-content.mjs --derived-only && node scripts/prepare-research-assets.mjs",
    "predev": "npm run prepare:generated",
    "prebuild": "npm run prepare:generated",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "preserver": "npm run prepare:generated",
    "server": "bun run server.ts",
    "prestart": "npm run prepare:generated",
    "start": "bun run server.ts",
    "test:api": "node scripts/generate-public-snapshot.mjs && node scripts/test-public-api.mjs",
    "test:queries": "bun run scripts/test-query-retrieval.ts",
    "test:challenges": "node scripts/generate-challenge-data.mjs && node scripts/test-challenges.mjs",
    "test:e2e:challenges": "node scripts/generate-challenge-data.mjs && node scripts/test-e2e-challenges.mjs",
    "test:e2e:public": "node scripts/test-public-routes.mjs",
    "test:e2e:public-complete": "node scripts/test-e2e-public-complete.mjs",
    "test:public-security": "node scripts/test-public-security.mjs",
    "test:runners": "bun test scripts/runners.test.ts",
    "test:runners-adversarial": "bun test scripts/runners-adversarial.test.ts",
    "test:e2e:isolated-run": "bun test scripts/isolated-run.test.ts",
    "test:auth": "bun run scripts/test-auth.ts",
    "test:auth-negative": "bun run scripts/test-auth-negative.ts",
    "test:community": "bun run scripts/test-community.ts",
    "test:intelligence": "bun run scripts/test-intelligence.ts",
    "test:intelligence:suite": "bun run scripts/test-intelligence-suite.ts",
    "test:intelligence:v3": "bun run scripts/test-intelligence-v3.ts",
    "test:intelligence:v3:task": "bun run scripts/test-intelligence-v3-task.ts",
    "test:intelligence:v3:tasks": "bun run scripts/test-intelligence-v3-task.ts --task=TC-V3-001 && bun run scripts/test-intelligence-v3-task.ts --task=TC-V3-001 --calibration-fixture && bun run scripts/test-intelligence-v3-task.ts --task=TC-V3-002 && bun run scripts/test-intelligence-v3-task.ts --task=TC-V3-002 --calibration-fixture",
    "run:intelligence:v3:public": "bun run scripts/run-intelligence-v3-public.ts",
    "grade:intelligence:v3:attempt": "bun run scripts/grade-intelligence-v3-attempt.ts",
    "test:intelligence:v31:repository": "bun test scripts/intelligence-v31-repository.test.ts",
    "test:intelligence:v31:author-shards": "bun test scripts/intelligence-v31-author-shards.test.ts",
    "test:intelligence:v31:comparison": "bun test scripts/intelligence-v31-comparison.test.ts",
    "test:intelligence:v31:calibration": "bun test scripts/intelligence-v31-calibration.test.ts",
    "test:intelligence:v31:calibration-assignments": "bun test scripts/intelligence-v31-calibration-assignments.test.ts",
    "test:intelligence:v31:infrastructure": "bun test scripts/intelligence-v31-infrastructure.test.ts",
    "test:intelligence:v31:catalog": "bun test scripts/intelligence-v31-catalog.test.ts",
    "test:intelligence:v31:tracks": "bun test scripts/intelligence-v31-tracks.test.ts",
    "test:intelligence:v31:pilot-e2e": "bun test scripts/intelligence-v31-pilot-e2e.test.ts",
    "test:intelligence-ui": "node scripts/test-intelligence-ui.mjs",
    "test:e2e:intelligence": "node scripts/test-e2e-intelligence.mjs",
    "test:participant-journey": "node scripts/test-participant-journey.mjs",
    "test:api-conformance": "bun run scripts/test-api-conformance.ts",
    "check:bundle-budget": "node scripts/check-public-bundle-budget.mjs",
    "pretest:content": "npm run prepare:generated",
    "test:content": "node scripts/test-content.mjs",
    "pretest:curriculum-coverage": "npm run prepare:generated",
    "test:curriculum-coverage": "node scripts/test-curriculum-coverage.mjs",
    "pretest:content-depth": "npm run prepare:generated",
    "test:content-depth": "node scripts/test-content-depth.mjs",
    "pretest:e2e:learn": "npm run prepare:generated",
    "test:e2e:learn": "node scripts/test-learning-flow.mjs",
    "pretest:e2e:learn-complete": "npm run prepare:generated",
    "test:e2e:learn-complete": "node scripts/test-learning-complete.mjs",
    "test:a11y": "node scripts/test-a11y.mjs && node scripts/test-public-a11y.mjs",
    "pretest:public-coverage": "npm run prepare:generated",
    "test:public-coverage": "node scripts/test-public-coverage.mjs",
    "test:benchmarks": "node scripts/test-benchmarks.mjs",
    "test:e2e:implementation-arena": "node scripts/test-implementation-arena.mjs",
    "test:launch": "node scripts/generate-public-snapshot.mjs && node scripts/test-launch.mjs",
    "test:uploads": "node scripts/test-uploads.mjs",
    "test:uploads-adversarial": "node scripts/test-uploads-adversarial.mjs",
    "test:e2e:draft-pr": "node scripts/test-e2e-draft-pr.mjs",
    "test:e2e:mobile-operations": "node scripts/test-mobile-operations.mjs",
    "test:disconnect-resume": "node scripts/test-disconnect-resume.mjs",
    "test:notifications": "node scripts/test-notifications.mjs",
    "test:disaster-recovery": "node scripts/test-disaster-recovery.mjs",
    "test:workspaces": "node scripts/test-workspaces.mjs",
    "test:e2e:workspace-lifecycle": "node scripts/test-workspace-lifecycle.mjs",
    "test:e2e:workspace-handoff": "node scripts/test-workspace-handoff.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^5.3.1"
  }
}
