{
  "name": "treatcode",
  "version": "1.0.0",
  "description": "TreatCode DSA Learning and Optimization Platform for Trit",
  "packageManager": "bun@1.3.14",
  "main": "server.ts",
  "scripts": {
    "dev": "vite",
    "generate:challenges": "node scripts/generate-challenge-data.mjs",
    "generate:public": "node scripts/generate-public-snapshot.mjs",
    "prebuild": "node scripts/generate-challenge-data.mjs && node scripts/generate-public-snapshot.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "bun run server.ts",
    "start": "bun run server.ts",
    "test:api": "node scripts/generate-public-snapshot.mjs && node scripts/test-public-api.mjs",
    "test:queries": "bun run scripts/test-query-retrieval.ts",
    "test:challenges": "node scripts/generate-challenge-data.mjs && node scripts/test-challenges.mjs",
    "test:e2e:challenges": "node scripts/generate-challenge-data.mjs && node scripts/test-e2e-challenges.mjs",
    "test:e2e:public": "node scripts/test-public-routes.mjs",
    "test:runners": "bun test scripts/runners.test.ts",
    "test:runners-adversarial": "bun test scripts/runners-adversarial.test.ts",
    "test:e2e:isolated-run": "bun test scripts/isolated-run.test.ts",
    "test:auth": "bun run scripts/test-auth.ts",
    "test:auth-negative": "bun run scripts/test-auth-negative.ts",
    "test:api-conformance": "bun run scripts/test-api-conformance.ts",
    "check:bundle-budget": "node scripts/check-public-bundle-budget.mjs",
    "test:content": "node scripts/test-content.mjs",
    "test:e2e:learn": "node scripts/test-learning-flow.mjs",
    "test:a11y": "node scripts/test-a11y.mjs && node scripts/test-public-a11y.mjs",
    "test:benchmarks": "node scripts/test-benchmarks.mjs",
    "test:e2e:implementation-arena": "node scripts/test-implementation-arena.mjs",
    "test:launch": "node scripts/generate-public-snapshot.mjs && node scripts/test-launch.mjs",
    "test:uploads": "node scripts/test-uploads.mjs",
    "test:uploads-adversarial": "node scripts/test-uploads-adversarial.mjs",
    "test:e2e:draft-pr": "node scripts/test-e2e-draft-pr.mjs",
    "test:e2e:mobile-operations": "node scripts/test-mobile-operations.mjs",
    "test:disconnect-resume": "node scripts/test-disconnect-resume.mjs",
    "test:notifications": "node scripts/test-notifications.mjs",
    "test:disaster-recovery": "node scripts/test-disaster-recovery.mjs",
    "test:workspaces": "node scripts/test-workspaces.mjs",
    "test:e2e:workspace-lifecycle": "node scripts/test-workspace-lifecycle.mjs",
    "test:e2e:workspace-handoff": "node scripts/test-workspace-handoff.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^5.3.1"
  }
}
