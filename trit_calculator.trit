// trit_calculator.trit
// A ternary calculator that parses and evaluates simple arithmetic expressions.

fn print_str(addr: ptr<t40, user, valid>) -> t40 {
    var i: t40 = 0;
    var done: t40 = 0;
    while 1 - done > 0 {
        var c: t40 = 0;
        unsafe { c = load(addr + i); }
        match c {
            zero => { done = 1; }
            neg => {
                sys_write_char(c);
                i = i + 1;
            }
            pos => {
                sys_write_char(c);
                i = i + 1;
            }
        }
    }
    return 0;
}

fn eval_expr(str: ptr<t40, user, valid>) -> t40 {
    var i: t40 = 0;
    var lhs: t40 = 0;
    var op: t40 = 0;
    var rhs: t40 = 0;
    
    // Parse LHS
    var parsing_lhs: t40 = 1;
    while parsing_lhs > 0 {
        var c: t40 = 0;
        unsafe { c = load(str + i); }
        match c {
            zero => { parsing_lhs = 0; }
            neg => {
                match c - 32 {
                    zero => { i = i + 1; }
                    _ => {
                        match c - 48 {
                            neg => { parsing_lhs = 0; }
                            zero => { lhs = lhs * 10; i = i + 1; }
                            pos => {
                                match 57 - c {
                                    neg => { parsing_lhs = 0; }
                                    _ => { lhs = lhs * 10 + (c - 48); i = i + 1; }
                                }
                            }
                        }
                    }
                }
            }
            pos => {
                match c - 32 {
                    zero => { i = i + 1; }
                    _ => {
                        match c - 48 {
                            neg => { parsing_lhs = 0; }
                            zero => { lhs = lhs * 10; i = i + 1; }
                            pos => {
                                match 57 - c {
                                    neg => { parsing_lhs = 0; }
                                    _ => { lhs = lhs * 10 + (c - 48); i = i + 1; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Parse Operator
    var parsing_op: t40 = 1;
    while parsing_op > 0 {
        var c: t40 = 0;
        unsafe { c = load(str + i); }
        match c {
            zero => { parsing_op = 0; }
            _ => {
                match c - 32 {
                    zero => { i = i + 1; }
                    _ => {
                        op = c;
                        i = i + 1;
                        parsing_op = 0;
                    }
                }
            }
        }
    }
    
    // Parse RHS
    var parsing_rhs: t40 = 1;
    while parsing_rhs > 0 {
        var c: t40 = 0;
        unsafe { c = load(str + i); }
        match c {
            zero => { parsing_rhs = 0; }
            neg => {
                match c - 32 {
                    zero => { i = i + 1; }
                    _ => {
                        match c - 48 {
                            neg => { parsing_rhs = 0; }
                            zero => { rhs = rhs * 10; i = i + 1; }
                            pos => {
                                match 57 - c {
                                    neg => { parsing_rhs = 0; }
                                    _ => { rhs = rhs * 10 + (c - 48); i = i + 1; }
                                }
                            }
                        }
                    }
                }
            }
            pos => {
                match c - 32 {
                    zero => { i = i + 1; }
                    _ => {
                        match c - 48 {
                            neg => { parsing_rhs = 0; }
                            zero => { rhs = rhs * 10; i = i + 1; }
                            pos => {
                                match 57 - c {
                                    neg => { parsing_rhs = 0; }
                                    _ => { rhs = rhs * 10 + (c - 48); i = i + 1; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    
    // Evaluate
    var res: t40 = 0;
    // '+' is 43, '-' is 45, '*' is 42, '/' is 47
    match op - 43 {
        zero => { res = lhs + rhs; }
        _ => {
            match op - 45 {
                zero => { res = lhs - rhs; }
                _ => {
                    match op - 42 {
                        zero => { res = lhs * rhs; }
                        _ => {
                            match op - 47 {
                                zero => { res = lhs / rhs; }
                                _ => { res = 0 - 999999; }
                            }
                        }
                    }
                }
            }
        }
    }
    return res;
}

fn main() -> t40 {
    // 1. "15 + 3"
    unsafe {
        store(100, 49); // '1'
        store(101, 53); // '5'
        store(102, 32); // ' '
        store(103, 43); // '+'
        store(104, 32); // ' '
        store(105, 51); // '3'
        store(106, 0);  // '\0'
    }
    print_str(100);
    sys_write_char(32); // ' '
    sys_write_char(61); // '='
    sys_write_char(32); // ' '
    sys_write_int(eval_expr(100));
    sys_newline();

    // 2. "15 - 3"
    unsafe {
        store(100, 49); // '1'
        store(101, 53); // '5'
        store(102, 32); // ' '
        store(103, 45); // '-'
        store(104, 32); // ' '
        store(105, 51); // '3'
        store(106, 0);  // '\0'
    }
    print_str(100);
    sys_write_char(32); // ' '
    sys_write_char(61); // '='
    sys_write_char(32); // ' '
    sys_write_int(eval_expr(100));
    sys_newline();

    // 3. "15 * 3"
    unsafe {
        store(100, 49); // '1'
        store(101, 53); // '5'
        store(102, 32); // ' '
        store(103, 42); // '*'
        store(104, 32); // ' '
        store(105, 51); // '3'
        store(106, 0);  // '\0'
    }
    print_str(100);
    sys_write_char(32); // ' '
    sys_write_char(61); // '='
    sys_write_char(32); // ' '
    sys_write_int(eval_expr(100));
    sys_newline();

    // 4. "15 / 3"
    unsafe {
        store(100, 49); // '1'
        store(101, 53); // '5'
        store(102, 32); // ' '
        store(103, 47); // '/'
        store(104, 32); // ' '
        store(105, 51); // '3'
        store(106, 0);  // '\0'
    }
    print_str(100);
    sys_write_char(32); // ' '
    sys_write_char(61); // '='
    sys_write_char(32); // ' '
    sys_write_int(eval_expr(100));
    sys_newline();

    return 0;
}
