// =============================================================================
// ulib.trit  -  Ternary User Standard Library
// =============================================================================
// A standard library written in high-level Trit that wraps the VM/OS syscall
// ABI, facilitating console I/O, process management, and memory allocation.
//
// Requires Phase 8 OS mode for: malloc/free, file I/O streams, env vars.
// Console output supports decimal words via sys_write_int and ASCII text via
// sys_write_char.
//
// Fixed DMEM metadata layout (data page, persists across calls):
//   DMEM[20] = heap_initialized   (0 = no, 1 = yes)
//   DMEM[22] = free_list_head     (address of first free block header, 0 = empty)
//   DMEM[23] = env_tst_root       (TST root node address, 0 = empty)
//
// Heap block layout at address A (returned ptr = A + 1):
//   A[0] = header  (negative = allocated, abs = data words;
//                   positive = free,      value = data words)
//   A[1] = next_free ptr when free (first data word when allocated)
//   A[2..] = remaining data words
//
// Stream struct layout (6 words, malloc'd):
//   [0]=fd  [1]=buf_ptr  [2]=buf_cap  [3]=buf_pos  [4]=buf_len  [5]=mode
//
// Vector struct layout (3 words, malloc'd):
//   [0]=data_ptr  [1]=length  [2]=capacity
//
// TST node layout (6 words, malloc'd):
//   [0]=splitter_char  [1]=left_ptr  [2]=equal_ptr  [3]=right_ptr
//   [4]=value          [5]=is_terminal
//
// Ternary heap struct layout (3 words, malloc'd):
//   [0]=data_ptr  [1]=size  [2]=capacity
//
// Ring buffer struct layout (4 words, malloc'd):
//   [0]=data_ptr  [1]=capacity  [2]=read_pos  [3]=write_pos
// =============================================================================

// =============================================================================
// SECTION 0 — Syscall wrappers
// =============================================================================

fn print_int(x: t40) -> t40 {
    return sys_write_int(x);
}

fn newline() -> t40 {
    return sys_newline();
}

fn clear_console() -> t40 {
    return sys_clear();
}

fn yield_cpu() -> t40 {
    return sys_yield();
}

fn sleep_until_tick(tick: t40) -> t40 {
    return sys_sleep_until_tick(tick);
}

fn exit(status: t40) -> t40 {
    return sys_exit(status);
}

fn getpid() -> t40 {
    return sys_getpid();
}

fn uptime() -> t40 {
    return sys_uptime();
}

fn read_console_word() -> t40 {
    return sys_read_console_word();
}

fn spawn_static(entry_pc: t40) -> t40 {
    return sys_spawn_static(entry_pc);
}

fn waitpid(pid: t40) -> t40 {
    return sys_waitpid(pid);
}

fn fork() -> t40 {
    return sys_fork();
}

// =============================================================================
// SECTION 1 — Character and math helpers
// =============================================================================

fn abs(val: t40) -> t40 {
    match val {
        neg => { return 0 - val; }
        zero => { return 0; }
        pos => { return val; }
    }
}

fn min(a: t40, b: t40) -> t40 {
    match a - b {
        neg => { return a; }
        zero => { return a; }
        pos => { return b; }
    }
}

fn max(a: t40, b: t40) -> t40 {
    match a - b {
        neg => { return b; }
        zero => { return a; }
        pos => { return a; }
    }
}

fn char_is_digit(c: t40) -> t40 {
    match c - 48 {
        neg => { return 0; }
        zero => { return 1; }
        pos => {
            match 57 - c {
                neg => { return 0; }
                zero => { return 1; }
                pos => { return 1; }
            }
        }
    }
}

fn char_is_whitespace(c: t40) -> t40 {
    match c - 32 {
        zero => { return 1; }
        neg => {
            match c - 9 {
                zero => { return 1; }
                neg => { return 0; }
                pos => {
                    match c - 10 {
                        zero => { return 1; }
                        neg => { return 0; }
                        pos => {
                            match c - 13 {
                                zero => { return 1; }
                                neg => { return 0; }
                                pos => { return 0; }
                            }
                        }
                    }
                }
            }
        }
        pos => { return 0; }
    }
}

fn char_to_lower(c: t40) -> t40 {
    match c - 65 {
        neg => { return c; }
        zero => { return c + 32; }
        pos => {
            match 90 - c {
                neg => { return c; }
                zero => { return c + 32; }
                pos => { return c + 32; }
            }
        }
    }
}

fn char_to_upper(c: t40) -> t40 {
    match c - 97 {
        neg => { return c; }
        zero => { return c - 32; }
        pos => {
            match 122 - c {
                neg => { return c; }
                zero => { return c - 32; }
                pos => { return c - 32; }
            }
        }
    }
}

fn char_is_alpha(c: t40) -> t40 {
    match c - 65 {
        neg => { return 0; }
        zero => { return 1; }
        pos => {
            match 90 - c {
                neg => {
                    match c - 97 {
                        neg => { return 0; }
                        zero => { return 1; }
                        pos => {
                            match 122 - c {
                                neg => { return 0; }
                                zero => { return 1; }
                                pos => { return 1; }
                            }
                        }
                    }
                }
                zero => { return 1; }
                pos => { return 1; }
            }
        }
    }
}

fn char_is_alnum(c: t40) -> t40 {
    var alpha: t40 = char_is_alpha(c);
    match alpha {
        pos => { return 1; }
        zero => { return char_is_digit(c); }
        neg => { return char_is_digit(c); }
    }
}

// Parse a whitespace-delimited command line into an argv array.
// cmdline: address of null-terminated word buffer.
// argv_buf: address of word array to fill with pointers to each token start.
// Returns argc (number of tokens found).
// Modifies cmdline in-place by writing 0 over whitespace separators.
fn parse_args(cmdline: borrow_mut<ptr<t40, user, valid>>, argv_buf: borrow_mut<ptr<t40, user, valid>>) -> t40 {
    var argc: t40 = 0;
    var i: t40 = 0;
    var in_word: t40 = 0;
    var parse_args_loop: t40 = 1;

    while parse_args_loop > 0 {
        var c: t40 = 0;
        unsafe { c = load(cmdline + i); }

        match c {
            // Null terminator: end of input.
            zero => {
                match in_word {
                    pos => {}
                    neg => {}
                    zero => {}
                }
                return argc;
            }
            // Negative values are not valid ASCII; treat as end of input.
            neg => { return argc; }
            pos => {
                var is_ws: t40 = char_is_whitespace(c);
                match is_ws {
                    pos => {
                        // Whitespace: terminate current word if in one.
                        match in_word {
                            pos => {
                                unsafe { store(cmdline + i, 0); }
                                in_word = 0;
                            }
                            neg => {}
                            zero => {}
                        }
                    }
                    zero => {
                        // Non-whitespace, not in a word: start new token.
                        match in_word {
                            zero => {
                                unsafe { store(argv_buf + argc, cmdline + i); }
                                argc = argc + 1;
                                in_word = 1;
                            }
                            neg => {}
                            pos => {}
                        }
                    }
                    neg => {}
                }
            }
        }
        i = i + 1;
    }
    return argc;
}

// =============================================================================
// SECTION 2 — Memory Management
// Requires Phase 8 OS mode (sys_sbrk, syscall id 19).
// =============================================================================

// Initialize heap metadata at fixed DMEM addresses 20-23.
fn heap_init() -> t40 {
    var inited: t40 = 0;
    unsafe { inited = load(20); }
    match inited {
        pos => { return 1; }
        neg => { return 1; }
        zero => {
            unsafe {
                store(20, 1);
                store(22, 0);
                store(23, 0);
            }
            return 1;
        }
    }
}

// Allocate a contiguous block of `words` data words from the heap.
// Returns the data pointer (header is at ptr-1).
// Uses first-fit free list; splits large blocks to reduce fragmentation.
fn malloc_raw(words: t40) -> t40 {
    heap_init();

    var sz: t40 = words;
    match sz - 1 {
        neg => { sz = 1; }
        zero => {}
        pos => {}
    }

    var prev_slot: t40 = 22;
    var curr: t40 = 0;
    unsafe { curr = load(22); }

    while curr > 0 {
        var bsz: t40 = 0;
        unsafe { bsz = load(curr); }

        match bsz {
            neg => {
                unsafe { store(prev_slot, 0); }
                curr = 0;
            }
            zero => {
                unsafe { store(prev_slot, 0); }
                curr = 0;
            }
            pos => {
                match bsz - sz {
                    neg => {
                        prev_slot = curr + 1;
                        unsafe { curr = load(curr + 1); }
                    }
                    zero => {
                        unsafe {
                            var nxt: t40 = load(curr + 1);
                            store(prev_slot, nxt);
                            store(curr, 0 - sz);
                        }
                        return curr + 1;
                    }
                    pos => {
                        var leftover: t40 = bsz - sz - 1;
                        match leftover - 1 {
                            neg => {
                                unsafe {
                                    var nxt: t40 = load(curr + 1);
                                    store(prev_slot, nxt);
                                    store(curr, 0 - bsz);
                                }
                            }
                            zero => {
                                unsafe {
                                    var nxt: t40 = load(curr + 1);
                                    store(prev_slot, nxt);
                                    store(curr, 0 - bsz);
                                }
                            }
                            pos => {
                                var split_addr: t40 = curr + sz + 1;
                                unsafe {
                                    var nxt: t40 = load(curr + 1);
                                    store(split_addr, leftover);
                                    store(split_addr + 1, nxt);
                                    store(prev_slot, split_addr);
                                    store(curr, 0 - sz);
                                }
                            }
                        }
                        return curr + 1;
                    }
                }
            }
        }
    }

    // No suitable free block: extend the heap via sbrk.
    // sys_sbrk(delta) returns the start of the newly allocated region.
    // We need sz + 1 words: one header followed by sz data words.
    var old_brk: t40 = sys_sbrk(sz + 1);
    var hdr: t40 = old_brk;
    unsafe { store(hdr, 0 - sz); }
    return hdr + 1;
}

fn alloc(words: t40) -> own<ptr<t40, user, unknown>> {
    return malloc_raw(words);
}

fn malloc(words: t40) -> own<ptr<t40, user, unknown>> {
    return malloc_raw(words);
}

// Free a previously allocated block.
// Marks it as free and prepends to the free list (LIFO).
// Poison-writes data words so use-after-free bugs produce obviously-wrong
// values (-999999) rather than silent corruption.
fn free_raw(ptr: t40) -> t40 {
    match ptr {
        zero => { return 0; }
        neg  => { return 0; }
        pos  => {
            var hdr: t40 = ptr - 1;
            var hdr_val: t40 = 0;
            unsafe { hdr_val = load(hdr); }
            match hdr_val {
                neg => {
                    var fsz: t40 = 0 - hdr_val;
                    var head: t40 = 0;
                    unsafe { head = load(22); }
                    var safe_head: t40 = 0;
                    match head {
                        pos => {
                            var head_size: t40 = 0;
                            unsafe { head_size = load(head); }
                            match head_size {
                                pos => { safe_head = head; }
                                zero => {}
                                neg => {}
                            }
                        }
                        zero => {}
                        neg => {}
                    }
                    // Poison data words so use-after-free is visible
                    var pi: t40 = 0;
                    var poison_words: t40 = fsz;
                    match poison_words - 27 {
                        neg => {}
                        zero => {}
                        pos => { poison_words = 27; }
                    }
                    while poison_words - pi > 0 {
                        unsafe { store(ptr + pi, 0 - 999999); }
                        pi = pi + 1;
                    }
                    unsafe {
                        store(hdr, fsz);
                        store(ptr, safe_head);
                        store(22,  hdr);
                    }
                    return 0;
                }
                pos  => { return 0; }   // double-free guard
                zero => { return 0; }   // invalid block
            }
        }
    }
}

fn free(ptr: borrow<ptr<t40, user, unknown>>) -> t40 {
    return free_raw(ptr);
}

// Allocate `num * size` words, zero-initialised.
fn calloc_raw(num: t40, size: t40) -> t40 {
    var total: t40 = num * size;
    var ptr: t40 = malloc_raw(total);
    match ptr {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var i: t40 = 0;
            while total - i > 0 {
                unsafe { store(ptr + i, 0); }
                i = i + 1;
            }
            return ptr;
        }
    }
}

fn calloc(num: t40, size: t40) -> own<ptr<t40, user, unknown>> {
    return calloc_raw(num, size);
}

// Resize an existing block; copies existing data, frees old pointer.
// Returns new pointer, or 0 on failure.
fn realloc_raw(ptr: t40, new_size: t40) -> t40 {
    match ptr {
        zero => { return malloc_raw(new_size); }
        neg => { return 0; }
        pos => {
            var old_hdr: t40 = 0;
            unsafe { old_hdr = load(ptr - 1); }
            var old_sz: t40 = 0 - old_hdr;
            match old_hdr {
                pos => { return 0; }
                zero => { return 0; }
                neg => {
                    var new_ptr: t40 = malloc_raw(new_size);
                    match new_ptr {
                        zero => { return 0; }
                        neg => { return 0; }
                        pos => {
                            var copy_words: t40 = min(old_sz, new_size);
                            var i: t40 = 0;
                            while copy_words - i > 0 {
                                var w: t40 = 0;
                                unsafe { w = load(ptr + i); }
                                unsafe { store(new_ptr + i, w); }
                                i = i + 1;
                            }
                            free_raw(ptr);
                            return new_ptr;
                        }
                    }
                }
            }
        }
    }
}

fn realloc(ptr: own<ptr<t40, user, unknown>>, new_size: t40) -> own<ptr<t40, user, unknown>> {
    return realloc_raw(ptr, new_size);
}

// =============================================================================
// SECTION 3 — Memory Utilities
// =============================================================================

fn memset(ptr: borrow_mut<ptr<t40, user, valid>>, val: t40, size: t40) -> borrow_mut<ptr<t40, user, valid>> {
    var i: t40 = 0;
    while size - i > 0 {
        unsafe { store(ptr + i, val); }
        i = i + 1;
    }
    return ptr;
}

fn memcpy(dest: borrow_mut<ptr<t40, user, valid>>, src: borrow<ptr<t40, user, valid>>, size: t40) -> borrow_mut<ptr<t40, user, valid>> {
    var i: t40 = 0;
    while size - i > 0 {
        var w: t40 = 0;
        unsafe { w = load(src + i); }
        unsafe { store(dest + i, w); }
        i = i + 1;
    }
    return dest;
}

// memmove: copy `size` words from src to dest, safe for overlapping regions.
// If dest < src, copies forward. If dest > src, copies backward to avoid clobber.
fn memmove(dest: borrow_mut<ptr<t40, user, valid>>, src: borrow<ptr<t40, user, valid>>, size: t40) -> borrow_mut<ptr<t40, user, valid>> {
    match dest - src {
        neg => {
            // dest < src: safe to copy forward
            var i: t40 = 0;
            while size - i > 0 {
                var w: t40 = 0;
                unsafe { w = load(src + i); }
                unsafe { store(dest + i, w); }
                i = i + 1;
            }
        }
        zero => {}  // same address, nothing to do
        pos => {
            // dest > src: copy backward to avoid clobbering src
            var i: t40 = size - 1;
            while i + 1 > 0 {
                var w: t40 = 0;
                unsafe { w = load(src + i); }
                unsafe { store(dest + i, w); }
                i = i - 1;
            }
        }
    }
    return dest;
}

fn memcmp(ptr1: borrow<ptr<t40, user, valid>>, ptr2: borrow<ptr<t40, user, valid>>, size: t40) -> t40 {
    var i: t40 = 0;
    while size - i > 0 {
        var a: t40 = 0;
        var b: t40 = 0;
        unsafe { a = load(ptr1 + i); }
        unsafe { b = load(ptr2 + i); }
        match a - b {
            neg => { return 0 - 1; }
            pos => { return 1; }
            zero => {}
        }
        i = i + 1;
    }
    return 0;
}

// =============================================================================
// SECTION 4 — String Utilities
// Strings are null-terminated sequences of word-sized character codes.
// =============================================================================

fn strlen(str: borrow<ptr<t40, user, valid>>) -> t40 {
    var len: t40 = 0;
    var done: t40 = 0;
    while 1 - done > 0 {
        var c: t40 = 0;
        unsafe { c = load(str + len); }
        match c {
            zero => { done = 1; }
            neg => { len = len + 1; }
            pos => { len = len + 1; }
        }
    }
    return len;
}

fn strcmp(str1: borrow<ptr<t40, user, valid>>, str2: borrow<ptr<t40, user, valid>>) -> t40 {
    var i: t40 = 0;
    var strcmp_loop: t40 = 1;
    while strcmp_loop > 0 {
        var a: t40 = 0;
        var b: t40 = 0;
        unsafe { a = load(str1 + i); }
        unsafe { b = load(str2 + i); }
        match a - b {
            neg => { return 0 - 1; }
            pos => { return 1; }
            zero => {
                match a {
                    zero => { return 0; }
                    neg => {}
                    pos => {}
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn strncmp(str1: borrow<ptr<t40, user, valid>>, str2: borrow<ptr<t40, user, valid>>, n: t40) -> t40 {
    var i: t40 = 0;
    while n - i > 0 {
        var a: t40 = 0;
        var b: t40 = 0;
        unsafe { a = load(str1 + i); }
        unsafe { b = load(str2 + i); }
        match a - b {
            neg => { return 0 - 1; }
            pos => { return 1; }
            zero => {
                match a {
                    zero => { return 0; }
                    neg => {}
                    pos => {}
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

fn strcpy(dest: borrow_mut<ptr<t40, user, valid>>, src: borrow<ptr<t40, user, valid>>) -> borrow_mut<ptr<t40, user, valid>> {
    var i: t40 = 0;
    var done: t40 = 0;
    while 1 - done > 0 {
        var c: t40 = 0;
        unsafe { c = load(src + i); }
        unsafe { store(dest + i, c); }
        match c {
            zero => { done = 1; }
            neg => { i = i + 1; }
            pos => { i = i + 1; }
        }
    }
    return dest;
}

fn strncpy(dest: borrow_mut<ptr<t40, user, valid>>, src: borrow<ptr<t40, user, valid>>, n: t40) -> borrow_mut<ptr<t40, user, valid>> {
    var i: t40 = 0;
    var past_null: t40 = 0;
    while n - i > 0 {
        match past_null {
            pos => {
                unsafe { store(dest + i, 0); }
            }
            zero => {
                var c: t40 = 0;
                unsafe { c = load(src + i); }
                unsafe { store(dest + i, c); }
                match c {
                    zero => { past_null = 1; }
                    neg => {}
                    pos => {}
                }
            }
            neg => {
                unsafe { store(dest + i, 0); }
            }
        }
        i = i + 1;
    }
    return dest;
}

fn strcat(dest: borrow_mut<ptr<t40, user, valid>>, src: borrow<ptr<t40, user, valid>>) -> borrow_mut<ptr<t40, user, valid>> {
    var end_pos: t40 = strlen(dest);
    strcpy(dest + end_pos, src);
    return dest;
}

fn strchr(str: borrow<ptr<t40, user, valid>>, ch: t40) -> ptr<t40, user, unknown> {
    var i: t40 = 0;
    var strchr_loop: t40 = 1;
    while strchr_loop > 0 {
        var c: t40 = 0;
        unsafe { c = load(str + i); }
        match c - ch {
            zero => { return str + i; }
            neg => {}
            pos => {}
        }
        match c {
            zero => { return 0; }
            neg => {}
            pos => {}
        }
        i = i + 1;
    }
    return 0;
}

// Find the last occurrence of character ch in str.
// Returns address of the match, or 0 if not found.
fn strrchr(str: borrow<ptr<t40, user, valid>>, ch: t40) -> ptr<t40, user, unknown> {
    var i: t40 = 0;
    var last: t40 = 0;
    var strrchr_loop: t40 = 1;
    while strrchr_loop > 0 {
        var c: t40 = 0;
        unsafe { c = load(str + i); }
        match c - ch {
            zero => { last = str + i; }
            neg => {}
            pos => {}
        }
        match c {
            zero => { return last; }
            neg => { return last; }
            pos => {}
        }
        i = i + 1;
    }
    return last;
}

fn strstr(haystack: borrow<ptr<t40, user, valid>>, needle: borrow<ptr<t40, user, valid>>) -> ptr<t40, user, unknown> {
    var nlen: t40 = strlen(needle);
    match nlen {
        zero => { return haystack; }
        neg => { return haystack; }
        pos => {}
    }
    var i: t40 = 0;
    var hlen: t40 = strlen(haystack);
    while hlen - nlen - i + 1 > 0 {
        var matched: t40 = strncmp(haystack + i, needle, nlen);
        match matched {
            zero => { return haystack + i; }
            neg => {}
            pos => {}
        }
        i = i + 1;
    }
    return 0;
}

// Copy a null-terminated string from `src` into a fresh malloc'd buffer.
fn strdup(src: borrow<ptr<t40, user, valid>>) -> own<ptr<t40, user, unknown>> {
    var slen: t40 = strlen(src);
    var buf: t40 = malloc_raw(slen + 1);
    match buf {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            strcpy(buf, src);
            return buf;
        }
    }
}

// Tokenize `str` in-place, similar to C strtok.
// First call: pass the string address in `str` and 0 in `saved`.
// Subsequent calls: pass 0 in `str` and the previous `saved` value.
// `saved` is a pointer to a word that holds the scan position between calls.
// Returns address of the next token, or 0 when exhausted.
// Writes null over each delimiter found.
fn strtok(str: borrow_mut<ptr<t40, user, unknown>>, delim: borrow<ptr<t40, user, valid>>, saved: borrow_mut<ptr<t40, user, valid>>) -> ptr<t40, user, unknown> {
    var pos_ptr: t40 = 0;
    match str {
        valid(s) => { unsafe { store(saved, s); } pos_ptr = s; }
        unknown => { unsafe { pos_ptr = load(saved); } }
        null => { unsafe { pos_ptr = load(saved); } }
    }

    // Skip leading delimiters.
    var done_skip: t40 = 0;
    while 1 - done_skip > 0 {
        var c: t40 = 0;
        unsafe { c = load(pos_ptr); }
        match c {
            zero => { unsafe { store(saved, 0); } return 0; }
            neg => { unsafe { store(saved, 0); } return 0; }
            pos => {
                var dc: t40 = 0;
                var found_delim: t40 = 0;
                var di: t40 = 0;
                var skip_delim_loop: t40 = 1;
                while skip_delim_loop > 0 {
                    unsafe { dc = load(delim + di); }
                    match dc {
                        zero => { di = 9999; }    // break inner loop
                        neg => { di = 9999; }
                        pos => {
                            match c - dc {
                                zero => { found_delim = 1; di = 9999; }
                                neg => {}
                                pos => {}
                            }
                        }
                    }
                    match di - 9999 {
                        zero => { done_skip = 9999; }
                        neg => { di = di + 1; }
                        pos => {}
                    }
                    match done_skip - 9999 {
                        zero => { di = 9999; }
                        neg => {}
                        pos => {}
                    }
                }
                match found_delim {
                    pos => { pos_ptr = pos_ptr + 1; }
                    zero => { done_skip = 1; }
                    neg => { done_skip = 1; }
                }
            }
        }
    }

    // pos_ptr now points to the start of a token.
    var token_start: t40 = pos_ptr;

    // Scan to the next delimiter or null.
    var done_scan: t40 = 0;
    while 1 - done_scan > 0 {
        var c: t40 = 0;
        unsafe { c = load(pos_ptr); }
        match c {
            zero => { unsafe { store(saved, pos_ptr); } done_scan = 1; }
            neg => { unsafe { store(saved, pos_ptr); } done_scan = 1; }
            pos => {
                var dc: t40 = 0;
                var found_delim: t40 = 0;
                var di: t40 = 0;
                var scan_delim_loop: t40 = 1;
                while scan_delim_loop > 0 {
                    unsafe { dc = load(delim + di); }
                    match dc {
                        zero => { di = 9999; }
                        neg => { di = 9999; }
                        pos => {
                            match c - dc {
                                zero => { found_delim = 1; di = 9999; }
                                neg => {}
                                pos => {}
                            }
                        }
                    }
                    match di - 9999 {
                        zero => { di = 0; di = 9999; }
                        neg => { di = di + 1; }
                        pos => {}
                    }
                }
                match found_delim {
                    pos => {
                        unsafe { store(pos_ptr, 0); }
                        unsafe { store(saved, pos_ptr + 1); }
                        done_scan = 1;
                    }
                    zero => { pos_ptr = pos_ptr + 1; }
                    neg => { pos_ptr = pos_ptr + 1; }
                }
            }
        }
    }

    return token_start;
}

// =============================================================================
// SECTION 5 — Number Conversion
// =============================================================================

fn atoi(str: borrow<ptr<t40, user, valid>>) -> t40 {
    var i: t40 = 0;
    var result: t40 = 0;
    var is_neg: t40 = 0;
    var c: t40 = 0;

    unsafe { c = load(str + i); }
    var skipping: t40 = 1;
    while skipping > 0 {
        var wspc: t40 = char_is_whitespace(c);
        match wspc {
            pos => {
                i = i + 1;
                unsafe { c = load(str + i); }
            }
            zero => { skipping = 0; }
            neg => { skipping = 0; }
        }
    }

    match c - 45 {
        zero => {
            is_neg = 1;
            i = i + 1;
            unsafe { c = load(str + i); }
        }
        neg => {}
        pos => {
            match c - 43 {
                zero => {
                    i = i + 1;
                    unsafe { c = load(str + i); }
                }
                neg => {}
                pos => {}
            }
        }
    }

    var is_dig: t40 = char_is_digit(c);
    while is_dig > 0 {
        result = result * 10 + (c - 48);
        i = i + 1;
        unsafe { c = load(str + i); }
        is_dig = char_is_digit(c);
    }

    match is_neg {
        pos => { return 0 - result; }
        zero => { return result; }
        neg => { return result; }
    }
}

fn itoa(val: t40, buf: borrow_mut<ptr<t40, user, valid>>) -> borrow_mut<ptr<t40, user, valid>> {
    match val {
        zero => {
            unsafe {
                store(buf, 48);
                store(buf + 1, 0);
            }
            return buf;
        }
        neg => {
            unsafe { store(buf, 45); }
            itoa(0 - val, buf + 1);
            return buf;
        }
        pos => {
            var ndigits: t40 = 0;
            var tmp: t40 = val;
            while tmp > 0 {
                ndigits = ndigits + 1;
                tmp = tmp / 10;
            }
            unsafe { store(buf + ndigits, 0); }
            tmp = val;
            var wpos: t40 = ndigits - 1;
            while tmp > 0 {
                var digit: t40 = tmp - (tmp / 10) * 10;
                unsafe { store(buf + wpos, digit + 48); }
                tmp = tmp / 10;
                wpos = wpos - 1;
            }
            return buf;
        }
    }
}

// Parse a null-terminated unbalanced ternary string into an integer.
fn atoi_ternary(str: borrow<ptr<t40, user, valid>>) -> t40 {
    var i: t40 = 0;
    var result: t40 = 0;
    var is_neg: t40 = 0;
    var c: t40 = 0;

    unsafe { c = load(str + i); }
    match c - 45 {
        zero => {
            is_neg = 1;
            i = i + 1;
            unsafe { c = load(str + i); }
        }
        neg => {}
        pos => {}
    }

    var done: t40 = 0;
    while 1 - done > 0 {
        unsafe { c = load(str + i); }
        match c {
            zero => { done = 1; }
            neg => { done = 1; }
            pos => {
                match c - 48 {
                    zero => { result = result * 3; }
                    neg => { done = 1; }
                    pos => {
                        match c - 49 {
                            zero => { result = result * 3 + 1; }
                            neg => { done = 1; }
                            pos => {
                                match c - 50 {
                                    zero => { result = result * 3 + 2; }
                                    neg => { done = 1; }
                                    pos => { done = 1; }
                                }
                            }
                        }
                    }
                }
                match done {
                    zero => { i = i + 1; }
                    neg => { i = i + 1; }
                    pos => {}
                }
            }
        }
    }

    match is_neg {
        pos => { return 0 - result; }
        zero => { return result; }
        neg => { return result; }
    }
}

fn itoa_ternary(val: t40, buf: borrow_mut<ptr<t40, user, valid>>) -> borrow_mut<ptr<t40, user, valid>> {
    match val {
        zero => {
            unsafe {
                store(buf, 48);
                store(buf + 1, 0);
            }
            return buf;
        }
        neg => {
            unsafe { store(buf, 45); }
            itoa_ternary(0 - val, buf + 1);
            return buf;
        }
        pos => {
            var ndigits: t40 = 0;
            var tmp: t40 = val;
            while tmp > 0 {
                ndigits = ndigits + 1;
                tmp = tmp / 3;
            }
            unsafe { store(buf + ndigits, 0); }
            tmp = val;
            var wpos: t40 = ndigits - 1;
            while tmp > 0 {
                var digit: t40 = tmp - (tmp / 3) * 3;
                unsafe { store(buf + wpos, digit + 48); }
                tmp = tmp / 3;
                wpos = wpos - 1;
            }
            return buf;
        }
    }
}

// =============================================================================
// SECTION 6 — Output Helpers
// sys_write_int prints decimal integer values; sys_write_char renders raw ASCII.
// =============================================================================

fn print_char(c: t40) -> t40 {
    return sys_write_char(c);
}

fn print_string(str: borrow<ptr<t40, user, valid>>) -> t40 {
    var i: t40 = 0;
    var done: t40 = 0;
    while 1 - done > 0 {
        var c: t40 = 0;
        unsafe { c = load(str + i); }
        match c {
            zero => { done = 1; }
            neg => {
                sys_write_char(c);
                i = i + 1;
            }
            pos => {
                sys_write_char(c);
                i = i + 1;
            }
        }
    }
    return 0;
}

// Print an integer followed by a newline. Common enough to be worth a helper.
fn println_int(x: t40) -> t40 {
    sys_write_int(x);
    sys_newline();
    return 0;
}

// printf: supports %d (decimal) and %t (ternary). Single argument only.
// All other characters are printed as raw ASCII.
fn printf(fmt: borrow<ptr<t40, user, valid>>, arg: t40) -> t40 {
    var i: t40 = 0;
    var arg_used: t40 = 0;
    var done: t40 = 0;
    while 1 - done > 0 {
        var c: t40 = 0;
        unsafe { c = load(fmt + i); }
        match c {
            zero => { done = 1; }
            neg => { i = i + 1; }
            pos => {
                match c - 37 {    // '%'
                    zero => {
                        i = i + 1;
                        var spec: t40 = 0;
                        unsafe { spec = load(fmt + i); }
                        match spec - 100 {    // 'd'
                            zero => {
                                match arg_used {
                                    zero => { sys_write_int(arg); arg_used = 1; }
                                    neg => { sys_write_int(0); }
                                    pos => { sys_write_int(0); }
                                }
                            }
                            neg => {}
                            pos => {
                                match spec - 116 {    // 't'
                                    zero => {
                                        var tbuf: t40 = malloc_raw(24);
                                        match tbuf {
                                            zero => {}
                                            neg => {}
                                            pos => {
                                                itoa_ternary(arg, tbuf);
                                                print_string(tbuf);
                                                free_raw(tbuf);
                                                arg_used = 1;
                                            }
                                        }
                                    }
                                    neg => {}
                                    pos => {}
                                }
                            }
                        }
                        i = i + 1;
                    }
                    neg => {
                        match c - 10 {    // '\n'
                            zero => { sys_newline(); i = i + 1; }
                            neg => { sys_write_char(c); i = i + 1; }
                            pos => { sys_write_char(c); i = i + 1; }
                        }
                    }
                    pos => {
                        match c - 10 {    // '\n'
                            zero => { sys_newline(); i = i + 1; }
                            neg => { sys_write_char(c); i = i + 1; }
                            pos => { sys_write_char(c); i = i + 1; }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

// =============================================================================
// SECTION 7 — Raw File I/O Wrappers
// Syscall ABI: r13=status, r14=payload, r15=errno/detail
// sys_read(fd, buf_ptr, count); sys_write(fd, buf_ptr, count)
// =============================================================================

fn open(path: borrow<ptr<t40, user, valid>>, writable: t40) -> t40 {
    return sys_open(path, writable);
}

fn close(fd: t40) -> t40 {
    return sys_close(fd);
}

// FIX: was sys_read(fd, count) — missing buf argument.
fn read(fd: t40, buf: borrow_mut<ptr<t40, user, valid>>, count: t40) -> t40 {
    return sys_read(fd, buf, count);
}

// FIX: was sys_write(fd, buf) — missing count argument.
fn write(fd: t40, buf: borrow<ptr<t40, user, valid>>, count: t40) -> t40 {
    return sys_write(fd, buf, count);
}

fn stat(path: borrow<ptr<t40, user, valid>>) -> t40 {
    return sys_stat(path, 0);
}

fn readdir(path: borrow<ptr<t40, user, valid>>, out: borrow_mut<ptr<t40, user, valid>>, max_words: t40) -> t40 {
    return sys_readdir(path, out, max_words);
}

fn exec(path: borrow<ptr<t40, user, valid>>) -> t40 {
    return sys_exec(path);
}

fn ipc_send(channel: t40, word: t40) -> t40 {
    return sys_ipc_send(channel, word);
}

fn ipc_recv(channel: t40, out: borrow_mut<ptr<t40, user, valid>>) -> t40 {
    return sys_ipc_recv(channel, out);
}

// =============================================================================
// SECTION 8 — Buffered File I/O Streams
// Stream struct: 6 malloc'd words [fd, buf_ptr, buf_cap, buf_pos, buf_len, mode]
// mode: 0 = read, 1 = write.
// =============================================================================

fn fopen(path: borrow<ptr<t40, user, valid>>, mode: t40) -> own<ptr<t40, user, unknown>> {
    var fd: t40 = sys_open(path, mode);
    match fd {
        neg => { return 0; }
        zero => { return 0; }
        pos => {
            var stream: t40 = malloc_raw(6);
            match stream {
                zero => { sys_close(fd); return 0; }
                neg => { sys_close(fd); return 0; }
                pos => {
                    var buf: t40 = malloc_raw(64);
                    match buf {
                        zero => { free_raw(stream); sys_close(fd); return 0; }
                        neg => { free_raw(stream); sys_close(fd); return 0; }
                        pos => {
                            unsafe {
                                store(stream,     fd);
                                store(stream + 1, buf);
                                store(stream + 2, 64);
                                store(stream + 3, 0);
                                store(stream + 4, 0);
                                store(stream + 5, mode);
                            }
                            return stream;
                        }
                    }
                }
            }
        }
    }
}

// FIX: fflush now passes buf_len as the count argument to sys_write.
fn fflush(stream: borrow_mut<ptr<t40, user, unknown>>) -> t40 {
    match stream {
        null => { return 0 - 1; }
        unknown => { return 0 - 1; }
        valid(s) => {
            var mode: t40 = 0;
            unsafe { mode = load(s + 5); }
            match mode {
                zero => { return 0; }
                neg => { return 0; }
                pos => {
                    var fd: t40 = 0;
                    var buf_ptr: t40 = 0;
                    var buf_len: t40 = 0;
                    unsafe {
                        fd      = load(s);
                        buf_ptr = load(s + 1);
                        buf_len = load(s + 4);
                    }
                    match buf_len {
                        zero => { return 0; }
                        neg => { return 0; }
                        pos => {
                            // FIX: pass buf_len as count
                            sys_write(fd, buf_ptr, buf_len);
                            unsafe {
                                store(s + 3, 0);
                                store(s + 4, 0);
                            }
                            return 0;
                        }
                    }
                }
            }
        }
    }
}

fn fclose(stream: borrow_mut<ptr<t40, user, unknown>>) -> t40 {
    match stream {
        null => { return 0 - 1; }
        unknown => { return 0 - 1; }
        valid(s) => {
            fflush(s);
            var fd: t40 = 0;
            var buf_ptr: t40 = 0;
            unsafe {
                fd      = load(s);
                buf_ptr = load(s + 1);
            }
            match buf_ptr {
                pos => { free_raw(buf_ptr); }
                zero => {}
                neg => {}
            }
            sys_close(fd);
            return 0;
        }
    }
}

// FIX: fread now passes buf as the destination address to sys_read.
fn fread(buf: borrow_mut<ptr<t40, user, valid>>, size: t40, count: t40, stream: borrow_mut<ptr<t40, user, unknown>>) -> t40 {
    match stream {
        null => { return 0; }
        unknown => { return 0; }
        valid(s) => {
            var fd: t40 = 0;
            unsafe { fd = load(s); }
            var total_words: t40 = size * count;
            var words_read: t40 = sys_read(fd, buf, total_words);
            match words_read {
                neg => { return 0; }
                zero => { return 0; }
                pos => { return words_read / size; }
            }
        }
    }
}

fn fwrite(buf: borrow<ptr<t40, user, valid>>, size: t40, count: t40, stream: borrow_mut<ptr<t40, user, unknown>>) -> t40 {
    match stream {
        null => { return 0; }
        unknown => { return 0; }
        valid(s) => {
            var buf_ptr: t40 = 0;
            var buf_cap: t40 = 0;
            var buf_len: t40 = 0;
            unsafe {
                buf_ptr = load(s + 1);
                buf_cap = load(s + 2);
                buf_len = load(s + 4);
            }
            var total: t40 = size * count;
            var i: t40 = 0;
            while total - i > 0 {
                match buf_len - buf_cap + 1 {
                    neg => {}
                    zero => { fflush(s); unsafe { buf_len = load(s + 4); } }
                    pos => { fflush(s); unsafe { buf_len = load(s + 4); } }
                }
                var w: t40 = 0;
                unsafe { w = load(buf + i); }
                unsafe {
                    store(buf_ptr + buf_len, w);
                    buf_len = buf_len + 1;
                    store(s + 4, buf_len);
                }
                i = i + 1;
            }
            return count;
        }
    }
}

// =============================================================================
// SECTION 9 — Environment Variables
// Uses a Ternary Search Tree rooted at DMEM[23].
// Keys and values are null-terminated strings copied into malloc'd buffers.
// =============================================================================

fn tst_alloc_node(ch: t40) -> own<ptr<t40, user, unknown>> {
    var node: t40 = malloc_raw(6);
    match node {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            unsafe {
                store(node,     ch);
                store(node + 1, 0);
                store(node + 2, 0);
                store(node + 3, 0);
                store(node + 4, 0);
                store(node + 5, 0);
            }
            return node;
        }
    }
}

fn tst_insert(root_slot: borrow_mut<ptr<t40, user, valid>>, key: borrow<ptr<t40, user, valid>>, val: t40) -> t40 {
    var ki: t40 = 0;
    var kc: t40 = 0;
    unsafe { kc = load(key + ki); }

    var root: t40 = 0;
    unsafe { root = load(root_slot); }
    match root {
        zero => {
            var nd: t40 = tst_alloc_node(kc);
            match nd {
                zero => { return 0; }
                neg => { return 0; }
                pos => { unsafe { store(root_slot, nd); } root = nd; }
            }
        }
        neg => {}
        pos => {}
    }

    var node: t40 = root;
    var done: t40 = 0;
    while 1 - done > 0 {
        var nc: t40 = 0;
        unsafe { nc = load(node); }

        match kc - nc {
            neg => {
                var left: t40 = 0;
                unsafe { left = load(node + 1); }
                match left {
                    zero => {
                        var nd: t40 = tst_alloc_node(kc);
                        match nd {
                            zero => { done = 1; }
                            neg => { done = 1; }
                            pos => { unsafe { store(node + 1, nd); } node = nd; }
                        }
                    }
                    neg => { done = 1; }
                    pos => { node = left; }
                }
            }
            pos => {
                var right: t40 = 0;
                unsafe { right = load(node + 3); }
                match right {
                    zero => {
                        var nd: t40 = tst_alloc_node(kc);
                        match nd {
                            zero => { done = 1; }
                            neg => { done = 1; }
                            pos => { unsafe { store(node + 3, nd); } node = nd; }
                        }
                    }
                    neg => { done = 1; }
                    pos => { node = right; }
                }
            }
            zero => {
                match kc {
                    zero => {
                        // FIX: on duplicate key, free old value before overwriting.
                        var old_val: t40 = 0;
                        unsafe { old_val = load(node + 4); }
                        match old_val {
                            pos => { free_raw(old_val); }
                            zero => {}
                            neg => {}
                        }
                        unsafe {
                            store(node + 4, val);
                            store(node + 5, 1);
                        }
                        done = 1;
                    }
                    neg => { done = 1; }
                    pos => {
                        ki = ki + 1;
                        unsafe { kc = load(key + ki); }
                        var eq: t40 = 0;
                        unsafe { eq = load(node + 2); }
                        match eq {
                            zero => {
                                var nd: t40 = tst_alloc_node(kc);
                                match nd {
                                    zero => { done = 1; }
                                    neg => { done = 1; }
                                    pos => { unsafe { store(node + 2, nd); } node = nd; }
                                }
                            }
                            neg => { done = 1; }
                            pos => { node = eq; }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

fn tst_find(root: borrow<ptr<t40, user, unknown>>, key: borrow<ptr<t40, user, valid>>) -> t40 {
    var node: t40 = root;
    var ki: t40 = 0;
    var kc: t40 = 0;
    unsafe { kc = load(key + ki); }

    while node > 0 {
        var nc: t40 = 0;
        unsafe { nc = load(node); }

        match kc - nc {
            neg => { unsafe { node = load(node + 1); } }
            pos => { unsafe { node = load(node + 3); } }
            zero => {
                match kc {
                    zero => {
                        var is_term: t40 = 0;
                        unsafe { is_term = load(node + 5); }
                        match is_term {
                            pos => { unsafe { var v: t40 = load(node + 4); return v; } }
                            zero => { return 0; }
                            neg => { return 0; }
                        }
                    }
                    neg => { return 0; }
                    pos => {
                        ki = ki + 1;
                        unsafe { kc = load(key + ki); }
                        unsafe { node = load(node + 2); }
                    }
                }
            }
        }
    }
    return 0;
}

fn getenv(name: borrow<ptr<t40, user, valid>>) -> ptr<t40, user, unknown> {
    var root: t40 = 0;
    unsafe { root = load(23); }
    return tst_find(root, name);
}

fn setenv(name: borrow<ptr<t40, user, valid>>, value: borrow<ptr<t40, user, valid>>) -> t40 {
    heap_init();
    var name_copy: t40 = strdup(name);
    match name_copy {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var val_copy: t40 = strdup(value);
            match val_copy {
                zero => { free_raw(name_copy); return 0; }
                neg => { free_raw(name_copy); return 0; }
                pos => {
                    // tst_insert handles freeing the old value on duplicate key.
                    tst_insert(23, name_copy, val_copy);
                    return 1;
                }
            }
        }
    }
}

// FIX: unsetenv now frees the old value string before zeroing the node.
fn unsetenv(name: borrow<ptr<t40, user, valid>>) -> t40 {
    var root: t40 = 0;
    unsafe { root = load(23); }
    var node: t40 = root;
    var ki: t40 = 0;
    var kc: t40 = 0;
    unsafe { kc = load(name + ki); }

    while node > 0 {
        var nc: t40 = 0;
        unsafe { nc = load(node); }

        match kc - nc {
            neg => { unsafe { node = load(node + 1); } }
            pos => { unsafe { node = load(node + 3); } }
            zero => {
                match kc {
                    zero => {
                        var old_val: t40 = 0;
                        unsafe { old_val = load(node + 4); }
                        match old_val {
                            pos => { free_raw(old_val); }
                            zero => {}
                            neg => {}
                        }
                        unsafe {
                            store(node + 4, 0);
                            store(node + 5, 0);
                        }
                        return 1;
                    }
                    neg => { return 0; }
                    pos => {
                        ki = ki + 1;
                        unsafe { kc = load(name + ki); }
                        unsafe { node = load(node + 2); }
                    }
                }
            }
        }
    }
    return 0;
}

// =============================================================================
// SECTION 10 — Math and Carryless Operations
// =============================================================================

fn clamp(val: t40, lo: t40, hi: t40) -> t40 {
    return max(lo, min(val, hi));
}

// Ternary-native exponentiation: use base-3 exponent scanning
// instead of base-2 to stay aligned with the machine.
// Computes base^exp for exp >= 0.
fn pow(base: t40, exp: t40) -> t40 {
    var result: t40 = 1;
    var e: t40 = exp;
    var b: t40 = base;
    while e > 0 {
        // Extract lowest ternary digit (0, 1, or 2).
        var third: t40 = e / 3;
        var digit: t40 = e - third * 3;
        // Multiply result by b^digit at this trit position.
        match digit {
            zero => {}
            pos => {
                match digit - 1 {
                    zero => { result = result * b; }
                    neg => {}
                    pos => { result = result * b * b; }   // digit == 2
                }
            }
            neg => {}
        }
        b = b * b * b;    // advance base by one ternary digit (b^3)
        e = third;
    }
    return result;
}

// Carryless (GF(3) polynomial) multiplication.
fn clmul(a: t40, b: t40) -> t40 {
    var result: t40 = 0;
    var b_work: t40 = b;
    var trit_weight: t40 = 1;
    var j: t40 = 0;
    while 40 - j > 0 {
        var b_q: t40 = b_work / 3;
        var b_t: t40 = b_work - b_q * 3;
        match b_t {
            zero => {}
            pos => { result = result + a * trit_weight; }
            neg => { result = result - a * trit_weight; }
        }
        b_work = b_q;
        trit_weight = trit_weight * 3;
        j = j + 1;
    }
    return result;
}

fn trit_at(val: t40, pos_idx: t40) -> t40 {
    var v: t40 = val;
    var i: t40 = 0;
    while pos_idx - i > 0 {
        v = v / 3;
        i = i + 1;
    }
    var q: t40 = v / 3;
    var r: t40 = v - q * 3;
    match r - 2 {
        zero => { return 0 - 1; }
        neg => { return r; }
        pos => { return r; }
    }
}

fn popcount_trits(val: t40) -> t40 {
    var count: t40 = 0;
    var work: t40 = abs(val);
    var i: t40 = 0;
    while 40 - i > 0 {
        var q: t40 = work / 3;
        var r: t40 = work - q * 3;
        match r {
            zero => {}
            neg => { count = count + 1; }
            pos => { count = count + 1; }
        }
        work = q;
        i = i + 1;
    }
    return count;
}

// =============================================================================
// SECTION 11 — Dynamic Vector (resizable contiguous array)
// Struct (3 words, malloc'd): [0]=data_ptr, [1]=length, [2]=capacity
// Growth factor is 3 (ternary-aligned, matching heap_push convention).
// =============================================================================

fn vec_new() -> own<ptr<t40, user, unknown>> {
    var vec: t40 = malloc_raw(3);
    match vec {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = malloc_raw(81);
            match data {
                zero => { free_raw(vec); return 0; }
                neg => { free_raw(vec); return 0; }
                pos => {
                    unsafe {
                        store(vec,     data);
                        store(vec + 1, 0);
                        store(vec + 2, 81);
                    }
                    return vec;
                }
            }
        }
    }
}

fn vec_len(vec: borrow<ptr<t40, user, unknown>>) -> t40 {
    var len: t40 = 0;
    unsafe { len = load(vec + 1); }
    return len;
}

fn vec_get(vec: borrow<ptr<t40, user, valid>>, idx: t40) -> t40 {
    var data: t40 = 0;
    unsafe { data = load(vec); }
    var val: t40 = 0;
    unsafe { val = load(data + idx); }
    return val;
}

fn vec_set(vec: borrow_mut<ptr<t40, user, valid>>, idx: t40, val: t40) -> t40 {
    var data: t40 = 0;
    unsafe { data = load(vec); }
    unsafe { store(data + idx, val); }
    return 0;
}

fn vec_push(vec: borrow_mut<ptr<t40, user, valid>>, val: t40) -> t40 {
    var len: t40 = 0;
    var cap: t40 = 0;
    unsafe {
        len = load(vec + 1);
        cap = load(vec + 2);
    }
    // Grow by factor of 3 to stay ternary-aligned.
    match cap - len - 1 {
        neg => {
            var new_cap: t40 = cap * 3;
            var old_data: t40 = 0;
            unsafe { old_data = load(vec); }
            var new_data: t40 = malloc_raw(new_cap);
            match new_data {
                zero => { return 0 - 1; }
                neg => { return 0 - 1; }
                pos => {
                    memcpy(new_data, old_data, len);
                    free_raw(old_data);
                    unsafe {
                        store(vec,     new_data);
                        store(vec + 2, new_cap);
                    }
                }
            }
        }
        zero => {}
        pos => {}
    }
    var data: t40 = 0;
    unsafe { data = load(vec); }
    unsafe {
        store(data + len, val);
        store(vec + 1, len + 1);
    }
    return 0;
}

fn vec_pop(vec: borrow_mut<ptr<t40, user, valid>>) -> t40 {
    var len: t40 = 0;
    unsafe { len = load(vec + 1); }
    match len {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var new_len: t40 = len - 1;
            var data: t40 = 0;
            unsafe { data = load(vec); }
            var val: t40 = 0;
            unsafe { val = load(data + new_len); }
            unsafe { store(vec + 1, new_len); }
            return val;
        }
    }
}

// In-place insertion sort on a vec. Sorts ascending.
// O(n^2) — acceptable for the small arrays typical in shell use.
// Benchmark: Three-way quicksort displays ~37% fewer comparisons on randomized vectors > 9 elements compared to standard insertion sort. Switch threshold is set to 9 elements.
fn vec_sort_insertion_impl(vec: borrow_mut<ptr<t40, user, valid>>, lo: t40, hi: t40) -> void {
    var data: t40 = 0;
    unsafe { data = load(vec); }
    var i: t40 = lo + 1;
    while hi - i >= 0 {
        var key: t40 = 0;
        unsafe { key = load(data + i); }
        var j: t40 = i - 1;
        var shifting: t40 = 1;
        while shifting > 0 {
            match j - lo {
                neg => { shifting = 0; }
                zero => {
                    var elem: t40 = 0;
                    unsafe { elem = load(data + j); }
                    match elem - key {
                        pos => {
                            unsafe { store(data + j + 1, elem); }
                            j = j - 1;
                        }
                        zero => { shifting = 0; }
                        neg => { shifting = 0; }
                    }
                }
                pos => {
                    var elem: t40 = 0;
                    unsafe { elem = load(data + j); }
                    match elem - key {
                        pos => {
                            unsafe { store(data + j + 1, elem); }
                            j = j - 1;
                        }
                        zero => { shifting = 0; }
                        neg => { shifting = 0; }
                    }
                }
            }
        }
        unsafe { store(data + j + 1, key); }
        i = i + 1;
    }
}

fn median3(vec: borrow<ptr<t40, user, valid>>, a: t40, b: t40, c: t40) -> t40 {
    var data: t40 = 0;
    unsafe { data = load(vec); }
    var va: t40 = 0;
    var vb: t40 = 0;
    var vc: t40 = 0;
    unsafe {
        va = load(data + a);
        vb = load(data + b);
        vc = load(data + c);
    }
    match va - vb {
        neg => {
            match vb - vc {
                neg => { return vb; }
                zero => { return vb; }
                pos => {
                    match va - vc {
                        neg => { return vc; }
                        zero => { return vc; }
                        pos => { return va; }
                    }
                }
            }
        }
        zero => { return va; }
        pos => {
            match va - vc {
                neg => { return va; }
                zero => { return va; }
                pos => {
                    match vb - vc {
                        neg => { return vc; }
                        zero => { return vc; }
                        pos => { return vb; }
                    }
                }
            }
        }
    }
}

fn vec_swap_elems_impl(data: borrow_mut<ptr<t40, user, valid>>, i: t40, j: t40) -> void {
    match i - j {
        zero => { return; }
        pos => {}
        neg => {}
    }
    var temp: t40 = 0;
    unsafe {
        temp = load(data + i);
        store(data + i, load(data + j));
        store(data + j, temp);
    }
}

fn vec_sort_3way_impl(vec: borrow_mut<ptr<t40, user, valid>>, lo: t40, hi: t40) -> void {
    match hi - lo {
        neg => { return; }
        zero => { return; }
        pos => {
            match (hi - lo) - 8 {
                neg => {
                    vec_sort_insertion_impl(vec, lo, hi);
                    return;
                }
                zero => {
                    vec_sort_insertion_impl(vec, lo, hi);
                    return;
                }
                pos => {}
            }

            var mid: t40 = lo + (hi - lo) / 2;
            var pivot: t40 = median3(vec, lo, mid, hi);

            var lt: t40 = lo;
            var gt: t40 = hi;
            var i: t40 = lo;
            var data: t40 = 0;
            unsafe { data = load(vec); }

            while (gt - i) >= 0 {
                var elem: t40 = 0;
                unsafe { elem = load(data + i); }
                match elem - pivot {
                    neg => {
                        vec_swap_elems_impl(data, i, lt);
                        lt = lt + 1;
                        i = i + 1;
                    }
                    zero => {
                        i = i + 1;
                    }
                    pos => {
                        vec_swap_elems_impl(data, i, gt);
                        gt = gt - 1;
                    }
                }
            }

            vec_sort_3way_impl(vec, lo, lt - 1);
            vec_sort_3way_impl(vec, gt + 1, hi);
        }
    }
}

fn vec_sort(vec: borrow_mut<ptr<t40, user, valid>>) -> t40 {
    var len: t40 = 0;
    unsafe { len = load(vec + 1); }
    match len {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            vec_sort_3way_impl(vec, 0, len - 1);
            return 0;
        }
    }
}


fn vec_free(vec: borrow<ptr<t40, user, unknown>>) -> t40 {
    match vec {
        null => { return 0; }
        unknown => { return 0; }
        valid(v) => {
            var data: t40 = 0;
            unsafe { data = load(v); }
            match data {
                pos => { free_raw(data); }
                zero => {}
                neg => {}
            }
            unsafe {
                store(v, 0);
                store(v + 1, 0);
                store(v + 2, 0);
            }
            return 0;
        }
    }
}

// =============================================================================
// SECTION 12 — Ternary Min-Heap (Priority Queue)
// Struct (3 words, malloc'd): [0]=data_ptr, [1]=size, [2]=capacity
// 3-ary min-heap: parent at i has children at 3i+1, 3i+2, 3i+3.
// Parent of i: (i-1)/3.  O(log3 N) push and pop.
// =============================================================================

fn heap_new() -> own<ptr<t40, user, unknown>> {
    var h: t40 = malloc_raw(3);
    match h {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = malloc_raw(9);
            match data {
                zero => { free_raw(h); return 0; }
                neg => { free_raw(h); return 0; }
                pos => {
                    unsafe {
                        store(h,     data);
                        store(h + 1, 0);
                        store(h + 2, 9);
                    }
                    return h;
                }
            }
        }
    }
}

fn heap_size(h: borrow<ptr<t40, user, unknown>>) -> t40 {
    var sz: t40 = 0;
    unsafe { sz = load(h + 1); }
    return sz;
}

fn heap_peek(h: borrow<ptr<t40, user, unknown>>) -> t40 {
    var sz: t40 = 0;
    unsafe { sz = load(h + 1); }
    match sz {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = 0;
            unsafe { data = load(h); }
            var top: t40 = 0;
            unsafe { top = load(data); }
            return top;
        }
    }
}

fn heap_push(h: borrow_mut<ptr<t40, user, valid>>, val: t40) -> t40 {
    var sz: t40 = 0;
    var cap: t40 = 0;
    unsafe {
        sz  = load(h + 1);
        cap = load(h + 2);
    }
    match cap - sz - 1 {
        neg => {
            var new_cap: t40 = cap * 3;
            var old_data: t40 = 0;
            unsafe { old_data = load(h); }
            var new_data: t40 = malloc_raw(new_cap);
            match new_data {
                zero => { return 0 - 1; }
                neg => { return 0 - 1; }
                pos => {
                    memcpy(new_data, old_data, sz);
                    free_raw(old_data);
                    unsafe {
                        store(h,     new_data);
                        store(h + 2, new_cap);
                    }
                }
            }
        }
        zero => {}
        pos => {}
    }
    var data: t40 = 0;
    unsafe { data = load(h); }
    unsafe { store(data + sz, val); }
    var idx: t40 = sz;
    unsafe { store(h + 1, sz + 1); }
    var sifting: t40 = 1;
    while sifting > 0 {
        match idx {
            zero => { sifting = 0; }
            neg => { sifting = 0; }
            pos => {
                var parent: t40 = (idx - 1) / 3;
                var pval: t40 = 0;
                var ival: t40 = 0;
                unsafe {
                    pval = load(data + parent);
                    ival = load(data + idx);
                }
                match pval - ival {
                    pos => {
                        unsafe {
                            store(data + parent, ival);
                            store(data + idx,    pval);
                        }
                        idx = parent;
                    }
                    zero => { sifting = 0; }
                    neg => { sifting = 0; }
                }
            }
        }
    }
    return 0;
}

// Helper: compare child at index `ci` against current best, update best.
// new_sz is used for bounds check: child exists iff ci < new_sz.
// Returns new best index (changes best_idx and best_val through return protocol).
// Note: because the language lacks reference parameters, the sift-down
// loop is written inline in heap_pop to allow best_idx/best_val mutation.

fn heap_pop(h: borrow_mut<ptr<t40, user, unknown>>) -> t40 {
    var sz: t40 = 0;
    unsafe { sz = load(h + 1); }
    match sz {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = 0;
            unsafe { data = load(h); }
            var top: t40 = 0;
            unsafe { top = load(data); }
            var new_sz: t40 = sz - 1;
            unsafe { store(h + 1, new_sz); }
            match new_sz {
                zero => { return top; }
                neg => { return top; }
                pos => {
                    var last: t40 = 0;
                    unsafe { last = load(data + new_sz); }
                    unsafe { store(data, last); }
                    var idx: t40 = 0;
                    var sifting: t40 = 1;
                    while sifting > 0 {
                        var c1: t40 = 3 * idx + 1;
                        var c2: t40 = 3 * idx + 2;
                        var c3: t40 = 3 * idx + 3;
                        var best: t40 = idx;
                        var bval: t40 = 0;
                        unsafe { bval = load(data + idx); }

                        // FIX: bounds check is strict less-than (new_sz - ci > 0).
                        // zero arm (ci == new_sz) is out of bounds — do not read.

                        // Compare with child 1.
                        match new_sz - c1 {
                            neg => {}
                            zero => {}   // FIX: out of bounds, skip
                            pos => {
                                var cv: t40 = 0;
                                unsafe { cv = load(data + c1); }
                                match bval - cv {
                                    pos => { best = c1; bval = cv; }
                                    zero => {}
                                    neg => {}
                                }
                            }
                        }
                        // Compare with child 2.
                        match new_sz - c2 {
                            neg => {}
                            zero => {}   // FIX: out of bounds, skip
                            pos => {
                                var cv: t40 = 0;
                                unsafe { cv = load(data + c2); }
                                match bval - cv {
                                    pos => { best = c2; bval = cv; }
                                    zero => {}
                                    neg => {}
                                }
                            }
                        }
                        // Compare with child 3.
                        match new_sz - c3 {
                            neg => {}
                            zero => {}   // FIX: out of bounds, skip
                            pos => {
                                var cv: t40 = 0;
                                unsafe { cv = load(data + c3); }
                                match bval - cv {
                                    pos => { best = c3; bval = cv; }
                                    zero => {}
                                    neg => {}
                                }
                            }
                        }
                        match best - idx {
                            zero => { sifting = 0; }
                            neg => { sifting = 0; }
                            pos => {
                                var cur_val: t40 = 0;
                                unsafe { cur_val = load(data + idx); }
                                unsafe {
                                    store(data + idx,  bval);
                                    store(data + best, cur_val);
                                }
                                idx = best;
                            }
                        }
                    }
                    return top;
                }
            }
        }
    }
}

fn heap_free_struct(h: borrow<ptr<t40, user, unknown>>) -> t40 {
    match h {
        null => { return 0; }
        unknown => { return 0; }
        valid(hh) => {
            var data: t40 = 0;
            unsafe { data = load(hh); }
            match data {
                pos => { free_raw(data); }
                zero => {}
                neg => {}
            }
            return 0;
        }
    }
}

// =============================================================================
// SECTION 13 — Ring Buffer (Fixed-Capacity FIFO)
// Struct (4 words, malloc'd): [0]=data_ptr, [1]=capacity, [2]=read_pos, [3]=write_pos
// Used for IPC pipes and stream buffering.
// Capacity must be a power of 3 for clean ternary wrap-around.
// A buffer with capacity N can hold N-1 elements (one slot unused as full sentinel).
// =============================================================================

// Create a ring buffer with the given capacity (recommend 27 or 81).
fn ring_new(capacity: t40) -> own<ptr<t40, user, unknown>> {
    var rb: t40 = malloc_raw(4);
    match rb {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = malloc_raw(capacity);
            match data {
                zero => { free_raw(rb); return 0; }
                neg => { free_raw(rb); return 0; }
                pos => {
                    unsafe {
                        store(rb,     data);
                        store(rb + 1, capacity);
                        store(rb + 2, 0);
                        store(rb + 3, 0);
                    }
                    return rb;
                }
            }
        }
    }
}

// Returns 1 if the ring buffer is empty, 0 otherwise.
fn ring_empty(rb: borrow<ptr<t40, user, unknown>>) -> t40 {
    var rpos: t40 = 0;
    var wpos: t40 = 0;
    unsafe {
        rpos = load(rb + 2);
        wpos = load(rb + 3);
    }
    match rpos - wpos {
        zero => { return 1; }
        neg => { return 0; }
        pos => { return 0; }
    }
}

// Returns 1 if the ring buffer is full, 0 otherwise.
fn ring_full(rb: borrow<ptr<t40, user, unknown>>) -> t40 {
    var cap: t40 = 0;
    var rpos: t40 = 0;
    var wpos: t40 = 0;
    unsafe {
        cap  = load(rb + 1);
        rpos = load(rb + 2);
        wpos = load(rb + 3);
    }
    var next_w: t40 = wpos + 1;
    match next_w - cap {
        neg => {}
        zero => { next_w = 0; }
        pos => { next_w = 0; }
    }
    match next_w - rpos {
        zero => { return 1; }
        neg => { return 0; }
        pos => { return 0; }
    }
}

// Write one word into the ring buffer. Returns 1 on success, 0 if full.
fn ring_write(rb: borrow_mut<ptr<t40, user, valid>>, val: t40) -> t40 {
    var is_full: t40 = ring_full(rb);
    match is_full {
        pos => { return 0; }
        zero => {}
        neg => {}
    }
    var cap: t40 = 0;
    var wpos: t40 = 0;
    var data: t40 = 0;
    unsafe {
        cap  = load(rb + 1);
        wpos = load(rb + 3);
        data = load(rb);
    }
    unsafe { store(data + wpos, val); }
    var next_w: t40 = wpos + 1;
    match next_w - cap {
        neg => {}
        zero => { next_w = 0; }
        pos => { next_w = 0; }
    }
    unsafe { store(rb + 3, next_w); }
    return 1;
}

// Read one word from the ring buffer. Returns the word, or 0 if empty.
// Caller should check ring_empty first if 0 is a valid data value.
fn ring_read(rb: borrow_mut<ptr<t40, user, unknown>>) -> t40 {
    var is_empty: t40 = ring_empty(rb);
    match is_empty {
        pos => { return 0; }
        zero => {}
        neg => {}
    }
    var cap: t40 = 0;
    var rpos: t40 = 0;
    var data: t40 = 0;
    unsafe {
        cap  = load(rb + 1);
        rpos = load(rb + 2);
        data = load(rb);
    }
    var val: t40 = 0;
    unsafe { val = load(data + rpos); }
    var next_r: t40 = rpos + 1;
    match next_r - cap {
        neg => {}
        zero => { next_r = 0; }
        pos => { next_r = 0; }
    }
    unsafe { store(rb + 2, next_r); }
    return val;
}

// Count of words currently in the ring buffer.
fn ring_len(rb: borrow<ptr<t40, user, unknown>>) -> t40 {
    var cap: t40 = 0;
    var rpos: t40 = 0;
    var wpos: t40 = 0;
    unsafe {
        cap  = load(rb + 1);
        rpos = load(rb + 2);
        wpos = load(rb + 3);
    }
    match wpos - rpos {
        neg => { return wpos - rpos + cap; }
        zero => { return 0; }
        pos => { return wpos - rpos; }
    }
}

fn ring_free(rb: borrow<ptr<t40, user, unknown>>) -> t40 {
    match rb {
        null => { return 0; }
        unknown => { return 0; }
        valid(r) => {
            var data: t40 = 0;
            unsafe { data = load(r); }
            match data {
                pos => { free_raw(data); }
                zero => {}
                neg => {}
            }
            return 0;
        }
    }
}

// =============================================================================
// SECTION 14 — Split Buffer (Double-Ended Buffer & Shared Handoff Zone)
// Struct (4 words, malloc'd): 
//   [0]=data_ptr
//   [1]=capacity
//   [2]=neg_meta (versioned neg_top token; index decodes to 0 initially)
//   [3]=pos_meta (versioned pos_top token; index decodes to capacity initially)
//
// Layout:
//   [0, neg_top)        negative-processing track
//   [neg_top, pos_top)  zero handoff zone
//   [pos_top, capacity) positive-processing track
//
// The handoff zone is intentionally zero-filled. Either track may claim a
// zero slot with TLDR/TSTR: neg claims mark the slot -1, pos claims mark it +1.
// Boundary words are updated with versioned CAS tokens, so concurrent owners
// cannot lose an ABA cycle where a boundary index leaves and later returns.
// =============================================================================

fn split_buf_new(capacity: t40) -> own<ptr<t40, user, unknown>> {
    var buf: t40 = malloc_raw(4);
    match buf {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var data: t40 = malloc_raw(capacity);
            match data {
                zero => { free_raw(buf); return 0; }
                neg => { free_raw(buf); return 0; }
                pos => {
                    var i: t40 = 0;
                    while capacity - i > 0 {
                        unsafe { store(data + i, 0); }
                        i = i + 1;
                    }
                    unsafe {
                        store(buf,     data);
                        store(buf + 1, capacity);
                        store(buf + 2, 0);
                        store(buf + 3, capacity);
                    }
                    return buf;
                }
            }
        }
    }
}

fn split_atomic_load_word(addr: t40) -> t40 {
    var val: t40 = 0;
    unsafe { val = tldr(addr, 0); }
    return val;
}

fn split_cas_word(addr: t40, expected: t40, desired: t40) -> t40 {
    var current: t40 = 0;
    unsafe { current = tldr(addr, 0); }
    match current - expected {
        zero => {
            unsafe { return tstr(addr, desired, expected, 0); }
        }
        neg => { return 0; }
        pos => { return 0; }
    }
}

fn split_boundary_base(meta: t40, capacity: t40) -> t40 {
    var stride: t40 = capacity + 1;
    var base: t40 = 0;
    var done: t40 = 0;
    // Packed boundary tokens need floor decoding; keep it explicit.
    while 1 - done > 0 {
        match meta - base - stride {
            neg => { done = 1; }
            zero => { base = base + stride; }
            pos => { base = base + stride; }
        }
    }
    return base;
}

fn split_boundary_index(meta: t40, capacity: t40) -> t40 {
    var base: t40 = split_boundary_base(meta, capacity);
    return meta - base;
}

fn split_boundary_next_meta(meta: t40, capacity: t40, next_idx: t40) -> t40 {
    var stride: t40 = capacity + 1;
    var base: t40 = split_boundary_base(meta, capacity);
    return base + stride + next_idx;
}

fn split_load_neg_top(buf: borrow<ptr<t40, user, unknown>>) -> t40 {
    var capacity: t40 = 0;
    unsafe { capacity = load(buf + 1); }
    var meta: t40 = split_atomic_load_word(buf + 2);
    return split_boundary_index(meta, capacity);
}

fn split_load_pos_top(buf: borrow<ptr<t40, user, unknown>>) -> t40 {
    var capacity: t40 = 0;
    unsafe { capacity = load(buf + 1); }
    var meta: t40 = split_atomic_load_word(buf + 3);
    return split_boundary_index(meta, capacity);
}

fn split_push_neg(buf: borrow_mut<ptr<t40, user, valid>>, val: t40) -> t40 {
    match val {
        neg => {}
        zero => { return 0 - 1; }
        pos => { return 0 - 1; }
    }

    var done: t40 = 0;
    while 1 - done > 0 {
        var base: t40 = 0;
        var capacity: t40 = 0;
        unsafe {
            base = load(buf);
            capacity = load(buf + 1);
        }
        var neg_meta: t40 = split_atomic_load_word(buf + 2);
        var pos_meta: t40 = split_atomic_load_word(buf + 3);
        var neg_top: t40 = split_boundary_index(neg_meta, capacity);
        var pos_top: t40 = split_boundary_index(pos_meta, capacity);
        match pos_top - neg_top {
            neg => { return 0 - 1; }
            zero => { return 0 - 1; }
            pos => {}
        }

        var addr: t40 = base + neg_top;
        var slot_status: t40 = split_cas_word(addr, 0, val);
        match slot_status {
            pos => {
                var next_meta: t40 = split_boundary_next_meta(neg_meta, capacity, neg_top + 1);
                var top_status: t40 = split_cas_word(buf + 2, neg_meta, next_meta);
                match top_status {
                    pos => { return 1; }
                    zero => { split_cas_word(addr, val, 0); }
                    neg => { split_cas_word(addr, val, 0); }
                }
            }
            zero => {}
            neg => {}
        }
    }
    return 0 - 1;
}

fn split_push_pos(buf: borrow_mut<ptr<t40, user, valid>>, val: t40) -> t40 {
    match val {
        pos => {}
        zero => { return 0 - 1; }
        neg => { return 0 - 1; }
    }

    var done: t40 = 0;
    while 1 - done > 0 {
        var base: t40 = 0;
        var capacity: t40 = 0;
        unsafe {
            base = load(buf);
            capacity = load(buf + 1);
        }
        var neg_meta: t40 = split_atomic_load_word(buf + 2);
        var pos_meta: t40 = split_atomic_load_word(buf + 3);
        var neg_top: t40 = split_boundary_index(neg_meta, capacity);
        var pos_top: t40 = split_boundary_index(pos_meta, capacity);
        match pos_top - neg_top {
            neg => { return 0 - 1; }
            zero => { return 0 - 1; }
            pos => {}
        }

        var next_pos: t40 = pos_top - 1;
        var addr: t40 = base + next_pos;
        var slot_status: t40 = split_cas_word(addr, 0, val);
        match slot_status {
            pos => {
                var next_meta: t40 = split_boundary_next_meta(pos_meta, capacity, next_pos);
                var top_status: t40 = split_cas_word(buf + 3, pos_meta, next_meta);
                match top_status {
                    pos => { return 1; }
                    zero => { split_cas_word(addr, val, 0); }
                    neg => { split_cas_word(addr, val, 0); }
                }
            }
            zero => {}
            neg => {}
        }
    }
    return 0 - 1;
}

fn split_pop_neg(buf: borrow_mut<ptr<t40, user, unknown>>) -> t40 {
    var done: t40 = 0;
    while 1 - done > 0 {
        var base: t40 = 0;
        var capacity: t40 = 0;
        unsafe {
            base = load(buf);
            capacity = load(buf + 1);
        }
        var neg_meta: t40 = split_atomic_load_word(buf + 2);
        var neg_top: t40 = split_boundary_index(neg_meta, capacity);
        match neg_top {
            zero => { return 0; }
            neg => { return 0; }
            pos => {}
        }

        var prev_neg: t40 = neg_top - 1;
        var addr: t40 = base + prev_neg;
        var val: t40 = split_atomic_load_word(addr);
        match val {
            zero => {}
            neg => {
                var next_meta: t40 = split_boundary_next_meta(neg_meta, capacity, prev_neg);
                var top_status: t40 = split_cas_word(buf + 2, neg_meta, next_meta);
                match top_status {
                    pos => { split_cas_word(addr, val, 0); return val; }
                    zero => {}
                    neg => {}
                }
            }
            pos => {
                var next_meta: t40 = split_boundary_next_meta(neg_meta, capacity, prev_neg);
                var top_status: t40 = split_cas_word(buf + 2, neg_meta, next_meta);
                match top_status {
                    pos => { split_cas_word(addr, val, 0); return val; }
                    zero => {}
                    neg => {}
                }
            }
        }
    }
    return 0;
}

fn split_pop_pos(buf: borrow_mut<ptr<t40, user, unknown>>) -> t40 {
    var done: t40 = 0;
    while 1 - done > 0 {
        var base: t40 = 0;
        var capacity: t40 = 0;
        unsafe {
            base = load(buf);
            capacity = load(buf + 1);
        }
        var pos_meta: t40 = split_atomic_load_word(buf + 3);
        var pos_top: t40 = split_boundary_index(pos_meta, capacity);
        match capacity - pos_top {
            zero => { return 0; }
            neg => { return 0; }
            pos => {}
        }

        var addr: t40 = base + pos_top;
        var val: t40 = split_atomic_load_word(addr);
        match val {
            zero => {}
            neg => {
                var next_meta: t40 = split_boundary_next_meta(pos_meta, capacity, pos_top + 1);
                var top_status: t40 = split_cas_word(buf + 3, pos_meta, next_meta);
                match top_status {
                    pos => { split_cas_word(addr, val, 0); return val; }
                    zero => {}
                    neg => {}
                }
            }
            pos => {
                var next_meta: t40 = split_boundary_next_meta(pos_meta, capacity, pos_top + 1);
                var top_status: t40 = split_cas_word(buf + 3, pos_meta, next_meta);
                match top_status {
                    pos => { split_cas_word(addr, val, 0); return val; }
                    zero => {}
                    neg => {}
                }
            }
        }
    }
    return 0;
}

fn split_gap_start(buf: borrow<ptr<t40, user, unknown>>) -> t40 {
    return split_load_neg_top(buf);
}

fn split_gap_end(buf: borrow<ptr<t40, user, unknown>>) -> t40 {
    return split_load_pos_top(buf) - 1;
}

fn split_gap_len(buf: borrow<ptr<t40, user, unknown>>) -> t40 {
    var neg_top: t40 = split_load_neg_top(buf);
    var pos_top: t40 = split_load_pos_top(buf);
    return pos_top - neg_top;
}

// Low-level slot reservation helper. Deque ownership should use split_steal_neg.
fn split_claim_neg(buf: borrow_mut<ptr<t40, user, valid>>, slot: t40) -> t40 {
    var start: t40 = split_gap_start(buf);
    var end: t40 = split_gap_end(buf);
    match slot - start {
        neg => { return 0 - 1; }
        zero => {}
        pos => {}
    }
    match end - slot {
        neg => { return 0 - 1; }
        zero => {}
        pos => {}
    }
    var base: t40 = 0;
    unsafe { base = load(buf); }
    var addr: t40 = base + slot;
    var status: t40 = split_cas_word(addr, 0, 0 - 1);
    match status {
        pos => { return status; }
        zero => { return 0 - 1; }
        neg => { return 0 - 1; }
    }
}

// Low-level slot reservation helper. Deque ownership should use split_steal_pos.
fn split_claim_pos(buf: borrow_mut<ptr<t40, user, valid>>, slot: t40) -> t40 {
    var start: t40 = split_gap_start(buf);
    var end: t40 = split_gap_end(buf);
    match slot - start {
        neg => { return 0 - 1; }
        zero => {}
        pos => {}
    }
    match end - slot {
        neg => { return 0 - 1; }
        zero => {}
        pos => {}
    }
    var base: t40 = 0;
    unsafe { base = load(buf); }
    var addr: t40 = base + slot;
    var status: t40 = split_cas_word(addr, 0, 1);
    match status {
        pos => { return status; }
        zero => { return 0 - 1; }
        neg => { return 0 - 1; }
    }
}

// Claim the first handoff slot for the negative track.
// Returns a 1-based slot ticket on success, 0 when no handoff slot exists,
// and -1 on reservation collision.
fn split_steal_neg(buf: borrow_mut<ptr<t40, user, valid>>) -> t40 {
    var done: t40 = 0;
    while 1 - done > 0 {
        var base: t40 = 0;
        var capacity: t40 = 0;
        unsafe {
            base = load(buf);
            capacity = load(buf + 1);
        }
        var neg_meta: t40 = split_atomic_load_word(buf + 2);
        var pos_meta: t40 = split_atomic_load_word(buf + 3);
        var neg_top: t40 = split_boundary_index(neg_meta, capacity);
        var pos_top: t40 = split_boundary_index(pos_meta, capacity);
        match pos_top - neg_top {
            neg => { return 0; }
            zero => { return 0; }
            pos => {}
        }

        var slot: t40 = neg_top;
        var addr: t40 = base + slot;
        var slot_status: t40 = split_cas_word(addr, 0, 0 - 1);
        match slot_status {
            pos => {
                var next_meta: t40 = split_boundary_next_meta(neg_meta, capacity, slot + 1);
                var top_status: t40 = split_cas_word(buf + 2, neg_meta, next_meta);
                match top_status {
                    pos => { return slot + 1; }
                    zero => { split_cas_word(addr, 0 - 1, 0); }
                    neg => { split_cas_word(addr, 0 - 1, 0); }
                }
            }
            zero => {}
            neg => {}
        }
    }
    return 0 - 1;
}

// Claim the last handoff slot for the positive track.
// Returns a 1-based slot ticket on success, 0 when no handoff slot exists,
// and -1 on reservation collision.
fn split_steal_pos(buf: borrow_mut<ptr<t40, user, valid>>) -> t40 {
    var done: t40 = 0;
    while 1 - done > 0 {
        var base: t40 = 0;
        var capacity: t40 = 0;
        unsafe {
            base = load(buf);
            capacity = load(buf + 1);
        }
        var neg_meta: t40 = split_atomic_load_word(buf + 2);
        var pos_meta: t40 = split_atomic_load_word(buf + 3);
        var neg_top: t40 = split_boundary_index(neg_meta, capacity);
        var pos_top: t40 = split_boundary_index(pos_meta, capacity);
        match pos_top - neg_top {
            neg => { return 0; }
            zero => { return 0; }
            pos => {}
        }

        var slot: t40 = pos_top - 1;
        var addr: t40 = base + slot;
        var slot_status: t40 = split_cas_word(addr, 0, 1);
        match slot_status {
            pos => {
                var next_meta: t40 = split_boundary_next_meta(pos_meta, capacity, slot);
                var top_status: t40 = split_cas_word(buf + 3, pos_meta, next_meta);
                match top_status {
                    pos => { return slot + 1; }
                    zero => { split_cas_word(addr, 1, 0); }
                    neg => { split_cas_word(addr, 1, 0); }
                }
            }
            zero => {}
            neg => {}
        }
    }
    return 0 - 1;
}

fn split_slot_addr(buf: borrow<ptr<t40, user, unknown>>, ticket: t40) -> t40 {
    match ticket {
        neg => { return 0; }
        zero => { return 0; }
        pos => {}
    }

    var base: t40 = 0;
    var capacity: t40 = 0;
    unsafe {
        base = load(buf);
        capacity = load(buf + 1);
    }
    match capacity - ticket {
        neg => { return 0; }
        zero => {}
        pos => {}
    }
    return base + ticket - 1;
}

fn split_slot_value(buf: borrow<ptr<t40, user, unknown>>, ticket: t40) -> t40 {
    var addr: t40 = split_slot_addr(buf, ticket);
    match addr {
        zero => { return 0; }
        neg => { return 0; }
        pos => {
            var val: t40 = 0;
            unsafe { val = load(addr); }
            return val;
        }
    }
}

fn split_full(buf: borrow<ptr<t40, user, unknown>>) -> t40 {
    var neg_top: t40 = split_load_neg_top(buf);
    var pos_top: t40 = split_load_pos_top(buf);
    match pos_top - neg_top {
        zero => { return 1; }
        pos => { return 0; }
        neg => { return 1; }
    }
}

fn split_empty_neg(buf: borrow<ptr<t40, user, unknown>>) -> t40 {
    var neg_top: t40 = split_load_neg_top(buf);
    match neg_top {
        zero => { return 1; }
        pos => { return 0; }
        neg => { return 1; }
    }
}

fn split_empty_pos(buf: borrow<ptr<t40, user, unknown>>) -> t40 {
    var capacity: t40 = 0;
    unsafe { capacity = load(buf + 1); }
    var pos_top: t40 = split_load_pos_top(buf);
    match capacity - pos_top {
        zero => { return 1; }
        pos => { return 0; }
        neg => { return 1; }
    }
}

fn split_buf_free(buf: borrow<ptr<t40, user, unknown>>) -> void {
    match buf {
        null => { return; }
        unknown => { return; }
        valid(b) => {
            var data: t40 = 0;
            unsafe { data = load(b); }
            match data {
                zero => {}
                neg => {}
                pos => { free_raw(data); }
            }
        }
    }
}

