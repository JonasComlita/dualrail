// user_audio_app.trit
// Verification app for Ternary Audio DSP Pipeline.
// Avoids double-quotes in string literals to prevent compiler lexer issues.

fn print_ok() -> void {
    sys_write_char(32); // ' '
    sys_write_char(79); // 'O'
    sys_write_char(75); // 'K'
    sys_newline();
}

